## Stage 3's captures for preview.py (docs/research/POLY-MODELING.md): the
## drag after a tool and the interactive tools in Edit Mesh, on a 2-unit
## box (faces 0-5, its top face 2) or a 6 by 6 grid.
##   drag_extrude: the box's top extruded, the pointer moved up its normal
##     with no button: the extrusion follows, the normal's line in amber, the
##     value box by the pointer, Extrude's rows on the tool bar (More
##     options shut).
##   drag_extrude_lock: the box's front extruded and Z pressed: the line in
##     Z's color.
##   drag_bevel: an edge of the box beveled and a drag under way, the box
##     showing Offset.
##   loopcut_hover: Loop Cut over a side edge of the box with the wheel
##     turned twice: three loops round it in amber, the count by the
##     pointer.
##   loopcut_slide: the cut placed and sliding toward one end of its ring,
##     the rails in amber.
##   edge_slide: the grid's middle row sliding up its rails.
from app import Luce3D
from luce_ui.ui import Event
from luce_window.input import EventKind, Key, ScrollUnit
from luce_3d.graphics import Vector3
from luce_geocore.geocore import Selection
from view_projection import project
from edit_types import edge_level, face_level
import node_commands
import modeling_commands
import selection_commands
import preview_support

pub func scenes() -> list[str]:
    return ["drag_extrude", "drag_extrude_lock", "drag_bevel", "loopcut_hover", "loopcut_slide", "edge_slide"]

## An Edit Mesh holding primitive `name` (count `count` for a grid).
func modeled(editor: Luce3D, name: str, count: float) -> unit!:
    let w = editor.workspace
    node_commands.delete_selected(w)
    node_commands.add_node(w, "Edit Mesh", 40.0, 40.0)
    preview_support.settle(w)
    modeling_commands.create(w, name)
    preview_support.settle(w)
    if name == "Grid":
        modeling_commands.set_last_step(w, 1, count, 1.0, 1000.0)
        preview_support.settle(w)

## Scene `scene` before its first frame.
pub func setup(editor: Luce3D, scene: str) -> unit!:
    let w = editor.workspace
    modeled(editor, "Grid" if scene == "edge_slide" else "Box", 6.0)
    let mesh = w.geometry else trap("mesh")
    if scene == "drag_extrude":
        selection_commands.set_mode(w, face_level)
        w.selection = Selection.of(mesh, "2", 2)
        modeling_commands.model(w, "Extrude")
    elif scene == "drag_extrude_lock":
        selection_commands.set_mode(w, face_level)
        w.selection = Selection.of(mesh, "4", 2)
        modeling_commands.model(w, "Extrude")
    elif scene == "drag_bevel":
        selection_commands.set_mode(w, edge_level)
        w.selection = Selection.of(mesh, "p6-7", 4)
        modeling_commands.model(w, "Bevel")
    elif scene in ["loopcut_hover", "loopcut_slide"]:
        selection_commands.set_mode(w, edge_level)
        selection_commands.select_none(w)
        modeling_commands.model(w, "Loop Cut")
    elif scene == "edge_slide":
        selection_commands.set_mode(w, edge_level)
        w.selection = Selection.of(mesh, "p21-22-23-24-25-26-27", 4)
        modeling_commands.model(w, "Edge Slide")
    preview_support.settle(w)
    w.view.yaw = 0.6
    w.view.pitch = 0.55
    w.view.distance = 7.5
    w.view.target = Vector3(0.0, 0.8, 0.0)
    w.view.update_camera()
    editor.panels.refresh()

## Window point of world point `p`.
func at(editor: Luce3D, p: Vector3) -> list[float]!:
    let area = editor.panels.view.layout().bounds()
    let on = project(editor.workspace, p, area.width, area.height)
    return [area.x + on[0], area.y + on[1]]

func move(editor: Luce3D, point: list[float], meta: bool = false) -> unit!:
    editor.app.dispatch(Event(kind = EventKind.pointer_moved, x = point[0], y = point[1], meta = meta))

## Frame `frame` of scene `scene` (from 2; `last` is the frame captured).
pub func act(editor: Luce3D, scene: str, frame: int, last: int) -> unit!:
    let w = editor.workspace
    editor.app.focus(editor.panels.view.layout())
    if scene in ["loopcut_hover", "loopcut_slide"]:
        # A vertical side edge of the box (points 1 and 2), a little in.
        let over = at(editor, Vector3(1.0, 1.0, -0.98))
        if frame == 2:
            move(editor, over)
        elif frame == 3 and scene == "loopcut_hover":
            for _ in 0..<2:
                editor.app.dispatch(Event(kind = EventKind.scroll, x = over[0], y = over[1], scroll_y = 1.0, scroll_unit = ScrollUnit.lines))
        elif frame == 3:
            editor.app.dispatch(Event(kind = EventKind.pointer_down, x = over[0], y = over[1], button = 0))
            editor.app.dispatch(Event(kind = EventKind.pointer_up, x = over[0], y = over[1], button = 0))
            preview_support.settle(w)
        elif frame == last - 1 and scene == "loopcut_slide":
            let s = w.drag_session else return
            let origin = s.frame.rail_origin(0)
            move(editor, at(editor, origin))
            move(editor, at(editor, origin.add(s.frame.rail_end(0).subtract(origin).multiply_scalar(0.6))), meta = true)
        preview_support.settle(w)
        editor.panels.refresh()
        return
    let s = w.drag_session else return
    let center = s.frame.center_point()
    if scene == "drag_bevel":
        let middle = at(editor, center)
        let start = [middle[0] + 80.0, middle[1] + 20.0]
        if frame == 2:
            move(editor, start)
            editor.app.dispatch(Event(kind = EventKind.pointer_down, x = start[0], y = start[1], button = 0))
        elif frame == last - 1:
            move(editor, [start[0] + 60.0, start[1] + 15.0], meta = true)
    elif scene == "edge_slide":
        let origin = s.frame.rail_origin(s.frame.nearest(w.view.camera.position(), center.subtract(w.view.camera.position()), false))
        if frame == 2:
            move(editor, at(editor, origin))
        elif frame == last - 1:
            var rail = 0
            for index in 0..<s.frame.rail_count():
                if s.frame.rail_origin(index).subtract(origin).length() < 0.000001 and s.frame.rail_sign(index) > 0.0:
                    rail = index
            move(editor, at(editor, origin.add(s.frame.rail_end(rail).subtract(origin).multiply_scalar(0.4))), meta = true)
    else:
        if frame == 2:
            move(editor, at(editor, center))
        elif frame == 3 and scene == "drag_extrude_lock":
            editor.app.dispatch(Event(kind = EventKind.key_down, key = Key.z))
        elif frame == last - 1:
            let way = Vector3(0.0, 0.0, 0.7) if scene == "drag_extrude_lock" else Vector3(0.0, 0.6, 0.0)
            move(editor, at(editor, center.add(way)), meta = true)
    preview_support.settle(w)
    editor.panels.refresh()
