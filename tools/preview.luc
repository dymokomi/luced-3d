import probe
import time
from app import Luce3D
from three import Vector3

pub func main(arguments: list[str]) -> int!:
    let editor = Luce3D(width = int(arguments[15]) if arguments.length > 16 else 2200, height = int(arguments[16]) if arguments.length > 16 else 1400)
    if arguments.length > 17 and arguments[17] == "viewport":
        for id in ["parameters", "outliner", "network", "geometry_spreadsheet"]:
            let panel = editor.panels.dock.find(id) else trap("missing capture panel")
            editor.panels.dock.remove(panel)
    if arguments.length > 5 and arguments[5] == "background":
        editor.workspace.enable_compute()
    if arguments.length > 4:
        editor.workspace.set_display_mode(int(probe.parse_value(arguments[4])))
    if arguments.length > 2 and arguments[1] in ["cad", "cad_wire", "analytic"]:
        let w = editor.workspace
        w.delete_selected()
        w.add_node("File", 40.0, 40.0)
        w.set_text(0, arguments[2])
        if arguments.length > 6 and arguments[6] != "":
            w.add_node("Blast", 220.0, 100.0)
            w.set_text(0, arguments[6])
            w.set_parameter(0, 1.0)
        if arguments[1] != "analytic":
            w.add_node("Tessellate", 40.0, 160.0)
            if arguments.length > 3:
                w.set_parameter(1, probe.parse_value(arguments[3]))
        w.add_node("Transform", 40.0, 280.0)
        w.set_parameter(4, 0.0 if arguments[2].lower().ends_with(".obj") else -90.0)
        if arguments.length > 11 and arguments[11] != "": w.set_parameter(4, probe.parse_value(arguments[11]))
        if arguments[1] == "cad_wire":
            w.set_display_mode(4)
        w.frame_cube()
        w.distance *= 0.75
        w.update_camera()
        if arguments[1] == "analytic":
            w.select_node(2)
            print(f"analytic preview: {w.notice}")
        editor.panels.refresh()
    if arguments.length > 1 and arguments[1] == "outliner":
        let w = editor.workspace
        w.set_output(1, -1)
        w.add_node("Group", 220.0, 70.0)
        let vehicle = w.network.selected
        w.rename("Assembly")
        w.enter_group(vehicle)
        w.add_node("Cube", 40.0, 60.0)
        w.rename("Body")
        w.add_node("Group", 240.0, 60.0)
        let detail = w.network.selected
        w.rename("Details")
        w.set_parameter(1, 3.0)
        w.enter_group(detail)
        w.add_node("Sphere", 40.0, 60.0)
        w.rename("Sphere")
        w.leave_group()
        w.leave_group()
        w.network.selected = -1
        w.add_node("Torus", 430.0, 70.0)
        w.add_node("Transform", 430.0, 180.0)
        w.set_parameter(1, -3.0)
        w.rename("Independent island")
        w.select_node(vehicle)
        editor.panels.refresh()
    if arguments.length > 1 and arguments[1] == "occlusion":
        let w = editor.workspace
        w.add_node("Bevel", 40.0, 170.0)
        w.add_node("Edit", 40.0, 270.0)
        w.choose_component(2, false)
        w.model("Delete")
        w.frame_cube()
        editor.panels.refresh()
    if arguments.length > 1 and arguments[1] == "edit":
        let w = editor.workspace
        w.add_node("Transform", 40.0, 200.0)
        w.set_parameter(5, 18.0)
        w.add_node("Edit", 40.0, 330.0)
        w.choose_component(2, false)
        w.extrude()
        w.choose_component(0, false)
        w.extrude()
        w.choose_component(2, false)
        w.choose_tool("Move")
        w.choose_component(2, false)
        w.frame_cube()
        editor.panels.refresh()
    if arguments.length > 1 and arguments[1] in ["modeling", "spreadsheet"]:
        let w = editor.workspace
        w.add_node("AttributeRandomize", 40.0, 160.0)
        w.add_node("Bevel", 40.0, 250.0)
        w.set_parameter(0, 0.18)
        w.add_node("Edit", 40.0, 340.0)
        w.choose_component(2, false)
        w.set_parameter(0, 0.22)
        w.model("Inset")
        w.choose_component(2, false)
        w.set_parameter(0, 0.35)
        w.extrude()
        w.choose_tool("Move")
        w.choose_component(2, false)
        w.frame_cube()
        editor.panels.refresh()
        if arguments[1] == "spreadsheet":
            let panel = editor.panels.dock.find("geometry_spreadsheet") else trap("sheet")
            editor.panels.dock.select(panel)
    var frames = 0
    var computing_frames = 0
    let started = time.now()
    var phase = ""
    let orbit = arguments.length > 7 and arguments[7] == "orbit"
    let final_frame = 336 if orbit else 5
    var frame_total = 0.0
    var frame_worst = 0.0
    # A scheduled input source keeps the loop awake. Invalidating only inside
    # on_frame measures the idle wait policy as well as rendering.
    var orbit_timer = -1
    if orbit:
        orbit_timer = editor.app.every(0.001, func () -> unit!:
            if frames > 0:
                editor.workspace.orbit(0.5, 0.0)
                editor.panels.view.layout().invalidate())
    if arguments.length > 1 and arguments[1].starts_with("gizmo_"):
        let w = editor.workspace
        w.add_node("Transform", 40.0, 220.0)
        editor.panels.view.tools.gizmos.mode = "Rotate" if arguments[1] == "gizmo_rotate" else ("Scale" if arguments[1] == "gizmo_scale" else ("Pivot" if arguments[1] == "gizmo_pivot" else "Move"))
        editor.panels.refresh()
    let observed = editor.app.on_frame(func (elapsed: float) -> unit!:
        if let compute = editor.workspace.compute:
            if compute.busy:
                let current = compute.service.phase()
                if current != phase:
                    phase = current
                    print(f"compute {float(time.now() - started) / 1000000000.0}s: {phase}")
                computing_frames += 1
                editor.panels.view.layout().invalidate()
                return
            if frames == 0:
                assert(editor.workspace.notice == "")
                print(f"Background compute: {computing_frames} live frames in {float(time.now() - started) / 1000000000.0}s; {editor.workspace.notice}")
                editor.workspace.frame_cube()
        if frames == 0 and arguments.length > 10 and arguments[1] in ["cad", "cad_wire", "analytic"]:
            if arguments[1] != "analytic":
                let visible = editor.workspace.geometry else trap("capture has no polygon geometry; check the group expression")
                assert(visible.face_count() > 0)
            editor.workspace.frame_cube()
            editor.workspace.distance *= probe.parse_value(arguments[8])
            editor.workspace.yaw = probe.parse_value(arguments[9])
            editor.workspace.pitch = probe.parse_value(arguments[10])
            if arguments.length > 14 and arguments[12] != "":
                editor.workspace.target = Vector3(probe.parse_value(arguments[12]), probe.parse_value(arguments[13]), probe.parse_value(arguments[14]))
            editor.workspace.update_camera()
        frames += 1
        # Capture changes the drawable configuration, so exclude its next
        # interval from the 300 measured callbacks.
        if orbit and frames > 35 and frames <= 335:
            frame_total += elapsed * 1000.0
            if elapsed * 1000.0 > frame_worst: frame_worst = elapsed * 1000.0
        if frames == 2:
            editor.panels.graph.frame_all()
            if arguments.length > 1 and arguments[1] == "shading":
                if let show = editor.panels.view.on_shading:
                    show(false)
            if arguments.length > 1 and arguments[1] == "menu":
                editor.panels.graph.pointer_x = 160.0
                editor.panels.graph.pointer_y = 80.0
                editor.panels.open_search()
        if frames == final_frame - 1:
            if arguments.length > 1 and arguments[1] == "menu":
                editor.panels.open_search()
            probe.begin("Luced 3D")
            editor.panels.view.layout().invalidate()
        elif frames >= final_frame:
            assert(editor.workspace.notice == "")
            if orbit: print(f"Native orbit: {frame_total / 300.0} ms mean, {frame_worst} ms worst; callbacks, not input-to-photon")
            editor.app.stop())
    editor.app.run()
    observed.disconnect()
    if orbit: editor.app.cancel(orbit_timer)
    probe.save(arguments[0])
    probe.end()
    editor.close()
    return 0
