## The edges of `model` from `a` to `b` that `keep` takes, each once.
func edges_along(model: CadModel, keep: func(Vector3, Vector3) -> bool) -> list[int]!:
    let found: list[int] = []
    for face in 0..<model.face_count():
        for use in 0..<model.face_edge_count(face):
            let edge = model.face_edge_id(face, use)
            if keep(model.face_edge_point(face, use, 0.0), model.face_edge_point(face, use, 1.0)) and not (edge in found):
                found.append(edge)
    return found

## A 20 x 4 x 20 plate with a 6 cube boss on it (y 2 to 8), joined: the
## Combine node, selected.
func boss_on_plate(w: Workspace) -> int!:
    node_commands.add_node(w, "Solid Box", 40.0, 40.0)
    node_commands.set_parameter(w, 1, 4.0)
    let plate = w.network.selected
    node_commands.add_node(w, "Solid Box", 240.0, 40.0)
    for slot in 0..<3: node_commands.set_parameter(w, slot, 6.0)
    node_commands.add_node(w, "Transform", 240.0, 140.0)
    node_commands.set_parameter(w, 2, 5.0)
    let boss = w.network.selected
    node_commands.select_node(w, plate)
    node_commands.add_node(w, "Combine", 40.0, 240.0)
    node_commands.connect(w, boss, w.network.selected, 1)
    return w.network.selected

## The name of `model`'s face facing up above `height`.
func top_face(model: CadModel, height: float) -> str!:
    for face in 0..<model.face_count():
        let name = CadModeling.face_name_of(model, face)
        let at = CadModeling.face_point(model, name)
        if at.found and at.normal.y > 0.999 and at.point.y > height: return name
    return ""

## A pyramid over a 20 by 12 base at y = 0, its apex at y = 15 (the
## study's F8b): a box less four blocks beyond its sides; the last Combine.
func oblong_pyramid(w: Workspace) -> int!:
    node_commands.add_node(w, "Solid Box", 40.0, 40.0)
    node_commands.set_parameter(w, 1, 15.0)
    node_commands.set_parameter(w, 2, 12.0)
    node_commands.add_node(w, "Transform", 40.0, 140.0)
    node_commands.set_parameter(w, 2, 7.5)
    var body = w.network.selected
    let alpha = math.atan2(10.0, 15.0)
    let beta = math.atan2(6.0, 15.0)
    let cuts = [(Vector3(10.0, 0.0, 0.0), Vector3(math.cos(alpha), math.sin(alpha), 0.0), Vector3(0.0, 0.0, alpha)),
                (Vector3(-10.0, 0.0, 0.0), Vector3(-math.cos(alpha), math.sin(alpha), 0.0), Vector3(0.0, 0.0, -alpha)),
                (Vector3(0.0, 0.0, 6.0), Vector3(0.0, math.sin(beta), math.cos(beta)), Vector3(-beta, 0.0, 0.0)),
                (Vector3(0.0, 0.0, -6.0), Vector3(0.0, math.sin(beta), -math.cos(beta)), Vector3(beta, 0.0, 0.0))]
    var k = 0
    for (at, out, turn) in cuts:
        let x = 240.0 + float(k) * 120.0
        node_commands.add_node(w, "Solid Box", x, 40.0)
        for slot in 0..<3: node_commands.set_parameter(w, slot, 60.0)
        node_commands.add_node(w, "Transform", x, 140.0)
        let centre = at.add(out.multiply_scalar(30.0))
        let degrees = turn.multiply_scalar(180.0 / math.pi)
        for (slot, value) in [(1, centre.x), (2, centre.y), (3, centre.z), (4, degrees.x), (5, degrees.y), (6, degrees.z)]:
            node_commands.set_parameter(w, slot, value)
        let tool = w.network.selected
        node_commands.select_node(w, body)
        node_commands.add_node(w, "Combine", 40.0, 240.0 + float(k) * 100.0)
        node_commands.set_parameter(w, edit_cad_faces.combine_slot, 1.0)
        node_commands.connect(w, tool, w.network.selected, 1)
        body = w.network.selected
        k += 1
    return body

pub func act(editor: Luce3D, scene: str, frame: int, last: int) -> unit!:
    _ = editor
    _ = scene
    _ = frame
    _ = last

## `body` less cylinder `k` (radius 2, 8 long) turned by `turn` degrees and
## moved to `at`: the Combine node, selected.
func cut(w: Workspace, body: int, k: int, at: Vector3, turn: Vector3) -> int!:
    let x = 240.0 + float(k) * 120.0
    node_commands.add_node(w, "Solid Cylinder", x, 40.0)
    node_commands.set_parameter(w, 0, 2.0)
    node_commands.set_parameter(w, 1, 8.0)
    node_commands.add_node(w, "Transform", x, 140.0)
    for (slot, value) in [(1, at.x), (2, at.y), (3, at.z), (4, turn.x), (5, turn.y), (6, turn.z)]:
        node_commands.set_parameter(w, slot, value)
    let tool = w.network.selected
    node_commands.select_node(w, body)
    node_commands.add_node(w, "Combine", 40.0, 140.0 + float(k) * 100.0)
    node_commands.set_parameter(w, edit_cad_faces.combine_slot, 1.0)
    node_commands.connect(w, tool, w.network.selected, 1)
    return w.network.selected

func look(w: Workspace, yaw: float, pitch: float, distance: float, target: Vector3) -> unit!:
    w.view.yaw = yaw
    w.view.pitch = pitch
    w.view.distance = distance
    w.view.target = target
    w.view.update_camera()
