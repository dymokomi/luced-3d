## Stage 4's captures for preview.py (docs/research/POLY-MODELING.md): Bevel
## in Edit Mesh, shown with its wireframe so the topology reads.
##   bevel_box: every edge of a 2-unit box at 3 segments: round strips and
##     the grid corners, a triangle in the middle of each (odd segments);
##     Bevel's rows on the tool bar.
##   bevel_corner: one corner's three edges at 4 segments, close in: the
##     corner patch's grid on its sphere.
##   bevel_vertex: the box's top corners cut off (Affect Auto, picked as
##     points), 2 segments.
##   bevel_miter: an L-shaped block (a grid less a quarter, extruded) with
##     its edges beveled at 3 segments, Limit Angle leaving the flat ones,
##     and Miter Outer Arc: the inner corner's strips end square with an
##     arc between.
##   bevel_custom: a box edge with Profile Type Custom set to a step, the
##     tool bar's More options open on the ramp.
##   bevel_keys: a drag after Bevel with P pressed: the value box reads the
##     Shape the pointer sets.
from app import Luce3D
from luce_ui.ui import Event
from luce_window.input import EventKind, Key
from luce_3d.graphics import Vector3
from luce_geocore.geocore import Selection
from view_projection import project
from edit_types import point_level, edge_level, face_level
import node_commands
import modeling_commands
import selection_commands
import preview_support
import text as characters

pub func scenes() -> list[str]:
    return ["bevel_box", "bevel_corner", "bevel_vertex", "bevel_miter", "bevel_custom", "bevel_keys"]

## An Edit Mesh holding primitive `name`.
func modeled(editor: Luce3D, name: str) -> unit!:
    let w = editor.workspace
    node_commands.delete_selected(w)
    node_commands.add_node(w, "Edit Mesh", 40.0, 40.0)
    preview_support.settle(w)
    modeling_commands.create(w, name)
    preview_support.settle(w)

## Run Bevel on `expression` (on `domain`: 0 points, 4 edges) at `level`,
## then set its numbers `slots` to `values`.
func bevel(editor: Luce3D, level: int, expression: str, domain: int, slots: list[int], values: list[float]) -> unit!:
    let w = editor.workspace
    let mesh = preview_support.shown(w) else trap("mesh")
    selection_commands.set_mode(w, level)
    w.selection = Selection.of(mesh, expression, domain)
    modeling_commands.model(w, "Bevel")
    preview_support.settle(w)
    for index in 0..<slots.length:
        modeling_commands.set_last_step(w, slots[index], values[index], -1.0e9, 1.0e9)
    preview_support.settle(w)

## Scene `scene` before its first frame.
pub func setup(editor: Luce3D, scene: str) -> unit!:
    let w = editor.workspace
    if scene == "bevel_miter":
        modeled(editor, "Grid")
        modeling_commands.set_last_step(w, 1, 2.0, 1.0, 1000.0)
        preview_support.settle(w)
        # A grid of 2 by 2 less one quarter: an L, raised into a block.
        var mesh = preview_support.shown(w) else trap("grid")
        selection_commands.set_mode(w, face_level)
        w.selection = Selection.of(mesh, "3", 2)
        modeling_commands.model(w, "Delete")
        preview_support.settle(w)
        mesh = preview_support.shown(w) else trap("L")
        w.selection = Selection.of(mesh, "*", 2)
        modeling_commands.model(w, "Extrude")
        preview_support.settle(w)
        modeling_commands.set_last_step(w, 0, 0.8, -1.0e9, 1.0e9)
        preview_support.settle(w)
        bevel(editor, edge_level, "*", 4, [0, 1, 8, 18], [0.12, 3.0, 2.0, 1.0])
    else:
        modeled(editor, "Box")
        if scene == "bevel_box":
            bevel(editor, edge_level, "*", 4, [0, 1], [0.3, 3.0])
        elif scene == "bevel_corner":
            bevel(editor, edge_level, "p6-2 p6-5 p6-7", 4, [0, 1], [0.35, 4.0])
        elif scene == "bevel_vertex":
            bevel(editor, point_level, "2 3 6 7", 0, [0, 1], [0.3, 2.0])
        elif scene == "bevel_custom":
            bevel(editor, edge_level, "p6-7", 4, [0, 1, 7], [0.4, 6.0, 1.0])
            modeling_commands.set_last_step_values(w, 20, [1.0, 1.0, 3.0, 0.0, 0.0, 0.0, 0.5, 1.0, 0.0, 1.0, 1.0, 0.0])
            preview_support.settle(w)
        elif scene == "bevel_keys":
            bevel(editor, edge_level, "p6-7", 4, [1], [6.0])
    w.view.yaw = 0.6
    w.view.pitch = 0.55
    w.view.distance = 3.0 if scene == "bevel_corner" else 5.2
    w.view.target = Vector3(0.6, 1.6, 0.6) if scene == "bevel_corner" else (Vector3(0.0, 0.4, 0.0) if scene == "bevel_miter" else Vector3(0.0, 1.0, 0.0))
    w.view.update_camera()
    editor.panels.refresh()

## Window point of world point `p`.
func at(editor: Luce3D, p: Vector3) -> list[float]!:
    let area = editor.panels.view.layout().bounds()
    let on = project(editor.workspace, p, area.width, area.height)
    return [area.x + on[0], area.y + on[1]]

## Frame `frame` of scene `scene` (from 2; `last` is the frame captured).
pub func act(editor: Luce3D, scene: str, frame: int, last: int) -> unit!:
    let w = editor.workspace
    editor.app.focus(editor.panels.view.layout())
    if scene == "bevel_custom":
        editor.panels.tool_bar.panel.set_folder_open("more_options", true)
    if scene != "bevel_keys":
        editor.panels.refresh()
        return
    let s = w.drag_session else return
    let middle = at(editor, s.frame.center_point())
    let start = [middle[0] + 80.0, middle[1] + 20.0]
    if frame == 2:
        editor.app.dispatch(Event(kind = EventKind.pointer_moved, x = start[0], y = start[1]))
        editor.app.dispatch(Event(kind = EventKind.pointer_down, x = start[0], y = start[1], button = 0))
        editor.app.dispatch(Event(kind = EventKind.pointer_moved, x = start[0] + 20.0, y = start[1], meta = true))
        editor.app.dispatch(Event(kind = EventKind.key_down, key = Key.p))
        editor.app.dispatch(Event(kind = EventKind.text_input, codepoint = characters.code_of("p")))
    elif frame == last - 1:
        editor.app.dispatch(Event(kind = EventKind.pointer_moved, x = start[0] + 140.0, y = start[1] + 10.0, meta = true))
    preview_support.settle(w)
    editor.panels.refresh()
