## Diagnostic serialization with round-trip binary64 precision.
import c
import strings
import interop
from three import PolygonMesh, Vector3
extern func printf(format: c.str, ...) -> c.int

pub func point(x: f64, y: f64, z: f64):
    discard(printf("v %.17g %.17g %.17g\n", x, y, z))

pub func number(text: str) -> f64!:
    return try strings.parse_f64(text)

## Measure the actual renderer triangulation, including concave cut cells.
pub func metrics(mesh: interop.Reference[PolygonMesh]) -> !:
    var area: f64 = 0.0
    var volume: f64 = 0.0
    let data = mesh.value()
    for triangle in 0..<data.index_count()//3:
        var positions = [Vector3(),Vector3(),Vector3()]
        for at in 0..<3:
            let index = data.index(triangle*3+at)
            defer index.release()
            let vertex = data.vertex(try index.get())
            defer vertex.release()
            positions[(usize)at] = (try vertex.get()).position
        let cross = positions[1].subtract(positions[0]).cross(positions[2].subtract(positions[0]))
        area += cross.length()*0.5
        volume += positions[0].dot(cross)/6.0
    discard(printf("# renderer_area=%.17g renderer_volume=%.17g\n",area,volume))
