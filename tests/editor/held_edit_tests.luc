## Edit Mesh holds its result (POLY-MODELING.md, "Edit nodes hold their
## result"):
##
## - primitives are made inside it at any level with nothing selected (the
##   Create entries are not pale), each a piece selected at the Object
##   level; two boxes, one moved, both picked,
##   joined by Boolean (then Subtract by adjusting it);
## - the last action stays adjustable from the result before it, and the
##   next action bakes it;
## - a change upstream does not flow in: the node says its input changed,
##   and Reload Input (one undo step) takes the new input;
## - the undo history keeps earlier results and is bounded by their bytes;
## - a saved project keeps the held result in <name>.held/, loaded back as
##   the node's result with nothing to adjust;
## - Edit CAD's held bodies rechecked when the project's tolerances change.
from luce_3d.graphics import Vector3
from luce_geocore.geocore import Selection
from tool_drag_tests import editor_on, near
from edit_types import object_level, point_level, face_level
from held_store import HeldStore
from workspace import Workspace
from luce_cad.cad_geometry import CadGeometry
from luce_cad.model import CadTolerances
from project_settings import ProjectValues
import project_settings
import edit_held
import modeling_commands
import selection_commands
import node_commands
import component_moves
from luce_std import files, paths

pub func held_edit_tests() -> unit!:
    create_inside()
    boolean_inside()
    adjust_last()
    input_changes()
    history_bound()
    saved_held()
    cad_tolerances()
    print("PASS Edit Mesh holds its result: primitives made inside at any level, two boxes, one moved, both picked and joined by Boolean; the last action adjusted from the result before it, the next baking it; upstream changes held off, Input changed and Reload Input; undo bounded by the held bytes; saved beside the project and loaded back")

func create_inside() -> unit!:
    let editor = editor_on(Vector3(4.0, 5.0, 6.0), edit = false)
    let w = editor.workspace
    node_commands.delete_selected(w)
    node_commands.add_node(w, "Edit Mesh", 0.0, 0.0)
    editor.panels.refresh()
    # At the Polygons level, nothing selected: Box is offered.
    selection_commands.set_mode(w, face_level)
    editor.panels.actions.refresh()
    var found = false
    for command in editor.panels.actions.modeling:
        if command.text() == "Box":
            found = true
            assert(command.is_enabled(), "Box is pale in an Edit Mesh")
    assert(found)
    modeling_commands.create(w, "Box")
    assert(w.level_index() == object_level and w.selected_count() == 6)
    # The second box, moved to the right; then both picked as pieces.
    modeling_commands.create(w, "Box")
    assert(w.selected_count() == 6)
    component_moves.move_selection(w, Vector3(1.5, 0.0, 0.0))
    let mesh = w.geometry else trap("boxes")
    assert(mesh.face_count() == 12)
    near(mesh.bounds().maximum.x, 2.5)
    selection_commands.choose_component(w, 0, false)
    selection_commands.choose_component(w, 6, true)
    assert(w.selected_count() == 12)
    editor.close()

## Two boxes made inside one Edit Mesh, the second moved into the first,
## then both picked and joined by Boolean (one undo step), adjusted to Intersect.
func boolean_inside() -> unit!:
    let editor = editor_on(Vector3(4.0, 5.0, 6.0), edit = false)
    let w = editor.workspace
    node_commands.delete_selected(w)
    node_commands.add_node(w, "Edit Mesh", 0.0, 0.0)
    modeling_commands.create(w, "Box")
    modeling_commands.create(w, "Box")
    component_moves.move_selection(w, Vector3(0.5, 0.5, 0.5))
    selection_commands.choose_component(w, 0, false)
    selection_commands.choose_component(w, 6, true)
    let before = w.history.cursor
    modeling_commands.model(w, "Boolean")
    let joined = w.geometry else trap("joined")
    assert(w.history.cursor == before + 1 and w.notice == "")
    # The union: one closed piece over both boxes (-1..1 and -0.5..1.5
    # across, 0..2 and 0.5..2.5 up), new points where their faces cross.
    assert(joined.point_count() > 16, f"{joined.point_count()} points")
    near(joined.bounds().minimum.x, -1.0)
    near(joined.bounds().maximum.y, 2.5)
    # Intersect, adjusted from the tool bar: only the part both hold.
    modeling_commands.set_last_step(w, 0, 2.0, 0.0, 2.0)
    let both = w.geometry else trap("both")
    near(both.bounds().minimum.x, -0.5)
    near(both.bounds().maximum.y, 2.0)
    # Undo back to before it: the two boxes.
    while w.history.cursor > before:
        w.undo()
    assert((w.geometry else trap("undone")).point_count() == 16)
    editor.close()

func adjust_last() -> unit!:
    let editor = editor_on(Vector3(0.0, 5.0, 0.6))
    let w = editor.workspace
    selection_commands.set_mode(w, face_level)
    w.selection = Selection.of(w.geometry else trap("grid"), "5", 2)
    modeling_commands.extrude(w)
    let node = w.selected() else trap("edit")
    let held = node.held else trap("held")
    assert(node.edits.length == 1 and held.made_for == node.edits[0].key)
    # Adjusting it runs it again from the result before it.
    modeling_commands.set_last_step(w, 0, 0.5, -100.0, 100.0)
    near((w.geometry else trap("grid")).bounds().maximum.y, 0.5)
    # The next action bakes it: the extrusion is now the base.
    modeling_commands.model(w, "Inset")
    let after = w.selected() else trap("edit")
    let baked = after.held else trap("held")
    assert(after.edits.length == 1 and after.edits[0].verb == "Inset")
    near((baked.base.mesh else trap("base")).bounds().maximum.y, 0.5)
    editor.close()

func input_changes() -> unit!:
    let editor = editor_on(Vector3(0.0, 5.0, 0.6))
    let w = editor.workspace
    let edit = w.network.selected
    selection_commands.set_mode(w, point_level)
    w.selection = Selection.of(w.geometry else trap("grid"), "12", 0)
    component_moves.move_selection(w, Vector3(0.0, 1.0, 0.0))
    # The grid made finer upstream: the Edit Mesh keeps its 16 faces.
    var grid = -1
    for node in w.network.nodes:
        if node.kind == "Grid":
            grid = node.id
    node_commands.select_node(w, grid)
    node_commands.set_parameter(w, 2, 8.0)
    node_commands.select_node(w, edit)
    assert((w.geometry else trap("held")).face_count() == 16)
    assert(edit_held.input_changed(w.network, w.network.require(edit)))
    near((w.geometry else trap("held")).point(12).y, 1.0)
    # Reload Input: the finer grid, one undo step back to what it held.
    let before = w.history.cursor
    modeling_commands.clear_edits(w)
    assert(w.history.cursor == before + 1 and (w.geometry else trap("reloaded")).face_count() == 32)
    assert(not edit_held.input_changed(w.network, w.network.require(edit)))
    w.undo()
    assert((w.geometry else trap("undone")).face_count() == 16)
    near((w.geometry else trap("undone")).point(12).y, 1.0)
    editor.close()

func history_bound() -> unit!:
    let editor = editor_on(Vector3(0.0, 5.0, 0.6))
    let w = editor.workspace
    selection_commands.set_mode(w, point_level)
    # Under a tiny bound every older change goes as soon as a new one comes.
    w.held_budget = 1
    for step in 0..<5:
        w.selection = Selection.of(w.geometry else trap("grid"), f"{step}", 0)
        component_moves.move_selection(w, Vector3(0.0, 0.1, 0.0))
    assert(w.history.changes.length <= 2, f"{w.history.changes.length} changes kept")
    # Held results nothing reaches are released.
    let live = HeldStore.count()
    w.held_budget = 2147483648
    for step in 0..<3:
        w.selection = Selection.of(w.geometry else trap("grid"), f"{step + 10}", 0)
        component_moves.move_selection(w, Vector3(0.0, 0.1, 0.0))
    assert(HeldStore.count() >= live and w.history.changes.length >= 4, f"{HeldStore.count()} held, {live} before, {w.history.changes.length} changes")
    editor.close()

func saved_held() -> unit!:
    let editor = editor_on(Vector3(0.0, 5.0, 0.6))
    let w = editor.workspace
    selection_commands.set_mode(w, point_level)
    w.selection = Selection.of(w.geometry else trap("grid"), "12", 0)
    component_moves.move_selection(w, Vector3(0.0, 0.75, 0.0))
    let session = editor.panels.projects
    files.ensure_directory("held-project")
    session.save_to("held-project/held.prisma")
    let edit = w.network.selected
    assert(files.exists(paths.join("held-project/held.prisma.held", f"n{edit}.prism")))
    session.load_from("held-project/held.prisma")
    let node = w.network.require(edit)
    let held = node.held else trap("no held result after loading")
    assert(node.edits.length == 0 and held.made_for == 0)
    node_commands.select_node(w, edit)
    near((w.geometry else trap("loaded")).point(12).y, 0.75)
    editor.close()

## Edit CAD holds its bodies: the project's tolerances changed, they are
## checked against the new ones (not cooked again) in the same undo step.
func cad_tolerances() -> unit!:
    let w = Workspace()
    node_commands.delete_selected(w)
    node_commands.add_node(w, "CAD", 0.0, 0.0)
    node_commands.enter_group(w, w.network.selected)
    node_commands.add_node(w, "Edit CAD", 0.0, 0.0)
    modeling_commands.create(w, "Box")
    let node = w.network.require(w.network.selected)
    let before = node.held else trap("held")
    let faces = CadGeometry.model(before.result.geometry, 0).face_count()
    let values = project_settings.current(w)
    project_settings.apply_values(w, ProjectValues(units = values.units, tolerances = CadTolerances(positional = 0.0001, fit = 0.00001, tangent = 0.001, curvature = 0.005), quality = values.quality, fps = values.fps, start = values.start, end = values.end))
    let after = w.network.require(node.id).held else trap("rechecked")
    assert(after.key != before.key and CadGeometry.model(after.result.geometry, 0).face_count() == faces and w.network.require(node.id).held_note == "")
    w.undo()
    assert((w.network.require(node.id).held else trap("undone")).key == before.key)
