## Headless worker integration: real isolated Luce heap, progress and stale jobs.
from workspace import Workspace
from compute_request import RequestWriter, read_request
from network import Network
from luce_3d.graphics import Vector3, WireBatch
import time
import modeling_commands
import node_commands
import selection_commands
from result_store import ResultStore
from geometry_data import GeometryData
from live_objects import live_objects

func settle(workspace: Workspace) -> unit!:
    let session = workspace.compute else trap("compute")
    let deadline = time.now() + 20000000000
    while session.busy and time.now() < deadline:
        _ = workspace.poll_compute()
    assert(not session.busy)

pub func compute_tests() -> unit!:
    let workspace = Workspace()
    node_commands.rename(workspace, "Cube %\n雪")
    let copied = read_request(RequestWriter().encode(workspace.network, 3), Network(false))
    assert(copied.require(1).name == workspace.network.require(1).name)
    workspace.enable_compute()
    settle(workspace)
    assert(workspace.notice == "")
    assert((workspace.geometry else trap("worker mesh")).face_count() == 6)
    node_commands.set_parameter(workspace, 1, 3.0)
    node_commands.set_parameter(workspace, 1, 4.0)
    node_commands.set_parameter(workspace, 1, 5.0)
    settle(workspace)
    assert((workspace.geometry else trap("latest mesh")).bounds().maximum.y == 5.0)
    let prepared = workspace.geometry else trap("prepared worker mesh")
    assert(prepared.ray_distance(Vector3(0.0,6.0,0.0),Vector3(0.0,-1.0,0.0)) == 1.0)
    assert(prepared.surface_distance(Vector3(0.0,6.0,0.0)) == 1.0)
    let generation = (workspace.compute else trap("compute")).generation
    for mode in [4, 0, 1, 2, 3]:
        workspace.set_display_mode(mode)
        assert(not (workspace.compute else trap("compute")).busy)
        assert((workspace.compute else trap("compute")).generation == generation)
        assert((workspace.geometry else trap("cached geometry")).bounds().maximum.y == 5.0)
    workspace.undo()
    settle(workspace)
    assert((workspace.geometry else trap("undo mesh")).bounds().maximum.y == 4.0)
    # A verb with nothing to do warns across the worker and passes its input.
    node_commands.add_node(workspace, "Fill", 0.0, 120.0)
    settle(workspace)
    let fill = workspace.selected() else trap("fill node")
    assert(fill.warning != "" and fill.failure == "" and (workspace.geometry else trap("fill mesh")).face_count() == 6)
    workspace.undo()
    settle(workspace)
    # Select → tool → node on the worker: the output selection arrives with
    # the result.
    selection_commands.set_mode(workspace, 3)
    selection_commands.choose_component(workspace, 2, false)
    modeling_commands.model(workspace, "Extrude")
    settle(workspace)
    assert((workspace.geometry else trap("extruded")).face_count() == 10 and workspace.selected_ids() == [2])
    workspace.undo()
    settle(workspace)
    # Normal guides are made only while shown.
    assert(segments(workspace.batches.normal_batches) == 0)
    workspace.toggle_normals()
    settle(workspace)
    assert(segments(workspace.batches.normal_batches) == 6)
    workspace.toggle_normals()
    node_commands.add_node(workspace, "File", 0.0, 0.0)
    node_commands.set_text(workspace, 0, "tests/fixtures/assembly.step")
    settle(workspace)
    assert(workspace.notice == "")
    assert(segments(workspace.batches.wire_batches) > 0)
    assert(segments(workspace.batches.patch_batches) > 0)
    assert((workspace.selected() else trap("File")).group_paths == ["Camera test/Lens:1/solid_37"])
    node_commands.add_node(workspace, "Tessellate", 0.0, 100.0)
    settle(workspace)
    assert(workspace.notice == "")
    assert((workspace.geometry else trap("tessellated worker mesh")).face_count() > 0)
    assert((workspace.selected() else trap("Tessellate")).group_paths == ["Camera test/Lens:1/solid_37"])
    node_commands.add_node(workspace, "Blast", 0.0, 200.0)
    node_commands.set_text(workspace, 0, "*/solid_37")
    node_commands.set_parameter(workspace, 0, 1.0)
    settle(workspace)
    assert((workspace.selected() else trap("Blast")).group_paths == ["Camera test/Lens:1/solid_37"])
    node_commands.set_parameter(workspace, 0, 0.0)
    settle(workspace)
    assert((workspace.selected() else trap("Blast")).group_paths.length == 0)
    workspace.undo()
    settle(workspace)
    assert((workspace.selected() else trap("Blast")).group_paths.length == 1)
    # A STEP square whose corner leaves its plane by 0.1 mm, beside a good
    # one, is not dropped silently: the node showing it says the file is
    # looser than the project's tolerance (luce-cad's own tests name a face
    # no mesher follows).
    node_commands.add_node(workspace, "File", 0.0, 300.0)
    node_commands.set_text(workspace, 0, "tests/fixtures/step_skip.step")
    settle(workspace)
    let shown = workspace.selected() else trap("File")
    assert(shown.failure == "" and shown.warning.contains("looser than the project's"), shown.warning)
    (workspace.compute else trap("compute")).close()
    print("PASS background DAG computation, copied snapshots, latest-wins requests, undo and CAD preview/tessellation; a STEP file looser than the project's tolerance named on the node")

## The worker's result store keeps one current result per node
## (result_store.luc): a new stamp's cook overwrites the node's slot, a
## shown node's last good result and a recipe Edit node's current
## checkpoints are kept apart, and slots of nodes gone are let go. A
## 6,000-move drag of a Transform at the end of a 60-node chain adds no
## result (the store holds as many, taking as many bytes, after it as
## before), never cooks the nodes above it again, keeps as many objects
## alive on this thread after it as early in it, moves as fast at its end as
## a fresh chain's drag does, and undoes in one step.
pub func result_store_bound() -> unit!:
    let store = ResultStore()
    for stamp in 1..<301:
        _ = store.put(7, stamp, GeometryData())
    assert(store.count() == 1 and store.peek(7, 300) != none and store.peek(7, 299) == none)
    store.remember_good(7)
    _ = store.fail(7, 301, "failed")
    assert(store.count() == 2 and store.good(7) != none)
    store.put_checkpoint(8, 11, GeometryData())
    store.put_checkpoint(8, 12, GeometryData())
    let wanted: map[int, set[int]] = {}
    wanted[8] = {12}
    store.prune({7, 8}, wanted)
    assert(store.count() == 3 and store.checkpoint(8, 11) == none and store.checkpoint(8, 12) != none)
    store.prune({8}, wanted)
    assert(store.count() == 1 and store.peek(7, 301) == none)

    let (w, chain) = transform_chain()
    let shifted = (w.geometry else trap("chain")).bounds().maximum.x
    let last = w.network.require(chain[59])
    assert(shifted > 1.59 and shifted < 1.61, f"{shifted} {w.notice}")
    let session = w.compute else trap("compute")
    let results = session.results
    let held_bytes = session.result_bytes
    assert(results >= 61, f"{results} results")
    let cooks = w.network.require(chain[0]).evaluations
    let above = w.network.require(chain[58]).evaluations
    let values = last.values.copy()
    w.begin("Move gizmo")
    var early_live = 0
    for move in 0..<6000:
        _ = drag_move(w, values, move)
        if move == 499: early_live = live_objects()
        assert(session.results == results, f"move {move}: {session.results} results, {results} before")
    # Nothing a move makes outlives it (a move that kept something would
    # leave thousands more here).
    let late_live = live_objects()
    assert(late_live <= early_live + 64, f"{early_live} objects alive at move 500, {late_live} at 6,000")
    # The drag's moves now against a fresh chain's first ones, one each in
    # turn, so a load that comes and goes (another test program, another
    # session) falls on both alike: a creep shows as the long drag's moves
    # costing more (it was 3.8 times over 6,000 moves; windows timed apart
    # swung 2.4 times on a loaded machine with no creep at all).
    let (fresh, _) = transform_chain()
    let fresh_values = (fresh.selected() else trap("fresh")).values.copy()
    fresh.begin("Move gizmo")
    let late_moves: list[float] = []
    let fresh_moves: list[float] = []
    for move in 0..<500:
        late_moves.append(drag_move(w, values, 6000 + move))
        fresh_moves.append(drag_move(fresh, fresh_values, move))
    fresh.commit()
    settle(fresh)
    (fresh.compute else trap("fresh compute")).close()
    w.commit()
    settle(w)
    near_x(w, shifted + 0.65)
    assert(session.results == results and session.result_bytes == held_bytes, f"{session.results} results of {session.result_bytes} bytes after, {results} of {held_bytes} before")
    assert(w.network.require(chain[0]).evaluations == cooks and w.network.require(chain[58]).evaluations == above)
    # Medians, so spikes do not decide.
    late_moves.sort()
    fresh_moves.sort()
    let later = late_moves[250]
    let first = fresh_moves[250]
    print(f"PASS A 6,500-move drag through the worker: {results} results held before and after, {early_live} objects alive at move 500 and {late_live} at 6,000, moves past 6,000 {later:.3f} ms (median) against a fresh chain's {first:.3f} ms, in turn")
    assert(later < first * 1.5, f"{later} ms a move after 6,000 moves, {first} ms in a fresh chain")
    w.undo()
    settle(w)
    near_x(w, shifted)
    session.close()

func near_x(w: Workspace, expected: float) -> unit!:
    let shown = w.meshes_of(w.network.display)
    assert(shown.length == 1, f"{shown.length} meshes shown, {w.notice}, history {w.history.cursor}")
    let x = shown[0].bounds().maximum.x
    assert(x > expected - 0.0001 and x < expected + 0.0001, f"{x} {expected}")

## A Box and 60 Transforms after it, each moving it 0.01 along x, cooked
## by the worker; the last one selected. The Transforms' ids, in order.
func transform_chain() -> (Workspace, list[int])!:
    let w = Workspace()
    w.enable_compute()
    settle(w)
    var chain: list[int] = []
    for at in 0..<60:
        node_commands.add_node(w, "Transform", 0.0, 100.0 + float(at) * 40.0)
        let node = w.selected() else trap("transform")
        node.values[1] = 0.01
        w.network.invalidate(node.id)
        chain.append(node.id)
    w.rebuild()
    settle(w)
    return (w, chain)

## Milliseconds of move `move` of a drag of the selected Transform's
## Translate x (`values` its parameters before the drag), to its result.
func drag_move(w: Workspace, values: list[float], move: int) -> float!:
    let started = time.now()
    let moved = values.copy()
    moved[1] = 0.01 + 0.0001 * float(move + 1)
    w.preview_parameters(moved)
    settle(w)
    return float(time.now() - started) / 1000000.0

## Segments of every batch in `batches` (one a product).
func segments(batches: list[WireBatch]) -> int:
    var total = 0
    for batch in batches:
        total += batch.count()
    return total
