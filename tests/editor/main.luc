pub func main(arguments: list[str]) -> int!:
    # run from this program's own directory, wherever luc test starts it
    if let here = process.variable("LUC_TEST_DIR"):
        process.change_directory(here)
    # The tests name their fixtures tests/fixtures/... and write beside them, so they run
    # in a scratch directory holding a copy of tests/fixtures and the generated grid.
    let fixtures = paths.join(paths.directory(process.current_directory()), "fixtures")
    with files.TemporaryDirectory() as directory:
        let copied = paths.join(directory.path(), "tests/fixtures")
        files.ensure_directory(copied)
        for name in files.list(fixtures):
            files.copy(paths.join(fixtures, name), paths.join(copied, name))
        files.write_text(paths.join(copied, "grid500k.obj"), grid(710))
        process.change_directory(directory.path())
        run_all()
    return 0

## A planar grid of n x n quads (~500k faces at 710), for the worker request-size and Edit
## replay checks.
func grid(n: int) -> str:
    var lines: list[str] = []
    for z in 0..<n + 1:
        for x in 0..<n + 1:
            lines.append(f"v {x} 0 {z}\n")
    for z in 0..<n:
        for x in 0..<n:
            lines.append(f"f {z * (n + 1) + x + 1} {(z + 1) * (n + 1) + x + 1} {(z + 1) * (n + 1) + x + 2} {z * (n + 1) + x + 2}\n")
    return lines.join("")

