## Networks for operator tests: nodes wire into chains only on a data level,
## so these build inside a Geo (the root is an object level, where nothing
## is wired: docs/NETWORK-LEVELS.md).
from network import Network

## An empty network whose view is inside a new Geo (node 1).
pub func data_network() -> Network!:
    let graph = Network(false)
    let geo = graph.add("Geo", 0.0, 0.0)
    graph.scope = geo.id
    return graph
