## The Sketch node and its viewport editor, driven by pointer events as a
## user would: a rectangle drawn on the ground plane (its sides level and
## upright), its bottom dimensioned with Sketch Dimension and the dimension
## changed as the parameter panel does, the sketch extruded to the body it
## bounds; undo takes the change back; a line drawn by the bottom's end
## shares that end; constraint tools refuse what over-constrains.
from app import Luce3D
from luce_ui.ui import Event
from luce_window.input import EventKind, Key
from luce_cad.sketch import CadSketch
from luce_cad.cad_geometry import CadGeometry
from luce_3d.graphics import Vector3
from viewport_tools import projected
import node_commands
import modeling_commands
import sketch_commands
from luce_std import math
from luce_gpu.gpu import Frame
from luce_window import window

## Click the viewport at sketch point (`x`, `y`) of the editor's plane.
func click(editor: Luce3D, x: float, y: float) -> unit!:
    let view = editor.panels.view
    let bounds = view.layout().bounds()
    let f = view.sketch.editor.frame
    let s = projected(editor.workspace, f.at(x, y), bounds.width, bounds.height)
    for kind in [EventKind.pointer_moved, EventKind.pointer_down, EventKind.pointer_up]:
        editor.app.dispatch(Event(kind = kind, x = bounds.x + s[0], y = bounds.y + s[1], button = 0))

func near(a: float, b: float) -> bool:
    return math.abs(a - b) <= 1e-6 * math.max(1.0, math.abs(b))

pub func sketch_node_tests() -> unit!:
    let editor = Luce3D()
    editor.app.layout(1600.0, 1000.0)
    let w = editor.workspace
    node_commands.delete_selected(w)
    node_commands.add_node(w, "CAD", 0.0, 0.0)
    node_commands.enter_group(w, w.network.selected)
    node_commands.add_node(w, "Sketch", 0.0, 0.0)
    let id = w.network.selected
    node_commands.display_selected(w)
    # Look straight down on the ground plane, 40 mm across.
    w.view.yaw = 0.0
    w.view.pitch = 1.5
    w.view.distance = 120.0
    w.view.target = Vector3(20.0, 0.0, -10.0)
    w.view.update_camera()
    editor.app.layout(1600.0, 1000.0)
    let sketch_editor = editor.panels.view.sketch.editor
    assert(w.sketching() and sketch_editor.active())
    # A rectangle from (0, 0) to (40, 20).
    sketch_editor.choose("Rectangle")
    click(editor, 0.0, 0.0)
    click(editor, 40.0, 20.0)
    var s = CadSketch.parse(w.network.require(id).texts[0])
    assert(s.entity_count() == 8 and s.constraint_count() == 4)
    # Its bottom dimensioned: the bottom line, then a click where the
    # value goes.
    sketch_editor.choose("Sketch Dimension")
    click(editor, 20.0, 0.0)
    click(editor, 20.0, -8.0)
    let found = sketch_commands.dimensions(w.network.require(id).texts[0])
    assert(found.length == 1 and near(found[0].value, 40.0) and not found[0].angle)
    # Its value box opened where it was placed, the measured value selected:
    # typed "50 mm" and Enter, the rectangle (fixed nowhere) widens by the
    # least motion, both sides out.
    assert(editor.panels.sketch_value.is_open())
    render(editor)
    for c in [53, 48, 32, 109, 109]:
        editor.app.dispatch(Event(kind = EventKind.text_input, codepoint = c))
    editor.app.dispatch(Event(kind = EventKind.key_down, key = Key.enter))
    assert(not editor.panels.sketch_value.is_open())
    s = CadSketch.parse(w.network.require(id).texts[0])
    var left = 1000.0
    var right = -1000.0
    for at in 0..<s.entity_count():
        if s.kind(at) == 0:
            left = math.min(left, s.x(at))
            right = math.max(right, s.x(at))
    assert(near(right - left, 50.0) and near(left, -5.0))
    # Extruded 10 mm (the default): a 50 x 20 x 10 block.
    node_commands.add_node(w, "Extrude", 0.0, 120.0)
    let body = CadGeometry.model(w.network.evaluate_data(w.network.selected).geometry, 0)
    let box = body.tessellate(8).bounds()
    assert(near(box.maximum.x - box.minimum.x, 50.0) and near(box.maximum.y - box.minimum.y, 10.0) and near(box.maximum.z - box.minimum.z, 20.0))
    # Undo the extrusion and the dimension's change: 40 wide again.
    w.undo()
    w.undo()
    node_commands.select_node(w, id)
    node_commands.display_selected(w)
    assert(near(sketch_commands.dimensions(w.network.require(id).texts[0])[0].value, 40.0))
    # A line from the rectangle's corner snaps to that corner: it shares
    # the point (no new point made for its start).
    sketch_editor.sync()
    let before = CadSketch.parse(w.network.require(id).texts[0]).entity_count()
    sketch_editor.choose("Line")
    click(editor, 40.0, 0.0)
    click(editor, 60.0, -15.0)
    editor.app.dispatch(Event(kind = EventKind.key_down, key = Key.escape))
    assert(CadSketch.parse(w.network.require(id).texts[0]).entity_count() == before + 2)
    # Horizontal/Vertical on the slanted line makes it level (more level
    # than upright); then Perpendicular between it and the level bottom
    # cannot hold: refused, with Fusion's notice.
    let line = CadSketch.parse(w.network.require(id).texts[0]).entity_count() - 1
    sketch_editor.choose("Horizontal/Vertical")
    let middle = middle_of(w.network.require(id).texts[0], line)
    click(editor, middle[0], middle[1])
    let held = CadSketch.parse(w.network.require(id).texts[0]).constraint_count()
    sketch_editor.choose("Perpendicular")
    let moved = middle_of(w.network.require(id).texts[0], line)
    click(editor, moved[0], moved[1])
    click(editor, 20.0, 0.0)
    assert(CadSketch.parse(w.network.require(id).texts[0]).constraint_count() == held)
    assert(w.notice.contains("over constrained"))
    # Saved and opened again: the sketch comes back as it was.
    let kept = w.network.require(id).texts[0]
    editor.panels.projects.save_to("sketch.prisma")
    editor.panels.projects.load_from("sketch.prisma")
    assert(w.network.require(id).texts[0] == kept)
    profile_picking(editor)
    editor.close()
    print("PASS Sketch node: a rectangle drawn on the ground, dimensioned and changed, extruded, undone; a line snapping to a corner; an over-constraining constraint refused; saved and opened; Pick profiles takes a click's region, again leaves it")

## Line `line`'s middle in the sketch `text` describes.
func middle_of(text: str, line: int) -> list[float]!:
    let s = CadSketch.parse(text)
    let a = s.part(line, 0)
    let b = s.part(line, 1)
    return [(s.x(a) + s.x(b)) * 0.5, (s.y(a) + s.y(b)) * 0.5]

## A frame drawn, as the app draws one (the panels refreshed first): a field
## asked to take focus has it after this.
func render(editor: Luce3D) -> unit!:
    editor.panels.refresh()
    let frame = Frame(window.Size(1600.0, 1000.0, 1600.0, 1000.0, 1.0))
    editor.app.layout(1600.0, 1000.0)
    editor.app.render(frame.target())
    frame.close()

## Pick profiles: a 40 x 20 rectangle split by a line at x 15, extruded;
## a click in the left part takes it alone (15 x 20), a second click there
## leaves it out again (back to the whole), Enter finishes.
func profile_picking(editor: Luce3D) -> unit!:
    let w = editor.workspace
    let s = CadSketch.parse(sketch_commands.rectangle_text(20.0, -10.0, 40.0, 20.0))
    _ = s.add_line(s.add_point(15.0, 0.0), s.add_point(15.0, -20.0))
    node_commands.add_node(w, "Sketch", 300.0, 0.0)
    let sketch = w.network.selected
    node_commands.set_text(w, 0, s.text())
    node_commands.add_node(w, "Extrude", 300.0, 120.0)
    let extrude = w.network.selected
    node_commands.display_selected(w)
    editor.app.layout(1600.0, 1000.0)
    modeling_commands.pick_profiles(w, extrude)
    assert(editor.panels.view.profiles.active())
    # The ground plane seen from above (XZ: sketch y runs along -Z).
    let view = editor.panels.view
    let bounds = view.layout().bounds()
    let at = projected(w, Vector3(5.0, 0.0, 10.0), bounds.width, bounds.height)
    for kind in [EventKind.pointer_moved, EventKind.pointer_down, EventKind.pointer_up]:
        editor.app.dispatch(Event(kind = kind, x = bounds.x + at[0], y = bounds.y + at[1], button = 0))
    assert(w.network.require(extrude).texts[0].split(";").length == 1 and w.network.require(extrude).texts[0] != "")
    let left = CadGeometry.model(w.network.evaluate_data(extrude).geometry, 0).tessellate(8).bounds()
    assert(near(left.maximum.x - left.minimum.x, 15.0))
    for kind in [EventKind.pointer_down, EventKind.pointer_up]:
        editor.app.dispatch(Event(kind = kind, x = bounds.x + at[0], y = bounds.y + at[1], button = 0))
    assert(w.network.require(extrude).texts[0] == "")
    editor.app.dispatch(Event(kind = EventKind.key_down, key = Key.enter))
    assert(w.prompt == none and w.network.require(sketch).kind == "Sketch")
