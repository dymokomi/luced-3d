## Format-scoped import settings survive projects, history and worker caches.
from luce_std import files
import node_catalog
import project_file
from app import Luce3D
from network import Network
from workspace import Workspace
from luce_prism.prism import Document
from project_graph import write_graph, read_graph
from compute_request import RequestWriter, read_request
from stamps import stamp_graph
import time
import node_commands
from luce_cad.model import CadTolerances

pub func file_options_tests() -> unit!:
    for path in ["shape.step", "shape.STP", " shape.STEP "]:
        let fields = node_catalog.parameters("File", path)
        assert(fields.length == 1 and fields[0].slot == 0 and fields[0].kind == "menu" and fields[0].initial == 0.0)
    for path in ["", "shape.obj"]:
        assert(node_catalog.parameters("File", path).length == 0)
    # A file whose vertex lies 0.00005 mm off its edge's end, declaring an
    # uncertainty of 0.0001 mm: one point at the project's 0.01 mm, no
    # notice; looser than a 0.00001 mm project, where the node says so until
    # Keep or Adopt is chosen.
    let declared = "#9999=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.0001),#1,'distance_accuracy_value','');\nENDSEC;\nEND-ISO"
    let text = files.read_text("tests/fixtures/cylinder.step").replace("(2.,0.,0.)", "(2.00005,0.,0.)").replace("ENDSEC;\nEND-ISO", declared)
    files.write_text("tolerant-import.step", text)
    let editor = Luce3D()
    let w = editor.workspace
    node_commands.add_node(w, "File", 0.0, 0.0)
    node_commands.set_text(w, 0, "tolerant-import.step")
    let node = w.selected() else trap("File")
    assert(node.failure == "" and node.cache != none and node.warning == "")
    w.network.tolerances = CadTolerances(positional = 0.00001, fit = 0.000001)
    w.network.invalidate(node.id)
    _ = w.network.evaluate_data(node.id)
    assert(node.failure == "" and node.warning.contains("choose Keep the file's or Adopt the scene's"))
    node_commands.set_parameter(w, 0, 1.0)
    assert(node.failure == "" and node.warning == "")
    # The option is part of the File node's stamp and of its worker body.
    let writer = RequestWriter()
    stamp_graph(w.network)
    let kept = node.stamp
    let worker = read_request(writer.encode(w.network, 3), Network(false))
    assert(worker.require(node.id).values[0] == 1.0 and worker.require(node.id).stamp == kept)
    node_commands.set_parameter(w, 0, 2.0)
    stamp_graph(w.network)
    assert(node.stamp != kept)
    let changed = read_request(writer.encode(w.network, 3), worker)
    assert(changed.require(node.id).values[0] == 2.0)
    w.undo()
    assert((w.selected() else trap("File")).values[0] == 1.0)
    w.redo()
    assert((w.selected() else trap("File")).values[0] == 2.0)
    let doc = Document()
    write_graph(doc, w.network)
    let restored = read_graph(doc)
    assert(restored.require(node.id).values[0] == 2.0)
    assert(project_file.same_graph(w.network, restored))
    # Reusing a File node for a different format hides the STEP-only setting.
    node_commands.set_text(w, 0, "tests/fixtures/cylinder.obj")
    editor.panels.inspector.refresh()
    assert(node_catalog.parameters("File", (w.selected() else trap("File")).texts[0]).length == 0)
    node_commands.set_text(w, 0, "tolerant-import.step")
    editor.panels.inspector.refresh()
    assert(editor.panels.inspector.shown_value(0) == 2.0)
    # Exercise the actual off-main worker, not just its serialized recipe.
    w.enable_compute()
    settle(w)
    assert(w.notice == "" and w.batches.patch_batches.length > 0)
    node_commands.set_parameter(w, 0, 1.0)
    settle(w)
    assert(w.notice == "" and (w.selected() else trap("File")).failure == "")
    assert(w.batches.patch_batches.length > 0)
    editor.close()
    print("PASS STEP import tolerances: one point within the project's P, Ask's notice beyond it, Keep and Adopt, projects, undo and worker invalidation")

func settle(workspace: Workspace) -> unit!:
    let session = workspace.compute else trap("compute")
    let deadline = time.now() + 20000000000
    while session.busy and time.now() < deadline:
        _ = workspace.poll_compute()
    assert(not session.busy)
