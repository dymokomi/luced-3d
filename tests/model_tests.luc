from network import Network
from edit_operations import EditOperation
from workspace import Workspace
from three import Vector3
from geometry_tests import near

pub func model_tests() -> unit!:
    let empty = Network()
    empty.require(1).enabled = false
    empty.invalidate(1)
    assert(empty.evaluate(1).point_count() == 0)
    let graph = Network()
    let left = graph.add("Transform", 300.0, 30.0)
    let right = graph.add("Transform", 300.0, 180.0)
    let merge = graph.add("Merge", 600.0, 80.0)
    graph.connect(1, left.id, 0)
    graph.connect(1, right.id, 0)
    graph.connect(left.id, merge.id, 0)
    graph.connect(right.id, merge.id, 1)
    right.values[1] = 4.0
    let result = graph.evaluate(merge.id)
    assert(result.point_count() == 16)
    near(result.bounds().maximum.x, 5.0)
    assert(graph.require(1).evaluations == 1)
    left.values[2] = 3.0
    graph.invalidate(left.id)
    discard(graph.evaluate(merge.id))
    assert(left.evaluations == 2 and right.evaluations == 1 and merge.evaluations == 2)
    var rejected = false
    graph.connect(merge.id, left.id, 0) catch failure:
        rejected = true
    assert(rejected and left.inputs[0] == 1)
    rejected = false
    graph.connect(left.id, left.id, 0) catch failure:
        rejected = true
    assert(rejected)
    let edit = graph.add("Edit", 500.0, 50.0)
    graph.connect(left.id, edit.id, 0)
    let input = graph.evaluate(left.id)
    edit.edits.append(EditOperation("Extrude", [2], input, Vector3(), 1.0))
    assert(graph.evaluate(edit.id).face_count() == 10)
    edit.enabled = false
    graph.invalidate(edit.id)
    assert(graph.evaluate(edit.id).face_count() == 6)
    edit.enabled = true
    graph.connect(merge.id, edit.id, 0)
    rejected = false
    discard(graph.evaluate(edit.id)) catch failure:
        rejected = true
    assert(rejected and edit.failure != "")
    graph.remove(right.id)
    assert(merge.inputs[1] == -1)
    rejected = false
    discard(graph.evaluate(merge.id)) catch failure:
        rejected = true
    assert(rejected)

    let w = Workspace()
    w.add_node("Transform", 300.0, 20.0)
    let transform_id = w.network.selected
    w.begin("Scrub translate")
    w.set_parameter(1, 1.0)
    w.set_parameter(1, 2.0)
    w.set_parameter(1, 3.0)
    w.commit()
    assert(w.history.changes.length == 2)
    w.undo()
    near(w.network.require(transform_id).values[1], 0.0)
    w.redo()
    near(w.network.require(transform_id).values[1], 3.0)
    w.add_node("Edit", 550.0, 20.0)
    let edit_id = w.network.selected
    assert(w.editing())
    w.choose_component(2, false)
    w.extrude()
    assert((w.geometry else trap("mesh")).face_count() == 10)
    assert(w.network.require(edit_id).edits.length == 1)
    w.set_last_extrusion(1.25)
    near((w.geometry else trap("mesh")).bounds().maximum.y, 3.25)
    w.undo()
    near((w.geometry else trap("mesh")).bounds().maximum.y, 2.5)
    w.undo()
    assert((w.geometry else trap("mesh")).face_count() == 6 and w.components == [2])
    w.redo()
    assert((w.geometry else trap("mesh")).face_count() == 10)
    w.begin("Move gizmo")
    w.preview_move(Vector3(0.0, 0.2, 0.0))
    w.preview_move(Vector3(0.0, 0.7, 0.0))
    w.commit()
    assert(w.network.require(edit_id).edits.length == 2)
    near((w.geometry else trap("mesh")).bounds().maximum.y, 3.2)
    w.undo()
    near((w.geometry else trap("mesh")).bounds().maximum.y, 2.5)
    w.begin("Cancelled gizmo")
    w.preview_move(Vector3(0.0, 3.0, 0.0))
    w.cancel()
    near((w.geometry else trap("mesh")).bounds().maximum.y, 2.5)
    w.toggle_enabled()
    assert((w.geometry else trap("mesh")).face_count() == 6)
    w.undo()
    assert((w.geometry else trap("mesh")).face_count() == 10)
    w.select_node(1)
    assert(w.network.display == edit_id and not w.editing())
    w.display_selected()
    assert(w.network.display == 1)
    w.undo()
    assert(w.network.display == edit_id)
    let before = w.history.changes.length
    w.connect(edit_id, transform_id, 0)
    assert(w.notice != "" and w.history.changes.length == before)
    # Undo followed by a fresh command clears the redo branch.
    w.undo()
    w.rename("Renamed cube")
    assert(not w.history.can_redo())
    print("PASS branching DAG, cycles, cache invalidation, bypass, topology guards and undo transactions")
