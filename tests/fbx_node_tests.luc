## FBX in the graph: the File node's FBX rows and options.
from network import Network
from stamps import stamp_graph
import node_catalog

pub func fbx_node_tests() -> unit!:
    # An FBX path brings the FBX rows: import mode, instancing, units,
    # normals, frame and deform.
    let fields = node_catalog.parameters("File", "scene.FBX")
    assert(fields.length == 7 and fields[0].slot == 1)
    assert(node_catalog.file_format("a.fbx") == "fbx")
    let graph = Network(false)
    let file = graph.add("File", 0.0, 0.0)
    file.texts[0] = "tests/fixtures/instancing.fbx"
    for parameter in node_catalog.parameters("File", file.texts[0]):
        file.values[parameter.slot] = parameter.initial
    stamp_graph(graph)
    # Eight Suzannes sharing one mesh: instances by default.
    assert(graph.evaluate_data(file.id).geometry.instance_count() == 8)
    # Without instancing, one merged mesh.
    file.values[2] = 0.0
    graph.invalidate(file.id)
    stamp_graph(graph)
    assert(graph.evaluate(file.id).face_count() == 4000)
    # Keep hierarchy: every model an instance again, each its own prototype.
    file.values[1] = 1.0
    graph.invalidate(file.id)
    stamp_graph(graph)
    assert(graph.evaluate_data(file.id).geometry.instance_count() == 8)
    # A skinned, animated mesh moves with the frame.
    let skinned = graph.add("File", 200.0, 0.0)
    skinned.texts[0] = "tests/fixtures/skinned.fbx"
    for parameter in node_catalog.parameters("File", skinned.texts[0]):
        skinned.values[parameter.slot] = parameter.initial
    stamp_graph(graph)
    let rest = graph.evaluate_data(skinned.id).mesh else trap("mesh")
    skinned.values[5] = 1.0
    skinned.values[6] = 29.0
    graph.invalidate(skinned.id)
    stamp_graph(graph)
    let posed = graph.evaluate_data(skinned.id).mesh else trap("mesh")
    assert(rest.point_count() == posed.point_count() and rest.point(0).x != posed.point(0).x)
    # The Export node writes .fbx: the shared Suzannes come back as eight
    # instances of one mesh.
    file.values[1] = 0.0
    file.values[2] = 1.0
    graph.invalidate(file.id)
    let written = graph.add("Export", 0.0, 60.0)
    written.texts[0] = "exported.fbx"
    graph.connect(file.id, written.id, 0)
    stamp_graph(graph)
    assert(graph.evaluate_data(written.id).geometry.instance_count() == 8)
    let reread = graph.add("File", 0.0, 120.0)
    reread.texts[0] = "exported.fbx"
    for parameter in node_catalog.parameters("File", reread.texts[0]):
        reread.values[parameter.slot] = parameter.initial
    stamp_graph(graph)
    let rows = graph.evaluate_data(reread.id).geometry
    assert(rows.instance_count() == 8)
    # Each instance keeps its model's path through the export.
    let first = graph.evaluate_data(file.id).geometry
    for index in 0..<8: assert(rows.instance_path(index) != "" and rows.instance_path(index) == first.instance_path(index))
    print("PASS FBX File node: rows, instancing, merge and Keep hierarchy, frames and skins; Export writes .fbx")
