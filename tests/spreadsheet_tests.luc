from app import Luce3D
from ui import Event
from input import EventKind, ScrollUnit
from gpu import Frame
import window
from geometry_tests import near

pub func spreadsheet_tests() -> unit!:
    let editor = Luce3D()
    let w = editor.workspace
    let sheet = editor.panels.spreadsheet
    w.add_node("AttributeCreate", 200.0, 100.0)
    w.set_text(1, "temperature")
    w.set_parameter(3, 42.0)
    editor.panels.refresh()
    assert(sheet.row_count() == 8 and sheet.columns.length == 4)
    near(sheet.value(0, 3), 42.0)
    sheet.pinned = w.network.selected
    w.select_node(1)
    sheet.refresh()
    assert(sheet.columns.length == 4)
    sheet.pinned = -1
    sheet.refresh()
    assert(sheet.columns.length == 3)
    w.add_node("UVProject", 200.0, 200.0)
    sheet.set_domain(1)
    assert(sheet.row_count() == 24 and sheet.columns.length == 4)
    sheet.filter_attributes("uv")
    assert(sheet.columns.length == 2)
    sheet.filter_rows("2-5")
    assert(sheet.row_ids() == [2, 3, 4, 5])
    sheet.event(Event(kind = EventKind.pointer_down, x = 80.0, y = 70.0, button = 0, inside = true))
    var last = -1.0e20
    for row in sheet.row_ids():
        let value = sheet.value(row, 0)
        assert(value >= last)
        last = value
    sheet.filter_attributes("")
    sheet.filter_rows("")
    sheet.set_domain(2)
    assert(sheet.row_count() == 6)
    sheet.set_domain(3)
    near(sheet.value(0, 0), 8.0)
    near(sheet.value(0, 1), 24.0)
    w.add_node("Edit Mesh", 200.0, 300.0)
    sheet.set_domain(0)
    sheet.event(Event(kind = EventKind.pointer_down, x = 25.0, y = 116.0, button = 0, inside = true))
    assert(w.component_mode == 3 and w.selected_ids() == [1])
    sheet.selected_only = true
    sheet.refresh()
    assert(sheet.row_ids() == [1])
    sheet.selected_only = false
    # Refreshes, selection clicks and redraws reuse rows until their inputs change.
    discard(sheet.row_count())
    let builds = sheet.builds
    editor.panels.refresh()
    w.choose_component(2, true)
    editor.panels.refresh()
    assert(sheet.row_count() == 8 and sheet.builds == builds)
    sheet.set_domain(2)
    assert(sheet.row_count() == 6 and sheet.builds == builds + 1)
    sheet.set_domain(0)
    let panel = editor.panels.dock.find("geometry_spreadsheet") else trap("Spreadsheet panel")
    editor.panels.dock.select(panel)
    editor.app.layout(1400.0, 900.0)
    sheet.refresh()
    let bounds = sheet.layout().bounds()
    assert(bounds.width > 400.0 and bounds.height > 100.0)
    let frame = Frame(window.Size(1400.0, 900.0, 1400.0, 900.0, 1.0))
    editor.app.render(frame.target())
    frame.close()
    sheet.event(Event(kind = EventKind.scroll, scroll_y = -1000.0, scroll_unit = ScrollUnit.lines))
    sheet.filter_rows("99999")
    assert(sheet.row_count() == 0)
    sheet.filter_rows("")
    sheet.pinned = w.network.selected
    w.delete_selected()
    sheet.refresh()
    assert(sheet.mesh == none and sheet.row_count() == 0)
    editor.close()
    print("PASS spreadsheet domains, attributes, pinning, filtering, numeric sorting, component selection and rendering")
