from three import PolygonMesh, Vector3
import math

pub func near(a: float, b: float):
    assert(math.abs(a - b) < 0.000001)

pub func manifold(mesh: PolygonMesh) -> unit!:
    let counts: list[int] = []
    let directions: list[int] = []
    for edge in 0..<mesh.edge_count():
        counts.append(0)
        directions.append(0)
    for face in 0..<mesh.face_count():
        for at in 0..<mesh.face_size(face):
            let edge = mesh.face_edge(face,at)
            let a = mesh.edge_point(edge,0)
            let b = mesh.edge_point(edge,1)
            let p = mesh.face_point(face,at)
            let q = mesh.face_point(face,(at+1)%mesh.face_size(face))
            assert((p == a and q == b) or (p == b and q == a))
            counts[edge] += 1
            directions[edge] += 1 if p == a else -1
    for edge in 0..<mesh.edge_count(): assert(counts[edge] == 2 and directions[edge] == 0)
    for triangle in 0..<mesh.index_count() // 3:
        let a = mesh.vertex(mesh.index(triangle * 3))
        let b = mesh.vertex(mesh.index(triangle * 3 + 1))
        let c = mesh.vertex(mesh.index(triangle * 3 + 2))
        assert(b.position.subtract(a.position).cross(c.position.subtract(a.position)).dot(a.normal) > 0.0)

pub func geometry_tests() -> unit!:
    let cube = PolygonMesh.cube()
    assert(cube.point_count() == 8 and cube.face_count() == 6 and cube.edge_count() == 12)
    assert(cube.vertex_count() == 24 and cube.index_count() == 36)
    manifold(cube)
    assert(cube.ray_face(Vector3(0.0, 5.0, 0.0), Vector3(0.0, -1.0, 0.0)) == 2)
    near(cube.ray_distance(Vector3(0.0, 5.0, 0.0), Vector3(0.0, -1.0, 0.0)), 3.0)
    assert(cube.ray_face(Vector3(8.0, 5.0, 0.0), Vector3(0.0, -1.0, 0.0)) == -1)
    let extruded = cube.extruded_faces([2], 0.5)
    assert(extruded.point_count() == 12 and extruded.face_count() == 10 and extruded.edge_count() == 20)
    near(extruded.bounds().maximum.y, 2.5)
    near(cube.bounds().maximum.y, 2.0)
    manifold(extruded)
    let again = extruded.extruded_faces([2], 0.5)
    assert(again.face_count() == 14)
    near(again.bounds().maximum.y, 3.0)
    manifold(again)
    # Adjacent faces share six boundary edges, not eight separate walls.
    let region = cube.extruded_faces([2, 4, 2], 0.5)
    assert(region.face_count() == 12 and region.point_count() == 14)
    manifold(region)
    let transformed = cube.transformed(Vector3(4.0, 0.0, 0.0), Vector3(), Vector3(-2.0, 1.0, 1.0))
    near(transformed.bounds().minimum.x, 2.0)
    near(transformed.bounds().maximum.x, 6.0)
    manifold(transformed)
    let merged = cube.merged(transformed)
    assert(merged.point_count() == 16 and merged.face_count() == 12)
    manifold(merged)
    let moved = cube.moved_points([2, 3, 6, 7], Vector3(0.0, 1.0, 0.0))
    near(moved.bounds().maximum.y, 3.0)
    near(cube.bounds().maximum.y, 2.0)
    manifold(moved)
    var rejected = false
    discard(cube.extruded_faces([100], 1.0)) catch failure:
        rejected = true
    assert(rejected)
    rejected = false
    discard(cube.extruded_faces([2], 0.0)) catch failure:
        rejected = true
    assert(rejected)
    rejected = false
    discard(cube.transformed(Vector3(), Vector3(), Vector3(0.0, 1.0, 1.0))) catch failure:
        rejected = true
    assert(rejected)
    # A concave face must not render or pick across its notch.
    let concave = PolygonMesh([Vector3(0.0, 0.0, 0.0), Vector3(2.0, 0.0, 0.0), Vector3(2.0, 2.0, 0.0), Vector3(1.0, 0.5, 0.0), Vector3(0.0, 2.0, 0.0)], [5], [0, 1, 2, 3, 4])
    assert(concave.index_count() == 9)
    assert(concave.ray_face(Vector3(1.0, 1.5, 2.0), Vector3(0.0, 0.0, -1.0)) == -1)
    near(concave.ray_distance(Vector3(0.2, 0.2, 2.0), Vector3(0.0, 0.0, -1.0)), 2.0)
    # Collinear trim corners must survive triangulation, independent of units.
    for scale in [1.0,0.00001]:
        let points = [Vector3(),Vector3(scale,0.0,0.0),Vector3(scale,scale,0.0),Vector3(scale*0.5,scale,0.0),Vector3(0.0,scale,0.0)]
        let polygon = PolygonMesh(points,[5],[0,1,2,3,4])
        assert(polygon.index_count() == 9 and polygon.edge_count() == 5)
        var area = 0.0
        for at in 0..<3:
            let a = polygon.vertex(polygon.index(at*3)).position
            let b = polygon.vertex(polygon.index(at*3+1)).position
            let c = polygon.vertex(polygon.index(at*3+2)).position
            let twice = b.subtract(a).cross(c.subtract(a)).z
            assert(twice > 0.0)
            area += twice*0.5
        near(area/(scale*scale),1.0)
    print("PASS polygon topology, region extrusion, winding, immutable transforms, merge and ray picking")
