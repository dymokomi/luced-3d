# Saving an example shows its last node: the display flag goes to it and to
# each container holding it, so the root renders it (docs/NETWORK-LEVELS.md).
from workspace import Workspace

## Give `last` and every container above it the display flag.
pub func show_chain(w: Workspace, last: int) -> unit!:
    var id = last
    while id >= 0:
        w.network.set_display(id)
        id = w.network.require(id).parent
    w.rebuild()
