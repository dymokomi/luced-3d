## Edit Mesh's PolyMirror, Spin, Crease and PolyDraw tools on a 4 by 4 grid
## over -1..1 (point z*5+x, face z*4+x): each offered on its level only,
## each a step, and each also a node in the catalog.
from workspace import Workspace
from geocore import Selection
import node_catalog

## The Edit node's last step (the node is looked up again: undo restores
## copies).
func last_verb(w: Workspace) -> str!:
    let node = w.selected() else trap("node")
    return node.edits[-1].verb

func faces(w: Workspace) -> int!:
    return (w.geometry else trap("geometry")).face_count()

## A workspace showing an Edit Mesh on the grid.
func edited_grid() -> Workspace!:
    let w = Workspace()
    w.delete_selected()
    w.add_node("Grid", 0.0, 0.0)
    w.add_node("Edit Mesh", 0.0, 100.0)
    return w

pub func edit_mesh_draw_tests() -> unit!:
    for kind in ["PolyMirror", "Spin", "Crease", "PolyDraw"]:
        assert(kind in node_catalog.kinds())
    let w = edited_grid()
    # PolyMirror is a Polygons tool: face 0 mirrored across X, welded.
    w.set_mode(2)
    assert(not w.tool_available("PolyMirror") and w.tool_available("Spin") and w.tool_available("Crease"))
    w.set_mode(1)
    w.choose_component(0, false)
    w.model("PolyMirror")
    assert(faces(w) == 17 and w.selected_count() == 1 and last_verb(w) == "PolyMirror")
    w.undo()
    # Spin, on Edges: the edge from point 0 to 1 swept a full turn in 12
    # steps.
    w.set_mode(2)
    let grid = w.geometry else trap("grid")
    w.selection = Selection.of(grid, "p0-1", 4)
    w.model("Spin")
    assert(faces(w) == 16 + 12 and last_verb(w) == "Spin")
    w.undo()
    # Crease, on Edges: the tool amount is the sharpness.
    (w.selected() else trap("node")).values[0] = 4.0
    w.selection = Selection.of(w.geometry else trap("grid"), "p0-1", 4)
    w.model("Crease")
    let creased = w.geometry else trap("creased")
    let crease = creased.find_attribute("crease", 4)
    assert(creased.attribute_value(crease, creased.find_edge(0, 1)) == 4.0 and creased.attribute_value(crease, creased.find_edge(1, 2)) == 0.0)
    w.undo()
    # PolyDraw, on Vertices: a face through four selected points.
    w.set_mode(3)
    assert(w.tool_available("PolyDraw") and not w.tool_available("PolyMirror"))
    w.choose_component(0, false)
    for point in [1, 6, 5]:
        w.choose_component(point, true)
    w.model("PolyDraw")
    assert(faces(w) == 17 and last_verb(w) == "PolyDraw" and w.domain() == 2 and w.selected_count() == 1)
    print("PASS Edit Mesh draw tools: PolyMirror on Polygons, Spin and Crease on Edges, PolyDraw on Vertices, each also a node")
