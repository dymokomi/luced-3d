## Format-scoped import settings survive projects, history and worker caches.
import files
import node_catalog
import project_file
from step import Step
from app import Luce3D
from network import Network
from workspace import Workspace
from prism import Document
from project_graph import write_graph, read_graph
from compute_protocol import snapshot, Reader
import compute_protocol
import time

pub func file_options_tests() -> unit!:
    for path in ["shape.step", "shape.STP", " shape.STEP "]:
        let fields = node_catalog.parameters("File", path)
        assert(fields.length == 1 and fields[0].slot == 0)
        assert(fields[0].decimals == 9 and fields[0].initial == 0.0)
    for path in ["", "shape.obj", "shape.fbx"]:
        assert(node_catalog.parameters("File", path).length == 0)
    # Source uncertainty remains authoritative unless this import overrides it.
    let text = files.read_text("tests/fixtures/cylinder.step").replace("(2.,0.,0.)", "(2.00005,0.,0.)")
    var rejected = false
    discard(Step.decode_model(text)) catch failure: rejected = true
    assert(rejected)
    assert(Step.decode_model(text, 0.0001).face_count() == 3)
    let declared = text.replace("DATA;", "DATA;#500=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.0001),#501,'','');")
    assert(Step.decode_model(declared).face_count() == 3)
    rejected = false
    discard(Step.decode_model(declared, 0.000001)) catch failure: rejected = true
    assert(rejected) # Explicit tighter settings must not become max(file, user).
    let precise = files.read_text("tests/fixtures/cylinder.step").replace("(2.,0.,0.)", "(2.0000005,0.,0.)")
    assert(Step.decode_model(precise).face_count() == 3) # Undeclared 1e-6 fallback.
    let strict = precise.replace("DATA;", "DATA;#500=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.0000001),#501,'','');")
    rejected = false
    discard(Step.decode_model(strict)) catch failure: rejected = true
    assert(rejected) # Source uncertainty below the fallback must remain strict.
    assert(Step.decode_model(strict, 0.000001).face_count() == 3)
    for value in [-0.01, 0.0000000001, 1.01]:
        rejected = false
        discard(Step.decode_model(text, value)) catch failure: rejected = true
        assert(rejected)
    files.write_text("tolerant-import.step", text)
    let editor = Luce3D()
    let w = editor.workspace
    w.add_node("File", 0.0, 0.0)
    w.set_text(0, "tolerant-import.step")
    let node = w.selected() else trap("File")
    assert(node.failure != "")
    w.set_parameter(0, 0.0001)
    assert(node.failure == "" and node.cache != none)
    let worker = compute_protocol.read_graph(Reader(snapshot(w.network, 3)), Network(false))
    discard(worker.evaluate_data(node.id))
    let cached = compute_protocol.read_graph(Reader(snapshot(w.network, 3)), worker)
    assert(not cached.require(node.id).dirty)
    w.set_parameter(0, 0.0002)
    let changed = compute_protocol.read_graph(Reader(snapshot(w.network, 3)), cached)
    assert(changed.require(node.id).dirty)
    let evaluations = changed.require(node.id).evaluations
    discard(changed.evaluate_data(node.id))
    assert(changed.require(node.id).evaluations == evaluations+1)
    w.undo()
    assert((w.selected() else trap("File")).values[0] == 0.0001)
    w.redo()
    assert((w.selected() else trap("File")).values[0] == 0.0002)
    let doc = Document()
    write_graph(doc, w.network)
    let restored = read_graph(doc)
    assert(restored.require(node.id).values[0] == 0.0002)
    assert(project_file.same_graph(w.network, restored))
    # Reusing a File node for a different format hides the STEP-only setting.
    w.set_text(0, "tests/fixtures/cylinder.obj")
    editor.panels.inspector.refresh()
    assert(node_catalog.parameters("File", (w.selected() else trap("File")).texts[0]).length == 0)
    w.set_text(0, "tolerant-import.step")
    editor.panels.inspector.refresh()
    assert(editor.panels.inspector.fields[0].value() == 0.0002)
    # Exercise the actual off-main worker, not just its serialized recipe.
    w.enable_compute()
    settle(w)
    assert(w.notice == "" and w.patch_batch != none)
    w.set_parameter(0, 0.0)
    settle(w)
    assert((w.selected() else trap("File")).failure != "")
    w.set_parameter(0, 0.0001)
    settle(w)
    assert(w.notice == "" and (w.selected() else trap("File")).failure == "")
    assert(w.patch_batch != none)
    editor.close()
    print("PASS STEP import tolerance, format-scoped parameters, exact overrides, projects, undo and worker invalidation")

func settle(workspace: Workspace) -> unit!:
    let session = workspace.compute else trap("compute")
    let deadline = time.now() + 20000000000
    while session.busy and time.now() < deadline:
        discard(workspace.poll_compute())
    assert(not session.busy)
