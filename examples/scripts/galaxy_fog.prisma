              let oy = at[1] - (f32)j\n                    let oz = at[2] - (f32)n\n                    let weight = math32.exp(-(ox * ox + oy * oy + oz * oz) * 1.2) * glow\n                    try fog.set(i, j, n, fog.get(i, j, n) + weight)\n    # How the viewport draws the grid (its look, as the Volume Visualization\n    # node sets it): thick, softly shadowed, tinted smoke.\n    try fog.set_look(density = (f64)k.f32(\"density\", 8.0), shadow = 0.4, smoke = k.color(\"tint\", [0.75, 0.8, 1.0, 0.0]))\n    print(f\"{stars} stars in {fog.count() // 512} leaves, {fog.active_count()} voxels\")\n    try k.set_geometry(g)\n", "", "stars\t16\t1\t1\nvoxel\t17\t1\t0\ntwist\t18\t1\t0\nglow\t19\t1\t0\ndensity\t20\t1\t0\ntint\t21\t3\t0\tcolor\t", "", "", "", "", "", "", "", "", ""]
