## Set Planar (Alias's): closed curves lying in a plane filled as a planar
## sheet, inner loops its holes (build_ops.luc).
## A node keeps its picks as words (curves by name, edges by their face and
## where they were clicked); an Edit CAD step takes what is picked, in the
## order picked, and waits for more (edit_cad_build.luc).
from tool_record import Tool, ToolEntry, Pick
from edit_types import edge_level, curve_level
import pick_kinds
import build_ops
import edit_cad_build
import cad_cook

pub func entry() -> ToolEntry:
    return ToolEntry(build_ops.planar_verb, build_ops.planar_verb, "plane", "Surfaces", [cad_cook.context], [cad_cook.edit_kind], made)

func made() -> Tool:
    return entry().tool("Modify", "Surface Build", "Closed curves lying in a plane filled as a planar sheet", picks(), build_ops.rows(build_ops.planar_verb), edit_cad_build.cook,
                        numbers = build_ops.starting(build_ops.planar_verb), waits = waits)

func picks() -> list[Pick]:
    return [Pick("Curves", [curve_level, edge_level], kind = pick_kinds.words, slot = build_ops.curves_text, step = build_ops.curves_text, doc = "The curves (or edges) used.")]

func waits(values: list[float], texts: list[str], wired: bool) -> str:
    return build_ops.waits_for(build_ops.planar_verb, texts, build_ops.spined(build_ops.planar_verb, values))
