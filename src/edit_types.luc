## What an Edit node kind plugs into the Edit framework (edit_kinds.luc):
## its selection levels, its tools and primitives, the geometry each level
## picks on, and the step executor that gives its recipe's verbs meaning.
## The framework owns everything else: the recipe (undo is a shorter
## recipe), checkpoints, move coalescing, the tool amount, symmetry, soft
## selection and Keep selection, the selection and its hand-off, Tool →
## Select, the inspector rows, the level switcher and the tool strip.
from luce_geocore.geocore import Verbs
from luce_geocore.geocore import Mesh, Domain, GroupType, Vector3
from geometry_data import GeometryData
from edit_operations import EditStep

## The viewport's selection levels, the same in every context (keys 1-5):
## Object, Point (vertices, CVs), Edge (edges, isoparms), Face, and Smart,
## which picks whichever of the kind's `smart` levels is under the pointer.
pub let object_level = 0
pub let point_level = 1
pub let edge_level = 2
pub let face_level = 3
pub let smart_level = 4

## The levels' switcher names, icons and keys.
pub func level_names() -> list[str]:
    return ["Object", "Point", "Edge", "Face", "Smart"]

## A sketch's names for them (it has no Object level).
pub func sketch_level_names() -> list[str]:
    return ["Object", "Points", "Lines", "Shapes", "Smart"]

pub func level_icons() -> list[str]:
    return ["cube", "vertex-select", "edge-select", "face-select", "magic-wand-tool"]

## A selection level: what one pick selects, on which domain of the level's
## pick geometry, and the group type its steps receive. A kind without a
## level (Edit SDF has only Object) leaves its slot `missing`.
pub class EditLevel:
    ## The switcher's label and icon ("Polygons", "face-select").
    pub let name: str
    pub let icon: str
    pub let domain: Domain
    pub let group_type: GroupType
    ## With a piece function, a pick selects the whole piece around the
    ## picked element: the group expression naming it on `domain` (Object
    ## levels); without one, the element alone.
    pub let piece: func(Mesh, int) -> str!?
    pub let available: bool

    pub func init(self, name: str, icon: str, domain: Domain, group_type: GroupType, piece: func(Mesh, int) -> str!? = none, available: bool = true):
        self.name = name
        self.icon = icon
        self.domain = domain
        self.group_type = group_type
        self.piece = piece
        self.available = available

    ## The group expression of what picking `element` of `mesh` selects: its
    ## piece, or "" for the element alone.
    pub func whole(self, mesh: Mesh, element: int) -> str!:
        let expand = self.piece else return ""
        return expand(mesh, element)

    ## The domain and group type as geocore's i64 parameters take them.
    pub func domain_number(self) -> int:
        return domain_number(self.domain)

    pub func group_number(self) -> int:
        return group_number(self.group_type)

## A level slot a kind does not have (`name` as level_names has it).
pub func missing(name: str) -> EditLevel:
    return EditLevel(name, "", Domain.face, GroupType.faces, available = false)

## A tool button: its label, the verb its step runs, the levels it is
## offered on ([] every level) and its numbers for a tool amount.
pub class EditTool:
    pub let name: str
    pub let verb: str
    pub let levels: list[int]
    pub let numbers: func(float) -> list[float]

    pub func init(self, name: str, verb: str, levels: list[int], numbers: func(float) -> list[float]):
        self.name = name
        self.verb = verb
        self.levels = levels
        self.numbers = numbers

    pub func offered(self, level: int) -> bool:
        return self.levels.length == 0 or level in self.levels

## An Edit node kind.
pub class EditKind:
    ## The node kind ("Edit Mesh").
    pub let name: str
    ## Object, Point, Edge and Face, in that order (missing ones too).
    pub let levels: list[EditLevel]
    pub let tools: list[EditTool]
    ## Create entries ("Box", "Sphere", …).
    pub let primitives: list[str]
    ## The geometry the recipe starts from, made from the node's input (an
    ## empty GeometryData when unconnected); fails on input it cannot edit.
    pub let start: func(GeometryData) -> GeometryData!
    ## The geometry level `level` of `data` picks on (the worker publishes
    ## it for the viewport); none when there is nothing to pick.
    pub let pick: func(GeometryData, int) -> Mesh?!
    ## One recipe step on `data`.
    pub let run: func(EditStep, GeometryData) -> GeometryData!
    ## The step creating primitive `name`, with its default numbers.
    pub let create: func(str) -> EditStep?!
    ## Whether the selection also shows through surfaces: for pick geometry
    ## the viewport does not draw (Edit SDF's proxies inside the surface).
    pub let see_through: bool
    ## Tools that, with nothing selected, draw instead: clicks place corners
    ## (on points, surfaces or the ground), Enter or the first corner again
    ## finishes, and `drawn` makes the one step (Edit Mesh's PolyDraw).
    pub let draw_tools: list[str]
    pub let drawn: func(str, list[Vector3]) -> EditStep?!?
    ## The levels Smart picks among (all on the same pick geometry): the
    ## nearest point, else edge, else face under the pointer (none: all
    ## three).
    pub let smart: list[int]

    pub func init(self, name: str, levels: list[EditLevel], tools: list[EditTool], primitives: list[str], start: func(GeometryData) -> GeometryData!,
                  pick: func(GeometryData, int) -> Mesh?!, run: func(EditStep, GeometryData) -> GeometryData!, create: func(str) -> EditStep?!,
                  see_through: bool = false, draw_tools: list[str] = [], drawn: func(str, list[Vector3]) -> EditStep?!? = none, smart: list[int]? = none):
        self.name = name
        self.levels = levels
        self.tools = tools
        self.primitives = primitives
        self.start = start
        self.pick = pick
        self.run = run
        self.create = create
        self.see_through = see_through
        self.draw_tools = draw_tools
        self.drawn = drawn
        self.smart = smart else [point_level, edge_level, face_level]

    ## Whether a recipe step of `verb` is one this kind makes: a geometry
    ## verb (luce-geocore's), a primitive's (its create's), a tool's or a
    ## draw tool's step, or a move (Transform Components).
    pub func knows(self, verb: str) -> bool:
        if Verbs.index_of(verb) >= 0 or verb == "Transform Components" or verb in self.draw_tools:
            return true
        # A primitive's step is named by its create ("Box" makes Create
        # Box).
        for name in self.primitives:
            let step = self.create(name) catch failure:
                continue
            if let made = step:
                if made.verb == verb:
                    return true
        for tool in self.tools:
            if tool.verb == verb:
                return true
        return false

    ## Tool `name`, when this kind has it.
    pub func tool(self, name: str) -> EditTool?:
        for tool in self.tools:
            if tool.name == name:
                return tool
        return none

pub func domain_number(domain: Domain) -> int:
    if domain == Domain.corner: return 1
    if domain == Domain.face: return 2
    if domain == Domain.edge: return 4
    return 0

pub func group_number(group_type: GroupType) -> int:
    if group_type == GroupType.points: return 1
    if group_type == GroupType.edges: return 2
    if group_type == GroupType.faces: return 3
    if group_type == GroupType.corners: return 4
    return 0

# -- Helpers kinds share.

## A tool's numbers whatever the tool amount (Delete, Close, a boolean mode).
pub func fixed_numbers(values: list[float]) -> func(float) -> list[float]:
    return func (amount: float) -> list[float]:
        _ = amount
        return values

## The input in a wrapper of the Edit node's own (its warning kept), so the
## pick geometry a kind caches on it is that kind's: a `start` for kinds
## that edit a component and pass the others through.
pub func own_data(data: GeometryData) -> GeometryData!:
    let result = GeometryData(geometry = data.geometry)
    result.warning = data.warning
    return result
