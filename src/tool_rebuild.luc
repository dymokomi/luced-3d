## Rebuild (Alias's Rebuild Surface): Explicit (multi-span quintic by
## default, one span of degree 7, or custom), Within tolerance, Reduce
## spans, Del multi knots, Non-rational or Bezier, the edges keeping their
## continuity (luce-cad's CadNurbs).
## An Edit CAD step on the surface of the first CV or face picked
## (edit_cad_nets.luc).
from tool_record import Tool, ToolEntry, Pick
from edit_types import point_level, face_level, patch_level
import pick_kinds
import edit_cad_nets
import cad_cook

pub func entry() -> ToolEntry:
    return ToolEntry(edit_cad_nets.rebuild_verb, edit_cad_nets.rebuild_verb, "rebuild-curve", "Modify", [], [cad_cook.edit_kind], made)

func made() -> Tool:
    return entry().tool("Modify", "Surface Structure", "Rebuild a surface: explicit degrees and spans, within a tolerance, fewer spans, Bezier", [Pick("Surface", [point_level, face_level, patch_level], kind = pick_kinds.components, slot = pick_kinds.nowhere)],
                        edit_cad_nets.rebuild_rows(), edit_cad_nets.cook, numbers = [0.0, 0.0, 5.0, 5.0, 4.0, 4.0, 2.0, 2.0, 0.01, 32.0])
