## Raise Degree (Alias's): a surface's degree raised along U and V, the
## shape kept (luce-cad's CadNurbs).
## An Edit CAD step on the surface of the first CV or face picked
## (edit_cad_nets.luc).
from tool_record import Tool, ToolEntry, Pick
from edit_types import point_level, face_level, patch_level
import pick_kinds
import edit_cad_nets
import cad_cook

pub func entry() -> ToolEntry:
    return ToolEntry(edit_cad_nets.raise_verb, edit_cad_nets.raise_verb, "subdivide", "Modify", [], [cad_cook.edit_kind], made)

func made() -> Tool:
    return entry().tool("Modify", "Surface Structure", "Raise a surface's degree along U and V, the shape kept", [Pick("Surface", [point_level, face_level, patch_level], kind = pick_kinds.components, slot = pick_kinds.nowhere)],
                        edit_cad_nets.raise_rows(), edit_cad_nets.cook, numbers = [1.0, 1.0])
