## Delete at the Curves level: the curves picked taken out of the model.
## An Edit CAD step on the curves picked at the Curves level
## (edit_cad_curves.luc).
from tool_record import Tool, ToolEntry, Pick
from parameter_rows import Parameter
from edit_types import curve_level
import pick_kinds
import edit_cad_curves
import cad_cook

pub func entry() -> ToolEntry:
    return ToolEntry(edit_cad_curves.delete_verb, "Delete", "trash", "Curves", [], [cad_cook.edit_kind], made, verb = edit_cad_curves.delete_verb)

func made() -> Tool:
    return entry().tool("Modify", "Curves", "Delete the curves picked", [Pick("Curves", [curve_level], kind = pick_kinds.curves, slot = pick_kinds.nowhere)], rows(), edit_cad_curves.cook,
                        numbers = [0.0])

func rows() -> list[Parameter]:
    let none_shown: list[Parameter] = []
    return none_shown
