## Sheet Revolve (Alias's Revolve): free curves turned about an axis to
## sheets (build_ops.luc).
## A node keeps its picks as words (curves by name, edges by their face and
## where they were clicked); an Edit CAD step takes what is picked, in the
## order picked, and waits for more (edit_cad_build.luc).
from tool_record import Tool, ToolEntry, Pick
from edit_types import edge_level, curve_level
import pick_kinds
import build_ops
import edit_cad_build
import cad_cook

pub func entry() -> ToolEntry:
    return ToolEntry(build_ops.revolve_verb, build_ops.revolve_verb, "rotate-tool", "Surfaces", [cad_cook.context], [cad_cook.edit_kind], made)

func made() -> Tool:
    return entry().tool("Modify", "Surface Build", "Free curves turned about an axis to a sheet", picks(), build_ops.rows(build_ops.revolve_verb), edit_cad_build.cook,
                        numbers = build_ops.starting(build_ops.revolve_verb), waits = waits)

func picks() -> list[Pick]:
    return [Pick("Curves", [curve_level, edge_level], kind = pick_kinds.words, slot = build_ops.curves_text, step = build_ops.curves_text, doc = "The curves (or edges) used.")]

func waits(values: list[float], texts: list[str], wired: bool) -> str:
    return build_ops.waits_for(build_ops.revolve_verb, texts, build_ops.spined(build_ops.revolve_verb, values))
