## Duplicate Curve (Alias's): the edges picked as free curves, exactly; at
## the Faces and Patch levels, a face's isoparm at a parameter. An Edit CAD
## step (edit_cad_curves.luc).
from tool_record import Tool, ToolEntry, Pick
from parameter_rows import Parameter, number, menu
from edit_types import edge_level, face_level, patch_level
import pick_kinds
import edit_cad_curves
import cad_cook

pub func entry() -> ToolEntry:
    return ToolEntry(edit_cad_curves.duplicate_verb, edit_cad_curves.duplicate_verb, "duplicate", "Curves", [], [cad_cook.edit_kind], made)

func made() -> Tool:
    return entry().tool("Modify", "Curves", "Free curves from the edges picked, or a face's isoparm", [Pick("Edges or faces", [edge_level, face_level, patch_level], kind = pick_kinds.components, slot = pick_kinds.nowhere)],
                        rows(), edit_cad_curves.cook, numbers = [0.0, 0.5])

func rows() -> list[Parameter]:
    return [menu("Direction", 0, "U|V", 0.0, "At a face: the isoparm along v at a u (U) or along u at a v."),
            number("Parameter", 1, 0.5, 0.0, 1.0, 0.01, "At a face: where along it, 0 to 1.", slider = true)]
