## The Sketch editor's tools, as Fusion 360 groups them in its CREATE,
## MODIFY and CONSTRAINTS menus (docs/research/FUSION-SKETCH-STUDY.md):
## each with its shortcut, its icon and whether it works yet. Tools not
## built yet show greyed in their menu, so the menus read as Fusion's do.

pub class SketchTool:
    pub let name: str
    ## A single key that picks it, or "".
    pub let key: str
    pub let icon: str
    pub let ready: bool
    ## A separator above it in its menu.
    pub let group_start: bool

    pub func init(self, name: str, key: str, icon: str, ready: bool, group_start: bool = false):
        self.name = name
        self.key = key
        self.icon = icon
        self.ready = ready
        self.group_start = group_start

pub func menu_names() -> list[str]:
    return ["CREATE", "MODIFY", "CONSTRAINTS"]

## The tools of menu `menu` (menu_names' order).
pub func tools(menu: int) -> list[SketchTool]:
    if menu == 0:
        return [SketchTool("Line", "L", "line-tool", true), SketchTool("Midpoint Line", "", "line-tool", false),
                SketchTool("Rectangle", "R", "rectangle-tool", true), SketchTool("Circle", "C", "ellipse-tool", true),
                SketchTool("Arc", "A", "path-tool", true), SketchTool("Polygon", "", "polygon-select-tool", false),
                SketchTool("Ellipse", "", "ellipse-tool", false), SketchTool("Slot", "", "rectangle-tool", false),
                SketchTool("Spline", "", "pen-tool", false), SketchTool("Conic Curve", "", "path-tool", false),
                SketchTool("Point", "P", "vertex-select", true), SketchTool("Text", "", "text-tool", false),
                SketchTool("Mirror", "", "mirror-modifier", false, true), SketchTool("Circular Pattern", "", "array-modifier", false),
                SketchTool("Rectangular Pattern", "", "array-modifier", false), SketchTool("Project / Include", "", "import", false, true),
                SketchTool("Sketch Dimension", "D", "measure-tool", true, true)]
    if menu == 1:
        return [SketchTool("Fillet", "", "bevel", false), SketchTool("Chamfer", "", "bevel", false), SketchTool("Blend Curve", "", "path-tool", false),
                SketchTool("Offset", "O", "inset", false), SketchTool("Trim", "T", "crop-tool", false, true), SketchTool("Extend", "", "arrow-right", false),
                SketchTool("Break", "", "split-mesh", false), SketchTool("Sketch Scale", "", "scale-tool", false),
                SketchTool("Move/Copy", "M", "move-tool", false), SketchTool("Change Parameters", "", "settings", false, true)]
    return [SketchTool("Horizontal/Vertical", "", "align-horizontal-center", true), SketchTool("Coincident", "", "merge-vertices", true),
            SketchTool("Tangent", "", "path-tool", true), SketchTool("Equal", "", "distribute-horizontal", true),
            SketchTool("Parallel", "", "align-left", true), SketchTool("Perpendicular", "", "corner-pin", true),
            SketchTool("Fix/UnFix", "", "lock", true), SketchTool("MidPoint", "", "vertex-select", true),
            SketchTool("Concentric", "", "ellipse-select-tool", true), SketchTool("Collinear", "", "line-tool", true),
            SketchTool("Symmetry", "", "mirror-modifier", true), SketchTool("Curvature", "", "path-tool", false),
            SketchTool("Polygon", "", "polygon-select-tool", false)]

## The tool a key picks, or "".
pub func tool_for_key(key: str) -> str:
    for menu in 0..<3:
        for tool in tools(menu):
            if tool.key != "" and tool.key == key and tool.ready:
                return tool.name
    return ""

## Whether `name` draws (a CREATE tool that places geometry).
pub func draws(name: str) -> bool:
    return name in ["Line", "Rectangle", "Circle", "Arc", "Point"]

## Whether `name` is a constraint tool.
pub func constrains(name: str) -> bool:
    return in_menu(name, 2)

## Whether tool `name` is in menu `menu`.
pub func in_menu(name: str, menu: int) -> bool:
    for tool in tools(menu):
        if tool.name == name:
            return true
    return false
