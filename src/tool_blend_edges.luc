## Blend Curve between edges: at the Edges level Edit CAD's Blend Curve
## takes two picked edges as its ends (edit_cad_curves.luc); its tool bar
## and handles are Blend Curve's.
from tool_record import Tool, ToolEntry, Pick
from edit_types import edge_level
import pick_kinds
import edit_cad_curves
import cad_cook

pub func entry() -> ToolEntry:
    return ToolEntry(edit_cad_curves.blend_edges_verb, edit_cad_curves.blend_verb, "node-tool", "Curves", [], [cad_cook.edit_kind], made)

func made() -> Tool:
    return entry().tool("Modify", "Curves", "A curve blending two edges, G0 to G4 at each end", [Pick("Edges", [edge_level], kind = pick_kinds.edges, slot = pick_kinds.nowhere)],
                        edit_cad_curves.blend_rows(), edit_cad_curves.cook, numbers = edit_cad_curves.blend_numbers(), handles = true)
