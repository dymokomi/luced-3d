## A luce-geocore verb's parameters as parameter rows, in consecutive value
## slots from 0: the node's rows (node_catalog) and the tool's (verb_tools)
## are the same rows. A mesh verb's parameter with `bar` off stays off the
## tool bar (`in_steps`); those with `more` follow a More options folder,
## shut at first, after the others.
from luce_geocore.geocore import Verbs, VerbCatalog
from parameter_rows import Parameter, number, whole, vector, toggle, menu, more_options

## The rows of catalog verb `verb` (VerbCatalog's index).
pub func rows(verb: int) -> list[Parameter]:
    let result: list[Parameter] = []
    let later: list[Parameter] = []
    let mesh_verb = verb < Verbs.count()
    var slot = 0
    for parm in 0..<VerbCatalog.parm_count(verb):
        let label = VerbCatalog.parm_label(verb, parm)
        let kind = VerbCatalog.parm_kind(verb, parm)
        let initial = VerbCatalog.parm_initial(verb, parm)
        let low = VerbCatalog.parm_minimum(verb, parm)
        let high = VerbCatalog.parm_maximum(verb, parm)
        let doc = VerbCatalog.parm_doc(verb, parm)
        var row = number(label, slot, initial, low, high, 0.1, doc, VerbCatalog.parm_soft(verb, parm) > 0.0, VerbCatalog.parm_soft(verb, parm))
        if kind == 1:
            row = whole(label, slot, initial, low, high, doc, true)
        elif kind == 2:
            row = toggle(label, slot, initial, doc)
        elif kind == 3:
            let defaults: list[float] = []
            for component in 0..<VerbCatalog.parm_components(verb, parm):
                defaults.append(initial)
            row = vector(label, slot, defaults, doc, low, high)
        elif kind == 4:
            row = menu(label, slot, VerbCatalog.parm_choices(verb, parm), initial, doc)
        if mesh_verb:
            row.in_steps = Verbs.parm_bar(verb, parm)
        if mesh_verb and Verbs.parm_more(verb, parm):
            later.append(row)
        else:
            result.append(row)
        slot += row.components
    if later.length > 0:
        return result + [more_options()] + later
    return result

## Verb `name`'s initial numbers, one per value slot (a vector's components
## each), or none for no verb.
pub func initial_numbers(name: str) -> list[float]:
    let result: list[float] = []
    let verb = VerbCatalog.index_of(name)
    if verb < 0:
        return result
    for parm in 0..<VerbCatalog.parm_count(verb):
        for component in 0..<VerbCatalog.parm_components(verb, parm):
            result.append(VerbCatalog.parm_initial(verb, parm))
    return result
