## Symmetry Align (Alias's Symmetry Plane Align): a surface's edge or a
## curve's end meeting a symmetry plane made G0 to G3 with its mirror
## image (edit_cad_align.luc, align_ops.luc). The node keeps its edge as
## words; an Edit CAD step aligns the edge or curve end picked.
from tool_record import Tool, ToolEntry, Pick
from edit_types import edge_level, curve_level
import pick_kinds
import align_ops
import edit_cad_align
import cad_cook

pub func entry() -> ToolEntry:
    return ToolEntry(align_ops.symmetry_verb, align_ops.symmetry_verb, "symmetry-align", "Surfaces", [cad_cook.context], [cad_cook.edit_kind], made)

func made() -> Tool:
    return entry().tool("Modify", "Align", "Make an edge meeting a symmetry plane continuous with its mirror image", picks(), align_ops.symmetry_rows(), edit_cad_align.cook,
                        numbers = align_ops.symmetry_starting(), waits = edit_cad_align.symmetry_waits)

func picks() -> list[Pick]:
    return [Pick("Input edge", [edge_level, curve_level], "Symmetry Align: select the input first: a surface's edge (Edges level) or a curve near its end (Curves level)",
                 kind = pick_kinds.align_input, slot = align_ops.input_text, step = align_ops.input_text,
                 doc = "The edge that meets the symmetry plane (a surface's edge, or a curve's end).")]
