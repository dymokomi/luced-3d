## Edit CAD: the Edit framework's kind for analytic models, Fusion 360's
## direct modeling ("Do not capture design history") in one node, with
## Alias's curves and surfaces. Its levels are Object (a whole model), CVs
## (control vertices of surfaces and curves), Edges (a B-rep edge), Faces
## (a B-rep face), Patch and Curves (a whole curve); Smart picks edges and
## faces. Object, Faces and Edges pick on the models' display tessellations
## tagged with their models, faces and edges (luce-cad's
## CadEdits.pick_mesh); CVs on the control-vertex cloud; Curves on the
## curves' segments (CadCurves.pick_mesh).
##
## Every tool is a step on the model the steps before it made, and nothing
## earlier changes when something later does:
##   sketches and the Extrude and Revolve of their profiles
##     (edit_cad_sketches.luc: a sketch is an object of the model);
##   the gizmo's moves (whole models placed, faces moved and turned with
##     their neighbors following), Create copy, Offset Face, Delete (faces
##     healed), Remove Faces, Replace Face, Shell, Combine and Split Body
##     (edit_cad_faces.luc);
##   Fillet and Chamfer of picked edges, by the CAD nodes' own code;
##   CVs moved by the point verbs that keep topology, a moved boundary CV
##     re-projecting its trims (luce-cad), and the CV moves and structure
##     steps of edit_cad_nets.luc;
##   curves drawn, duplicated, blended and edited (edit_cad_curves.luc);
##   luce-cad's analytic solids, created named.
## The faces a step makes are named for the node and the step's place in
## the recipe (`#<node>s<n>`), so later steps find them by name and two Edit
## CAD nodes in one chain never make the same names; a model whose faces
## have no names (a STEP import) gets them when the recipe starts
## (`#<node>m<i>`).
from luce_geocore.geocore import Mesh, Verbs, Groups, Domain, GroupType, Vector3, Matrix4
from luce_cad.cad_geometry import CadGeometry
from luce_cad.cad_edits import CadEdits
from luce_cad.solids import CadSolids
from luce_cad.model import CadModel
from luce_cad.modeling import CadModeling
import cad_nodes
from geometry_data import GeometryData
from edit_operations import EditStep
from edit_types import EditKind, EditLevel, EditTool, object_level, point_level, edge_level, face_level, patch_level, curve_level, missing, own_data
from parameter_rows import Parameter
import cad_moves
from tools import tool_run
import edit_cad_sketches
import edit_cad_faces
import edit_cad_nets
import edit_cad_curves
from luce_cad.cad_curves import CadCurves
from luce_ui import ui

pub let kind_name = "Edit CAD"

## CVs are the Point level.
let cv_level = point_level

## The verbs that move control vertices.
pub func cv_verbs() -> list[str]:
    return ["Transform Components", "Mountain", "Flatten", "Snap"]

pub func primitive_names() -> list[str]:
    return ["Box", "Cylinder", "Cone", "Sphere", "Torus"]

pub func kind() -> EditKind:
    let steps = [edit_cad_sketches.sketch_verb, edit_cad_sketches.edit_sketch_verb, edit_cad_sketches.visibility_verb, edit_cad_sketches.plane_verb, "Extrude", "Revolve", edit_cad_nets.move_verb]
    return EditKind(kind_name, levels(), tool_list(), primitive_names(), start, pick, run, create, smart = [edge_level, face_level], steps = steps,
                    draw_tools = edit_cad_curves.draw_verbs(), drawn = edit_cad_curves.drawn)

func levels() -> list[EditLevel]:
    return [EditLevel("Object", "cube", Domain.face, GroupType.faces, model_piece),
            EditLevel("CVs", "vertex-select", Domain.point, GroupType.points),
            EditLevel("Edges", "edge-select", Domain.edge, GroupType.edges, edge_piece),
            EditLevel("Faces", "face-select", Domain.face, GroupType.faces, face_piece), missing("Smart"),
            EditLevel("Patch", "grid", Domain.face, GroupType.faces, patch_piece),
            EditLevel("Curves", "path-tool", Domain.edge, GroupType.edges, edit_cad_curves.curve_piece)]

## The tools on picked components: Move/Copy (the gizmo's step, its tool
## bar Fusion's dialog: cad_moves.luc), Delete (models go, faces heal),
## Remove (bodies, as a step of its own), Remove Faces, Offset Face,
## Replace Face, Split Face, Shell, Combine and Split Body; Fillet and
## Chamfer of edges; Noise, Flatten and Snap of CVs; Insert Knot, Remove
## Knot, Raise Degree, Rebuild and Convert to B-spline of a CV's or a
## face's surface; the curves' drawing tools, Duplicate Curve, Blend Curve,
## Attach, Detach, Close, Stretch, Reverse and Delete (edit_cad_curves).
func tool_list() -> list[EditTool]:
    let result: list[EditTool] = []
    result.append(EditTool("Move/Copy", "Transform Components", [object_level, face_level, patch_level], cad_moves.starting(), cad_moves.rows()))
    let none_shown: list[Parameter] = []
    result.append(EditTool("Delete", "Delete", [object_level, face_level, patch_level], [0.0], none_shown))
    result.append(EditTool("Remove", "Remove", [object_level], [0.0], none_shown))
    result.append(EditTool("Remove Faces", "Remove Faces", [face_level, patch_level], [0.0], none_shown))
    for (name, offered) in [("Offset Face", [face_level, patch_level]), ("Replace Face", [face_level, patch_level]), ("Split Face", [face_level, patch_level]),
                            ("Shell", [object_level, face_level, patch_level]), ("Combine", [object_level]), ("Split Body", [object_level])]:
        result.append(EditTool(name, name, offered))
    for (name, offered) in [("Noise", [cv_level]), ("Flatten", [cv_level]), ("Snap", [cv_level])]:
        let made = tool_run(name) else continue
        result.append(EditTool(name, made.verb, offered, made.numbers))
    for feature in edge_features():
        result.append(EditTool(feature, feature, [edge_level]))
    # The NURBS structure steps (edit_cad_nets.luc) and the curves'
    # (edit_cad_curves.luc).
    result.extend(edit_cad_nets.tools(cv_level, face_level, patch_level))
    result.extend(edit_cad_curves.tools(curve_level, edge_level, face_level, patch_level))
    return result

## The CAD nodes that are Edit CAD tools on picked edges.
pub func edge_features() -> list[str]:
    return ["Fillet", "Chamfer"]

## The whole model under a picked polygon.
func model_piece(mesh: Mesh, face: int) -> str!:
    return f"@cad_model={int(mesh.attribute_value(mesh.find_attribute("cad_model", 2), face))}"

## The whole B-rep face under a picked polygon.
func face_piece(mesh: Mesh, face: int) -> str!:
    let model = int(mesh.attribute_value(mesh.find_attribute("cad_model", 2), face))
    let owner = int(mesh.attribute_value(mesh.find_attribute("cad_face", 2), face))
    return f"@cad_model={model} &@cad_face={owner}"

## The whole B-rep edge under a picked mesh edge (nothing inside a face).
func edge_piece(mesh: Mesh, edge: int) -> str!:
    let owner = int(mesh.attribute_value(mesh.find_attribute("cad_edge", 4), edge))
    let model = int(mesh.attribute_value(mesh.find_attribute("cad_edge_model", 4), edge))
    return f"@cad_edge_model={model} &@cad_edge={owner}" if owner >= 0 else "!*"

## Every trimmed region on the picked underlying surface of this model.
func patch_piece(mesh: Mesh, face: int) -> str!:
    let model = int(mesh.attribute_value(mesh.find_attribute("cad_model", 2), face))
    let surface = int(mesh.attribute_value(mesh.find_attribute("cad_surface", 2), face))
    return f"@cad_model={model} &@cad_surface={surface}"

## A separate gesture expands an edge along its unambiguous tangent chain.
pub func edge_chain(mesh: Mesh, edge: int) -> str!:
    let chain = int(mesh.attribute_value(mesh.find_attribute("cad_edge_chain", 4), edge))
    let model = int(mesh.attribute_value(mesh.find_attribute("cad_edge_model", 4), edge))
    return f"@cad_edge_model={model} &@cad_edge_chain={chain}" if chain >= 0 else "!*"

## The input's CAD models, their faces named where they had none (a STEP
## import's), and its sketches; other components pass through (with a
## warning when there are no models yet: create one, sketch, or connect
## CAD).
func start(data: GeometryData, tag: str) -> GeometryData!:
    if data.has_cad():
        return stated(GeometryData(geometry = CadEdits.named_models(data.geometry, f"{tag}m")))
    if data.has_curves():
        return stated(own_data(data))
    if data.instance_count() == 0 and data.mesh == none:
        return stated(data)
    return data.passed("The input has no CAD models; it passes through (create a solid, or connect CAD)")

func pick(data: GeometryData, level: int) -> Mesh?!:
    if level == curve_level:
        return CadCurves.pick_mesh(data.geometry) if data.has_curves() else Mesh.empty()
    if level == cv_level and (data.has_cad() or data.has_curves()):
        return CadGeometry.cv_cloud(data.geometry)
    if not data.has_cad():
        return Mesh.empty()
    return pick_mesh(data)


## The tagged tessellations the Object, Faces and Edges levels pick on,
## made once per result, with what the last step created as `.selection`
## (a group may name it, so steps read their groups on this same mesh).
pub func pick_mesh(data: GeometryData) -> Mesh!:
    if let known = data.pick_cache:
        return known
    var made = CadEdits.pick_mesh(data.geometry)
    if data.created != "":
        made = Groups.with_group(made, ".selection", 2, data.created)
    data.pick_cache = made
    return made

## Step number `at` of a recipe on `data`, with the model's sketches told
## to the editor (Node.sketch_state); after Insert Knot or Remove Knot, the
## surface it works on too (edit_cad_nets.probe_line: the viewport draws
## the isoparm under the pointer from it, knot_place.luc).
func run(step: EditStep, at: int, data: GeometryData, tag: str) -> GeometryData!:
    let made = ran(step, f"{tag}s{at}", data)
    let probe = made.sketch_state if made.sketch_state.starts_with(edit_cad_nets.probe_head) else ""
    let result = stated(made)
    if probe != "":
        result.sketch_state = result.sketch_state + "\n" + probe if result.sketch_state != "" else probe
    return result

## `data` with its sketches as the editor reads them.
func stated(data: GeometryData) -> GeometryData!:
    data.sketch_state = edit_cad_sketches.state_of(data)
    return data

## `name` names what the step makes (`#<node>s<n>`).
func ran(step: EditStep, name: str, data: GeometryData) -> GeometryData!:
    if step.verb.starts_with("Create "):
        return created(step, name, data)
    if edit_cad_sketches.is_sketch_step(step.verb):
        return edit_cad_sketches.sketched(step, data)
    if edit_cad_sketches.is_feature_step(step.verb):
        return edit_cad_sketches.featured(step, name, data)
    # Curves: drawn ones and those on picked curves need no model.
    if step.verb in edit_cad_curves.draw_verbs() or step.verb in edit_cad_curves.curve_verbs():
        return edit_cad_curves.run(step, data, none)
    if step.group_type == 1 and data.has_curves() and not data.has_cad():
        return moved_cvs(step, data)
    if not data.has_cad():
        error(ui.invalid, "Edit CAD has no models to edit yet: create one, sketch and extrude, or connect CAD")
    if step.verb == edit_cad_nets.move_verb:
        return edit_cad_nets.run_move(step, data)
    if step.verb in edit_cad_nets.structure_verbs():
        return edit_cad_nets.run_structure(step, data, none if step.group_type == 1 else edit_cad_faces.picked(step, data, pick_mesh))
    if step.group_type == 1:
        return moved_cvs(step, data)
    let shown = edit_cad_faces.picked(step, data, pick_mesh)
    if step.verb in edit_cad_curves.model_verbs():
        return edit_cad_curves.run(step, data, shown)
    if step.verb in edge_features():
        return featured(step, name, data, shown)
    if step.group_type == 2:
        error(ui.invalid, f"{step.verb} does not apply to CAD edges")
    if step.verb == "Transform Components" or step.verb in edit_cad_faces.face_verbs():
        return edit_cad_faces.run_face_step(step, name, data, shown)
    error(ui.invalid, f"{step.verb} does not apply to CAD models or faces")

## A feature on picked edges, as its node makes it: each model with picked
## edges replaced by the feature on them (its new faces named for the
## step); the first one's radius arrow is the step's handle.
func featured(step: EditStep, name: str, data: GeometryData, shown: Mesh) -> GeometryData!:
    var geometry = data.geometry
    var any = false
    var handles = ""
    for index in 0..<CadGeometry.model_count(data.geometry):
        let edges = CadEdits.model_edges(shown, step.group, index)
        if edges == "":
            continue
        let body = GeometryData(geometry = CadGeometry.of_model(CadGeometry.model(data.geometry, index)))
        let made = cad_nodes.evaluate_cad(step.verb, step.numbers, body, f"{name}.{index}", texts = [edges, "", ""])
        geometry = CadEdits.replaced(geometry, index, CadGeometry.model(made.geometry, 0))
        if handles == "":
            handles = made.handles
        any = true
    if not any:
        error(ui.invalid, f"{step.verb} needs edges of a model: pick them at the Edges level")
    let result = GeometryData(geometry = geometry)
    result.handles = handles
    return result

## A point verb on the control vertices: the moved points go back.
func moved_cvs(step: EditStep, data: GeometryData) -> GeometryData!:
    if not (step.verb in cv_verbs()):
        error(ui.invalid, f"{step.verb} does not apply to control vertices")
    let before = CadGeometry.cv_cloud(data.geometry)
    if step.topology != 0 and step.topology != before.topology_hash():
        error(ui.invalid, "The CAD input's control vertices changed. Undo the upstream change or clear this node's edits.")
    let numbers = step.numbers[..<cad_moves.transform_count] if step.numbers.length > cad_moves.transform_count else step.numbers
    let result = Verbs.run(step.verb, before, step.group, step.group_type, numbers, step.symmetry, step.keep)
    let made = GeometryData(geometry = CadGeometry.with_cv_cloud(data.geometry, before, result.mesh()))
    made.warning = result.warning()
    return made

## The step adding solid `name` at the origin. Its numbers: three sizes
## (box width, height, depth; cylinder and cone radius, height, top radius;
## sphere radius; torus ring and tube radii), then the position.
func create(name: str) -> EditStep?!:
    if not (name in primitive_names()):
        return none
    var sizes = [2.0, 2.0, 2.0]
    if name == "Cylinder" or name == "Cone":
        sizes = [1.0, 2.0, 0.0]
    elif name == "Sphere":
        sizes = [1.0, 0.0, 0.0]
    elif name == "Torus":
        sizes = [1.0, 0.3, 0.0]
    return EditStep("Create " + name, "", 0, sizes + [0.0, 0.0, 0.0], 0)

## `data` with the solid of step `name` added as a model of its own,
## named for the step and selected as what was created.
func created(step: EditStep, tag: str, data: GeometryData) -> GeometryData!:
    let name = step.verb[7..]
    let v = step.numbers
    if v.length < 6:
        error(ui.invalid, f"{step.verb} needs six numbers")
    let index = CadGeometry.model_count(data.geometry)
    let solid = CadModeling.tagged(solid_of(name, v), tag)
    let position = Vector3(v[3], v[4], v[5])
    let placed = solid if position.length() == 0.0 else solid.placed(Matrix4.compose(position, Vector3(), Vector3(1.0, 1.0, 1.0)))
    let result = GeometryData(geometry = CadEdits.with_model(data.geometry, placed))
    result.created = f"@cad_model={index}"
    return result

func solid_of(name: str, v: list[float]) -> CadModel!:
    if name == "Box":
        return CadSolids.box(v[0], v[1], v[2])
    if name == "Cylinder":
        return CadSolids.cylinder(v[0], v[1])
    if name == "Cone":
        return CadSolids.cone(v[0], v[1], v[2])
    if name == "Sphere":
        return CadSolids.sphere(v[0])
    if name == "Torus":
        return CadSolids.torus(v[0], v[1])
    error(ui.invalid, f"Edit CAD cannot create {name}")
