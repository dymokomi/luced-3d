## Detach (Alias's): a curve cut in two at a parameter.
## An Edit CAD step on the curves picked at the Curves level
## (edit_cad_curves.luc).
from tool_record import Tool, ToolEntry, Pick
from parameter_rows import Parameter, number
from edit_types import curve_level
import pick_kinds
import edit_cad_curves
import cad_cook

pub func entry() -> ToolEntry:
    return ToolEntry(edit_cad_curves.detach_verb, edit_cad_curves.detach_verb, "detach-curve", "Curves", [], [cad_cook.edit_kind], made, verb = edit_cad_curves.detach_verb)

func made() -> Tool:
    return entry().tool("Modify", "Curves", "Cut a curve in two at a parameter", [Pick("Curves", [curve_level], kind = pick_kinds.curves, slot = pick_kinds.nowhere)], rows(), edit_cad_curves.cook,
                        numbers = [0.5])

func rows() -> list[Parameter]:
    return [number("Parameter", 0, 0.5, 0.001, 0.999, 0.01, "Where the curve is cut, 0 at its start to 1 at its end.", slider = true)]
