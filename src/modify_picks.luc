## The selection inputs of the Modify feature nodes (cad_modify.luc), as
## the selection fields of Fusion 360's dialogs: each node's inputs in
## order (Shell's faces and bodies, Combine's target and tool bodies, Move's
## objects, axis and points…). Each is a row in the parameter panel (what
## is picked, and a button to pick it again) and a prompt in the viewport:
## the node's input shows while it waits, what is clicked goes into the
## node by name, a single pick (one face, one body, an edge, a point)
## finishes at once and the others at Enter, and the next input the node
## still waits for starts by itself, as Fusion's dialog moves to its next
## field. Esc undoes the picking.
from luce_geocore.geocore import Mesh, Selection, Domain
from workspace import Workspace
from node import Node
from tool_prompt import ToolPrompt
from edit_types import object_level, edge_level, face_level, curve_level
from edit_steps import show
import cad_modify
import cad_curve_nodes
import cad_surface_nodes
from luce_cad.cad_curves import CadCurves
import cad_moves
import cad_names
import edit_cad_faces
import edit_cad_align
import align_ops
import build_ops
import blend_ops
from luce_3d.graphics import Vector3

## What one input takes.
pub let faces = 0
pub let bodies = 1
pub let face = 2
pub let body = 3
pub let edge = 4
pub let point = 5
## A curve of the input (the Curves level) or, without curves, an edge: a
## blend's end ("curve <name>" or "edge <reference>").
pub let curve_or_edge = 6
## Curves of the input, by name (Project's), several (Enter finishes).
pub let curves = 7
## Align's input: an edge (the Edges level) or a curve's end (the Curves
## level), as words (align_ops.luc); its masters: an edge, a curve, a face
## (Project, U/V) or a double-click for a temporary isoparm.
pub let align_input = 8
pub let align_master = 9
## A builder's curves (build_ops.luc): curves (the Curves level) or edges,
## several, as words in the order clicked; a click again takes one out, a
## double-click on a surface adds a temporary isoparm; Enter finishes.
pub let curve_words = 10

## A selection input: its label in the panel, the node's text (or for a
## point, the value slots) it writes, what it takes, when it shows (a
## Houdini condition on the node's rows) and its tooltip.
pub class PickInput:
    pub let label: str
    pub let slot: int
    pub let takes: int
    pub let hide_when: str
    pub let doc: str

    pub func init(self, label: str, slot: int, takes: int, hide_when: str, doc: str):
        self.label = label
        self.slot = slot
        self.takes = takes
        self.hide_when = hide_when
        self.doc = doc

    ## The viewport prompt's label ("Pick tool bodies").
    pub func prompt(self) -> str:
        return "Pick " + self.label.lower()

## Node `kind`'s selection inputs, in its dialog's order.
pub func inputs(kind: str) -> list[PickInput]:
    let first = cad_modify.first_text
    let second = cad_modify.second_text
    let split = "{ splitting_tool != 0 }"
    if kind == "Shell":
        return [PickInput("Faces", first, faces, "", "The faces opened (removed); kept by their names."),
                PickInput("Bodies", second, bodies, "", "Bodies hollowed closed, with nothing opened.")]
    if kind == "Move":
        let rotate = "{ move_type != 2 } { axis != 3 }"
        return [PickInput("Objects", first, faces, "", "What moves: bodies or faces, as Move object says."),
                PickInput("Rotate axis", second, edge, rotate, "Rotate: the edge whose line it turns about."),
                PickInput("From point", cad_moves.from_slot, point, "{ move_type < 3 }", "The point that moves: a corner or an edge's end, a round edge's middle."),
                PickInput("To point", cad_moves.to_slot, point, "{ move_type != 3 }", "Point to point: where it goes."),
                PickInput("Pivot", cad_moves.pivot_point_slot, point, "{ move_type == 1 } { move_type > 2 } { pivot != 2 }", "Set pivot: the point Free move and Rotate turn about.")]
    if kind == "Combine":
        return [PickInput("Target body", first, body, "", "The body the tools change."),
                PickInput("Tool bodies", second, bodies, "", "The bodies joined to, cut from or intersected with the target (the second input's bodies are tools too).")]
    if kind == "Split Body":
        return [PickInput("Body", first, bodies, "", "The bodies to split."),
                PickInput("Splitting face", second, face, split, "The face whose surface, extended, splits the bodies.")]
    if kind == "Split Face":
        return [PickInput("Faces", first, faces, "", "The faces to split."),
                PickInput("Splitting face", second, face, split, "The face whose surface, extended, splits them.")]
    if kind == "Replace Face":
        return [PickInput("Faces", first, faces, "", "The faces replaced."),
                PickInput("Target faces", second, faces, "", "The faces (one surface, or a solid's faces) the faces are moved onto.")]
    if kind == "Delete Face":
        return [PickInput("Faces", first, faces, "", "The faces deleted; the body heals over them.")]
    if kind == "Remove":
        return [PickInput("Bodies", first, bodies, "", "The bodies removed.")]
    if kind == cad_curve_nodes.blend_kind:
        return [PickInput("From curve", 0, curve_or_edge, "", "The curve or edge the blend leaves, at its end nearest the other (an edge when the input has no curves)."),
                PickInput("To curve", 1, curve_or_edge, "", "The curve or edge the blend meets.")]
    if kind == cad_curve_nodes.curve_kind:
        return [PickInput("Edge", cad_curve_nodes.source_text, edge, "{ type != 2 }", "From edge: the body's edge the curve is, kept by its reference."),
                PickInput("Face", cad_curve_nodes.source_text, face, "{ type < 3 }", "Isoparm and On face: the face, kept by its name.")]
    # Surfacing (cad_surface_nodes.luc).
    let s_first = cad_surface_nodes.first_text
    let s_second = cad_surface_nodes.second_text
    if kind == cad_surface_nodes.project_kind:
        return [PickInput("Curves", s_first, curves, "", "The curves cast onto the face, kept by their names."),
                PickInput("Projection face", s_second, face, "", "The face the curves are cast onto, kept by its name.")]
    if kind == cad_surface_nodes.intersect_kind:
        return [PickInput("Face", s_first, face, "", "The face the meeting curves lie on."),
                PickInput("Second face", s_second, face, "{ with == 1 }", "The face it meets.")]
    if kind == cad_surface_nodes.trim_kind:
        return [PickInput("Face", s_first, face, "", "The face trimmed by its curves; then click its region markers in the viewport."),
                PickInput("Cutting faces", cad_surface_nodes.cutters_text, faces, "{ intersect_faces == 0 }", "3D Trimming by Intersect: the faces that cut it where they meet it.")]
    if kind in [cad_surface_nodes.untrim_kind, cad_surface_nodes.convert_kind, cad_surface_nodes.shrink_kind]:
        return [PickInput("Face", s_first, face, "", "The face, kept by its name.")]
    if kind == cad_surface_nodes.stitch_kind:
        return [PickInput("Bodies", s_first, bodies, "", "The bodies joined (none picked: every body of the input).")]
    if kind == cad_surface_nodes.unstitch_kind:
        return [PickInput("Body", s_first, body, "", "The body whose faces each become a body.")]
    if kind == cad_surface_nodes.align_kind:
        return [PickInput("Input edge", align_ops.input_text, align_input, "", "The edge that moves (a surface's edge; at the Curves level a curve's end), kept as its face and where it was clicked."),
                PickInput("Master", align_ops.master_text, align_master, "", "What it aligns to: an edge, a curve, a face (Project, U/V), or a double-click on a surface for an isoparm."),
                PickInput("Second master", align_ops.second_text, align_master, "", "A second master for another side of the input (optional).")]
    if kind == cad_surface_nodes.symmetry_kind:
        return [PickInput("Input edge", align_ops.input_text, align_input, "", "The edge that meets the symmetry plane (a surface's edge, or a curve's end).")]
    # Surfaces from curves (build_ops.luc).
    let b_curves = build_ops.curves_text
    let b_rails = build_ops.rails_text
    if kind == build_ops.square_verb:
        return [PickInput("Boundaries", b_curves, curve_words, "", "The four boundaries, curves or edges (or isoparms), in the order the Boundary rows follow.")]
    if kind == build_ops.skin_verb:
        return [PickInput("Sections", b_curves, curve_words, "", "The sections in order, curves or edges.")]
    if kind == build_ops.rail_verb:
        return [PickInput("Generation curves", b_curves, curve_words, "", "The curves swept along the rails."),
                PickInput("Rails", b_rails, curve_words, "", "One rail, or two.")]
    if kind == build_ops.profile_verb:
        return [PickInput("Profiles", b_curves, curve_words, "", "The profiles placed along the rail."),
                PickInput("Rail", b_rails, curve_words, "", "The rail the profiles are placed on.")]
    if kind in [build_ops.planar_verb, build_ops.extrude_verb, build_ops.revolve_verb]:
        return [PickInput("Curves", b_curves, curve_words, "", "The curves (or edges) used.")]
    if kind == build_ops.extend_verb:
        return [PickInput("Edge", b_curves, align_input, "", "The surface's edge to carry on (at the Curves level, a curve's end), kept as its face and where it was clicked.")]
    # Blends between surfaces (blend_ops.luc).
    if kind == blend_ops.blend_verb:
        return [PickInput("First side", blend_ops.first_text, curve_words, "", "Side 1: edges, curves or isoparms, a chain in order."),
                PickInput("Second side", blend_ops.second_text, curve_words, "", "Side 2, likewise."),
                PickInput("Profiles", blend_ops.profiles_text, curve_words, "", "Alias's Profile Blend: curves across the blend it passes through (none: a Freeform Blend).")]
    if kind == blend_ops.fillet_verb:
        return [PickInput("First faces", blend_ops.first_text, faces, "", "The first set: the faces the ball rolls on one side, kept by their names."),
                PickInput("Second faces", blend_ops.second_text, faces, "", "The second set.")]
    if kind == blend_ops.tube_verb:
        return [PickInput("Curve", blend_ops.first_text, curve_words, "", "The curve the tube runs along: a curve, an edge, or a double-click for an isoparm.")]
    return []

## The input of `kind` whose prompt is `label`, or none.
func input_named(kind: str, label: str) -> PickInput?:
    for input in inputs(kind):
        if input.prompt() == label:
            return input
    return none

## What a row shows: what is picked, in words.
pub func summary(node: Node, input: PickInput) -> str:
    if input.takes == point:
        let v = node.values
        return f"{v[input.slot]:.3f}, {v[input.slot + 1]:.3f}, {v[input.slot + 2]:.3f}"
    let text = node.texts[input.slot].trim()
    if text == "":
        return "None picked"
    if input.takes == edge:
        return "An edge"
    if input.takes == curve_or_edge:
        return text if text.starts_with("curve ") else "An edge"
    if input.takes == curves:
        let named = text.split(";").length
        return "1 curve" if named == 1 else f"{named} curves"
    if input.takes == curve_words:
        let named = build_ops.items(text).length
        return "1 curve" if named == 1 else f"{named} curves"
    if input.takes in [align_input, align_master]:
        let words = text.split(" ")
        if words[0] == "isoparm" or words[0] == "isoparm_at":
            return "An isoparm"
        return f"{words[1]} ({words[0]})" if words.length > 1 else text
    let count = text.split(";").length
    var noun = "face" if input.takes in [faces, face] else "body"
    if node.kind == "Move" and input.slot == cad_modify.first_text:
        noun = "body" if int(node.values[cad_modify.object_slot]) == 0 else "face"
    if count == 1:
        return f"1 {noun}"
    return f"{count} {"bodies" if noun == "body" else "faces"}"

## Wait for input `input` of node `id`: its input body shows, picked at the
## level the input takes.
pub func start(w: Workspace, id: int, input: PickInput) -> unit!:
    let node = w.network.require(id)
    if node.inputs[0] < 0 or w.in_transaction():
        return
    w.begin(input.prompt())
    begin_waiting(w, node, input)

func begin_waiting(w: Workspace, node: Node, input: PickInput) -> unit!:
    w.prompt = ToolPrompt(node.id, node.inputs[0], input.prompt(), true)
    w.network.selected = node.inputs[0]
    show(w, node.inputs[0])
    let takes_bodies = input.takes in [bodies, body] or (node.kind == "Move" and input.slot == cad_modify.first_text and int(node.values[cad_modify.object_slot]) == 0)
    var level = object_level if takes_bodies else (edge_level if input.takes in [edge, point] else face_level)
    # A blend's end: the input's curves when it has any, else its edges.
    if input.takes == curve_or_edge:
        level = curve_level if input_has_curves(w, node) else edge_level
    if input.takes == curves:
        level = curve_level
    if input.takes == align_input:
        level = edge_level
    if input.takes == align_master:
        level = face_level if int(node.values[align_ops.type_slot]) in [1, 2] else edge_level
    if input.takes == curve_words:
        level = curve_level if input_has_curves(w, node) else edge_level
    w.adopt_level(level)
    w.selection = none
    w.pending_changed = true
    let many = input.takes in [faces, bodies, curves, curve_words]
    w.notice = f"{input.prompt()}: click {"them (Shift adds), then Enter" if many else "one"}; Esc cancels"
    if input.takes == align_master:
        w.notice = f"{input.prompt()}: click an edge, a curve (Curves level) or a face (Project, U/V); double-click a surface for an isoparm; Esc cancels"
    if input.takes == curve_words:
        w.notice = f"{input.prompt()}: click curves or edges in order (again: takes one out), double-click a surface for an isoparm, then Enter; Esc cancels"
    w.revision += 1
    w.rebuild()

## Whether node `node`'s input holds CAD curves.
func input_has_curves(w: Workspace, node: Node) -> bool!:
    let input = w.network.find(node.inputs[0]) else return false
    let data = input.cache else return CadCurves.count(w.network.evaluate_data(input.id).geometry) > 0
    return data.has_curves()

## The first input node `node` still waits for (cad_modify.waits_for,
## cad_curve_nodes.waits_for), or none: an empty one it needs as its values
## stand.
pub func next_input(node: Node) -> PickInput?:
    var waiting = ""
    if node.kind in cad_curve_nodes.kinds():
        waiting = cad_curve_nodes.waits_for(node.kind, node.values, node.texts)
    elif node.kind in cad_surface_nodes.kinds():
        waiting = cad_surface_nodes.waits_for(node.kind, node.values, node.texts)
    else:
        waiting = cad_modify.waits_for(node.kind, node.values, node.texts, node.inputs.length > 1 and node.inputs[1] >= 0)
    if waiting == "":
        return none
    for input in inputs(node.kind):
        if input.takes != point and node.texts[input.slot].trim() == "" and needed(node, input):
            return input
    return none

## Whether `node` needs input `input` as its values stand.
func needed(node: Node, input: PickInput) -> bool:
    if input.label == "Splitting face":
        return int(node.values[edit_cad_faces.split_tool_slot]) == 0
    if input.label in ["Second master", "Cutting faces"]:
        return false
    if input.label == "Second face":
        return node.kind == cad_surface_nodes.intersect_kind and int(node.values[0]) == 0
    if input.label == "Rotate axis":
        return int(node.values[cad_moves.type_slot]) == 2 and int(node.values[cad_moves.axis_slot]) == 3
    if input.label == "Tool bodies":
        return node.inputs.length < 2 or node.inputs[1] < 0
    if node.kind == cad_curve_nodes.curve_kind:
        let made_as = int(node.values[cad_curve_nodes.type_slot])
        return made_as == cad_curve_nodes.edge_type if input.takes == edge else made_as >= cad_curve_nodes.isoparm_type
    return true

## Whether prompt `label` is one of node `node`'s inputs.
pub func waits(node: Node, label: str) -> bool:
    return (node.kind in cad_modify.kinds() or node.kind in cad_curve_nodes.kinds() or node.kind in cad_surface_nodes.kinds()) and input_named(node.kind, label) != none

## The selection changed while input `label` of `node` waits: what is
## picked goes into the node; a single pick finishes at once.
pub func follow(w: Workspace, node: Node, label: str, mesh: Mesh, chosen: Selection) -> unit!:
    let input = input_named(node.kind, label) else return
    let first = chosen.next(-1)
    if input.takes in [align_input, align_master]:
        let words = edit_cad_align.pick_words(mesh, first, w.level_index(), input.takes == align_master) if first >= 0 else ""
        if words == "":
            return
        node.texts[input.slot] = words
        if input.slot == align_ops.second_text:
            let near = edit_cad_align.words_point(words) else Vector3()
            node.values[align_ops.second_near_slot] = near.x
            node.values[align_ops.second_near_slot + 1] = near.y
            node.values[align_ops.second_near_slot + 2] = near.z
        finish(w, node, label)
        return
    # A builder's curves or edges, each click one in order.
    if input.takes == curve_words:
        if first < 0 or not (w.level_index() == curve_level or w.level_index() == edge_level):
            return
        let words = edit_cad_align.pick_words(mesh, first, w.level_index(), true)
        if words == "":
            return
        add_curve_words(w, node, label, words)
        return
    # Curves by name, each once; Enter finishes.
    if input.takes == curves:
        let names = mesh.find_attribute("cad_curve_name", 4)
        if names < 0 or w.level_index() != curve_level:
            return
        let picked: list[str] = []
        var at = first
        while at >= 0:
            let name = mesh.attribute_text(names, at)
            if name != "" and not (name in picked):
                picked.append(name)
            at = chosen.next(at)
        node.texts[input.slot] = picked.join(";")
        w.network.invalidate(node.id)
        w.pending_changed = true
        w.rebuild()
        return
    if input.takes == curve_or_edge and first >= 0 and w.level_index() == curve_level:
        let names = mesh.find_attribute("cad_curve_name", 4)
        let name = mesh.attribute_text(names, first) if names >= 0 else ""
        if name == "":
            return
        node.texts[input.slot] = f"curve {name}"
        finish(w, node, label)
        return
    if input.takes == point or input.takes == edge or input.takes == curve_or_edge:
        if first < 0 or not w.on_domain(Domain.edge):
            return
        if input.takes == point:
            let at = cad_names.edge_point(mesh, first)
            node.values[input.slot] = at.x
            node.values[input.slot + 1] = at.y
            node.values[input.slot + 2] = at.z
        else:
            let references = mesh.find_attribute("cad_edge_reference", 4)
            let reference = mesh.attribute_text(references, first) if references >= 0 else ""
            if reference == "":
                say(w, "This edge has no name to keep: pick one of a body made inside a CAD node")
                return
            node.texts[input.slot] = f"edge {reference}" if input.takes == curve_or_edge else reference
        finish(w, node, label)
        return
    let expression = chosen.expression(mesh) if chosen.count() > 0 else "!*"
    let takes_bodies = input.takes in [bodies, body] or (node.kind == "Move" and input.slot == cad_modify.first_text and int(node.values[cad_modify.object_slot]) == 0)
    var names = cad_names.model_names(mesh, expression) if takes_bodies else face_names(mesh, chosen)
    if input.takes in [face, body] and names != "":
        names = names.split(";")[0]
    node.texts[input.slot] = names
    w.network.invalidate(node.id)
    w.pending_changed = true
    if input.takes in [face, body] and names != "":
        finish(w, node, label)
        return
    w.rebuild()

## Input `label` of builder node `node` with `words` added (or taken out):
## Square finishes at its fourth boundary, the others at Enter.
pub func add_curve_words(w: Workspace, node: Node, label: str, words: str) -> unit!:
    let input = input_named(node.kind, label) else return
    # One curve (a blend's end): taken, done.
    if input.takes == curve_or_edge:
        node.texts[input.slot] = words
        finish(w, node, label)
        return
    let picked = build_ops.items(node.texts[input.slot])
    if words in picked:
        let kept: list[str] = []
        for item in picked:
            if item != words:
                kept.append(item)
        node.texts[input.slot] = kept.join(";")
    else:
        picked.append(words)
        node.texts[input.slot] = picked.join(";")
    w.network.invalidate(node.id)
    w.selection = none
    w.pending_changed = true
    let count = build_ops.items(node.texts[input.slot]).length
    if node.kind == build_ops.square_verb and count >= 4 or node.kind == blend_ops.tube_verb and count >= 1:
        finish(w, node, label)
        return
    w.rebuild()

## The names of the faces picked, each once, apart by `;`.
func face_names(mesh: Mesh, chosen: Selection) -> str!:
    let column = mesh.find_attribute("cad_face_name", 2)
    if column < 0:
        return ""
    let names: list[str] = []
    var at = chosen.next(-1)
    while at >= 0:
        let name = mesh.attribute_text(column, at)
        if name != "" and not (name in names):
            names.append(name)
        at = chosen.next(at)
    return names.join(";")

## Enter: the picks stand; the next input waiting starts.
pub func accept(w: Workspace, node: Node, label: str) -> unit!:
    finish(w, node, label)

## The pick is made: one undo step, the node shown again; then, as Fusion's dialog moves to its
## next field, the next input the node waits for (its own undo step).
func finish(w: Workspace, node: Node, label: str) -> unit!:
    w.network.invalidate(node.id)
    w.network.selected = node.id
    show(w, node.id)
    w.prompt = none
    w.peeking = false
    w.selection = none
    w.notice = ""
    w.pending_changed = true
    w.commit()
    w.rebuild()
    # The same input left empty (Enter on nothing) waits on the node.
    if let input = next_input(node):
        if input.prompt() != label:
            start(w, node.id, input)
    else:
        w.ask_value = node.kind == "Shell"

func say(w: Workspace, text: str):
    w.notice = text
    w.revision += 1
