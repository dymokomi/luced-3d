## Isoparm (Alias's isoparm pick): at the Curves level a double-click on a
## surface makes the isoparm through the point clicked a curve of the
## model, U or V in the tool bar, selected for the curve tools
## (edit_cad_curves.luc; viewport_tools.luc takes the double-click).
from tool_record import Tool, ToolEntry, Pick
from parameter_rows import Parameter, menu, vector
import pick_kinds
import edit_cad_curves
import cad_cook

pub func entry() -> ToolEntry:
    return ToolEntry(edit_cad_curves.isoparm_verb, edit_cad_curves.isoparm_verb, "isoparm", "Curves", [], [cad_cook.edit_kind], made)

func made() -> Tool:
    return entry().tool("Create", "Curves", "The isoparm through a point double-clicked on a surface, as a curve", [Pick("Point", [-1], kind = pick_kinds.components, slot = pick_kinds.nowhere)],
                        rows(), edit_cad_curves.cook, numbers = [0.0, 0.0, 0.0, 0.0], gesture = "isoparm")

func rows() -> list[Parameter]:
    return [menu("Direction", 0, "U|V", 0.0, "The isoparm along v through the point clicked (U), or along u (V)."),
            vector("Point", 1, [0.0, 0.0, 0.0], "Where the surface was clicked.")]
