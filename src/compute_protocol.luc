## Private versioned worker protocol. Only copied text crosses the Luce heaps;
## graph structure, parameters and edit recipes are immutable request snapshots.
from network import Network, Node
from edit_operations import EditOperation
from three import Vector3, PolygonMesh
from compute_bridge import number, decimal
import ui

pub func escaped(text: str) -> str:
    return text.replace("%", "%25").replace("\n", "%0A").replace("\r", "%0D")

pub func unescaped(text: str) -> str:
    return text.replace("%0A", "\n").replace("%0D", "\r").replace("%25", "%")

pub class Reader:
    let fields: list[str]
    var at: int = 0
    pub func init(self, text: str):
        self.fields = text.split("\n")
    pub func text(self) -> str!:
        if self.at >= self.fields.length:
            error(ui.invalid, "Incomplete compute snapshot")
        let value = unescaped(self.fields[self.at])
        self.at += 1
        return value
    pub func value(self) -> float!:
        return number(self.text())
    pub func integer(self) -> int!:
        return int(self.value())

pub func recipe(node: Node) -> str!:
    let fields = [str(node.id), escaped(node.kind), escaped(node.name), str(node.parent), str(node.output), "1" if node.visible else "0", "1" if node.enabled else "0", str(node.inputs.length)]
    for input in node.inputs:
        fields.append(str(input))
    for value in node.values:
        fields.append(decimal(value))
    for text in node.texts:
        fields.append(escaped(text))
    fields.append(str(node.edits.length))
    for edit in node.edits:
        fields.append(escaped(edit.kind))
        fields.append(decimal(edit.delta.x))
        fields.append(decimal(edit.delta.y))
        fields.append(decimal(edit.delta.z))
        fields.append(decimal(edit.distance))
        fields.append(str(edit.elements.length))
        for element in edit.elements:
            fields.append(str(element))
        fields.append(str(edit.topology))
    return fields.join("\n")

pub func snapshot(graph: Network, mode: int) -> str!:
    let fields = ["1", str(graph.scope), str(graph.display), str(graph.selected), "1" if graph.preview else "0", str(mode), str(graph.nodes.length)]
    for node in graph.nodes:
        fields.append(recipe(node))
        fields.append(str(node.source_revision))
    return fields.join("\n")

pub func read_graph(reader: Reader, previous: Network) -> Network!:
    if reader.integer() != 1:
        error(ui.invalid, "Unknown compute protocol")
    let graph = Network(false)
    graph.scope = reader.integer()
    graph.display = reader.integer()
    graph.selected = reader.integer()
    graph.preview = reader.integer() != 0
    graph.compute_mode = reader.integer()
    let count = reader.integer()
    let changed: list[int] = []
    for at in 0..<count:
        let id = reader.integer()
        let kind = reader.text()
        let node = Node(id, kind, 0.0, 0.0)
        node.name = reader.text()
        node.parent = reader.integer()
        node.output = reader.integer()
        node.visible = reader.integer() != 0
        node.enabled = reader.integer() != 0
        node.inputs = []
        let inputs = reader.integer()
        for port in 0..<inputs:
            node.inputs.append(reader.integer())
        for slot in 0..<node.values.length:
            node.values[slot] = reader.value()
        for slot in 0..<node.texts.length:
            node.texts[slot] = reader.text()
        let edits = reader.integer()
        for index in 0..<edits:
            let operation = reader.text()
            let delta = Vector3(reader.value(), reader.value(), reader.value())
            let distance = reader.value()
            let elements: list[int] = []
            let length = reader.integer()
            for element in 0..<length:
                elements.append(reader.integer())
            let topology = int(reader.text())
            node.edits.append(EditOperation(operation, elements, PolygonMesh.empty(), delta, distance, topology))
        node.source_revision = reader.integer()
        if let old = previous.find(id):
            if recipe(old) == recipe(node) and old.source_revision == node.source_revision:
                node.cache = old.cache
                node.dirty = old.dirty
                node.failure = old.failure
                node.evaluations = old.evaluations
                node.summary = old.summary
                node.group_paths = old.group_paths.copy()
            else:
                changed.append(id)
        else:
            changed.append(id)
        graph.nodes.append(node)
    for old in previous.nodes:
        if graph.find(old.id) == none and old.parent != 0:
            changed.append(old.parent)
    for id in changed:
        graph.invalidate(id)
    return graph
