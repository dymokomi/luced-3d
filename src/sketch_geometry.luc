## Plane geometry on a live sketch for the editor's tools: a curve's ends,
## which side of a line a place is, how far a place is from a curve's
## carrier. (What luce-cad computes, it keeps: picking, snapping, cuts.)
from luce_cad.sketch import CadSketch
from sketch_kinds import line_kind, circle_kind, arc_kind, spline_kind, conic_kind
from luce_std import math

## A curve's start point (-1 for a closed one: a circle, an ellipse).
pub func start_point(sketch: CadSketch, curve: int) -> int:
    let k = sketch.kind(curve)
    if k in [line_kind, spline_kind, conic_kind]:
        return sketch.part(curve, 0)
    return sketch.part(curve, 1) if k == arc_kind else -1

## A curve's end point (-1 for a closed one).
pub func end_point(sketch: CadSketch, curve: int) -> int:
    let k = sketch.kind(curve)
    if k == line_kind or k == conic_kind:
        return sketch.part(curve, 1)
    if k == spline_kind:
        return sketch.part(curve, sketch.part_count(curve) - 1)
    return sketch.part(curve, 2) if k == arc_kind else -1

## The line or arc point `point` is an end of, or -1.
pub func ended_curve(sketch: CadSketch, point: int) -> int:
    if point < 0:
        return -1
    for at in 0..<sketch.entity_count():
        if sketch.kind(at) in [line_kind, arc_kind] and (start_point(sketch, at) == point or end_point(sketch, at) == point):
            return at
    return -1

## Which side of line `line` (`x`, `y`) is: +1 its left, -1 its right (as
## Tangent keeps it).
pub func side_of(sketch: CadSketch, line: int, x: float, y: float) -> float:
    let a = sketch.part(line, 0)
    let b = sketch.part(line, 1)
    let cross = (sketch.x(b) - sketch.x(a)) * (y - sketch.y(a)) - (sketch.y(b) - sketch.y(a)) * (x - sketch.x(a))
    return 1.0 if cross >= 0.0 else -1.0

## Line `line`'s length.
pub func length_of(sketch: CadSketch, line: int) -> float:
    let a = sketch.part(line, 0)
    let b = sketch.part(line, 1)
    return math.hypot(sketch.x(b) - sketch.x(a), sketch.y(b) - sketch.y(a))

## How far (`x`, `y`) is from curve `curve`'s carrier (a line's line, a
## circle's or arc's circle; a free-form curve itself).
pub func carrier_distance(sketch: CadSketch, curve: int, x: float, y: float) -> float:
    let kind = sketch.kind(curve)
    if kind == line_kind:
        let a = sketch.part(curve, 0)
        let b = sketch.part(curve, 1)
        let dx = sketch.x(b) - sketch.x(a)
        let dy = sketch.y(b) - sketch.y(a)
        return math.abs(dx * (y - sketch.y(a)) - dy * (x - sketch.x(a))) / math.max(math.hypot(dx, dy), 1e-300)
    if kind == circle_kind or kind == arc_kind:
        let c = sketch.part(curve, 0)
        return math.abs(math.hypot(x - sketch.x(c), y - sketch.y(c)) - sketch.radius(curve))
    return sketch.distance(curve, x, y)
