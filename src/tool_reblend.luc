## Reblend (Parasolid's; Fusion's Press Pull on a fillet face): the picked
## blends (constant rolling-ball fillets, an imported body's too) given
## another radius, the blends meeting them keeping theirs: deleted, the
## faces healed, and filleted again (edit_cad_faces.luc). An Edit CAD step;
## its radius starts at the first picked blend's.
from tool_record import Tool, ToolEntry, Pick
from parameter_rows import number
from edit_types import face_level, patch_level
import pick_kinds
import cad_cook

pub func entry() -> ToolEntry:
    return ToolEntry("Reblend", "Reblend", "bevel", "Modify", [], [cad_cook.edit_kind], made)

func made() -> Tool:
    let radius = number("Radius", 0, 1.0, 0.0001, 100000.0, 0.1, "The blends' new radius: they are deleted, the faces healed, and filleted again; blends meeting them keep their own.", soft = 10.0)
    radius.length = true
    return entry().tool("Modify", "Blends", "Give fillet faces another radius", [Pick("Blends", [face_level, patch_level], kind = pick_kinds.faces, slot = pick_kinds.nowhere)],
                        [radius], cad_cook.face_step, drag = 0, asks = true, gesture = "reblend")
