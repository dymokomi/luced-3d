## luced-2d's default palette, in the same linear-light colour space.
## Kept local so starting this editor does not change the shared UI or 2D app.
from luce_ui.ui import Theme
from luce_gpu.gpu import Color
from luce_color import transfer

pub func grey(byte: float) -> Color:
    let value = transfer.srgb_decode(byte / 255.0)
    return Color(value, value, value)

pub func accent() -> Color:
    return Color(transfer.srgb_decode(231.0 / 255.0), transfer.srgb_decode(160.0 / 255.0), transfer.srgb_decode(63.0 / 255.0))

## Muted axis colors sit alongside the editor's gray/orange palette.
pub func axis(index: int) -> Color:
    let rgb = [201.0, 99.0, 83.0] if index == 0 else ([137.0, 176.0, 105.0] if index == 1 else [101.0, 151.0, 194.0])
    return Color(transfer.srgb_decode(rgb[0] / 255.0), transfer.srgb_decode(rgb[1] / 255.0), transfer.srgb_decode(rgb[2] / 255.0))

## Warnings: a node that passed its input through, or a group naming nothing.
pub func warning() -> Color:
    return Color(transfer.srgb_decode(226.0 / 255.0), transfer.srgb_decode(198.0 / 255.0), transfer.srgb_decode(70.0 / 255.0))

pub func backdrop() -> Color:
    return grey(26.0)
pub func tab_strip() -> Color:
    return grey(38.0)
pub func surface() -> Color:
    return grey(50.0)
pub func surface_raised() -> Color:
    return grey(46.0)
pub func border() -> Color:
    return grey(58.0)
pub func text() -> Color:
    return grey(217.0)
pub func text_muted() -> Color:
    return grey(140.0)

pub func editor_theme() -> Theme!:
    var theme = Theme()
    theme.background = backdrop()
    theme.panel = surface()
    theme.gutter = tab_strip()
    theme.foreground = text()
    theme.muted = text_muted()
    theme.selection = accent()
    theme.accent = accent()
    theme.button = grey(41.0)
    theme.button_hover = grey(58.0)
    theme.pressed = grey(72.0)
    theme.menu = surface_raised()
    theme.menu_hover = grey(64.0)
    theme.strip = tab_strip()
    theme.sunken = grey(41.0)
    theme.raised = surface_raised()
    theme.accent_text = grey(0.0)
    theme.menu_selection = accent()
    theme.border = border()
    theme.active_border = grey(150.0)
    theme.shadow_offset = 0.0
    theme.shadow_opacity = 0.0
    theme.control_radius = 5.0
    return theme
