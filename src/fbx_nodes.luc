## FBX in the node graph (luce-fbx): the File node reading .fbx with its FBX
## rows (node_catalog.fbx_fields).
from fbx import Fbx
from geometry_data import GeometryData
from usd_nodes import summary

## Whether `path` names an FBX file.
pub func is_fbx_path(path: str) -> bool:
    return path.trim().lower().ends_with(".fbx")

## A File node's FBX file at the options its FBX rows hold (value slots 1-4):
## 1 import (0 merge into one mesh, 1 keep hierarchy), 2 instancing,
## 3 convert to Y-up meters, 4 import normals.
pub func load_fbx(path: str, values: list[float]) -> GeometryData!:
    let geometry = Fbx.load(path, keep_hierarchy = values[1] == 1.0, instancing = values[2] != 0.0, convert_units = values[3] != 0.0, normals = values[4] != 0.0)
    let data = GeometryData(geometry = geometry)
    data.warning = summary(Fbx.warnings())
    return data
