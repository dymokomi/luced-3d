## UI-side scheduling: coalesce requests, ignore stale results, poll progress.
from compute_bridge import ComputeService
from compute_worker import compute_factory
from compute_protocol import snapshot, Reader
from network import Network

pub class ComputeSession:
    pub let service: ComputeService
    pub var generation: int = 0
    pub var applied: int = 0
    var sequence: int = -1
    pub var busy: bool = false

    pub func init(self) -> unit!:
        self.service = ComputeService(compute_factory)

    pub func submit(self, graph: Network, mode: int) -> unit!:
        self.generation += 1
        self.busy = true
        for node in graph.nodes:
            node.computing = node.dirty
            node.progress = 0.0
            node.phase = "Queued" if node.dirty else ""
        self.service.submit(snapshot(graph, mode), self.generation)

    pub func poll_progress(self, graph: Network) -> bool!:
        let sequence = self.service.sequence()
        if sequence == self.sequence:
            return false
        self.sequence = sequence
        for node in graph.nodes:
            if node.phase != "Queued":
                node.computing = false
        if let node = graph.find(self.service.active_node()):
            node.computing = self.busy
            node.progress = self.service.progress()
            node.phase = self.service.phase()
        return true

    pub func read_report(self, graph: Network) -> str!:
        if self.service.failed():
            self.busy = false
            self.applied = self.generation
            for node in graph.nodes:
                node.computing = false
                node.phase = ""
            return self.service.report()
        let reader = Reader(self.service.report())
        let notice = reader.text()
        let count = reader.integer()
        for at in 0..<count:
            let id = reader.integer()
            let dirty = reader.integer() != 0
            let failure = reader.text()
            let summary = reader.text()
            let evaluations = reader.integer()
            let paths: list[str] = []
            let path_count = reader.integer()
            for index in 0..<path_count: paths.append(reader.text())
            if let node = graph.find(id):
                node.dirty = dirty
                node.failure = failure
                node.summary = summary
                node.evaluations = evaluations
                node.group_paths = paths
                node.computing = false
                node.phase = ""
                node.cache = none
        self.busy = false
        self.applied = self.generation
        return notice

    pub func close(self):
        self.service.close()
