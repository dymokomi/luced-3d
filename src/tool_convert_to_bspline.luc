## Convert to B-spline: a face's analytic surface (a plane, a cylinder…)
## made the NURBS surface it is, its CVs then free to move.
## An Edit CAD step on the surface of the first CV or face picked
## (edit_cad_nets.luc).
from tool_record import Tool, ToolEntry, Pick
from parameter_rows import Parameter
from edit_types import face_level, patch_level
import pick_kinds
import edit_cad_nets
import cad_cook

pub func entry() -> ToolEntry:
    return ToolEntry(edit_cad_nets.convert_verb, edit_cad_nets.convert_verb, "shaded-wireframe", "Modify", [], [cad_cook.edit_kind], made)

func made() -> Tool:
    let none_shown: list[Parameter] = []
    return entry().tool("Modify", "Surface Structure", "Make a face's analytic surface a B-spline surface", [Pick("Surface", [face_level, patch_level], kind = pick_kinds.components, slot = pick_kinds.nowhere)],
                        none_shown, edit_cad_nets.cook, numbers = [0.0])
