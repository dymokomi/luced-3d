## Project in the Sketch editor (Fusion's Project): the input body's edges
## cast onto the sketch plane while Project is the tool. The cast is made
## by the cook, off the UI thread with the compute worker (the workspace's
## `shadows`, sketch_node.shadows_text), and read here once per cast. A
## click brings the edge under the cursor in, fixed and linked, so it
## follows the body; with curves to re-link (lost projections chosen for
## Re-link) it points them at that edge instead.
from luce_cad.sketch import CadSketch, CadShadows
from workspace import Workspace

pub class SketchProjecting:
    ## The cast as read, and the Sketch stamp it was read for.
    var shadows: CadShadows? = none
    var read_for: int = 0
    ## Lost curves to link to the next edge clicked (Re-link).
    pub var relinking: list[int]

    pub func init(self):
        self.relinking = []

    ## The input body's edges of Sketch node `node` as cast for its current
    ## stamp; none while it cooks, or without a body.
    pub func projection(self, w: Workspace, node: int) -> CadShadows?!:
        let found = w.network.find(node) else return none
        if w.shadows == "" or w.shadows_stamp != found.stamp:
            return none
        if self.read_for != w.shadows_stamp or self.shadows == none:
            self.shadows = CadShadows.parse(w.shadows)
            self.read_for = w.shadows_stamp
        return self.shadows

    ## Bring the edge nearest (`x`, `y`) within `reach` into `sketch` (or
    ## re-link the chosen lost curves to it); what to say when nothing could
    ## be ("": it was, or no edge is there), and whether one was.
    pub func project_at(self, w: Workspace, node: int, sketch: CadSketch, x: float, y: float, reach: float) -> (bool, str)!:
        let found = self.projection(w, node)
        let cast = found else return (false, "Project casts the edges of the Sketch's input body: connect a body to it (or wait for it to cook)")
        let edge = cast.nearest(x, y, reach)
        if edge < 0:
            return (false, "")
        var failed = ""
        if self.relinking.length > 0:
            for curve in self.relinking:
                if curve < sketch.entity_count():
                    sketch.link_to(curve, cast.reference(edge)) catch failure:
                        failed = failure.message
            self.relinking = []
        else:
            _ = sketch.project_shadow(cast, edge) catch failure:
                failed = failure.message
                recover -1
        if failed != "":
            return (false, failed)
        _ = sketch.solve()
        return (true, "")
