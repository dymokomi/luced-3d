## Chains of a sketch's curves: curves joined end to end, as far as each
## joint is just two curves meeting (a shape, for Offset and the Shapes
## selection level).
from luce_cad.sketch import CadSketch
from sketch_kinds import point_kind, line_kind, arc_kind, spline_kind, conic_kind

## The curves joined end to end with `curve` (as far as each joint is two
## curves meeting), in order along the chain.
pub func chain_of(sketch: CadSketch, curve: int) -> list[int]:
    let chain = [curve]
    # Forward from the curve's end, then back from its start.
    var tail = end_point(sketch, curve)
    var going = true
    while going:
        going = false
        let next = only_other(sketch, tail, chain)
        if next >= 0:
            chain.append(next)
            tail = end_point(sketch, next) if start_point(sketch, next) == tail else start_point(sketch, next)
            going = true
    var head = start_point(sketch, curve)
    going = true
    while going:
        going = false
        let previous = only_other(sketch, head, chain)
        if previous >= 0:
            chain.insert(0, previous)
            head = start_point(sketch, previous) if end_point(sketch, previous) == head else end_point(sketch, previous)
            going = true
    return chain

## The one curve besides those in `chain` at point `point`, or -1 (none,
## or a branch).
func only_other(sketch: CadSketch, point: int, chain: list[int]) -> int:
    if point < 0:
        return -1
    var found = -1
    for at in 0..<sketch.entity_count():
        if sketch.kind(at) == point_kind or at in chain:
            continue
        if start_point(sketch, at) == point or end_point(sketch, at) == point:
            if found >= 0:
                return -1
            found = at
    return found

## A curve's start point (-1 for a closed one: a circle, an ellipse).
func start_point(sketch: CadSketch, curve: int) -> int:
    let k = sketch.kind(curve)
    if k in [line_kind, spline_kind, conic_kind]:
        return sketch.part(curve, 0)
    return sketch.part(curve, 1) if k == arc_kind else -1

## A curve's end point (-1 for a closed one).
func end_point(sketch: CadSketch, curve: int) -> int:
    let k = sketch.kind(curve)
    if k == line_kind or k == conic_kind:
        return sketch.part(curve, 1)
    if k == spline_kind:
        return sketch.part(curve, sketch.part_count(curve) - 1)
    return sketch.part(curve, 2) if k == arc_kind else -1
