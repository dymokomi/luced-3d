## docs/TOOLS.md, generated from the tool registry: each tool by section and
## family with its node kind, where it runs, what it picks, the row a drag
## sets, its gesture and its rows with their starting values. tools/
## tool_docs.py writes the file; a test fails when it is stale.
from tool_record import Tool
from parameter_rows import Parameter
import tool_registry

## The whole page for `tools`.
pub func markdown(tools: list[Tool]) -> str:
    var text = "# Tools\n\nGenerated from the tool registry (`src/tool_registry.luc`) by `tools/tool_docs.py`; do not edit\nby hand. A test fails when this page is stale.\n\n"
    text += "Every tool is declared once. Its node, its Edit step, the tool bar, the Create, Modify and Select\nmenus, the A/S/D marking menus, the right-click menu, Repeat, its prompt, its icon and this page\nall come from that declaration (docs/research/POLY-MODELING.md §3). The mesh tools are\nluce-geocore's verbs.\n"
    for section in ["Create", "Modify", "Select"]:
        let families = families_in(tools, section)
        if families.length == 0:
            continue
        text += f"\n## {section}\n"
        for family in families:
            text += f"\n### {family}\n"
            for tool in tools:
                if tool.section == section and tool.family == family:
                    text += entry(tool)
    return text

## The families of `section`, in the menus' order.
func families_in(tools: list[Tool], section: str) -> list[str]:
    let found: list[str] = []
    for tool in tools:
        if tool.section == section and not (tool.family in found):
            found.append(tool.family)
    let result: list[str] = []
    for rank in 0..<tool_registry.family_order().length + 1:
        for family in found:
            if tool_registry.family_rank(family) == rank:
                result.append(family)
    return result

## One tool: its heading, what it does, where it runs and its rows.
func entry(tool: Tool) -> str:
    var text = f"\n#### {tool.label}\n\n{tool.doc}.\n\n"
    let named = level_words(tool)
    text += f"- Node `{tool.name}` in {contexts(tool).join(" and ")}; a step of {tool.kinds.join(", ")}.\n"
    text += f"- Works on {named}" + (", or everything when nothing is selected" if tool.whole else "") + ".\n"
    if tool.first_pick().prompt != "":
        text += f"- With nothing selected: \"{tool.first_pick().prompt}\".\n"
    if tool.gesture != "":
        text += f"- Gesture: {gesture_text(tool.gesture)}.\n"
    if tool.drag >= 0 and tool.drag < tool.rows.length:
        text += f"- A drag in the viewport after it runs sets {tool.rows[tool.drag].name}.\n"
    let rows = valued(tool.rows)
    if rows.length == 0:
        return text
    text += "\n| Row | Starts at | On the tool bar | What it does |\n| --- | --- | --- | --- |\n"
    for row in rows:
        text += f"| {row.name} | {starting(row)} | {"yes" if row.in_steps else "no"} | {row.doc} |\n"
    return text

func valued(rows: list[Parameter]) -> list[Parameter]:
    let result: list[Parameter] = []
    for row in rows:
        if row.valued():
            result.append(row)
    return result

## The levels its first pick takes, in words ("edges or faces").
func level_words(tool: Tool) -> str:
    return tool.levels_text(["Objects", "Points", "Edges", "Faces"])

func contexts(tool: Tool) -> list[str]:
    let result: list[str] = []
    for context in tool.contexts:
        result.append("Geo" if context == "geometry" else context)
    return result

func gesture_text(gesture: str) -> str:
    if gesture == "stroke":
        return "a stroke dragged across the model"
    if gesture == "place":
        return "clicks place its corners when nothing is selected; Enter finishes"
    return gesture

## A row's starting value as its pane shows it.
func starting(row: Parameter) -> str:
    if row.kind == "toggle":
        return "on" if row.initial != 0.0 else "off"
    if row.kind == "menu":
        let items = row.items.split("|")
        let at = int(row.initial)
        return items[at] if at >= 0 and at < items.length else str(row.initial)
    if row.kind == "vector":
        let parts = [number_text(row, row.initial)]
        for value in row.rest:
            parts.append(number_text(row, value))
        return parts.join(", ")
    return number_text(row, row.initial)

func number_text(row: Parameter, value: float) -> str:
    return str(int(value)) if row.integer else str(value)
