## Remove (Fusion 360's): whole bodies taken away, recorded as their own
## step (edit_cad_faces.luc). The node keeps its bodies by name.
from tool_record import Tool, ToolEntry, Pick, Invocation
from geometry_data import GeometryData
from parameter_rows import Parameter
from edit_types import object_level
import pick_kinds
import cad_cook

pub func entry() -> ToolEntry:
    return ToolEntry("Remove", "Remove", "trash", "Modify", [cad_cook.context], [cad_cook.edit_kind], made)

func made() -> Tool:
    let none_shown: list[Parameter] = []
    return entry().tool("Modify", "Bodies", "Take whole bodies away", picks(), none_shown, cook, numbers = [0.0], waits = waits)

func picks() -> list[Pick]:
    return [Pick("Bodies", [object_level], kind = pick_kinds.bodies, slot = 0, doc = "The bodies removed.")]

func waits(values: list[float], texts: list[str], wired: bool) -> str:
    return "Pick the bodies to remove" if texts[0].trim() == "" else ""

func cook(call: Invocation, data: GeometryData, tag: str) -> GeometryData!:
    if not call.node:
        return cad_cook.face_step(call, data, tag)
    let waiting = waits(call.numbers, call.texts, false)
    if waiting != "":
        return data.passed(waiting)
    let mesh = cad_cook.node_mesh(data, call.verb)
    return cad_cook.node_face_step(call, "Remove", data, mesh, cad_cook.picked(call, mesh, 0, true), ["", ""], 8, tag)
