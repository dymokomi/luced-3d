from luce_ui.ui import Widget, Layout, Constraints, Size, Event, Painter, SceneView
from luce_3d.graphics import WireRenderer, Vector3, Renderer
from luce_3d import graphics as three
from luce_gpu.gpu import RenderTarget, Rect
from luce_window.input import EventKind, Key, ScrollUnit
from workspace import Workspace
from viewport_tools import ViewportTools, view_buttons_width
from actions import Actions
import theme
import time
from shading_menu import mode_icon
import modeling_commands
import placing_commands

pub class SceneViewport: Widget:
    let view: SceneView
    let workspace: Workspace
    pub let tools: ViewportTools
    var dragging: bool = false
    var navigation_button: int = 0
    var pending_right: bool = false
    var last_x: float = 0.0
    var last_y: float = 0.0
    var mode_press: int = -1
    pub var on_shading: func(bool) -> unit!? = none
    ## Tab: the node menu, at the pointer.
    pub var on_search: func() -> unit!? = none
    pub var pointer_x: float = 100.0
    pub var pointer_y: float = 100.0

    pub func poll_hold(self) -> unit!:
        if self.mode_press >= 0 and time.now() - self.mode_press >= 350000000:
            self.mode_press = -1
            if let open = self.on_shading:
                open(true)

    pub func init(self, workspace: Workspace, actions: Actions) -> unit!:
        self.workspace = workspace
        self.tools = ViewportTools(workspace, actions)
        self.view = SceneView(workspace.scene, workspace.view.camera, Renderer(true))
        self.tools.renderer = self.view.renderer()
        self.view.layout().set_interactive(true)
        self.view.layout().set_focusable(true)
        self.view.layout().set_accepts_tab(true)

    pub func layout(self) -> Layout:
        return self.view.layout()

    pub func measure(self, available: Constraints) -> Size!:
        return self.view.measure(available)

    pub func draw(self, target: RenderTarget) -> unit!:
        let size = target.size()
        let painter = Painter(target)
        painter.rectangle(Rect(0.0, 0.0, size.width, size.height), theme.backdrop())
        painter.close()
        let w = self.workspace
        let renderer = self.view.renderer()
        # Components are shown while editing, prompting, or with a selection.
        let editing = w.editing() or w.prompt != none or w.selected_count() > 0
        let wired = w.view.display_mode in [0, 1, 4]
        renderer.set_flat(w.view.display_mode in [1, 2])
        renderer.set_shading(2 if w.view.display_mode == 7 else (3 if w.view.display_mode == 8 else (6 if w.view.display_mode == 9 else 0)), float(w.view.zebra_stripes), w.view.zebra_duty,
                             self.zebra_axis(), w.view.zebra_planar, w.view.zebra_stripes_only)
        renderer.set_curvature(w.view.curvature_kind, w.view.curvature_range)
        # Selected faces are tinted in the surface pass: one bit per face.
        let accent = theme.accent()
        let tinted = w.geometry != none and w.selection != none and w.domain() == 2
        if tinted:
            renderer.set_selected_faces(w.geometry else trap("geometry"), w.selection else trap("selection"), three.Color(accent.red, accent.green, accent.blue), 0.45)
        else:
            renderer.clear_face_selection()
        # Polygon wires come from each mesh's GPU arrays; Edit mode keeps them
        # on, but for a CAD body, whose B-rep edges are what is picked.
        let polygons = editing and not w.picking_brep()
        let wire_color = theme.grey(90.0) if polygons else (theme.grey(175.0) if w.view.display_mode == 0 else theme.grey(55.0))
        renderer.set_edges(1.0 if wired or polygons else 0.0, wire_color, w.view.display_mode != 0)
        renderer.set_wire_overlay(1.0 if wired or polygons or w.batches.patch_batch != none else 0.0)
        self.view.draw(target)
        if wired:
            if let batch = w.batches.wire_batch:
                batch.draw(w.view.camera, target, theme.grey(175.0) if w.view.display_mode == 0 else theme.grey(55.0))
        else:
            if let batch = w.batches.patch_batch:
                batch.draw(w.view.camera, target, theme.grey(55.0))
        # Curves draw in every mode, over their dimmer control hulls.
        if w.view.hulls_visible:
            for batch in w.batches.hull_batches:
                batch.draw(w.view.camera, target, theme.grey(110.0))
        for batch in w.batches.curve_batches:
            batch.draw(w.view.camera, target, theme.grey(225.0), 1.5)
        if w.view.normals_visible:
            if let batch = w.batches.normal_batch:
                batch.draw(w.view.camera, target, theme.accent())
        if self.workspace.view.grid_visible:
            for category in 0..<3:
                let lines: list[Vector3] = []
                for index in -10..<11:
                    if (2 if index == 0 else (1 if index % 5 == 0 else 0)) != category:
                        continue
                    let at = float(index)
                    lines.append(Vector3(-10.0, -0.008, at))
                    lines.append(Vector3(10.0, -0.008, at))
                    lines.append(Vector3(at, -0.008, -10.0))
                    lines.append(Vector3(at, -0.008, 10.0))
                WireRenderer.lines(lines, self.workspace.view.camera, target, theme.accent() if category == 2 else theme.grey(80.0 if category == 1 else 58.0), 1.0, 0.0)
        let overlay = Painter(target)
        let context = self.workspace.network.context()
        let inside = "CAD / LOCAL" if context == "cad" else ("MATERIAL / LOCAL" if context == "shading" else "GROUP / LOCAL")
        overlay.text("PREVIEW" if self.workspace.network.preview else (inside if self.workspace.network.scope >= 0 else "PERSPECTIVE"), 16.0, 14.0, theme.text_muted())
        overlay.text("Y up  /  grid: 1 unit", 16.0, size.height - 28.0, theme.text_muted())
        self.tools.draw(overlay, size.width, size.height)
        # The shading button, left of the view buttons.
        let shading = size.width - view_buttons_width() - 38.0
        overlay.rounded_rectangle(Rect(shading, 8.0, 32.0, 30.0), theme.surface(), 4.0)
        mode_icon(overlay, w.view.display_mode, shading + 4.0, 11.0)
        overlay.rectangle(Rect(shading + 28.0, 34.0, 3.0, 3.0), theme.accent())
        overlay.close()

    ## The world axis zebra and isophote stripes run around: X, Y, Z or the view's up.
    func zebra_axis(self) -> Vector3!:
        let axis = self.workspace.view.zebra_axis
        if axis == 3:
            return self.workspace.view.camera.projection(1.0).up
        return Vector3(1.0 if axis == 0 else 0.0, 1.0 if axis == 1 else 0.0, 1.0 if axis == 2 else 0.0)

    pub func event(self, event: Event) -> unit!:
        let bounds = self.layout().bounds()
        if event.kind == EventKind.pointer_moved or event.kind == EventKind.pointer_down:
            self.pointer_x = event.x
            self.pointer_y = event.y
        if event.kind == EventKind.key_down and event.key == Key.tab:
            if let search = self.on_search:
                search()
            return
        if event.cancelled or event.kind == EventKind.focus_lost:
            self.mode_press = -1
        # Shift or Cmd held during a tool prompt peeks at its input.
        if event.kind in [EventKind.modifiers_changed, EventKind.key_down, EventKind.key_up, EventKind.pointer_moved, EventKind.pointer_down]:
            modeling_commands.set_peek(self.workspace, event.shift or event.meta)
        elif event.kind == EventKind.focus_lost:
            modeling_commands.set_peek(self.workspace, false)
        if event.kind == EventKind.pointer_down and event.inside and not event.alt and event.x >= bounds.width - view_buttons_width() - 38.0 and event.x <= bounds.width - view_buttons_width() - 6.0 and event.y >= 8.0 and event.y <= 38.0:
            if event.button == 1:
                if let open = self.on_shading:
                    open(false)
            else:
                self.mode_press = time.now()
            return
        if event.kind == EventKind.pointer_up and self.mode_press >= 0:
            self.mode_press = -1
            if let open = self.on_shading:
                open(false)
            return
        if event.cancelled:
            self.dragging = false
            self.pending_right = false
        if self.tools.event(event, bounds.width, bounds.height):
            self.layout().invalidate()
            return
        # luce-ui currently drops modifiers on its special right-press route.
        # Arm only; the first move must confirm Alt before any camera change.
        if event.kind == EventKind.pointer_down and event.inside and event.button == 1:
            self.pending_right = true
            self.last_x = event.x
            self.last_y = event.y
        if event.kind == EventKind.pointer_moved and self.pending_right:
            self.pending_right = false
            if event.alt:
                self.dragging = true
                self.navigation_button = 1
        if event.kind == EventKind.pointer_down and event.inside and event.alt and (event.button == 0 or event.button == 1 or event.button == 2):
            self.dragging = true
            self.navigation_button = event.button
            self.last_x = event.x
            self.last_y = event.y
        elif event.kind == EventKind.pointer_moved and self.dragging:
            let dx = event.x - self.last_x
            let dy = event.y - self.last_y
            if self.navigation_button == 2:
                self.workspace.view.pan(dx, dy, self.layout().bounds().height)
            elif self.navigation_button == 1:
                self.workspace.view.zoom((dx - dy) * 0.1)
            else:
                self.workspace.view.orbit(dx, dy)
            self.last_x = event.x
            self.last_y = event.y
        elif event.kind == EventKind.pointer_up or event.kind == EventKind.focus_lost or event.kind == EventKind.overflow:
            self.dragging = false
            self.pending_right = false
        elif event.kind == EventKind.scroll:
            self.workspace.view.zoom(event.scroll_y * (0.05 if event.scroll_unit == ScrollUnit.points else 1.0))
        elif event.kind == EventKind.magnify:
            self.workspace.view.zoom(event.scroll_y * 12.0)
        elif event.kind == EventKind.key_down:
            if event.key == Key.escape:
                self.dragging = false
                if self.workspace.placing != none: self.workspace.cancel_placing()
                elif self.workspace.prompt != none: self.workspace.cancel_prompt()
            elif event.key == Key.enter and self.workspace.placing != none:
                placing_commands.finish_placing(self.workspace)
            elif event.key == Key.enter and self.workspace.prompt != none:
                modeling_commands.accept_prompt(self.workspace)
        # Hover over the same component changes nothing on screen.
        if event.kind == EventKind.pointer_moved and not self.dragging and not self.tools.hover_changed:
            return
        self.layout().invalidate()
