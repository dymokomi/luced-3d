## Skin (Alias's): a loft through sections in order, open or closed, its
## first and last section matched G0 to G3 to the surface they lie on
## (build_ops.luc).
## A node keeps its picks as words (curves by name, edges by their face and
## where they were clicked); an Edit CAD step takes what is picked, in the
## order picked, and waits for more (edit_cad_build.luc).
from tool_record import Tool, ToolEntry, Pick
from edit_types import edge_level, curve_level
import pick_kinds
import build_ops
import edit_cad_build
import cad_cook

pub func entry() -> ToolEntry:
    return ToolEntry(build_ops.skin_verb, build_ops.skin_verb, "bring-forward", "Surfaces", [cad_cook.context], [cad_cook.edit_kind], made)

func made() -> Tool:
    return entry().tool("Modify", "Surface Build", "A loft through sections in order, its ends matched to the surfaces they lie on", picks(), build_ops.rows(build_ops.skin_verb), edit_cad_build.cook,
                        numbers = build_ops.starting(build_ops.skin_verb), waits = waits)

func picks() -> list[Pick]:
    return [Pick("Sections", [curve_level, edge_level], kind = pick_kinds.words, slot = build_ops.curves_text, step = build_ops.curves_text, doc = "The sections in order, curves or edges.")]

func waits(values: list[float], texts: list[str], wired: bool) -> str:
    return build_ops.waits_for(build_ops.skin_verb, texts, build_ops.spined(build_ops.skin_verb, values))
