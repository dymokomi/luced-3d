## Solid Sphere: luce-cad's analytic solid (CadSolids), its faces named for
## the node. A node of a CAD network.
from luce_cad.cad_geometry import CadGeometry
from luce_cad.solids import CadSolids
from luce_cad.modeling import CadModeling
from tool_record import Tool, ToolEntry, Pick, Invocation
from geometry_data import GeometryData
from parameter_rows import Parameter, number
import cad_cook

pub func entry() -> ToolEntry:
    return ToolEntry("Solid Sphere", "Solid Sphere", "sphere", "Create", [cad_cook.context], [], made)

func made() -> Tool:
    let none_picked: list[Pick] = []
    let rows: list[Parameter] = [number("Radius", 0, 10.0, 0.001, 100000.0, 0.5, "Centered on the origin.", soft = 50.0)]
    return entry().tool("Create", "Solids", "A sphere centered on the origin", none_picked, rows, cook)

func cook(call: Invocation, data: GeometryData, tag: str) -> GeometryData!:
    let v = call.numbers
    return GeometryData(geometry = CadGeometry.of_model(CadModeling.tagged(CadSolids.sphere(v[0], tolerances = call.tolerances), tag)))
