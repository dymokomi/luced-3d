## Shrink (Alias's): a trimmed face's surface cut down to just around the
## trimmed region (surface_ops.luc). The node keeps its face by name; an
## Edit CAD step shrinks the one face picked.
from tool_record import Tool, ToolEntry, Pick, Invocation
from geometry_data import GeometryData
from parameter_rows import Parameter
from edit_types import face_level, patch_level
import pick_kinds
import edit_cad_surfaces
import surface_ops
import cad_cook
from luce_ui import ui

pub func entry() -> ToolEntry:
    return ToolEntry(edit_cad_surfaces.shrink_verb, edit_cad_surfaces.shrink_verb, "frame-selection", "Surfaces", [cad_cook.context], [cad_cook.edit_kind], made)

func made() -> Tool:
    let none_shown: list[Parameter] = []
    return entry().tool("Modify", "Surface Edit", "Cut a trimmed face's surface down to its trimmed region", [Pick("Face", [face_level, patch_level], kind = pick_kinds.face, slot = 0, doc = "The face, kept by its name.")],
                        none_shown, cook, numbers = [0.0], waits = waits)

func waits(values: list[float], texts: list[str], wired: bool) -> str:
    return "Pick the face" if texts[0].trim() == "" else ""

func cook(call: Invocation, data: GeometryData, tag: str) -> GeometryData!:
    if call.node:
        let waiting = waits(call.numbers, call.texts, false)
        if waiting != "":
            return data.passed(waiting)
        return surface_ops.shrink(data, call.text(0).trim())
    let faces = edit_cad_surfaces.step_faces(call, data)
    if faces.length > 1:
        error(ui.invalid, f"{call.verb} works on one face: pick one")
    return surface_ops.shrink(data, faces[0])
