## Fusion 360's Modify features from the viewport (the right-click menu, the
## S marking menu and Modify › CAD features): Shell, Move/Copy, Combine,
## Split Body, Split Face, Replace Face, Delete and Remove. In a CAD
## network each makes its node (cad_modify.luc) after the displayed one,
## taking what is selected (faces, or the bodies they are on), then waits
## for what it still needs, input by input (modify_picks.luc), as Fusion's
## dialog opens on its first empty selection field; Shell and Move open
## their value box. In an edited Edit CAD model the same commands are its
## direct modeling steps (edit_cad_commands.luc). Each is one undo step and
## says why when it does not apply.
from luce_ui.ui import Command
from interop import Connection
from luce_geocore.geocore import Domain
from workspace import Workspace
from tools import ToolRun
from edit_steps import insert_after_display
from tool_icons import asset_name
import cad_commands
import cad_modify
import cad_names
import edit_cad_commands
import modify_picks
import node_catalog

## The commands, in Fusion's Modify menu order: (label, node kind, Edit
## CAD's tool).
pub func features() -> list[(str, str, str)]:
    return [("Shell", "Shell", "Shell"), ("Move/Copy", "Move", "Move/Copy"), ("Combine", "Combine", "Combine"),
            ("Split Body", "Split Body", "Split Body"), ("Split Face", "Split Face", "Split Face"), ("Replace Face", "Replace Face", "Replace Face"),
            ("Delete", "Delete Face", "Delete"), ("Remove", "Remove", "Remove")]

pub class ModifyActions:
    let w: Workspace
    ## One command a feature (features' order).
    pub let commands: list[Command]
    let connections: list[Connection]

    pub func init(self, w: Workspace) -> unit!:
        self.w = w
        self.commands = []
        self.connections = []
        for (label, kind, tool) in features():
            let made = kind
            let edited = tool
            let command = Command(label, id = "cad_modify_" + kind.lower().replace(" ", "_"), icon = asset_name(kind))
            self.commands.append(command)
            self.connections.append(command.on_trigger(func () -> unit!:
                w.last_cad_tool = command_id(made)
                w.last_cad_name = edited
                if edit_cad_commands.active(w):
                    edit_cad_commands.tool(w, edited)
                else:
                    modify(w, made)))

    ## Enabled in a CAD network (not while sketching); in Edit CAD where
    ## its tool applies to the level, with something selected.
    pub func refresh(self) -> unit!:
        let w = self.w
        let cad = w.network.context() == "cad" and not w.sketching()
        let model = edit_cad_commands.active(w)
        let all = features()
        for at in 0..<self.commands.length:
            let (_, _, tool) = all[at]
            var enabled = cad
            if cad and model:
                let available = w.tool_available(tool) catch failure:
                    recover false
                enabled = available and w.selected_count() > 0
            self.commands[at].set_enabled(enabled)

    ## The command making node `kind` (or its Edit CAD tool).
    pub func command(self, kind: str) -> Command?:
        let all = features()
        for at in 0..<all.length:
            let (_, made, _) = all[at]
            if made == kind:
                return self.commands[at]
        return none

    pub func close(self):
        for connection in self.connections:
            connection.disconnect()
        self.connections.clear()

## The id of node `kind`'s command (the marking menus' Repeat finds it).
pub func command_id(kind: str) -> str:
    return "cad_modify_" + kind.lower().replace(" ", "_")

## Node `kind` after the displayed node, taking the selection: faces, or
## the bodies they are on; then the first input it still waits for.
pub func modify(w: Workspace, kind: str) -> unit!:
    if w.network.context() != "cad" or w.sketching():
        w.notice = f"{kind}: enter a CAD node first"
        w.revision += 1
        return
    let faces = cad_commands.selected_faces(w)
    let bodies = selected_bodies(w)
    w.perform(kind, func () -> unit!:
        let node = insert_after_display(w, ToolRun(kind, node_catalog.starting_values(kind)))
        if kind in ["Shell", "Split Face", "Replace Face", "Delete Face"]:
            node.texts[cad_modify.first_text] = faces.join(";")
        elif kind == "Move":
            # Faces picked move as faces (Move object: Faces); else bodies.
            node.values[cad_modify.object_slot] = 1.0 if faces.length > 0 else 0.0
            node.texts[cad_modify.first_text] = faces.join(";") if faces.length > 0 else bodies.join(";")
        elif kind == "Combine":
            if bodies.length > 0:
                node.texts[cad_modify.first_text] = bodies[0]
                node.texts[cad_modify.second_text] = bodies[1..].join(";")
        else:
            node.texts[cad_modify.first_text] = bodies.join(";")
        w.network.picked = [node.id]
        w.selection = none
        w.rebuild())
    let made = w.selected() else return
    if made.kind != kind:
        return
    if let input = modify_picks.next_input(made):
        modify_picks.start(w, made.id, input)
    elif kind in ["Shell", "Move"]:
        w.ask_value = true

## The bodies the selection is on, each by one of its faces' names.
func selected_bodies(w: Workspace) -> list[str]!:
    if w.sketching() or w.network.context() != "cad" or not w.selecting() or not w.on_domain(Domain.face):
        return []
    let mesh = w.geometry else return []
    let chosen = w.current_selection() else return []
    if chosen.count() == 0:
        return []
    let names = cad_names.model_names(mesh, chosen.expression(mesh))
    return names.split(";") if names != "" else []
