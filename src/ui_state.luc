## Per-user panel/window/display preferences. Tests and captures opt out by default.
from prism import Document, Value, Encoding
from panels import Panels
import project_values as values
import files
import paths
import ui
import math

pub func settings_path() -> str!:
    return paths.join(paths.join(files.home_directory(), ".luced-3d"), "ui.prisma")

pub class UIState:
    pub var width: int = 1400
    pub var height: int = 900
    pub var warning: str = ""
    var path: str = ""
    var restored: Document? = none
    var written: Document? = none
    var elapsed: float = 0.0
    var writable: bool = true

    pub func init(self, path: str = "") -> unit!:
        self.path = path
        if path == "": return
        let text = files.read_text(path, limit = 65536) catch failure:
            return
        self.read(text) catch failure:
            self.warning = "Could not restore UI layout: " + failure.message
            self.writable = false
            return

    func read(self, text: str) -> unit!:
        let doc = Document.parse(text)
        if doc.type_at("/ui") != "luced3d_ui":
            error(ui.invalid, "Unknown UI settings version")
        let version = values.integer(doc, "/ui", "version", 1, 3)
        self.width = values.integer(doc, "/ui", "width", 800, 8192)
        self.height = values.integer(doc, "/ui", "height", 600, 8192)
        discard(values.integer(doc, "/ui", "shading", 0, 9))
        if version == 3:
            discard(values.integer(doc, "/ui", "curvature", 0, 4))
            discard(values.scalar(doc, "/ui", "curvature_range"))
        if version >= 2:
            discard(values.integer(doc, "/ui", "zebra_stripes", 1, 256))
            discard(values.scalar(doc, "/ui", "zebra_duty"))
            discard(values.integer(doc, "/ui", "zebra_axis", 0, 3))
            discard(values.flag(doc, "/ui", "zebra_planar"))
            discard(values.flag(doc, "/ui", "zebra_stripes_only"))
        discard(values.flag(doc, "/ui", "grid"))
        discard(values.flag(doc, "/ui", "normals"))
        discard(values.text(doc, "/ui", "dock"))
        self.restored = doc

    pub func restore(self, panels: Panels) -> unit!:
        let doc = self.restored else return
        panels.dock_layout.restore(values.text(doc, "/ui", "dock")) catch failure:
            self.warning = "Could not restore panel layout: " + failure.message
            self.writable = false
            return
        let w = panels.workspace
        w.set_display_mode(values.integer(doc, "/ui", "shading", 0, 9))
        let version = values.integer(doc, "/ui", "version", 1, 3)
        if version == 3:
            w.view.curvature_kind = values.integer(doc, "/ui", "curvature", 0, 4)
            w.view.curvature_range = math.max(0.0, values.scalar(doc, "/ui", "curvature_range"))
        if version >= 2:
            w.view.zebra_stripes = values.integer(doc, "/ui", "zebra_stripes", 1, 256)
            w.view.zebra_duty = math.max(0.1, math.min(0.9, values.scalar(doc, "/ui", "zebra_duty")))
            w.view.zebra_axis = values.integer(doc, "/ui", "zebra_axis", 0, 3)
            w.view.zebra_planar = values.flag(doc, "/ui", "zebra_planar")
            w.view.zebra_stripes_only = values.flag(doc, "/ui", "zebra_stripes_only")
        w.view.grid_visible = values.flag(doc, "/ui", "grid")
        w.view.normals_visible = values.flag(doc, "/ui", "normals")
        w.revision += 1
        self.written = doc

    ## The timer avoids per-frame disk reads and writes only changed settings.
    pub func poll(self, panels: Panels, elapsed: float) -> unit!:
        if self.path == "" or not self.writable: return
        self.elapsed += elapsed
        if self.elapsed < 0.5: return
        self.elapsed = 0.0
        self.save(panels)

    pub func save(self, panels: Panels) -> unit!:
        if self.path == "" or not self.writable: return
        let bounds = panels.body.layout().bounds()
        if bounds.width < 800.0 or bounds.height < 600.0: return
        let doc = Document()
        doc.add("/ui", "luced3d_ui")
        doc.set("/ui", "version", Value.integer(3))
        doc.set("/ui", "width", Value.integer(int(bounds.width)))
        doc.set("/ui", "height", Value.integer(int(bounds.height)))
        doc.set("/ui", "dock", Value.text(panels.dock.layout_text()))
        let w = panels.workspace
        doc.set("/ui", "shading", Value.integer(w.view.display_mode))
        doc.set("/ui", "grid", Value.boolean(w.view.grid_visible))
        doc.set("/ui", "normals", Value.boolean(w.view.normals_visible))
        doc.set("/ui", "zebra_stripes", Value.integer(w.view.zebra_stripes))
        doc.set("/ui", "zebra_duty", Value.number(w.view.zebra_duty))
        doc.set("/ui", "zebra_axis", Value.integer(w.view.zebra_axis))
        doc.set("/ui", "zebra_planar", Value.boolean(w.view.zebra_planar))
        doc.set("/ui", "zebra_stripes_only", Value.boolean(w.view.zebra_stripes_only))
        doc.set("/ui", "curvature", Value.integer(w.view.curvature_kind))
        doc.set("/ui", "curvature_range", Value.number(w.view.curvature_range))
        if let previous = self.written:
            if previous.equals(doc): return
        files.ensure_directory(paths.directory(self.path))
        doc.save(self.path, Encoding.text)
        self.written = doc
