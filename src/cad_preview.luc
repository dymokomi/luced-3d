## Cached CAD display data: the models' tessellations (kept in the models),
## their analytic boundaries, normal guides and hulls (control nets, point
## pairs). Never replaces the DAG's analytic payload.
from cad import CadModel
from cad_geometry import CadGeometry
from geocore import Mesh
from three import Vector3, Matrix4

pub class CadPreview:
    pub let meshes: list[Mesh]
    pub let boundaries: list[Vector3]
    pub let normal_guides: list[Vector3]
    pub let hull: list[Vector3]
    pub var failed_faces: int = 0
    pub var first_error: str = ""
    ## Why some faces do not follow their moved control vertices ("": all do).
    pub var cv_warning: str = ""
    pub func init(self, models: list[CadModel], source: CadPreview? = none, matrix: Matrix4? = none, progress: func(float) -> unit!? = none) -> unit!:
        self.meshes = []
        self.boundaries = []
        self.normal_guides = []
        self.hull = []
        if let original = source:
            let placement = matrix else Matrix4()
            self.failed_faces = original.failed_faces
            self.first_error = original.first_error
            self.cv_warning = original.cv_warning
            for mesh in original.meshes:
                self.meshes.append(mesh.placed(placement))
            for point in original.boundaries:
                self.boundaries.append(placement.transform_point(point))
            for point in original.hull:
                self.hull.append(placement.transform_point(point))
            for at in 0..<original.normal_guides.length // 2:
                let start = original.normal_guides[at * 2]
                let delta = original.normal_guides[at * 2 + 1].subtract(start)
                let p = placement.transform_point(start)
                self.normal_guides.append(p)
                self.normal_guides.append(p.add(placement.transform_normal(delta).multiply_scalar(delta.length())))
            return
        # A CAD model shows its tessellation at the Tessellate node's defaults,
        # kept in the model: a Tessellate node with those settings places the
        # same mesh (no copy, no new GPU buffers). A model that cannot be
        # tessellated falls back to independent per-face previews.
        for index in 0..<models.length:
            let model = models[index]
            let report = func (fraction: float) -> unit!:
                if let callback = progress:
                    callback((float(index) + fraction) / float(models.length))
            let mesh = model.tessellate(16, 0.0, report, model.supports_curvature()) catch failure:
                self.failed_faces += model.face_count()
                if self.first_error == "":
                    self.first_error = failure.message
                self.append_previews(model, report)
                continue
            self.meshes.append(mesh)
            if self.cv_warning == "":
                self.cv_warning = tessellation_warning(mesh)
            let lines = model.overlay(mesh)
            for at in 0..<lines.boundary_count():
                self.boundaries.append(lines.boundary(at))
            for at in 0..<lines.guide_count():
                self.normal_guides.append(lines.guide(at))
            for at in 0..<lines.hull_count():
                self.hull.append(lines.hull_point(at))

    ## Independent per-face previews of `model`, in display batches.
    func append_previews(self, model: CadModel, progress: func(float) -> unit!) -> unit!:
        let part = model.preview(progress) catch failure:
            return
        for at in 0..<part.mesh_count():
            self.meshes.append(part.mesh(at))
        for at in 0..<part.boundary_count():
            self.boundaries.append(part.boundary(at))
        for at in 0..<part.guide_count():
            self.normal_guides.append(part.guide(at))

## What a CAD tessellation could not follow: faces left out because their
## moved control vertices folded their trims ("" when there were none).
pub func tessellation_warning(mesh: Mesh) -> str!:
    let dropped = CadGeometry.dropped_faces(mesh)
    if dropped == 0:
        return ""
    return f"{dropped} CAD faces are left out: their moved control vertices fold their trims"
