## Unstitch (Alias's): a body's faces each made a body of its own
## (surface_ops.luc). The node keeps its body by one face's name; an Edit
## CAD step unstitches each body picked.
from tool_record import Tool, ToolEntry, Pick, Invocation
from geometry_data import GeometryData
from parameter_rows import Parameter
from edit_types import object_level
import pick_kinds
import edit_cad_surfaces
import surface_ops
import cad_cook

pub func entry() -> ToolEntry:
    return ToolEntry(edit_cad_surfaces.unstitch_verb, edit_cad_surfaces.unstitch_verb, "split-window-horizontal", "Surfaces", [cad_cook.context], [cad_cook.edit_kind], made)

func made() -> Tool:
    let none_shown: list[Parameter] = []
    return entry().tool("Modify", "Surface Edit", "Make each face of a body a body of its own", [Pick("Body", [object_level], kind = pick_kinds.body, slot = 0, doc = "The body whose faces each become a body.")],
                        none_shown, cook, numbers = [0.0], waits = waits)

func waits(values: list[float], texts: list[str], wired: bool) -> str:
    return "Pick the body to unstitch" if texts[0].trim() == "" else ""

func cook(call: Invocation, data: GeometryData, tag: str) -> GeometryData!:
    if call.node:
        let waiting = waits(call.numbers, call.texts, false)
        if waiting != "":
            return data.passed(waiting)
        return surface_ops.unstitch(data, edit_cad_surfaces.named_bodies(data, call.text(0))[0])
    let bodies = edit_cad_surfaces.step_bodies(call, data)
    var result = data
    # Later bodies first, so earlier indices stay.
    var k = bodies.length - 1
    while k >= 0:
        result = surface_ops.unstitch(result, bodies[k])
        k -= 1
    return result
