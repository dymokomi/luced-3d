## What the marking menus offer (marking_menu.luc), by context:
##   a sketch being edited: its CREATE tools with Extrude and Revolve (its
##     picked profiles) and Finish Sketch (A), MODIFY (S) and CONSTRAINTS
##     (D);
##   an Edit node: its primitives and drawing tools (A) and its tools (S),
##     steps inside it; Edit Mesh's S is Repeat, then the registry's Modify
##     tools the selection level takes, by family (tool_menus.luc);
##     Edit CAD's A leads with Create Sketch (on the selected face, or an
##     origin plane) and Extrude face, then its curve drawing tools; its S
##     with Press Pull, then the tools the level takes (Blend Curve,
##     Attach… at Curves);
##   inside a CAD node: both lead with Repeat and the CAD tool used last
##     (Fusion's marking menu puts Repeat first); sketches, extrusions and
##     solids (A, Sketch on face and Extrude face first with a face
##     selected), features (S: Press Pull on what is selected, Offset Face
##     of selected faces, Fillet and Chamfer of selected edges);
##   elsewhere: primitives, lights, containers and Edit nodes (A), and the
##   modeling tools on the displayed mesh's selection at its level, each a
##   new node (S, Repeat first);
##   D outside a sketch: Select, the Select tools for the level and the
##   selection commands (select_items).
## Node entries add the node after the selected one (`add`).
from marking_menu import MarkItem
from workspace import Workspace
from actions import Actions
from sketch_editor import SketchEditor
from tool_icons import asset_name
from luce_ui.ui import Command
import sketch_tools
from sketch_tools import SketchTool
import cad_nodes
import cad_commands
import edit_cad_commands
import sketch_node
import cad_check
import tool_menus

## Create (A).
pub func create_items(w: Workspace, actions: Actions, add: func(str) -> unit!, sketch: SketchEditor) -> list[MarkItem]:
    if w.sketching():
        return sketch_items(sketch, 0) + command_items([actions.extrude_profiles, actions.revolve_profiles, actions.finish_sketch])
    if edit_cad_commands.active(w):
        # Edit CAD: sketches first (Sketch on face with a face selected),
        # then its primitives.
        let model = actions.model
        let first = command_items([actions.sketch_on_face]) if actions.sketch_on_face.is_enabled() else command_items([model.planes[1]])
        let sketching = MarkItem("Create Sketch", first[0].icon, true, first[0].run, variants = command_items([actions.sketch_on_face] + model.planes))
        let rest = command_items([actions.extrude_face]) if actions.extrude_face.is_enabled() else no_items()
        return model_repeat(w, actions, add) + [sketching] + rest + command_items(actions.draw_commands()) + command_items(actions.create_commands())
    if w.editing():
        return command_items(actions.create_commands() + actions.draw_commands())
    let context = w.network.context()
    if context == "cad":
        let items = node_items([sketch_node.kind_name, "Extrude", "Revolve"] + cad_nodes.solid_kinds(), add)
        if actions.sketch_on_face.is_enabled():
            return repeat_items(w, actions, add) + command_items([actions.sketch_on_face, actions.extrude_face]) + items
        return repeat_items(w, actions, add) + items
    if context == "shading":
        return no_items()
    return node_items(["Cube", "Sphere", "Cylinder", "Cone", "Torus", "Grid", "Light", "Camera", "Group", "Null", "Code", "CAD", "Edit Mesh", "Edit SDF", "File"], add)

## Modify (S).
pub func modify_items(w: Workspace, actions: Actions, add: func(str) -> unit!, sketch: SketchEditor) -> list[MarkItem]:
    if w.sketching():
        return sketch_items(sketch, 1)
    if edit_cad_commands.active(w):
        # Edit CAD: Press Pull on what is selected, then the model's tools
        # the level takes.
        let pull = command_items([actions.press_pull]) if actions.press_pull.is_enabled() else no_items()
        let offered: list[Command] = []
        let drawing = w.strip_kind().draw_tools
        for command in actions.modify_commands():
            let available = w.tool_available(command.text()) catch failure:
                recover false
            if available and not (command.text() in drawing):
                offered.append(command)
        return model_repeat(w, actions, add) + pull + command_items(offered)
    if w.editing():
        return command_items(tools_at_level(w, actions))
    let context = w.network.context()
    if context == "cad":
        let rest = node_items(["Mirror Body", "Pattern", "Transform", "Edit CAD", cad_check.kind_name], add)
        # Selected edges go to the blends; without, they are added bare.
        let blends = command_items([actions.fillet_edges, actions.chamfer_edges]) if actions.fillet_edges.is_enabled() else node_items(["Fillet", "Chamfer"], add)
        let faces = command_items([actions.offset_face]) if actions.offset_face.is_enabled() else no_items()
        let pull = command_items([actions.press_pull]) if actions.press_pull.is_enabled() else no_items()
        let modify: list[Command] = []
        for command in actions.cad_modify.commands:
            if command.is_enabled():
                modify.append(command)
        # Alias's surface tools: on picked faces those for faces, else all.
        let on_faces = cad_commands.selected_faces(w) catch failure:
            recover []
        let surfaces = actions.surfaces.on_faces() if on_faces.length > 0 else actions.surfaces.commands
        return repeat_items(w, actions, add) + pull + blends + faces + command_items(modify) + command_items(surfaces) + rest
    if context == "shading":
        return no_items()
    return command_items(tools_at_level(w, actions)) + node_items(["Transform", "Mirror", "CopyTransform"], add)

## Select (D, outside a sketch): the Select tools at the level, then the
## selection commands.
pub func select_items(w: Workspace, actions: Actions) -> list[MarkItem]:
    return command_items(tool_menus.select_commands(w, actions))

## The viewport kind's tools for S: Repeat and the registry's Modify tools
## the level takes (Edit Mesh, Geo), else every tool of the kind.
func tools_at_level(w: Workspace, actions: Actions) -> list[Command]:
    if not tool_menus.from_registry(w):
        return actions.modify_commands()
    return tool_menus.repeat(w, actions) + tool_menus.flat(tool_menus.families(w, actions, "Modify", w.level_index()))

## Repeat the CAD tool used last (none yet: no item), under the repeat
## icon (its name shows on hover): a node kind is added again; a command is
## triggered again when it applies to what is selected now, else its node
## is added bare, waiting for its input, as Fusion's Repeat opens the
## command with nothing picked.
func repeat_items(w: Workspace, actions: Actions, add: func(str) -> unit!) -> list[MarkItem]:
    let result = no_items()
    let id = w.last_cad_tool
    if id == "":
        return result
    let label = f"Repeat {w.last_cad_name}"
    if id.starts_with("add_"):
        let kind = id[4..]
        result.append(MarkItem(label, "repeat", true, func () -> unit!: add(kind)))
        return result
    let kinds = {"fillet_edges": "Fillet", "chamfer_edges": "Chamfer", "extrude_profiles": "Extrude", "extrude_face": "Extrude", "press_pull": "Extrude", "revolve_profiles": "Revolve", "offset_face": "Offset Face", "sketch_on_face": sketch_node.kind_name}
    for command in actions.all:
        if command.id() == id:
            let chosen = command
            let bare = kinds[id] else ""
            result.append(MarkItem(label, "repeat", true, func () -> unit!:
                if chosen.is_enabled() or bare == "":
                    chosen.trigger()
                else:
                    add(bare)))
    return result

## Repeat in an Edit CAD model: the last tool or command (a node added in
## the network is no step, so it is not offered here).
func model_repeat(w: Workspace, actions: Actions, add: func(str) -> unit!) -> list[MarkItem]:
    if w.last_cad_tool.starts_with("add_"):
        return no_items()
    return repeat_items(w, actions, add)

## Constraints (D, in a sketch).
pub func constraint_items(sketch: SketchEditor) -> list[MarkItem]:
    return sketch_items(sketch, 2)

## A sketch menu's tools: a tool with variants is one family item.
func sketch_items(sketch: SketchEditor, menu: int) -> list[MarkItem]:
    let result = no_items()
    for tool in sketch_tools.tools(menu):
        if tool.variants.length == 0:
            result.append(sketch_item(sketch, tool))
            continue
        let variants = no_items()
        for variant in tool.variants:
            variants.append(sketch_item(sketch, variant))
        let first = variants[0]
        result.append(MarkItem(tool.name, first.icon, tool.ready, first.run, variants = variants))
    return result

func sketch_item(sketch: SketchEditor, tool: SketchTool) -> MarkItem:
    let name = tool.name
    return MarkItem(name, tool.icon, tool.ready, func () -> unit!: sketch.choose(name))

func command_items(commands: list[Command]) -> list[MarkItem]:
    let result = no_items()
    for command in commands:
        let chosen = command
        let icon = command.icon() if command.icon() != "" else asset_name(command.text())
        result.append(MarkItem(command.text(), icon, command.is_enabled(), func () -> unit!: chosen.trigger()))
    return result

func node_items(kinds: list[str], add: func(str) -> unit!) -> list[MarkItem]:
    let result = no_items()
    for kind in kinds:
        let chosen = kind
        result.append(MarkItem(kind, asset_name(kind), true, func () -> unit!: add(chosen)))
    return result

func no_items() -> list[MarkItem]:
    let result: list[MarkItem] = []
    return result
