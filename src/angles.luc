## Angles: the scene keeps degrees on node parameters (as artists type
## them) and radians in sketches and maths; these convert.
from luce_std import math

## Degrees `value` in radians.
pub func radians(value: float) -> float:
    return value * math.pi / 180.0

## Radians `value` in degrees.
pub func degrees(value: float) -> float:
    return value * 180.0 / math.pi
