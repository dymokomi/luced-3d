## A tool waiting for components (or a reselection): the node that takes the
## group and the node whose geometry is shown for picking, and what the
## viewport says while it waits (hint).
pub class ToolPrompt:
    pub let node: int
    pub let input: int
    pub let label: str
    pub let reselect: bool

    pub func init(self, node: int, input: int, label: str, reselect: bool):
        self.node = node
        self.input = input
        self.label = label
        self.reselect = reselect

## The domain prompt `label` picks on, as Fusion's selection filter for a
## command's input: only that kind lights under the pointer and is taken,
## whatever the level (2 faces, 4 edges, -2 whole bodies; -1: the level's own, for Tool →
## Select and Reselect, and profiles, which Pick profiles takes itself).
## Pick axis takes edges of the body; its sketch lines are picked apart
## (axis_pick.luc).
pub func domain(label: str) -> int:
    if label in ["Pick face", "Pick object", "Pick side 2 object", "Pick start object", "Pick center face", "Pick faces", "Pick other faces", "Pick target faces", "Pick splitting face", "Pick extent face"]:
        return 2
    if label in ["Pick edges", "Pick axis", "Pick revolve axis", "Pick rotate axis", "Pick from point", "Pick to point", "Pick pivot"]:
        return 4
    if label in ["Pick bodies", "Pick body", "Pick target body", "Pick tool bodies"]:
        return -2
    return -1

## What the viewport says while prompt `label` waits.
pub func hint(label: str) -> str:
    if label == "Pick face":
        return "Pick face: click the flat face to sketch on, Esc to cancel"
    if label in ["Pick object", "Pick side 2 object"]:
        return f"{label}: click the face to run to, Esc to cancel"
    if label == "Pick start object":
        return "Pick start object: click the face to start from, Esc to cancel"
    if label == "Pick center face":
        return "Pick center face: click the face to round away whole, Esc to cancel"
    if label == "Pick bodies":
        return "Pick bodies: select the bodies to act on (Shift adds), Enter to finish, Esc to cancel"
    if label == "Pick axis":
        return "Pick axis: click a sketch line or a straight or round edge, Esc to cancel"
    if label in ["Pick faces", "Pick other faces"]:
        return f"{label}: select faces (Shift adds), Enter to finish, Esc to cancel"
    # Edit CAD's steps waiting (edit_cad_picks.luc).
    if label == "Pick tool bodies":
        return "Pick tool bodies: click the bodies to combine with the target (Shift adds), Enter to finish, Esc to cancel"
    if label == "Pick splitting face":
        return "Pick splitting face: click the face to split with, or choose an origin plane in the tool bar and press Enter; Esc to cancel"
    if label == "Pick revolve axis":
        return "Pick revolve axis: click a sketch line or a straight or round edge, or choose an origin axis in the tool bar and press Enter; Esc to cancel"
    if label == "Pick extent face":
        return "Pick extent face: click the face to extrude to, Esc to cancel"
    # The Modify feature nodes' inputs (modify_picks.luc).
    if label in ["Pick body", "Pick target body"]:
        return f"{label}: click the body; Esc to cancel"
    if label == "Pick objects":
        return "Pick objects: click the bodies or faces to move (Shift adds), then Enter; Esc to cancel"
    if label == "Pick target faces":
        return "Pick target faces: click the faces to move the faces onto (Shift adds), then Enter; Esc to cancel"
    if label == "Pick rotate axis":
        return "Pick rotate axis: click the edge to turn about; Esc to cancel"
    if label in ["Pick from point", "Pick to point", "Pick pivot"]:
        return f"{label}: click near a corner or an edge's end (a round edge: its middle); Esc to cancel"
    if label == "Pick profiles":
        return "Pick profiles: click regions to take or leave out, Enter to finish, Esc to cancel"
    return f"{label}: select components (Shift adds), Enter to finish, Esc to cancel"
