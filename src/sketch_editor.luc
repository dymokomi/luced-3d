## Editing a Sketch node in the viewport, Fusion 360's way
## (docs/research/FUSION-SKETCH-STUDY.md): while a Sketch node is selected
## and displayed, the viewport draws its entities on its plane (fully
## constrained ones white, free ones blue, construction orange), and the
## marking menus (hold A, S or D: CREATE, MODIFY, CONSTRAINTS) pick a tool.
##
## A tool is used once, then Select again (Line chains from its last end
## until Esc). Drawing tools are click by click; the cursor snaps through
## the snapping layer (snapping.luc: points, middles, crossings, curves,
## the grid; a snapped point is the same point, or held on its curve), and
## a line drawn near level or upright becomes horizontal or vertical.
## Holding Cmd (Ctrl elsewhere) places freely. Constraint tools take their
## entities in order, the first the reference (sketch_constrain.luc);
## Sketch Dimension takes one entity or two, then a click in empty space.
## Select picks entities (Shift adds, Ctrl or Cmd takes away) and drags
## points, which snap and are held where they are let go; a drag from
## empty space draws a box selecting what lies wholly inside it at the level
## (either way it is dragged; at Shapes, chains wholly inside), the same
## modifiers, a plain box over nothing selecting nothing. A click on a
## constraint's glyph or a dimension selects that constraint
## (sketch_glyphs.luc, sketch_dimensions.luc; they win over geometry under
## the pointer); a click on a selected dimension opens its value box on its
## label, and a dimension dragged moves its label (one undo step). While a
## drawing tool's shape is begun, value boxes follow the cursor
## (sketch_typing.luc): typing, Tab and Enter size it. Delete
## removes the selection, constraints and entities in one undo step (the
## viewport's right-click menu too); X makes it construction, Q is Select.
##
## The editor works on a live CadSketch read from the node; each finished
## action writes it back as one undo step (commit), and an undo or a change
## from elsewhere reads the node again (sync).
##
## What the editor leans on: where the cursor lands (sketch_inference.luc),
## selections and boxes (sketch_selecting.luc), Project
## (sketch_projecting.luc), the frame and Look At (sketch_frames.luc), the
## glyphs (sketch_glyphs.luc), the dimensions (sketch_dimensions.luc), the
## value boxes (sketch_typing.luc) and the profiles (sketch_profiles.luc).
from sketch_chains import chain_of
from snapping import SnapMark
from edit_types import point_level, edge_level, face_level, smart_level
from sketch_profiles import SketchProfiles
from luce_cad.sketch import CadSketch, CadProjection
from luce_cad.cad_geometry import CadGeometry
from luce_ui.ui import Event
from luce_window.input import EventKind, Key
from workspace import Workspace
from sketch_node import SketchFrame, node_frame
from sketch_frames import FrameCache, look_at
from sketch_projecting import SketchProjecting
import sketch_tools
import view_projection
from luce_std import math
import sketch_kinds
from sketch_kinds import coincident, on_curve, midpoint, point_kind, line_kind
import sketch_inference
import sketch_selecting
import marquee
import sketch_glyphs
from sketch_dimensions import SketchDimensions, LabelDrag
from sketch_typing import SketchTyping
import units

## How near the cursor snaps, in points on screen.
let snap_reach = 9.0

pub class SketchEditor:
    let w: Workspace
    ## The node edited and the text the live sketch was read from.
    var node: int = -1
    var text: str = ""
    var values: list[float]
    pub var sketch: CadSketch? = none
    pub var frame: SketchFrame
    pub let frames: FrameCache
    ## The input body's stamp the sketch was read with.
    var body_was: str = ""
    ## Project's casts of the input body's edges.
    pub let projecting: SketchProjecting
    ## The tool in use (set_tool keeps the workspace's sketch_tool the same).
    pub var tool: str = "Select"
    ## A drawing tool's placed points: plane coordinates, and the point
    ## entity each is (-1: not made yet).
    pub var clicks: list[list[float]]
    pub var click_snaps: list[int]
    ## What each click snapped to: its kind (snapping.luc's, CadSketch.snap:
    ## 1 point, 2 middle, 4 crossing, 8 curve; 0 none or the grid) and a
    ## crossing's second curve.
    var click_kinds: list[int]
    var click_others: list[int]
    ## Each click's point once made (made_point), else -1.
    var made: list[int]
    ## The cursor on the plane, snapped, and what it snapped to (-1: none).
    pub var cursor: list[float]
    pub var snap: int = -1
    var snap_kind: int = 0
    var snap_other: int = -1
    pub var free_placing: bool = false
    pub var hover: int = -1
    pub var selection: list[int]
    ## Constraints selected by their glyphs, and the one whose glyph is
    ## under the pointer (-1: none).
    pub var constraint_selection: list[int]
    pub var hover_glyph: int = -1
    ## The sketch's profiles: shaded, hovered and picked at Shapes and Smart
    ## (the picked keys are the workspace's sketch_profiles).
    pub let profiles: SketchProfiles
    ## The profile under a press that may turn into a box ("": none).
    var box_profile: str = ""
    ## A constraint or dimension tool's picks so far.
    pub var picks: list[int]
    ## A point being dragged by Select.
    var dragging: int = -1
    var drag_moved: bool = false
    ## Select pressed on nothing: a box from (box[0], box[1]) to the pointer
    ## at (box[2], box[3]) while `boxing`, and what it does (0 replaces, 1
    ## adds, 2 takes away).
    pub var boxing: bool = false
    pub var box: list[float]
    var box_operation: int = 0
    ## Counts changes to the live sketch, so drawings are made again.
    pub var revision: int = 0
    ## A dimension's value is typed here: called with its constraint, where
    ## (the viewport's points: the click placing it, or its label's corner)
    ## and whether the box sits on the label.
    pub var on_value: func(int, float, float, bool) -> unit!? = none
    ## A drawing tool's clicks are in (sketch_create.luc finishes it), set
    ## by the view.
    pub var on_finish: func() -> unit!? = none
    ## Ask for a number (a tool's value typed): its label, the value to
    ## start from, and what takes the answer.
    pub var on_ask: func(str, float, func(float) -> unit!) -> unit!? = none
    ## The distance the last Offset was.
    pub var last_offset: float = 5.0
    ## The Text tool's clicks are in: ask what it says (place_text).
    pub var on_text: func() -> unit!? = none
    ## Where that text goes: its anchor (x, y), height and the point its
    ## anchor snapped to (-1: none).
    pub var text_at: list[float]
    ## A MODIFY tool's click (sketch_modify.luc; Shift held), set by the
    ## view so this module need not know it.
    pub var on_modify: func(bool) -> unit!? = none
    ## A constraint or dimension tool's click (sketch_picking.luc), and a
    ## constraint tool applied to its picks, whether they were enough
    ## (set by the view).
    pub var on_pick: func() -> unit!? = none
    pub var on_constrain: func() -> bool!? = none
    ## The dimensions as placed on the screen.
    pub let dimensions: SketchDimensions
    ## A dimension pressed, its label to drag.
    let label_drag: LabelDrag
    ## The value boxes while drawing, the clicks placed so far by the tool
    ## (they follow it), and the cursor as it landed before they steered it.
    pub let typing: SketchTyping
    var placed_clicks: int = 0
    var landed: list[float]
    ## A click in the viewport (an open value box closes).
    pub var on_click: func() -> unit!? = none
    var node_was: int = -1
    pub var pointer_x: float = 0.0
    pub var pointer_y: float = 0.0
    ## Screen size of the last event, and the reach of a snap in sketch units.
    var width: float = 1.0
    var height: float = 1.0
    pub var reach: float = 1.0

    pub func init(self, w: Workspace) -> unit!:
        self.text_at = []
        self.w = w
        self.values = []
        self.frame = node_frame([1.0, 0.0])
        self.frames = FrameCache()
        self.projecting = SketchProjecting()
        self.clicks = []
        self.click_snaps = []
        self.click_kinds = []
        self.click_others = []
        self.made = []
        self.cursor = [0.0, 0.0]
        self.selection = []
        self.constraint_selection = []
        self.profiles = SketchProfiles()
        self.picks = []
        self.box = []
        self.dimensions = SketchDimensions()
        self.label_drag = LabelDrag()
        self.typing = SketchTyping()
        self.landed = [0.0, 0.0]

    ## Whether a Sketch node is being edited: selected, displayed, enabled,
    ## and no tool prompt open.
    pub func active(self) -> bool:
        return self.w.sketching()

    ## Read the node again when it is another node, or its text or plane
    ## changed (an undo, the parameter panel).
    pub func sync(self) -> unit!:
        let node = self.w.selected() else return
        # The plane follows its face as the body upstream changes.
        let frame = self.frames.frame(self.w, node)
        if not frame.equals(self.frame):
            let moved = self.sketch != none and node.id == self.node
            self.frame = frame
            self.revision += 1
            # A new plane (a face picked): look straight at it.
            if moved:
                self.look_at()
        # Projected curves follow the input body: a new body reads again.
        _ = self.frames.body(self.w, node)
        let same = node.id == self.node and node.texts[0] == self.text and node.values[0] == (self.values + [0.0])[0] and node.values[1] == (self.values + [0.0, 0.0])[1] and self.frames.body_stamp() == self.body_was
        if same and self.sketch != none:
            return
        self.body_was = self.frames.body_stamp()
        # Another sketch than the one edited: its tool and selection go.
        if node.id != self.node and self.node >= 0:
            self.reset_tool()
            self.selection = []
            self.constraint_selection = []
            self.w.sketch_profiles = []
            self.set_tool("Select")
        # What the pointer was over, and a tool's clicks and picks, belong to
        # the sketch read before (an undo, another node).
        self.hover = -1
        self.hover_glyph = -1
        self.snap = -1
        self.reset_tool()
        self.node = node.id
        self.text = node.texts[0]
        self.values = [node.values[0], node.values[1]]
        let sketch = CadSketch.parse(self.text)
        if sketch.link_count() > 0:
            if let data = self.frames.body(self.w, node):
                if CadGeometry.model_count(data.geometry) > 0:
                    _ = sketch.relink(CadGeometry.model(data.geometry, 0), self.frame.origin, self.frame.u, self.frame.v)
        _ = sketch.solve()
        sketch.analyze()
        let entering = self.sketch == none or self.node_was != node.id
        self.node_was = node.id
        self.sketch = sketch
        if entering:
            self.look_at()
        let kept: list[int] = []
        for at in self.selection:
            if at < sketch.entity_count():
                kept.append(at)
        self.selection = kept
        let constraints: list[int] = []
        for at in self.constraint_selection:
            if at < sketch.constraint_count():
                constraints.append(at)
        self.constraint_selection = constraints
        self.w.sketch_profiles = self.profiles.still_there(sketch, self.frame, self.w.sketch_profiles)
        self.revision += 1

    ## Look straight at the sketch plane, as Fusion's Look At does.
    pub func look_at(self) -> unit!:
        let sketch = self.sketch else return
        look_at(self.w, sketch, self.frame)

    ## Say `text` in the status line.
    pub func say(self, text: str):
        self.w.notice = text
        self.w.revision += 1

    ## Write the live sketch to the node as one undo step.
    pub func commit(self, label: str) -> unit!:
        let sketch = self.sketch else return
        let node = self.w.network.find(self.node) else return
        let text = sketch.text()
        if text == node.texts[0]:
            return
        self.w.perform(label, func () -> unit!:
            node.texts[0] = text
            self.w.network.invalidate(node.id)
            self.w.rebuild())
        self.text = text
        sketch.analyze()
        self.revision += 1
        # A tool is used once: what it made is in, so back to Select (Line
        # goes on from its end until Esc).
        if not (self.tool in ["Select", "Line"]):
            self.reset_tool()
            self.set_tool("Select")
            self.w.notice = self.hint()

    ## Pick tool `name` (Select, a drawing tool, a constraint tool or Sketch
    ## Dimension). A constraint tool with enough already selected applies
    ## to the selection at once.
    pub func choose(self, name: str) -> unit!:
        self.sync()
        self.reset_tool()
        self.set_tool(name)
        if name != "Select":
            self.w.last_sketch_tool = name
        if sketch_tools.constrains(name) and self.selection.length > 0:
            self.picks = self.selection.copy()
            if let constrain = self.on_constrain:
                if constrain():
                    self.set_tool("Select")
        self.w.notice = self.hint()
        self.w.revision += 1

    ## The tool in use, here and on the workspace (the viewport's tool
    ## column shows it).
    func set_tool(self, name: str):
        self.tool = name
        self.w.sketch_tool = name

    func reset_tool(self):
        self.clicks = []
        self.click_snaps = []
        self.click_kinds = []
        self.click_others = []
        self.made = []
        self.picks = []
        self.dragging = -1
        self.boxing = false
        _ = self.label_drag.finish()
        self.typing.clear()

    ## The status line's hint for the current tool.
    pub func hint(self) -> str:
        return sketch_tools.hint(self.tool)

    ## The viewport's events while editing; whether one was used.
    pub func event(self, event: Event, width: float, height: float) -> bool!:
        if not self.active() or event.alt:
            return false
        self.sync()
        self.width = width
        self.height = height
        let sketch = self.sketch else return false
        if self.boxing and (event.cancelled or event.kind in [EventKind.pointer_left, EventKind.focus_lost]):
            self.boxing = false
            self.revision += 1
        if event.kind == EventKind.key_down:
            return self.key(event)
        if event.kind == EventKind.pointer_moved:
            if self.boxing:
                self.box = [self.box[0], self.box[1], event.x, event.y]
                self.revision += 1
                return true
            if self.label_drag.active():
                if self.label_drag.follow(sketch, event.x, event.y, self.plane_point(event.x, event.y)):
                    self.revision += 1
                return true
            self.track(event.x, event.y, event.meta or event.control)
            if self.dragging >= 0:
                if sketch.drag(self.dragging, self.cursor[0], self.cursor[1]):
                    sketch.analyze()
                self.drag_moved = true
                self.revision += 1
            return true
        if event.kind == EventKind.pointer_up and event.button == 0 and self.dragging >= 0:
            let dragged = self.dragging
            self.dragging = -1
            if self.drag_moved:
                # Let go on a point or a curve it snapped to: held there.
                if self.snap >= 0 and self.snap != dragged:
                    # Exactly where it snapped, then held there.
                    sketch.place(dragged, self.cursor[0], self.cursor[1])
                    if self.snap_kind == 1:
                        _ = sketch.constrain(coincident, dragged, self.snap)
                    elif self.snap_kind == 8 and sketch_kinds.holds_points(sketch.kind(self.snap)):
                        _ = sketch.constrain(on_curve, dragged, self.snap)
                    if not sketch.solve():
                        sketch.unconstrain(sketch.constraint_count() - 1)
                        _ = sketch.solve()
                self.commit("Drag sketch point")
            return true
        if event.kind == EventKind.pointer_up and event.button == 0 and self.label_drag.active():
            # A dragged label stays (one undo step); a click on the selected
            # dimension opens its value box on its label.
            let moved = self.label_drag.moved
            let constraint = self.label_drag.finish()
            if moved:
                self.commit("Move dimension label")
            elif self.label_drag.was_selected:
                self.edit_dimension(constraint)
            return true
        if event.kind == EventKind.pointer_up and event.button == 0 and self.boxing:
            self.boxing = false
            self.box = [self.box[0], self.box[1], event.x, event.y]
            self.finish_box()
            return true
        if event.kind != EventKind.pointer_down or not event.inside:
            return false
        if let clicked = self.on_click:
            clicked()
        if event.button == 1:
            # A right click ends what is being drawn; otherwise the
            # viewport's menu opens for what is under the pointer (a glyph
            # there is selected first).
            if self.clicks.length > 0 or self.picks.length > 0:
                self.reset_tool()
                return true
            self.track(event.x, event.y, false)
            if self.hover_glyph >= 0 and not (self.hover_glyph in self.constraint_selection):
                self.selection = []
                self.constraint_selection = [self.hover_glyph]
                self.revision += 1
            return false
        if event.button != 0:
            return false
        self.track(event.x, event.y, event.meta or event.control)
        self.pointer_x = event.x
        self.pointer_y = event.y
        if self.tool == "Select":
            self.select_at(marquee.operation_of(event))
        elif self.tool == "Project":
            self.project_at()
        elif sketch_tools.draws(self.tool):
            self.place()
        elif sketch_tools.modifies(self.tool) or sketch_tools.copies(self.tool):
            if let act = self.on_modify:
                act(event.shift)
        elif let picked = self.on_pick:
            picked()
        return true

    ## Keys: a tool's letter, Esc, Delete, X.
    func key(self, event: Event) -> bool!:
        if event.key == Key.escape:
            if self.boxing:
                self.boxing = false
            elif self.clicks.length > 0 or self.picks.length > 0:
                self.reset_tool()
            elif self.tool != "Select":
                self.choose("Select")
            else:
                self.selection = []
                self.constraint_selection = []
                self.w.sketch_profiles = []
            self.revision += 1
            return true
        if event.key == Key.enter:
            if self.typing.active():
                self.enter_typed()
                return true
            self.finish_open()
            self.reset_tool()
            return true
        if event.key in [Key.delete, Key.backspace]:
            self.remove_selection()
            return true
        # A held key's repeats pick nothing.
        if event.repeated:
            return false
        let letter = sketch_tools.key_letter(event.key)
        # Q is Select here as everywhere.
        if letter == "Q":
            self.choose("Select")
            return true
        if letter == "X" and self.selection.length > 0:
            let sketch = self.sketch else return true
            let construction = not sketch.construction(self.selection[0])
            for at in self.selection:
                if sketch.kind(at) != point_kind:
                    sketch.set_construction(at, construction)
            self.commit("Toggle construction")
            return true
        let name = sketch_tools.tool_for_key(letter)
        if name != "":
            self.choose(name)
            return true
        return false

    ## Where the pointer at (`x`, `y`) is on the plane, snapped to a point or
    ## curve within reach unless `free`.
    func track(self, x: float, y: float, free: bool) -> unit!:
        let sketch = self.sketch else return
        let normal = self.frame.normal()
        let here = view_projection.plane(self.w, x, y, self.width, self.height, self.frame.origin, normal)
        let beside = view_projection.plane(self.w, x + snap_reach, y, self.width, self.height, self.frame.origin, normal)
        self.reach = math.max(1e-6, here.subtract(beside).length())
        self.cursor = self.frame.coordinates(here)
        self.free_placing = free
        self.snap = -1
        self.snap_kind = 0
        self.snap_other = -1
        self.hover = sketch.pick(self.cursor[0], self.cursor[1], self.reach, self.pick_filter())
        # Select: a glyph or label under the pointer wins over geometry.
        self.hover_glyph = -1
        if self.tool == "Select" and self.dragging < 0:
            _ = self.dimensions.placed(self.w, sketch, self.frame, self.revision, self.width, self.height)
            self.hover_glyph = self.dimensions.at(x, y)
            if self.hover_glyph < 0:
                self.hover_glyph = sketch_glyphs.glyph_at(sketch_glyphs.glyphs(self.w, sketch, self.frame, self.width, self.height), x, y)
            if self.hover_glyph >= 0:
                self.hover = -1
        # Shapes and Smart: the profile under the pointer, off the curves.
        self.profiles.hover = ""
        if self.tool == "Select" and self.dragging < 0 and self.hover < 0 and self.hover_glyph < 0 and self.w.sketch_level in [face_level, smart_level]:
            self.profiles.hover = self.profiles.key_at(sketch, self.frame, self.cursor[0], self.cursor[1])
        # Tools that place, and a dragged point, snap; tools that pick (Trim,
        # the constraints) read the pointer as it is.
        let places = sketch_tools.places(self.tool) or self.dragging >= 0
        if free or not places:
            return
        # The snapping layer (not the point just placed or dragged, nor what
        # is drawn on it), a line's level and upright inference, the grid.
        let skip = self.dragging if self.dragging >= 0 else (self.made[-1] if self.made.length > 0 else -1)
        let start = self.clicks[-1] if self.tool == "Line" and self.clicks.length > 0 else []
        let landing = sketch_inference.land(self.w, sketch, self.cursor, self.reach, skip, start)
        self.cursor = landing.cursor
        self.snap = landing.snap
        self.snap_kind = landing.kind
        self.snap_other = landing.other
        self.steer()
        # Steered by typed values, it is no longer where it snapped.
        if landing.mark != "" and not self.typing.any_locked():
            self.w.snap_mark = SnapMark(self.frame.at(self.cursor[0], self.cursor[1]), landing.mark)

    ## A point at the cursor: the snapped point itself, else a new point (on
    ## the snapped curve, constrained there).
    func cursor_point(self) -> int!:
        let sketch = self.sketch else return -1
        if self.snap >= 0 and sketch.kind(self.snap) == point_kind:
            return self.snap
        return self.snapped_point(self.cursor, self.snap, self.snap_kind, self.snap_other)

    ## A drawing tool's click.
    func place(self) -> unit!:
        let sketch = self.sketch else return
        if self.tool == "Point":
            _ = self.cursor_point()
            self.commit("Sketch point")
            return
        # Clicking the last point again ends a chain (a spline: makes it;
        # its points are made only then, so there, where it was).
        let again = self.clicks.length > 0 and ((self.snap >= 0 and self.snap == self.click_snaps[-1]) or
                    (sketch_tools.open_ended(self.tool) and math.hypot(self.cursor[0] - self.clicks[-1][0], self.cursor[1] - self.clicks[-1][1]) <= self.reach))
        if again:
            self.finish_open()
            self.reset_tool()
            return
        self.clicks.append(self.cursor.copy())
        self.click_snaps.append(self.snap)
        self.click_kinds.append(self.snap_kind)
        self.click_others.append(self.snap_other)
        self.made.append(-1)
        self.placed_clicks += 1
        self.revision += 1
        if self.tool == "Line" and self.clicks.length == 2:
            # sketch_create makes the line (with its typed dimensions).
            if let finish = self.on_finish:
                finish()
            # Chain from the end, that point itself.
            let b = self.made_point(1)
            self.clicks = [self.clicks[1]]
            self.click_snaps = [b]
            self.click_kinds = [1]
            self.click_others = [-1]
            self.made = [b]
        elif not sketch_tools.open_ended(self.tool) and self.clicks.length == sketch_tools.clicks_for(self.tool):
            if let finish = self.on_finish:
                finish()
            self.reset_tool()
            return
        self.steer()

    ## An open-ended tool (a spline) with two clicks or more: make it.
    func finish_open(self) -> unit!:
        if sketch_tools.open_ended(self.tool) and self.clicks.length >= 2:
            if let finish = self.on_finish:
                finish()

    ## The input body's edges cast onto the plane while Project is the
    ## tool; none without a body.
    pub func projection(self) -> CadProjection?!:
        return self.projecting.projection(self.w, self.node, self.frames, self.frame)

    ## The edge whose shadow is under the cursor, or -1.
    pub func projected_edge(self) -> int!:
        let cast = self.projection() else return -1
        return cast.nearest(self.cursor[0], self.cursor[1], self.reach)

    ## Project's click: the edge under the cursor brought in, fixed and
    ## linked.
    func project_at(self) -> unit!:
        let sketch = self.sketch else return
        let (made, problem) = self.projecting.project_at(self.w, self.node, self.frames, self.frame, sketch, self.cursor[0], self.cursor[1], self.reach)
        if problem != "":
            self.say(problem)
        if made:
            self.commit("Project")

    ## The Text tool's words: the text where its clicks put it, as one undo.
    pub func place_text(self, content: str) -> unit!:
        let sketch = self.sketch else return
        if self.text_at.length < 4 or content.trim() == "":
            return
        let snapped = int(self.text_at[3])
        let anchor = snapped if snapped >= 0 and sketch.kind(snapped) == point_kind else sketch.add_point(self.text_at[0], self.text_at[1])
        _ = sketch.add_text(anchor, self.text_at[2], content)
        self.text_at = []
        self.commit("Text")

    ## Click `at`'s point, made once: the point it snapped to, else a new
    ## one there (on the curve it snapped to).
    pub func made_point(self, at: int) -> int!:
        let sketch = self.sketch else return -1
        if self.made[at] >= 0:
            return self.made[at]
        let point = self.snapped_point(self.clicks[at], self.click_snaps[at], self.click_kinds[at], self.click_others[at])
        self.made[at] = point
        return point

    ## A point at `place` as what it snapped to holds it: that point itself;
    ## a new one at a line's middle, on two crossing curves or on a curve
    ## (held there by its constraints); else a free new one.
    func snapped_point(self, place: list[float], snapped: int, kind: int, other: int) -> int!:
        let sketch = self.sketch else return -1
        if snapped >= 0 and sketch.kind(snapped) == point_kind:
            return snapped
        let point = sketch.add_point(place[0], place[1])
        if snapped < 0:
            return point
        if kind == 2 and sketch.kind(snapped) == line_kind:
            _ = sketch.constrain(midpoint, point, snapped)
            return point
        for curve in [snapped, other if kind == 4 else -1]:
            if curve >= 0 and sketch_kinds.holds_points(sketch.kind(curve)):
                _ = sketch.constrain(on_curve, point, curve)
        return point

    ## What Select hovers at the selection level (Points: points, Lines and
    ## Shapes: curves); other tools pick either (CadSketch.pick's `only`).
    func pick_filter(self) -> int:
        # Tools that work on curves pick only curves (not a crossing's or
        # an end's point under the cursor).
        if sketch_tools.picks_curves(self.tool):
            return 2
        if self.tool != "Select":
            return 0
        if self.w.sketch_level == point_level:
            return 1
        return 2 if self.w.sketch_level in [edge_level, face_level] else 0

    ## Select's press: the entity under the cursor, at the Shapes level its
    ## whole chain, alone (`operation` 0), added or taken away again (1,
    ## Shift) or taken away (2, Ctrl or Cmd); a point pressed starts a drag.
    ## On nothing it starts a box (a click when it is not dragged).
    func select_at(self, operation: int) -> unit!:
        let sketch = self.sketch else return
        if self.hover_glyph >= 0:
            let pressed = self.hover_glyph
            if self.dimensions.find(pressed) != none:
                self.press_label(pressed, operation)
                return
            self.select_constraint(pressed, operation)
            return
        let at = self.hover
        if at < 0:
            # A press in a profile picks it when it is not dragged into a box.
            self.box_profile = self.profiles.hover
            self.boxing = true
            self.box = [self.pointer_x, self.pointer_y, self.pointer_x, self.pointer_y]
            self.box_operation = operation
            return
        if sketch.kind(at) == point_kind:
            self.dragging = at
            self.drag_moved = false
        let picked = chain_of(sketch, at) if self.w.sketch_level == face_level and sketch.kind(at) != point_kind else [at]
        self.change_selection(picked, 2 if operation == 1 and at in self.selection else operation)

    ## Profile `key` (a click in its region) alone (`operation` 0, the
    ## entities and constraints let go), added or taken away again (1,
    ## Shift) or taken away (2, Ctrl or Cmd).
    func select_profile(self, key: str, operation: int):
        if operation == 0:
            self.selection = []
            self.constraint_selection = []
        self.w.sketch_profiles = sketch_selecting.toggled_key(self.w.sketch_profiles, key, operation)
        self.revision += 1
        self.w.revision += 1

    ## Constraint `constraint` (its glyph clicked) alone (`operation` 0,
    ## the entities let go), added or taken away again (1, Shift) or taken
    ## away (2, Ctrl or Cmd).
    func select_constraint(self, constraint: int, operation: int):
        if operation == 0:
            self.selection = []
            self.w.sketch_profiles = []
        self.constraint_selection = sketch_selecting.toggled(self.constraint_selection, constraint, operation)
        self.revision += 1

    ## The selection with `picked` alone (`operation` 0; selected
    ## constraints and profiles let go), added (1) or taken away (2).
    func change_selection(self, picked: list[int], operation: int):
        if operation == 0:
            self.constraint_selection = []
            self.w.sketch_profiles = []
        self.selection = sketch_selecting.changed(self.selection, picked, operation)
        self.revision += 1

    ## Select's box let go: a click on nothing picks the profile pressed in
    ## (Shapes and Smart), else selects nothing (Shift or Ctrl: changes
    ## nothing); a drag, either way, selects what lies wholly inside the
    ## box at the level (sketch_selecting.boxed).
    func finish_box(self) -> unit!:
        let sketch = self.sketch else return
        let operation = self.box_operation
        if not marquee.dragged(self.box):
            if self.box_profile != "":
                self.select_profile(self.box_profile, operation)
            elif operation == 0:
                self.change_selection([], 0)
            return
        self.change_selection(sketch_selecting.boxed(self.w, sketch, self.frame, self.box, self.pick_filter(), self.w.sketch_level == face_level, self.width, self.height), operation)

    ## The value boxes follow the tool's clicks; while they show, the
    ## cursor goes where their locked values say, and their live values
    ## and places follow it.
    func steer(self):
        if not sketch_tools.draws(self.tool) or self.clicks.length == 0:
            self.typing.clear()
            return
        self.typing.follow(self.tool, self.clicks.length, self.placed_clicks)
        if not self.typing.active():
            return
        self.landed = self.cursor.copy()
        self.cursor = self.typing.steer(self.tool, self.clicks, self.landed)
        self.typing.live(self.tool, self.clicks, self.cursor, self.reach / snap_reach)
        self.revision += 1

    ## A key or typed character for the value boxes, before anything else
    ## sees it (the viewport asks first); whether they took it.
    pub func typing_event(self, event: Event) -> bool!:
        if not self.active() or not self.typing.active():
            return false
        if not self.typing.key(event, units.document_unit(self.w)):
            return false
        # A locked value moves the shape at once.
        self.cursor = self.typing.steer(self.tool, self.clicks, self.landed)
        self.typing.live(self.tool, self.clicks, self.cursor, self.reach / snap_reach)
        self.revision += 1
        self.w.revision += 1
        return true

    ## Enter with value boxes: the point placed where they say (a box that
    ## does not read as a number is said instead).
    func enter_typed(self) -> unit!:
        let wrong = self.typing.unreadable()
        if wrong != "":
            self.say(f"{wrong}: type a number (a length may carry its unit: 25 mm, 1 in)")
            return
        self.cursor = self.typing.steer(self.tool, self.clicks, self.landed)
        # Placed where the boxes say, not on what the pointer snapped to.
        self.snap = -1
        self.snap_kind = 0
        self.snap_other = -1
        self.place()

    ## A press on dimension `constraint`: selected (`operation` as a
    ## click's), its label ready to drag (LabelDrag).
    func press_label(self, constraint: int, operation: int) -> unit!:
        let sketch = self.sketch else return
        let was_selected = operation == 0 and self.constraint_selection == [constraint]
        if not was_selected:
            self.select_constraint(constraint, operation)
        self.label_drag.begin(sketch, constraint, was_selected, self.pointer_x, self.pointer_y, self.cursor, self.reach / snap_reach)

    ## Viewport point (`x`, `y`) on the plane.
    func plane_point(self, x: float, y: float) -> list[float]!:
        return self.frame.coordinates(view_projection.plane(self.w, x, y, self.width, self.height, self.frame.origin, self.frame.normal()))

    ## Open dimension `constraint`'s value box on its label (a driven one
    ## is measured, not set: said instead).
    pub func edit_dimension(self, constraint: int) -> unit!:
        let sketch = self.sketch else return
        if constraint < 0 or constraint >= sketch.constraint_count():
            return
        if sketch.driven(constraint):
            self.say("A driven dimension measures the sketch: make it driving (right-click) to set it")
            return
        let shown = self.dimensions.find(constraint) else return
        if let open = self.on_value:
            open(constraint, shown.box.x, shown.box.y, true)

    ## Delete: the selected constraints, then the selected entities (and
    ## what is drawn on them), as one undo step.
    pub func remove_selection(self) -> unit!:
        let sketch = self.sketch else return
        if self.selection.length == 0 and self.constraint_selection.length == 0:
            return
        let label = "Delete sketch entities" if self.selection.length > 0 else ("Delete constraint" if self.constraint_selection.length == 1 else "Delete constraints")
        # Highest first, as removing renumbers what follows.
        let constraints = self.constraint_selection.copy()
        constraints.sort()
        var at = constraints.length
        while at > 0:
            at -= 1
            if constraints[at] < sketch.constraint_count():
                sketch.unconstrain(constraints[at])
        let chosen = self.selection.copy()
        chosen.sort()
        at = chosen.length
        while at > 0:
            at -= 1
            if chosen[at] < sketch.entity_count():
                sketch.remove(chosen[at])
        self.selection = []
        self.constraint_selection = []
        self.hover_glyph = -1
        self.commit(label)
