## Edit CAD's commands, Fusion 360's direct modeling from the viewport: the
## right-click menu, the A and S marking menus and Modify › CAD features run
## these while an Edit CAD node is edited (cad_commands.luc sends them
## here). Each adds a step to the node's recipe as one undo step and says
## why when it does not apply.
##   Create Sketch: on the selected flat face (its loops projected once),
##     else on an origin plane; the sketch is edited at once (the same
##     Sketch editor), Finish Sketch leaves it. Edit Sketch edits a sketch
##     of the model again, Show or Hide sketch shows it or not.
##   Extrude, Revolve (in a sketch): a step taking the picked profiles (none:
##     the closed shapes); Extrude's distance box opens by its arrow,
##     Revolve waits for its axis.
##   Press Pull dispatches as Fusion's: profiles in a sketch Extrude, faces
##     Offset Face, edges Fillet. Extrude face: a sketch on the face and an
##     Extrude of its loops.
##   Offset Face, Fillet, Chamfer, Shell: a step on the selection, its value
##     box by its arrow. Replace Face, Combine and Split Body then wait for
##     what they need: the target face, the tool bodies (Enter finishes),
##     the splitting face (or an origin plane from the tool bar).
##   Move/Copy: the Move tool on the selection; its tool bar holds the
##     distances, the angles and Create copy.
from luce_geocore.geocore import Domain
from luce_3d.graphics import Vector3
from luce_std import math
from workspace import Workspace
from node import Node
from edit_types import object_level, edge_level, face_level, patch_level, curve_level
from edit_cad_sketches import SketchObject, sketch_step, feature_step, visibility_step, plane_step, next_name
from edit_cad_picks import wait_for, target_label, tools_label, splitting_label, axis_label, object_label, plane_label, projection_label, master_label, second_label
import edit_cad_align
import edit_cad_build
import build_ops
import blend_ops
import align_ops
import edit_cad_surfaces
from edit_operations import EditStep
import view_projection
import edit_cad_curves
from sketch_node import face_plane
import edit_cad
import edit_cad_sketches
import edit_cad_picks
import modify_picks
import modeling_commands
import node_catalog

## The Edit CAD node being edited in the viewport (its model, or one of
## its sketches), or none.
pub func model_node(w: Workspace) -> Node?:
    let node = w.selected() else return none
    if node.kind != edit_cad.kind_name or not node.enabled or node.id != w.network.display:
        return none
    return node

## Whether the commands here apply: an Edit CAD node is edited.
pub func active(w: Workspace) -> bool:
    return model_node(w) != none

## Whether one of its sketches is being edited.
pub func sketching(w: Workspace) -> bool:
    let node = model_node(w) else return false
    return w.sketching_model(node)

## The model's sketches as its last cook reported them.
pub func sketches(w: Workspace) -> list[SketchObject]!:
    let node = model_node(w) else return []
    return edit_cad_sketches.parse_objects(node.sketch_state)

# -- Sketches.

## Create Sketch: on the selected flat face, else on origin plane `plane`
## (sketch_node's: 0 XY, 1 XZ, 2 YZ); edited at once.
pub func create_sketch(w: Workspace, plane: int = 1) -> unit!:
    let node = model_node(w) else return
    let faces = selected_faces(w)
    let name = next_name(node.edits)
    let face = faces[0] if faces.length > 0 else ""
    w.perform("Create Sketch", func () -> unit!:
        node.edits.append(sketch_step(name, face_plane if face != "" else plane, 0.0, face))
        w.network.invalidate(node.id)
        start_editing(w, node, name)
        w.rebuild())

## Edit sketch `name` of the model again (the editor looks straight at it).
pub func edit_sketch(w: Workspace, name: str) -> unit!:
    let node = model_node(w) else return
    start_editing(w, node, name)
    w.rebuild()

func start_editing(w: Workspace, node: Node, name: str):
    w.edit_sketch = name
    w.edit_sketch_node = node.id
    w.selection = none
    w.sketch_profiles = []
    w.end_modal_tool()
    w.revision += 1

## Finish Sketch: back to the model.
pub func finish_sketch(w: Workspace) -> unit!:
    w.edit_sketch = ""
    w.edit_sketch_node = -1
    w.sketch_profiles = []
    w.selection = none
    w.revision += 1
    w.rebuild()

## Show or hide sketch `name` (one undo step).
pub func toggle_sketch(w: Workspace, name: str) -> unit!:
    let node = model_node(w) else return
    var visible = true
    for s in sketches(w):
        if s.name == name:
            visible = s.visible
    w.perform(("Hide " if visible else "Show ") + name, func () -> unit!:
        node.edits.append(visibility_step(name, not visible))
        w.network.invalidate(node.id)
        w.rebuild())

## Redefine Sketch Plane (Fusion's): sketch `name` onto the selected flat
## face, else it waits for a face clicked (or an origin plane chosen in the
## tool bar, then Enter); the drawing keeps its own coordinates. One undo
## step with the pick.
pub func redefine_sketch(w: Workspace, name: str) -> unit!:
    let node = model_node(w) else return
    if w.in_transaction():
        return
    let faces = selected_faces(w)
    if w.sketching():
        finish_sketch(w)
    w.begin("Redefine Sketch Plane")
    node.edits.append(plane_step(name, face_plane, 0.0, faces[0] if faces.length > 0 else ""))
    w.network.invalidate(node.id)
    if faces.length > 0:
        w.selection = none
        w.pending_changed = true
        w.commit()
        w.rebuild()
        return
    wait_for(w, node, plane_label, face_level, f"Click the flat face to put {name} on (or choose an origin plane in the tool bar, then Enter); Esc cancels")

## Extrude or Revolve (`kind`) of the edited sketch's picked profiles (none
## picked: its closed shapes); the sketch is finished. Extrude's distance
## box opens by its arrow; Revolve waits for its axis.
pub func feature_from_sketch(w: Workspace, kind: str) -> unit!:
    let node = model_node(w) else return
    if not w.sketching_model(node):
        return
    let name = w.edit_sketch
    let keys = w.sketch_profiles.join(";")
    if kind == "Revolve":
        w.begin("Revolve")
    w.perform(kind, func () -> unit!:
        node.edits.append(feature_step(kind, name, keys, node_catalog.starting_values(kind)))
        w.network.invalidate(node.id)
        w.edit_sketch = ""
        w.edit_sketch_node = -1
        w.sketch_profiles = []
        w.selection = none
        w.ask_value = kind == "Extrude"
        w.rebuild())
    if kind == "Revolve":
        wait_for(w, node, axis_label, edge_level, "Click the axis: a line of the sketch, or a straight or round edge; Esc cancels")

## Extrude face: a sketch on the selected flat face (its loops projected)
## and an Extrude of its closed shapes, one undo step.
pub func extrude_face(w: Workspace) -> unit!:
    let node = model_node(w) else return
    let faces = selected_faces(w)
    if faces.length == 0:
        say(w, "Extrude face: select a flat face (the Faces level) first")
        return
    let name = next_name(node.edits)
    w.perform("Extrude face", func () -> unit!:
        node.edits.append(sketch_step(name, face_plane, 0.0, faces[0]))
        node.edits.append(feature_step("Extrude", name, "", node_catalog.starting_values("Extrude")))
        w.network.invalidate(node.id)
        w.selection = none
        w.ask_value = true
        w.rebuild())

# -- Steps on the selection.

## Edit CAD's tool `name` on the selection (the Modify commands): those
## with a value open its box, those that need a second pick wait for it.
pub func tool(w: Workspace, name: str) -> unit!:
    if name in ["Offset Face", "Fillet", "Chamfer", "Shell"]:
        valued_step(w, name)
    elif name in ["Replace Face", "Combine", "Split Body", "Split Face"]:
        waiting_step(w, name)
    elif name == "Move/Copy":
        move_copy(w)
    elif name == edit_cad_surfaces.project_verb:
        project_step(w)
    elif name == edit_cad_curves.blend_verb and w.level_index() == curve_level:
        blend_step(w)
    elif name in edit_cad_align.verbs():
        align_step(w, name)
    elif name in edit_cad_build.verbs():
        build_step(w, name)
    else:
        modeling_commands.model(w, name)

## A double-click at (`x`, `y`) on a surface at the Curves level with no
## curve under it: the isoparm through the point picked (Alias's), a step,
## the curve selected. While an Align waits for its master (a step's or a
## node's), the isoparm there is its master instead: Alias's temporary pick
## object, kept in the step as the point. Whether it took the click.
pub func pick_isoparm(w: Workspace, x: float, y: float, width: float, height: float) -> bool!:
    if align_isoparm(w, x, y, width, height):
        return true
    if not active(w) or sketching(w) or w.level_index() != curve_level or w.prompt != none or w.placing != none:
        return false
    let node = model_node(w) else return false
    let hit = w.surface_at(w.view.camera.position(), view_projection.ray(w, x, y, width, height).normalized())
    if not hit.found:
        return false
    let p = hit.point
    w.perform(edit_cad_curves.isoparm_verb, func () -> unit!:
        node.edits.append(EditStep(edit_cad_curves.isoparm_verb, "", 0, [0.0, p.x, p.y, p.z], 0))
        w.network.invalidate(node.id)
        w.adopt_output = true
        w.pending_level = curve_level
        w.rebuild())
    return true

## Align's master as a temporary isoparm (see pick_isoparm): a step
## waiting in Edit CAD, or an Align node waiting for its master.
func align_isoparm(w: Workspace, x: float, y: float, width: float, height: float) -> bool!:
    let prompt = w.prompt else return false
    if edit_cad_build.waits(prompt.label) or prompt.label in edit_cad_picks.builder_node_labels():
        return builder_isoparm(w, prompt.node, prompt.label, x, y, width, height)
    if not (prompt.label in [master_label, second_label, "Pick master", "Pick second master"]):
        return false
    let way = view_projection.ray(w, x, y, width, height).normalized() catch failure:
        return false
    let hit = w.surface_at(w.view.camera.position(), way)
    if not hit.found:
        return false
    let p = hit.point
    let words = f"isoparm_at {p.x} {p.y} {p.z}"
    let node = w.network.find(prompt.node) else return false
    if node.kind == edit_cad.kind_name and node.edits.length > 0:
        let step = node.edits[-1]
        let texts = [step.text(0), step.text(1), step.text(2)]
        texts[align_ops.second_text if prompt.label == second_label else align_ops.master_text] = words
        node.edits[-1] = step.with_texts(texts)
        edit_cad_picks.accept_pick(w, node)
        return true
    node.texts[align_ops.second_text if prompt.label == "Pick second master" else align_ops.master_text] = words
    modify_picks.accept(w, node, prompt.label)
    return true

## A double-click on a surface while a builder (a step's, a node's) waits
## for curves: Alias's temporary isoparm through the point added to them.
func builder_isoparm(w: Workspace, id: int, label: str, x: float, y: float, width: float, height: float) -> bool!:
    let way = view_projection.ray(w, x, y, width, height).normalized() catch failure:
        return false
    let hit = w.surface_at(w.view.camera.position(), way)
    if not hit.found:
        return false
    let words = edit_cad_build.isoparm_words(hit.point)
    let node = w.network.find(id) else return false
    if node.kind == edit_cad.kind_name and node.edits.length > 0:
        node.edits[-1] = edit_cad_build.with_pick(node.edits[-1], label, words)
        edit_cad_picks.after_builder_pick(w, node)
        return true
    modify_picks.add_curve_words(w, node, label, words)
    return true

## Align or Symmetry Align (`verb`) on the picked edge or curve: the step
## takes it as its input; Align then waits for its master. Esc takes it
## away.
pub func align_step(w: Workspace, verb: str) -> unit!:
    let node = model_node(w) else return
    if w.in_transaction():
        return
    let mesh = w.geometry else return
    let chosen = w.current_selection() else return
    let input = edit_cad_align.pick_words(mesh, chosen.next(-1), w.level_index(), false)
    if input == "":
        say(w, f"{verb}: select the input first: a surface's edge (Edges level) or a curve near its end (Curves level)")
        return
    let numbers = align_ops.symmetry_starting() if verb == edit_cad_align.symmetry_verb else align_ops.starting()
    if verb == edit_cad_align.symmetry_verb:
        w.perform(verb, func () -> unit!:
            node.edits.append(EditStep(verb, "", 0, numbers, 0).with_texts([input, "", ""]))
            w.network.invalidate(node.id)
            w.selection = none
            w.rebuild())
        return
    w.begin(verb)
    node.edits.append(EditStep(verb, "", 0, numbers, 0).with_texts([input, "", ""]))
    w.network.invalidate(node.id)
    wait_for(w, node, master_label, w.level_index(), "Click the master: an edge (Edges level), a curve (Curves level) or a face for Project and U/V (Faces level); double-click a surface for an isoparm; Esc cancels")

## A surface builder `verb` (edit_cad_build.luc) on the curves or edges
## picked, in order (Extend: the edge or curve end picked); when it needs
## more it waits for them (a click adds one, Enter finishes); Esc takes it
## away.
pub func build_step(w: Workspace, verb: str) -> unit!:
    let node = model_node(w) else return
    if w.in_transaction():
        return
    var words: list[str] = []
    let level = w.level_index()
    let on_faces = blend_ops.takes_faces(verb) and (level == face_level or level == patch_level)
    if let mesh = w.geometry:
        if let chosen = w.current_selection():
            if w.selecting() and (level == curve_level or level == edge_level or on_faces):
                words = edit_cad_build.picked_words(mesh, chosen, level, verb == build_ops.extend_verb)
    if verb == build_ops.extend_verb and words.length == 0:
        say(w, "Extend: select a surface's edge (Edges level) or a curve near its end (Curves level) first")
        return
    let texts = [words[0] if verb == build_ops.extend_verb else words.join(";"), "", ""]
    w.begin(verb)
    node.edits.append(EditStep(verb, "", 0, edit_cad_build.starting(verb), 0).with_texts(texts))
    w.network.invalidate(node.id)
    let (label, hint) = edit_cad_build.next_prompt(node.edits[-1])
    if label == "":
        w.selection = none
        w.pending_changed = true
        w.commit()
        w.rebuild()
        return
    wait_for(w, node, label, edit_cad_build.level_for(node.edits[-1], w.level_index()), hint)

## The last Align step waits for its second master (from its tool bar).
pub func pick_second_master(w: Workspace) -> unit!:
    let node = model_node(w) else return
    if w.in_transaction() or node.edits.length == 0 or node.edits[-1].verb != edit_cad_align.align_verb:
        return
    w.begin(second_label)
    wait_for(w, node, second_label, edge_level, "Click the second master: an edge or a curve beside another side of the input (double-click a surface for an isoparm); Esc cancels")

## Whether curves are picked at the Curves level.
func curves_picked(w: Workspace) -> bool!:
    if w.level_index() != curve_level or not w.selecting():
        return false
    let chosen = w.current_selection() else return false
    return chosen.count() > 0

## Project on the picked curves: the step takes the view's direction (for
## Along: View), then waits for the face to cast onto; Esc takes it away.
## With no curves picked it waits for them first: a click adds one, a
## double-click on a surface a temporary isoparm (Alias's), Enter goes on.
pub func project_step(w: Workspace) -> unit!:
    let node = model_node(w) else return
    if w.in_transaction():
        return
    w.begin(edit_cad_surfaces.project_verb)
    let count = node.edits.length
    let waiting = not curves_picked(w)
    if waiting:
        node.edits.append(EditStep(edit_cad_surfaces.project_verb, "", 0, edit_cad_surfaces.project_numbers(), 0).with_texts(["", ""]))
    else:
        modeling_commands.model(w, edit_cad_surfaces.project_verb)
    if node.edits.length == count:
        w.cancel()
        return
    let step = node.edits[-1]
    let numbers = step.numbers.copy()
    # From the eye to the target (view_state.luc's orbit).
    let v = w.view
    let look = Vector3(-math.sin(v.yaw) * math.cos(v.pitch), -math.sin(v.pitch), -math.cos(v.yaw) * math.cos(v.pitch))
    # The view's direction is kept, so the step replays as made.
    if int(numbers[edit_cad_surfaces.along_slot]) == 1:
        numbers[edit_cad_surfaces.direction_slot] = look.x
        numbers[edit_cad_surfaces.direction_slot + 1] = look.y
        numbers[edit_cad_surfaces.direction_slot + 2] = look.z
        node.edits[-1] = step.with_numbers(numbers)
    if waiting:
        wait_for(w, node, edit_cad_build.project_curves_label, curve_level, "Click the curves to project, or double-click a surface for an isoparm; Enter goes on to the face, Esc cancels")
        return
    wait_for(w, node, projection_label, face_level, "Click the face to project the curves onto; Esc cancels")

## Blend Curve between the two picked curves; with fewer picked it waits for
## them: a click adds a curve, a double-click on a surface a temporary
## isoparm (Alias's); the second finishes it. Esc takes it away.
pub func blend_step(w: Workspace) -> unit!:
    let node = model_node(w) else return
    if w.in_transaction():
        return
    var words: list[str] = []
    if curves_picked(w):
        if let mesh = w.geometry:
            if let chosen = w.current_selection():
                words = edit_cad_build.picked_words(mesh, chosen, curve_level, false)
    if words.length >= 2:
        modeling_commands.model(w, edit_cad_curves.blend_verb)
        return
    w.begin(edit_cad_curves.blend_verb)
    node.edits.append(EditStep(edit_cad_curves.blend_verb, "", 0, edit_cad_curves.blend_numbers(), 0).with_texts([words.join(";"), ""]))
    w.network.invalidate(node.id)
    wait_for(w, node, edit_cad_build.blend_curves_label, curve_level, "Click the curves to blend between, or double-click a surface for an isoparm; Esc cancels")

## Press Pull: profiles in a sketch Extrude, faces Offset Face, edges a
## Fillet, as Fusion's dispatches.
pub func press_pull(w: Workspace) -> unit!:
    if sketching(w):
        feature_from_sketch(w, "Extrude")
        return
    if selected_faces(w).length > 0:
        valued_step(w, "Offset Face")
        return
    if selected_edges(w):
        valued_step(w, "Fillet")
        return
    say(w, "Press Pull: select faces or edges of the model, or edit a sketch and pick its profiles")

## Tool `name` on the selection, its value box opening by its arrow.
pub func valued_step(w: Workspace, name: str) -> unit!:
    let node = model_node(w) else return
    let count = node.edits.length
    modeling_commands.model(w, name)
    if node.edits.length > count:
        w.selection = none
        w.ask_value = true
        w.rebuild()

## Replace Face, Combine or Split Body (`name`) on the selection, then the
## prompt for what it needs; Esc takes the step away again.
pub func waiting_step(w: Workspace, name: str) -> unit!:
    let node = model_node(w) else return
    if w.in_transaction():
        return
    w.begin(name)
    let count = node.edits.length
    modeling_commands.model(w, name)
    if node.edits.length == count:
        w.cancel()
        return
    if name == "Replace Face":
        wait_for(w, node, target_label, face_level, "Click the target faces the faces move onto (Shift adds), then Enter; Esc cancels")
    elif name == "Combine":
        wait_for(w, node, tools_label, object_level, "Click the tool bodies (Shift adds), then Enter; Esc cancels")
    else:
        wait_for(w, node, splitting_label, face_level, "Click the face to split with (or choose an origin plane in the tool bar, then Enter); Esc cancels")

## Move/Copy: the Move tool on the selection, its tool bar Fusion's dialog
## (a step of no move, which the gizmo's moves then merge into).
pub func move_copy(w: Workspace) -> unit!:
    let node = model_node(w) else return
    let count = node.edits.length
    modeling_commands.model(w, "Move/Copy")
    if node.edits.length > count:
        modeling_commands.choose_tool(w, "Move")

## The selected faces' names (Faces or Patch level) of the edited model.
pub func selected_faces(w: Workspace) -> list[str]!:
    if not active(w) or sketching(w) or not w.selecting() or not w.on_domain(Domain.face) or w.level_index() == object_level:
        return []
    let mesh = w.geometry else return []
    let column = mesh.find_attribute("cad_face_name", 2)
    let chosen = w.current_selection() else return []
    let found: list[str] = []
    if column < 0:
        return found
    var at = chosen.next(-1)
    while at >= 0:
        let text = mesh.attribute_text(column, at)
        if text != "" and not (text in found):
            found.append(text)
        at = chosen.next(at)
    return found

## Whether edges of the edited model are selected (not curves).
pub func selected_edges(w: Workspace) -> bool:
    return active(w) and not sketching(w) and w.selecting() and w.on_domain(Domain.edge) and w.level_index() != curve_level and w.selected_count() > 0

## Whether curves of the edited model are selected (the Curves level).
pub func selected_curves(w: Workspace) -> bool:
    return active(w) and not sketching(w) and w.selecting() and w.level_index() == curve_level and w.selected_count() > 0

## Whether whole models are selected (the Object level).
pub func selected_models(w: Workspace) -> bool:
    return active(w) and not sketching(w) and w.selecting() and w.level_index() == object_level and w.selected_count() > 0

## To object picked in the tool bar: the last Extrude step waits for the
## face it runs to.
pub func pick_extent_face(w: Workspace) -> unit!:
    let node = model_node(w) else return
    if w.in_transaction() or node.edits.length == 0 or node.edits[-1].verb != "Extrude":
        return
    w.begin(object_label)
    wait_for(w, node, object_label, face_level, "Click the face to extrude to; Esc cancels")

func say(w: Workspace, text: str):
    w.notice = text
    w.revision += 1
