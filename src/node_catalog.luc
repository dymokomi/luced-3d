## Single source of truth for the node menu, defaults and parameter UI.
pub class Parameter:
    pub let name: str
    pub let slot: int
    pub let initial: float
    pub let minimum: float
    pub let maximum: float
    pub let step: float
    pub let integer: bool

    pub func init(self, name: str, slot: int, initial: float, minimum: float = -1000.0, maximum: float = 1000.0, step: float = 0.1, integer: bool = false):
        self.name = name
        self.slot = slot
        self.initial = initial
        self.minimum = minimum
        self.maximum = maximum
        self.step = step
        self.integer = integer

pub func sources() -> list[str]:
    return ["Cube", "Grid", "Sphere", "Cylinder", "Cone", "Torus", "File", "Group"]

pub func categories() -> list[str]:
    return ["Primitives", "Modeling", "Deform", "Transform / Copy", "Attributes", "Utility", "File I/O", "All"]

pub func category(kind: str) -> str:
    if kind == "File":
        return "File I/O"
    if kind == "Group":
        return "Utility"
    if kind in sources():
        return "Primitives"
    if kind in ["Mountain", "Smooth", "Peak"]:
        return "Deform"
    if kind in ["Transform", "Mirror", "CopyTransform", "CopyToPoints", "MatchSize"]:
        return "Transform / Copy"
    if kind.starts_with("Attribute") or kind in ["Selection Group", "Normal", "Measure", "UVProject", "Color"]:
        return "Attributes"
    if kind in ["Merge", "Null", "Switch"]:
        return "Utility"
    return "Modeling"

pub func kinds() -> list[str]:
    return sources() + ["Transform", "Tessellate", "Blast", "Edit", "Merge", "Null", "Switch", "Reverse", "Triangulate", "Subdivide", "Smooth", "Fuse", "Inset", "Bevel", "PolyExtrude", "Duplicate", "Split", "Delete", "Clean", "Mirror", "CopyTransform", "CopyToPoints", "Mountain", "Peak", "MatchSize", "AttributeCreate", "AttributeRandomize", "AttributeDelete", "AttributeRename", "AttributePromote", "Selection Group", "Normal", "Measure", "UVProject", "Color"]

pub func input_count(kind: str) -> int:
    return 0 if kind in sources() else (2 if kind in ["Merge", "Switch", "CopyToPoints"] else 1)

pub func has_group(kind: str) -> bool:
    return kind in ["Blast", "Reverse", "Triangulate", "Smooth", "Fuse", "Inset", "PolyExtrude", "Duplicate", "Split", "Delete", "Mountain", "Peak", "Selection Group"]

pub func has_attribute_name(kind: str) -> bool:
    return kind in ["AttributeCreate", "AttributeRandomize", "AttributeDelete", "AttributeRename", "AttributePromote", "Selection Group"]

pub func parameters(kind: str) -> list[Parameter]!:
    if kind == "Blast":
        return [Parameter("Delete non-selected / isolate", 0, 0.0, 0.0, 1.0, 1.0, true)]
    if kind == "Tessellate":
        return [Parameter("Surface divisions", 0, 16.0, 1.0, 64.0, 1.0, true), Parameter("Target edge length / 0 = off", 1, 0.0, 0.0, 100000.0, 0.5)]
    if kind == "Cube":
        return [Parameter("Size", 0, 2.0, 0.001, 100.0),
            Parameter("Position X", 1, 0.0), Parameter("Position Y", 2, 0.0), Parameter("Position Z", 3, 0.0),
            Parameter("Width factor", 7, 1.0, 0.001, 1000.0), Parameter("Height factor", 8, 1.0, 0.001, 1000.0), Parameter("Depth factor", 9, 1.0, 0.001, 1000.0)]
    if kind in ["Grid", "Sphere", "Cylinder", "Cone", "Torus"]:
        let result = [Parameter("Size" if kind == "Grid" else "Radius", 0, 2.0 if kind == "Grid" else 1.0, 0.001, 100.0), Parameter("Divisions", 1, 4.0 if kind == "Grid" else 16.0, 1.0 if kind == "Grid" else 4.0, 64.0, 1.0, true)]
        if kind in ["Cylinder", "Cone", "Torus"]:
            result.append(Parameter("Tube radius" if kind == "Torus" else "Height", 2, 0.3 if kind == "Torus" else 2.0, 0.001, 100.0))
        return result
    if kind in ["Transform", "Group"]:
        let result: list[Parameter] = []
        for group in 0..<3:
            for axis in 0..<3:
                result.append(Parameter(["Translate ", "Rotate ", "Scale "][group] + ["X", "Y", "Z"][axis], 1 + group * 3 + axis, 1.0 if group == 2 else 0.0))
        for axis in 0..<3:
            result.append(Parameter("Pivot " + ["X", "Y", "Z"][axis], 10 + axis, 0.0))
        return result
    if kind == "Subdivide":
        return [Parameter("Levels", 0, 1.0, 1.0, 3.0, 1.0, true), Parameter("Catmull-Clark (0 = linear)", 1, 1.0, 0.0, 1.0, 1.0, true)]
    if kind == "Bevel":
        return [Parameter("Chamfer fraction (all edges)", 0, 0.15, 0.001, 0.89, 0.05)]
    if kind in ["Smooth", "Mountain", "Peak", "Inset", "PolyExtrude", "Duplicate", "Fuse"]:
        return [Parameter("Tolerance" if kind == "Fuse" else ("Fraction" if kind == "Inset" else "Amount"), 0, 0.001 if kind == "Fuse" else 0.2, 0.000001 if kind == "Fuse" else (0.001 if kind == "Inset" else (-100.0 if kind in ["Peak", "PolyExtrude", "Duplicate"] else 0.0)), 0.99 if kind == "Inset" else (1.0 if kind == "Smooth" else 100.0), 0.001 if kind == "Fuse" else 0.1)]
    if kind == "Mirror":
        return [Parameter("Axis: X=0 Y=1 Z=2", 0, 0.0, 0.0, 2.0, 1.0, true), Parameter("Keep original", 1, 1.0, 0.0, 1.0, 1.0, true)]
    if kind == "CopyTransform":
        return [Parameter("Copies (includes source)", 0, 3.0, 1.0, 64.0, 1.0, true), Parameter("Step X", 1, 2.5), Parameter("Step Y", 2, 0.0), Parameter("Step Z", 3, 0.0)]
    if kind == "Switch":
        return [Parameter("Input", 0, 0.0, 0.0, 1.0, 1.0, true)]
    if kind == "MatchSize":
        return [Parameter("Longest side", 0, 2.0, 0.001, 1000.0)]
    if kind in ["AttributeCreate", "AttributeRandomize", "AttributeDelete", "AttributeRename", "AttributePromote", "Selection Group"]:
        let result = [Parameter("Domain: P=0 V=1 F=2 D=3", 0, 0.0, 0.0, 3.0, 1.0, true)]
        if kind == "AttributePromote":
            result.append(Parameter("Target domain", 1, 2.0, 0.0, 3.0, 1.0, true))
        if kind in ["AttributeCreate", "AttributeRandomize"]:
            result.append(Parameter("Tuple size", 1, 1.0, 1.0, 4.0, 1.0, true))
            result.append(Parameter("Integer (0/1)", 2, 0.0, 0.0, 1.0, 1.0, true))
            for component in 0..<4:
                result.append(Parameter(["Value X", "Value Y", "Value Z", "Value W"][component], 3 + component, 1.0 if component == 0 else 0.0))
            if kind == "AttributeRandomize":
                result.append(Parameter("Seed", 7, 1.0, 0.0, 100000.0, 1.0, true))
        return result
    if kind == "Normal":
        return [Parameter("Domain: points=0 faces=2", 0, 0.0, 0.0, 2.0, 2.0, true)]
    if kind == "UVProject":
        return [Parameter("UV scale", 0, 1.0, 0.001, 1000.0)]
    if kind == "Color":
        return [Parameter("Red", 0, 0.8, 0.0, 1.0), Parameter("Green", 1, 0.4, 0.0, 1.0), Parameter("Blue", 2, 0.1, 0.0, 1.0)]
    return []

pub func description(kind: str) -> str:
    if kind == "Group":
        return "Nested network / double-click to enter"
    if kind == "Subdivide":
        return "Catmull-Clark or linear quads; no creases"
    if kind == "Inset":
        return "Individual faces, centroid fraction"
    if kind == "Bevel":
        return "All edges; closed manifold; fraction width"
    if kind == "CopyToPoints":
        return "Input 1: source / Input 2: target points"
    if kind == "PolyExtrude":
        return "Face region with boundary; set Group"
    if kind in ["AttributeCreate", "AttributeRandomize", "AttributeDelete", "Selection Group"]:
        return "P: points / V: corners / F: faces / D: detail"
    if kind == "Color":
        return "Linear RGB point Cd, multiplied by material"
    return "Geometry operator"
