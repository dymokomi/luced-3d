## Commands on the component selection of the displayed geometry: picking
## components (whole pieces at a level of pieces), selecting all, inverting,
## growing and walking it, and switching the selection level (the selection
## carries over to the new level's domain). During a tool prompt each
## change goes to the prompted node at once (follow_prompt).
from luce_geocore.geocore import Selection, Domain
from workspace import Workspace
from tool_prompts import follow_prompt
from edit_types import smart_level, face_level, edge_level, domain_number
import edit_cad

pub func invert_selection(w: Workspace) -> unit!:
    let chosen = w.current_selection() else return
    w.perform("Invert selection", func () -> unit!:
        let inverted = chosen.inverted()
        let mesh = w.geometry else return
        w.selection = inverted.combined(mesh, "@cad_edge>=0", 2) if w.network.context() == "cad" and w.level_index() == edge_level else inverted)
    follow_prompt(w)

## Grow (0), shrink (1), border (2), flood (3), loop (4) or ring (5).
pub func walk_selection(w: Workspace, operation: int) -> unit!:
    if w.network.context() != "geometry": return
    let mesh = w.geometry else return
    let chosen = w.current_selection() else return
    if operation >= 4 and not w.on_domain(Domain.edge):
        w.notice = "Loops and rings need the Edges level"
        w.revision += 1
        return
    w.perform("Change selection", func () -> unit!:
        w.selection = chosen.walked(mesh, operation, 1))
    follow_prompt(w)

## Switching the component type carries the selection over (a face is
## kept when all its points were selected; a point when any face was).
## Smart keeps the level picked on, when it is one of Smart's.
pub func set_mode(w: Workspace, mode: int) -> unit!:
    if w.sketching():
        if mode in w.shown_levels():
            w.sketch_level = mode
            w.revision += 1
        return
    if mode == w.component_mode or not w.level_available(mode):
        return
    let mesh = w.geometry
    let chosen = w.selection
    let before = w.level_index()
    w.component_mode = mode
    if mode == smart_level:
        w.smart_pick = before if before in w.smart_levels() else face_level
        if w.level_index() == before:
            w.revision += 1
            return
    w.selection = none
    if let geometry = mesh:
        if let previous = chosen:
            if w.network.context() == "geometry" and previous.fits(geometry) and previous.count() > 0:
                let domain = w.domain()
                let strict = w.on_domain(Domain.face) or (w.on_domain(Domain.edge) and previous.domain() == domain_number(Domain.point))
                w.selection = previous.on_domain(geometry, domain, strict)
    w.revision += 1
    follow_prompt(w)
    # An Edit kind may pick each level on other geometry (Edit CAD).
    if w.selection_kind() != none:
        w.rebuild()

## Click: select `id` alone, or toggle it with `extend`, or take it out
## with `remove` (Ctrl or Cmd); -1 clears, but not while extending or
## removing. At a level of pieces (Object) the whole piece around `id`.
pub func choose_component(w: Workspace, id: int, extend: bool, chain: bool = false, remove: bool = false) -> unit!:
    if not w.selecting():
        return
    let mesh = w.geometry else return
    let chosen = w.current_selection() else return
    let tangent = chain and w.network.context() == "cad" and w.level_index() == edge_level
    let piece = (edit_cad.edge_chain(mesh, id) if tangent else w.level().whole(mesh, id)) if id >= 0 else ""
    w.perform("Select components", func () -> unit!:
        if id < 0:
            if not extend and not remove: w.selection = none
            return
        if piece == "":
            w.selection = chosen.changed(id, 1 if remove else (2 if extend else 3))
        elif remove:
            w.selection = chosen.combined(mesh, piece, 1)
        elif not extend:
            w.selection = Selection.of(mesh, piece, w.domain())
        else:
            w.selection = chosen.combined(mesh, piece, 1 if chosen.contains(id) else 0))
    follow_prompt(w)

## A box over the components: `boxed(current, operation, wholly, through)`
## is the Base selection of what the box touches (the points inside it, the
## edges and faces it meets; with `wholly` the edges and faces wholly
## inside it; with `through` hidden ones too) changed from `current` (0
## replaced, 1 added, 2 taken away). At a level of pieces each touched
## element brings its whole piece, one Base pass per piece; a CAD edge
## level counts B-rep edges only. On CAD (a CAD network, Edit CAD) a box
## follows Fusion's rule: dragged left to right it is a window, a B-rep
## face or edge taken only when all of it lies inside the box (and some of
## it shows); right to left a crossing, taking what it touches.
## Whether boxes follow CAD's rule, Fusion's: in a CAD network or Edit
## CAD, a box dragged left to right is a window, right to left a crossing.
pub func cad_boxes(w: Workspace) -> bool:
    if w.network.context() == "cad":
        return true
    let kind = w.active_kind() else return false
    return kind.name == edit_cad.kind_name

pub func choose_boxed(w: Workspace, operation: int, crossing: bool, boxed: func(Selection, int, bool, bool) -> Selection!) -> unit!:
    if not w.selecting():
        return
    let mesh = w.geometry else return
    let chosen = w.current_selection() else return
    let level = w.level()
    var made = chosen
    # A CAD window takes what lies wholly inside it; a crossing, as boxes
    # elsewhere, what it touches.
    let window = cad_boxes(w) and not crossing
    # What lies wholly inside the box, hidden or not (a piece must be all
    # in it).
    var outside: Selection? = none
    if window and level.piece != none:
        outside = boxed(Selection.empty(mesh, w.domain()), 0, true, true).inverted()
    if level.piece == none:
        made = boxed(chosen, operation, window, false)
    else:
        var rest = boxed(Selection.empty(mesh, w.domain()), 0, false, false)
        if w.network.context() == "cad" and w.level_index() == edge_level:
            rest = rest.combined(mesh, "@cad_edge>=0", 2)
        if operation == 0:
            made = Selection.empty(mesh, w.domain())
        var at = rest.next(-1)
        while at >= 0:
            let piece = level.whole(mesh, at)
            var whole = true
            if let out = outside:
                whole = out.combined(mesh, piece, 2).count() == 0
            if whole:
                made = made.combined(mesh, piece, 1 if operation == 2 else 0)
            rest = rest.combined(mesh, piece, 1).changed(at, 1)
            at = rest.next(-1)
    w.perform("Select components", func () -> unit!:
        w.selection = made if made.count() > 0 else none)
    follow_prompt(w)

pub func select_all(w: Workspace) -> unit!:
    let chosen = w.current_selection() else return
    w.perform("Select all", func () -> unit!:
        if w.network.context() == "cad" and w.level_index() == edge_level:
            w.selection = Selection.of(w.geometry else trap("CAD"), "@cad_edge>=0", w.domain())
        else:
            w.selection = chosen.filled(true))
    follow_prompt(w)

## Smart's click: component `id` of level `level` (what was under the
## pointer), alone, added or taken away (`operation` 0, 1, 2). Another level
## than the selection's starts a new selection on it; Smart's levels share
## their pick geometry, so nothing is cooked.
pub func choose_smart(w: Workspace, level: int, id: int, operation: int) -> unit!:
    if id >= 0 and level != w.smart_pick:
        if operation == 2:
            return
        w.smart_pick = level
        w.selection = none
    choose_component(w, id, operation == 1 and id >= 0, remove = operation == 2)
