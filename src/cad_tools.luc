## The CAD tools (docs/research/POLY-MODELING.md Stage 1): each declared
## once in its tool_<name>.luc (its node in a CAD network, its step of Edit
## CAD, its picks, rows, handles and cook), listed here, one line each.
## Luce has no reflection, so a new tool is its file and its line here;
## tool_registry.luc reads this list with the mesh tools, and nothing else
## names a CAD tool.
from tool_record import Tool, ToolEntry
import tool_sketch
import tool_sketch_plane
import tool_extrude
import tool_revolve
import tool_solid_box
