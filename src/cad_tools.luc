## Every CAD tool's entry, in menu order within its family.
pub func entries() -> list[ToolEntry]:
    return [tool_sketch.entry(), tool_sketch_plane.entry(), tool_extrude.entry(), tool_revolve.entry(), tool_solid_box.entry(), tool_solid_cylinder.entry(), tool_solid_cone.entry(), tool_solid_sphere.entry(), tool_solid_torus.entry(), tool_check.entry(),
            tool_offset_face.entry(), tool_shell.entry(), tool_split_face.entry(), tool_replace_face.entry(), tool_delete_face.entry(), tool_remove_faces.entry(),
            tool_move.entry(), tool_combine.entry(), tool_split_body.entry(), tool_remove.entry(), tool_mirror_body.entry(), tool_pattern.entry(), tool_scale_body.entry(),
            tool_fillet.entry(), tool_chamfer.entry(), tool_reblend.entry(),
            tool_project.entry(), tool_intersect.entry(), tool_trim.entry(), tool_untrim.entry(), tool_trim_convert.entry(), tool_shrink.entry(), tool_stitch.entry(), tool_unstitch.entry(),
            tool_align.entry(), tool_symmetry_align.entry(),
            tool_square.entry(), tool_skin.entry(), tool_rail.entry(), tool_profile.entry(), tool_set_planar.entry(), tool_sheet_extrude.entry(), tool_sheet_revolve.entry(), tool_extend.entry(),
            tool_blend_surface.entry(), tool_surface_fillet.entry(), tool_tube.entry(), tool_fill_surface.entry(), tool_bridge_fillet.entry(), tool_corner.entry(),
            tool_curve.entry(), tool_cv_curve.entry(), tool_ep_curve.entry(), tool_curve_on_surface.entry(), tool_duplicate_curve.entry(), tool_isoparm.entry(), tool_blend_curve.entry(),
            tool_blend_edges.entry(), tool_attach.entry(), tool_detach.entry(), tool_close.entry(), tool_stretch.entry(), tool_reverse_curve.entry(), tool_delete_curves.entry(),
            tool_insert_knot.entry(), tool_remove_knot.entry(), tool_raise_degree.entry(), tool_rebuild.entry(), tool_convert_to_bspline.entry()]

## Every CAD tool, built.
pub func tools() -> list[Tool]:
    let result: list[Tool] = []
    for entry in entries():
        result.append(entry.make())
    return result

## The entry named `name` (its node kind, label or step verb), or none.
pub func entry_of(name: str) -> ToolEntry?:
    for entry in entries():
        if entry.name == name or entry.label == name or entry.verb == name:
            return entry
    return none
