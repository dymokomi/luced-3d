## The Sketch editor's CREATE tools placed click by click (as Fusion's): what
## each makes once its clicks are in (finish), and what it would make with
## the cursor where it is (preview, the rubber band). A click's point is the
## point it snapped to, else a new one (on the curve it snapped to).
##
##   Midpoint Line        its middle, then an end
##   2-Point Rectangle    two corners (sides level and upright)
##   3-Point Rectangle    a side's two ends, then how wide (square corners)
##   Center Rectangle     its center, then a corner
##   Center Diameter Circle  its center, then a point on it
##   2-Point Circle       a diameter's ends
##   3-Point Circle       three points on it
##   3-Point Arc          its ends, then a point it passes through
##   Center Point Arc     its center, its start, its end (counterclockwise)
##   Circumscribed / Inscribed Polygon  its center, then a side's middle /
##                        a corner (six sides, all equal, on a construction
##                        circle)
##   Edge Polygon         one side's ends (six sides, to its left)
##   Center to Center Slot  its two centers, then how wide
from luce_cad.sketch import CadSketch
from overlay_lines import OverlayLines
from sketch_editor import SketchEditor
import sketch_editor as k
from luce_std import math

## How many sides the polygon tools make.
let polygon_sides = 6

## Drawing tool `e.tool`'s clicks are in: make what it makes, as one undo.
pub func finish(e: SketchEditor) -> unit!:
    let sketch = e.sketch else return
    let c = e.clicks
    let tool = e.tool
    if tool == "Midpoint Line":
        let m = e.made_point(0)
        let end = e.made_point(1)
        let start = sketch.add_point(2.0 * c[0][0] - c[1][0], 2.0 * c[0][1] - c[1][1])
        let line = sketch.add_line(start, end)
        _ = sketch.constrain(k.midpoint, m, line)
    elif tool == "2-Point Rectangle":
        _ = rectangle(e, c[0], [c[1][0], c[0][1]], c[1], [c[0][0], c[1][1]], true)
    elif tool == "Center Rectangle":
        let a = [2.0 * c[0][0] - c[1][0], 2.0 * c[0][1] - c[1][1]]
        let corners = rectangle(e, a, [c[1][0], a[1]], c[1], [a[0], c[1][1]], true)
        # Its center: the middle of a construction diagonal.
        if corners.length == 4:
            let diagonal = sketch.add_line(corners[0], corners[2], true)
            _ = sketch.constrain(k.midpoint, e.made_point(0), diagonal)
    elif tool == "3-Point Rectangle":
        let (nx, ny, w) = across(c[0], c[1], c[2])
        _ = rectangle(e, c[0], c[1], [c[1][0] + nx * w, c[1][1] + ny * w], [c[0][0] + nx * w, c[0][1] + ny * w], false)
    elif tool == "Center Diameter Circle":
        _ = sketch.add_circle(e.made_point(0), math.hypot(c[1][0] - c[0][0], c[1][1] - c[0][1]))
    elif tool == "2-Point Circle":
        let center = sketch.add_point((c[0][0] + c[1][0]) * 0.5, (c[0][1] + c[1][1]) * 0.5)
        _ = sketch.add_circle(center, math.hypot(c[1][0] - c[0][0], c[1][1] - c[0][1]) * 0.5)
    elif tool == "3-Point Circle":
        let o = through(c[0], c[1], c[2]) else return
        _ = sketch.add_circle(sketch.add_point(o[0], o[1]), math.hypot(c[0][0] - o[0], c[0][1] - o[1]))
    elif tool == "3-Point Arc":
        let o = through(c[0], c[1], c[2]) else return
        let a = e.made_point(0)
        let b = e.made_point(1)
        # Counterclockwise from the end that has the third point on its way.
        let along = turn_to(o, c[0], c[2]) <= turn_to(o, c[0], c[1])
        _ = sketch.add_arc(sketch.add_point(o[0], o[1]), a if along else b, b if along else a)
    elif tool == "Center Point Arc":
        let center = e.made_point(0)
        let start = e.made_point(1)
        let r = math.hypot(c[1][0] - c[0][0], c[1][1] - c[0][1])
        let aim = math.atan2(c[2][1] - c[0][1], c[2][0] - c[0][0])
        let end = e.made_point(2) if e.click_snaps[2] >= 0 else sketch.add_point(c[0][0] + r * math.cos(aim), c[0][1] + r * math.sin(aim))
        if r > 0.0 and start != end:
            _ = sketch.add_arc(center, start, end)
    elif tool in ["Circumscribed Polygon", "Inscribed Polygon", "Edge Polygon"]:
        polygon(e)
    elif tool == "Center to Center Slot":
        slot(e)
    _ = sketch.solve()
    e.commit(tool)

## A rectangle on corners `a`, `b`, `c`, `d` (in order): level and upright
## sides when `level`, else square corners kept by perpendicular and
## parallel sides. A corner clicked is that click's point. Its corners.
func rectangle(e: SketchEditor, a: list[float], b: list[float], c: list[float], d: list[float], level: bool) -> list[int]!:
    let sketch = e.sketch else return []
    if math.hypot(a[0] - c[0], a[1] - c[1]) <= 0.0:
        return []
    let p = [e.made_point(0), sketch.add_point(b[0], b[1]), e.made_point(1) if e.tool == "2-Point Rectangle" else sketch.add_point(c[0], c[1]), sketch.add_point(d[0], d[1])]
    if e.tool == "3-Point Rectangle":
        p[1] = e.made_point(1)
    if e.tool == "Center Rectangle":
        p[0] = sketch.add_point(a[0], a[1])
        p[2] = e.made_point(1)
    let lines = [sketch.add_line(p[0], p[1]), sketch.add_line(p[1], p[2]), sketch.add_line(p[2], p[3]), sketch.add_line(p[3], p[0])]
    if level:
        _ = sketch.constrain(k.horizontal, lines[0])
        _ = sketch.constrain(k.vertical, lines[1])
        _ = sketch.constrain(k.horizontal, lines[2])
        _ = sketch.constrain(k.vertical, lines[3])
    else:
        _ = sketch.constrain(k.perpendicular, lines[0], lines[1])
        _ = sketch.constrain(k.parallel, lines[0], lines[2])
        _ = sketch.constrain(k.parallel, lines[1], lines[3])
    return p

## A polygon of six equal sides: Circumscribed round a construction circle
## (each side touching it), Inscribed in one (each corner on it), Edge on a
## side's two ends (to its left).
func polygon(e: SketchEditor) -> unit!:
    let sketch = e.sketch else return
    let c = e.clicks
    let n = polygon_sides
    var cx = c[0][0]
    var cy = c[0][1]
    var r = math.hypot(c[1][0] - cx, c[1][1] - cy)
    var start = math.atan2(c[1][1] - cy, c[1][0] - cx)
    let half = math.pi / float(n)
    if e.tool == "Circumscribed Polygon":
        # The click is a side's middle: corners half a side either way.
        r = r / math.cos(half)
        start -= half
    elif e.tool == "Edge Polygon":
        let side = math.hypot(c[1][0] - c[0][0], c[1][1] - c[0][1])
        r = side * 0.5 / math.sin(half)
        let mx = (c[0][0] + c[1][0]) * 0.5
        let my = (c[0][1] + c[1][1]) * 0.5
        let ux = (c[1][0] - c[0][0]) / side
        let uy = (c[1][1] - c[0][1]) / side
        let apothem = r * math.cos(half)
        cx = mx - uy * apothem
        cy = my + ux * apothem
        start = math.atan2(c[0][1] - cy, c[0][0] - cx)
    if r <= 0.0:
        return
    let center = e.made_point(0) if e.tool != "Edge Polygon" else sketch.add_point(cx, cy)
    let circle = sketch.add_circle(center, r if e.tool != "Circumscribed Polygon" else r * math.cos(half), true)
    let corners: list[int] = []
    for at in 0..<n:
        let angle = start + 2.0 * math.pi * float(at) / float(n)
        if e.tool == "Edge Polygon" and at < 2:
            corners.append(e.made_point(at))
        else:
            corners.append(sketch.add_point(cx + r * math.cos(angle), cy + r * math.sin(angle)))
    let sides: list[int] = []
    for at in 0..<n:
        sides.append(sketch.add_line(corners[at], corners[(at + 1) % n]))
    for at in 0..<n:
        if e.tool == "Circumscribed Polygon":
            _ = sketch.constrain(k.tangent, sides[at], circle, side = side_of(sketch, sides[at], cx, cy))
        else:
            _ = sketch.constrain(k.on_curve, corners[at], circle)
        if at > 0:
            _ = sketch.constrain(k.equal, sides[0], sides[at])

## A slot from its two centers and its width: two half circles joined by
## two lines touching them.
func slot(e: SketchEditor) -> unit!:
    let sketch = e.sketch else return
    let c = e.clicks
    let length = math.hypot(c[1][0] - c[0][0], c[1][1] - c[0][1])
    if length <= 0.0:
        return
    let ux = (c[1][0] - c[0][0]) / length
    let uy = (c[1][1] - c[0][1]) / length
    let w = math.abs(-uy * (c[2][0] - c[0][0]) + ux * (c[2][1] - c[0][1]))
    if w <= 0.0:
        return
    let a = e.made_point(0)
    let b = e.made_point(1)
    # Corners: left and right of each center.
    let al = sketch.add_point(c[0][0] - uy * w, c[0][1] + ux * w)
    let ar = sketch.add_point(c[0][0] + uy * w, c[0][1] - ux * w)
    let bl = sketch.add_point(c[1][0] - uy * w, c[1][1] + ux * w)
    let br = sketch.add_point(c[1][0] + uy * w, c[1][1] - ux * w)
    let right = sketch.add_line(ar, br)
    let left = sketch.add_line(bl, al)
    # Round the far end counterclockwise from right to left, the near one
    # from left to right.
    let far = sketch.add_arc(b, br, bl)
    let near = sketch.add_arc(a, al, ar)
    _ = sketch.constrain(k.tangent, right, far, side = side_of(sketch, right, c[1][0], c[1][1]))
    _ = sketch.constrain(k.tangent, left, far, side = side_of(sketch, left, c[1][0], c[1][1]))
    _ = sketch.constrain(k.tangent, right, near, side = side_of(sketch, right, c[0][0], c[0][1]))
    _ = sketch.constrain(k.tangent, left, near, side = side_of(sketch, left, c[0][0], c[0][1]))
    _ = sketch.constrain(k.equal, far, near)

## What the tool would make with the cursor where it is.
pub func preview(e: SketchEditor, lines: OverlayLines) -> unit!:
    let c = e.clicks
    if c.length == 0:
        return
    let f = e.frame
    let p = e.cursor
    let all = c + [p]
    let tool = e.tool
    let first = c[0]
    if tool == "Line":
        lines.add_segment(f.at(c[-1][0], c[-1][1]), f.at(p[0], p[1]))
    elif tool == "Midpoint Line":
        lines.add_segment(f.at(2.0 * first[0] - p[0], 2.0 * first[1] - p[1]), f.at(p[0], p[1]))
    elif tool in ["2-Point Rectangle", "Center Rectangle"]:
        let a = first if tool == "2-Point Rectangle" else [2.0 * first[0] - p[0], 2.0 * first[1] - p[1]]
        loop(lines, e, [a, [p[0], a[1]], p, [a[0], p[1]]])
    elif tool == "3-Point Rectangle":
        if c.length == 1:
            lines.add_segment(f.at(first[0], first[1]), f.at(p[0], p[1]))
        else:
            let (nx, ny, w) = across(c[0], c[1], p)
            loop(lines, e, [c[0], c[1], [c[1][0] + nx * w, c[1][1] + ny * w], [c[0][0] + nx * w, c[0][1] + ny * w]])
    elif tool == "Center Diameter Circle":
        lines.add_arc(f.origin, f.u, f.v, first[0], first[1], math.hypot(p[0] - first[0], p[1] - first[1]), 0.0, 2.0 * math.pi)
    elif tool == "2-Point Circle":
        lines.add_arc(f.origin, f.u, f.v, (first[0] + p[0]) * 0.5, (first[1] + p[1]) * 0.5, math.hypot(p[0] - first[0], p[1] - first[1]) * 0.5, 0.0, 2.0 * math.pi)
    elif tool in ["3-Point Circle", "3-Point Arc"]:
        if c.length == 1:
            lines.add_segment(f.at(first[0], first[1]), f.at(p[0], p[1]))
        else:
            let o = through(all[0], all[1], all[2]) else return
            let r = math.hypot(all[0][0] - o[0], all[0][1] - o[1])
            if tool == "3-Point Circle":
                lines.add_arc(f.origin, f.u, f.v, o[0], o[1], r, 0.0, 2.0 * math.pi)
            else:
                let along = turn_to(o, all[0], all[2]) <= turn_to(o, all[0], all[1])
                let start_at = all[0] if along else all[1]
                let to = all[1] if along else all[0]
                lines.add_arc(f.origin, f.u, f.v, o[0], o[1], r, math.atan2(start_at[1] - o[1], start_at[0] - o[0]), turn_to(o, start_at, to))
    elif tool == "Center Point Arc":
        if c.length == 1:
            lines.add_segment(f.at(first[0], first[1]), f.at(p[0], p[1]))
        else:
            let r = math.hypot(c[1][0] - first[0], c[1][1] - first[1])
            let start = math.atan2(c[1][1] - first[1], c[1][0] - first[0])
            lines.add_arc(f.origin, f.u, f.v, first[0], first[1], r, start, turn_to(first, c[1], p))
    elif tool in ["Circumscribed Polygon", "Inscribed Polygon", "Edge Polygon"]:
        lines.add_segment(f.at(first[0], first[1]), f.at(p[0], p[1]))
    elif tool == "Center to Center Slot":
        if c.length == 1:
            lines.add_segment(f.at(first[0], first[1]), f.at(p[0], p[1]))
        else:
            lines.add_segment(f.at(first[0], first[1]), f.at(c[1][0], c[1][1]))
            lines.add_segment(f.at(c[1][0], c[1][1]), f.at(p[0], p[1]))

## A closed outline through `corners`.
func loop(lines: OverlayLines, e: SketchEditor, corners: list[list[float]]) -> unit!:
    let f = e.frame
    for at in 0..<corners.length:
        let a = corners[at]
        let b = corners[(at + 1) % corners.length]
        lines.add_segment(f.at(a[0], a[1]), f.at(b[0], b[1]))

## The circle through three points, or none (in a line).
func through(a: list[float], b: list[float], c: list[float]) -> list[float]?:
    let d = 2.0 * (a[0] * (b[1] - c[1]) + b[0] * (c[1] - a[1]) + c[0] * (a[1] - b[1]))
    if math.abs(d) <= 1e-12:
        return none
    let a2 = a[0] * a[0] + a[1] * a[1]
    let b2 = b[0] * b[0] + b[1] * b[1]
    let c2 = c[0] * c[0] + c[1] * c[1]
    return [(a2 * (b[1] - c[1]) + b2 * (c[1] - a[1]) + c2 * (a[1] - b[1])) / d, (a2 * (c[0] - b[0]) + b2 * (a[0] - c[0]) + c2 * (b[0] - a[0])) / d]

## The counterclockwise turn about `o` from `a` to `b` (0..2π).
func turn_to(o: list[float], a: list[float], b: list[float]) -> float:
    var t = math.atan2(b[1] - o[1], b[0] - o[0]) - math.atan2(a[1] - o[1], a[0] - o[0])
    while t <= 0.0:
        t += 2.0 * math.pi
    return t

## The square to side `a`–`b` toward `p`, and how far `p` is along it.
func across(a: list[float], b: list[float], p: list[float]) -> (float, float, float):
    let l = math.max(math.hypot(b[0] - a[0], b[1] - a[1]), 1e-300)
    let nx = -(b[1] - a[1]) / l
    let ny = (b[0] - a[0]) / l
    return (nx, ny, nx * (p[0] - a[0]) + ny * (p[1] - a[1]))

## Which side of line `line` (`x`, `y`) is, as Tangent keeps it.
func side_of(sketch: CadSketch, line: int, x: float, y: float) -> float:
    let a = sketch.part(line, 0)
    let b = sketch.part(line, 1)
    let cross = (sketch.x(b) - sketch.x(a)) * (y - sketch.y(a)) - (sketch.y(b) - sketch.y(a)) * (x - sketch.x(a))
    return 1.0 if cross >= 0.0 else -1.0
