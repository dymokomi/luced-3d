## Immutable per-node modeling recipes and topology guards.
from geocore import PolygonMesh, MeshOps, TopologyTools
from three import Vector3
import ui

pub class EditOperation:
    pub let kind: str
    pub let elements: list[int]
    pub let delta: Vector3
    pub let distance: float
    # Connectivity hash of the mesh the recipe was authored on (0: unguarded,
    # e.g. from an older project). Upstream transforms keep it; different
    # connectivity must not silently send edits to unrelated components.
    pub let topology: int
    ## Content hashes of the element list and of the whole recipe; node stamps
    ## and worker deltas use them, so large selections are hashed once.
    pub let elements_key: int
    pub let key: int

    pub func init(self, kind: str, elements: list[int], mesh: PolygonMesh, delta: Vector3, distance: float, recipe: int? = none) -> unit!:
        self.kind = kind
        self.elements = elements.copy()
        self.delta = delta
        self.distance = distance
        self.topology = recipe else mesh.topology_hash()
        self.elements_key = hash(self.elements)
        self.key = hash((kind, self.elements_key, delta.x, delta.y, delta.z, distance, self.topology))

    pub func evaluate(self, mesh: PolygonMesh) -> PolygonMesh!:
        if self.topology != 0 and self.topology != mesh.topology_hash():
            error(ui.invalid, "Edit input topology changed. Undo the upstream change or clear this node's edits.")
        if self.kind == "Extrude":
            return mesh.extruded_faces(self.elements, self.distance)
        if self.kind == "DeletePoints":
            return MeshOps.delete_points(mesh, self.elements)
        if self.kind == "Clean":
            return MeshOps.compact(mesh)
        if self.kind in ["Delete", "Reverse", "Triangulate", "Inset", "Duplicate", "Split"]:
            return MeshOps.faces(mesh, self.elements, ["Delete", "Reverse", "Triangulate", "Inset", "Duplicate", "Split"].index_of(self.kind) else 0, self.distance)
        if self.kind == "Fuse":
            return MeshOps.fuse(mesh, self.elements, self.distance)
        if self.kind == "Subdivide":
            return MeshOps.subdivide(mesh, true)
        if self.kind == "Bevel":
            return TopologyTools.bevel(mesh, self.distance)
        if self.kind == "Fill":
            return TopologyTools.fill(mesh, self.elements)
        if self.kind == "Dissolve":
            if self.elements.length != 1:
                error(ui.invalid, "Dissolve currently joins across one selected edge")
            return TopologyTools.dissolve(mesh, self.elements[0])
        if self.kind in ["Smooth", "Noise", "Peak", "Flatten", "Rotate", "Scale", "Snap"]:
            return MeshOps.points(mesh, self.elements, ["Smooth", "Noise", "Peak", "Flatten", "Rotate", "Scale", "Snap"].index_of(self.kind) else 0, self.distance, self.delta)
        if self.kind == "Move":
            return mesh.moved_points(self.elements, self.delta)
        error(ui.invalid, "Unknown edit operation")
