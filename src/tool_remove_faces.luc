## Remove Faces: faces taken away, the model left open (Edit CAD's step on
## the faces picked; edit_cad_faces.luc).
from tool_record import Tool, ToolEntry, Pick
from parameter_rows import Parameter
from edit_types import face_level, patch_level
import pick_kinds
import cad_cook

pub func entry() -> ToolEntry:
    return ToolEntry("Remove Faces", "Remove Faces", "subtract-from-selection", "Modify", [], [cad_cook.edit_kind], made)

func made() -> Tool:
    let none_shown: list[Parameter] = []
    return entry().tool("Modify", "Faces", "Take faces away and leave the model open", [Pick("Faces", [face_level, patch_level], kind = pick_kinds.faces, slot = pick_kinds.nowhere)],
                        none_shown, cad_cook.face_step, numbers = [0.0])
