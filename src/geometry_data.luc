## Typed DAG payload. CAD stays analytic until an explicit conversion node.
## Additional geometry families belong here, not in a polygon-only File contract.
from three import PolygonMesh, Vector3, Matrix4
from cad import CadModel
from cad_preview import CadPreview
from geometry_groups import GeometryGroup
import ui

pub class GeometryInstance:
    pub let data: GeometryData
    pub let translation: Vector3
    pub let rotation: Vector3
    pub let scale: Vector3
    pub let visible: bool
    pub func init(self, data: GeometryData, translation: Vector3? = none, rotation: Vector3? = none, scale: Vector3? = none, visible: bool = true):
        self.data = data
        self.translation = translation else Vector3()
        self.rotation = rotation else Vector3()
        self.scale = scale else Vector3(1.0, 1.0, 1.0)
        self.visible = visible

pub class GeometryData:
    var preview_cache: CadPreview? = none
    ## Content key of the import this data was parsed from (0: derived data).
    pub var origin: int = 0
    pub let mesh: PolygonMesh?
    pub let surfaces: list[CadModel]
    pub let instances: list[GeometryInstance]
    pub let groups: list[GeometryGroup]

    pub func init(self, mesh: PolygonMesh? = none, surfaces: list[CadModel]? = none, instances: list[GeometryInstance]? = none, groups: list[GeometryGroup]? = none):
        self.mesh = mesh
        self.surfaces = (surfaces else []).copy()
        self.instances = (instances else []).copy()
        self.groups = (groups else []).copy()

    pub func paths(self) -> list[str]:
        let result: list[str] = []
        for group in self.groups:
            if group.faces.length > 0 and not (group.path in result): result.append(group.path)
        for instance in self.instances:
            for path in instance.data.paths():
                if not (path in result): result.append(path)
        return result

    pub func require_mesh(self) -> PolygonMesh!:
        if self.surfaces.length > 0:
            error(ui.invalid, "This operation requires polygons; connect a Tessellate node first")
        var result = self.mesh else PolygonMesh.empty()
        for instance in self.instances:
            let mesh = instance.data.require_mesh().transformed(instance.translation, instance.rotation, instance.scale)
            result = result.merged(mesh)
        return result

    pub func preview(self, progress: func(float) -> unit!? = none) -> CadPreview!:
        if let cached = self.preview_cache:
            return cached
        let result = CadPreview(self.surfaces, progress = progress)
        self.preview_cache = result
        return result

    pub func merged(self, other: GeometryData) -> GeometryData!:
        var polygons = self.mesh
        if let incoming = other.mesh:
            if let existing = polygons:
                polygons = existing.merged(incoming)
            else:
                polygons = incoming
        let groups = self.groups.copy()
        var offset = 0
        if let mesh = self.mesh: offset = mesh.face_count()
        for group in other.groups:
            let faces: list[int] = []
            for face in group.faces: faces.append(face + (offset if group.model < 0 else 0))
            groups.append(GeometryGroup(group.path, faces, group.model + self.surfaces.length if group.model >= 0 else -1))
        return GeometryData(polygons, self.surfaces + other.surfaces, self.instances + other.instances, groups)

    pub func transformed(self, translation: Vector3, rotation: Vector3, scale: Vector3) -> GeometryData!:
        if Matrix4.compose(translation, rotation, scale).is_identity():
            return self
        let models: list[CadModel] = []
        for model in self.surfaces:
            models.append(model.transformed(translation, rotation, scale))
        var polygons: PolygonMesh? = none
        if let mesh = self.mesh:
            polygons = mesh.transformed(translation, rotation, scale)
        let children: list[GeometryInstance] = []
        if self.instances.length > 0:
            children.append(GeometryInstance(GeometryData(instances = self.instances), translation, rotation, scale))
        let result = GeometryData(polygons, models, children, self.groups)
        if let cached = self.preview_cache:
            result.preview_cache = CadPreview([], cached, Matrix4.compose(translation, rotation, scale))
        return result

    pub func tessellated(self, divisions: int, edge_size: float = 0.0, progress: func(float) -> unit!? = none) -> GeometryData!:
        var result = self.mesh
        let groups: list[GeometryGroup] = []
        for group in self.groups:
            if group.model < 0: groups.append(group)
        for model_index in 0..<self.surfaces.length:
            let model = self.surfaces[model_index]
            let part = model.tessellate(divisions, edge_size, progress)
            let source = part.find_attribute("cad_face", 2)
            var offset = 0
            if let mesh = result: offset = mesh.face_count()
            let owners: list[int] = []
            for face in 0..<model.face_count(): owners.append(-1)
            let mapped: list[list[int]] = []
            let names: list[str] = []
            for group in self.groups:
                if group.model != model_index: continue
                for face in group.faces: owners[face] = mapped.length
                mapped.append([])
                names.append(group.path)
            if source >= 0:
                for face in 0..<part.face_count():
                    let original = int(part.attribute_value(source, face))
                    if original >= 0 and original < owners.length and owners[original] >= 0:
                        mapped[owners[original]].append(offset + face)
            for index in 0..<mapped.length:
                groups.append(GeometryGroup(names[index], mapped[index]))
            if let mesh = result:
                result = mesh.merged(part)
            else:
                result = part
        let children: list[GeometryInstance] = []
        for instance in self.instances:
            children.append(GeometryInstance(instance.data.tessellated(divisions, edge_size, progress), instance.translation, instance.rotation, instance.scale, instance.visible))
        return GeometryData(result, instances = children, groups = groups)

    ## Approximate resident bytes, for the worker's result-store budget. Shared
    ## meshes count once per holder, which errs toward evicting early.
    pub func footprint(self) -> int:
        var total = 256
        if let mesh = self.mesh:
            total += mesh_bytes(mesh)
        for model in self.surfaces:
            total += model.face_count() * 16384
        if let preview = self.preview_cache:
            for mesh in preview.meshes:
                total += mesh_bytes(mesh)
            total += (preview.boundaries.length + preview.normal_guides.length) * 32
        for instance in self.instances:
            total += instance.data.footprint()
        return total

    pub func description(self) -> str!:
        var faces = 0
        for model in self.surfaces:
            faces += model.face_count()
        var text = f"{faces} CAD surfaces" if faces > 0 else ""
        if let mesh = self.mesh:
            text += (" / " if text != "" else "") + f"{mesh.point_count()} points / {mesh.face_count()} faces / {mesh.attribute_count()} attributes"
        if self.instances.length > 0:
            text += (" / " if text != "" else "") + f"{self.instances.length} scene branches"
        return text if text != "" else "Empty geometry"

func mesh_bytes(mesh: PolygonMesh) -> int:
    return 256 + mesh.point_count() * 24 + mesh.vertex_count() * 40 + mesh.face_count() * 56 + mesh.index_count() * 8 + mesh.edge_count() * 16
