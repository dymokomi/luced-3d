## A node's cooked result: a thin wrapper around luce-geocore's GeometrySet,
## which holds its mesh, CAD models (luce-cad's family), point cloud and
## instances. The set is immutable and shares its arrays; what this class
## adds is Luce-side caching: the CAD preview meshes, and wrappers of the
## instances' sets so their previews persist too. CAD stays analytic until a
## Tessellate node.
from geocore import Mesh, GeometrySet, Fields
from three import Vector3, Matrix4
from cad import CadModel
from cad_geometry import CadGeometry
from cad_preview import CadPreview, tessellation_warning

pub class GeometryData:
    pub let geometry: GeometrySet
    ## The set's own mesh (not its instances').
    pub let mesh: Mesh?
    ## Content key of the import this data was parsed from (0: derived data).
    pub var origin: int = 0
    ## What the node that made this data wants the user to know, although it
    ## succeeded ("nothing to fill; the input passes through").
    pub var warning: str = ""
    var preview_cache: CadPreview? = none
    ## Wrappers of the instances' sets, made once, in instance order.
    var children: list[GeometryData]? = none
    ## The surface preview of the set's SDF and volume, made once.
    var field_cache: Mesh? = none
    var field_checked: bool = false

    pub func init(self, mesh: Mesh? = none, geometry: GeometrySet? = none) -> unit!:
        var chosen = geometry else GeometrySet()
        if geometry == none:
            if let polygons = mesh:
                chosen = GeometrySet.of_mesh(polygons)
        self.geometry = chosen
        self.mesh = chosen.mesh() if geometry != none else mesh

    pub func models(self) -> list[CadModel]!:
        let result: list[CadModel] = []
        for index in 0..<CadGeometry.model_count(self.geometry):
            result.append(CadGeometry.model(self.geometry, index))
        return result

    pub func has_cad(self) -> bool!:
        return CadGeometry.model_count(self.geometry) > 0

    ## What the viewport draws for the set's own SDF and volume: their
    ## surface (luce-geocore keeps it with the component), or none.
    pub func field_preview(self) -> Mesh?!:
        if not self.field_checked:
            self.field_checked = true
            if Fields.present(self.geometry):
                self.field_cache = Fields.preview(self.geometry)
        return self.field_cache

    # -- Instances.

    pub func instance_count(self) -> int:
        return self.geometry.instance_count()

    ## Instance `index`'s data; the same object on every call.
    pub func instance(self, index: int) -> GeometryData!:
        if self.children == none:
            let made: list[GeometryData] = []
            for at in 0..<self.geometry.instance_count():
                made.append(GeometryData(geometry = self.geometry.instance(at)))
            self.children = made
        return (self.children else [])[index]

    pub func instance_translation(self, index: int) -> Vector3!:
        return self.geometry.instance_translation(index)
    ## XYZ radians.
    pub func instance_rotation(self, index: int) -> Vector3!:
        return self.geometry.instance_rotation(index)
    pub func instance_scale(self, index: int) -> Vector3!:
        return self.geometry.instance_scale(index)
    pub func instance_visible(self, index: int) -> bool!:
        return self.geometry.instance_visible(index)
    pub func instance_matrix(self, index: int) -> Matrix4!:
        return Matrix4.compose(self.geometry.instance_translation(index), self.geometry.instance_rotation(index), self.geometry.instance_scale(index))

    ## This data with `child` added as an instance; `child` keeps serving as
    ## the new instance's data (and its preview).
    pub func with_instance(self, child: GeometryData, translation: Vector3? = none, rotation: Vector3? = none, scale: Vector3? = none, visible: bool = true) -> GeometryData!:
        let result = GeometryData(geometry = self.geometry.with_instance(child.geometry, translation else Vector3(), rotation else Vector3(), scale else Vector3(1.0, 1.0, 1.0), visible))
        let kept: list[GeometryData] = []
        for index in 0..<self.instance_count():
            kept.append(self.instance(index))
        kept.append(child)
        result.children = kept
        return result

    # -- Whole-data operations.

    pub func paths(self) -> list[str]!:
        let text = self.geometry.paths()
        return [] if text == "" else text.split("\n")

    ## One mesh of every polygon, instances baked; fails on CAD (Tessellate
    ## first).
    pub func require_mesh(self) -> Mesh!:
        if self.instance_count() == 0:
            if let mesh = self.mesh:
                if not self.has_cad(): return mesh
        return self.geometry.realized()

    ## What mesh operators work on: the set's own mesh; without one, the
    ## polygons of its instances realized (CAD fails and asks for a
    ## Tessellate node, as before). None when there are no polygons: the other
    ## components pass mesh operators through, as in Houdini.
    pub func operand(self) -> Mesh?!:
        if let mesh = self.mesh:
            return mesh
        if self.instance_count() > 0 or self.has_cad():
            return self.require_mesh()
        return none

    ## This data with `mesh` in place of what `operand` gave: every other
    ## component kept (shared); instances realized into it go.
    pub func with_operand(self, mesh: Mesh) -> GeometryData!:
        var geometry = self.geometry.with_mesh(mesh)
        if self.mesh == none and self.instance_count() > 0:
            geometry = geometry.without("instances")
        return GeometryData(geometry = geometry)

    ## This data unchanged, with a warning for the node that passed it on.
    pub func passed(self, warning: str) -> GeometryData!:
        let result = GeometryData(geometry = self.geometry)
        result.warning = warning
        return result

    pub func preview(self, progress: func(float) -> unit!? = none) -> CadPreview!:
        if let cached = self.preview_cache:
            return cached
        let result = CadPreview(self.models(), progress = progress)
        self.preview_cache = result
        return result

    pub func merged(self, other: GeometryData) -> GeometryData!:
        let result = GeometryData(geometry = self.geometry.merged(other.geometry))
        # Instances of both keep their wrappers (and previews).
        if self.instance_count() + other.instance_count() > 0:
            let kept: list[GeometryData] = []
            for index in 0..<self.instance_count():
                kept.append(self.instance(index))
            for index in 0..<other.instance_count():
                kept.append(other.instance(index))
            result.children = kept
        return result

    ## Placed by translation, rotation (XYZ radians) and scale. Instances are
    ## wrapped in one instance under the placement; a CAD preview is placed
    ## rather than remade.
    pub func transformed(self, translation: Vector3, rotation: Vector3, scale: Vector3) -> GeometryData!:
        if Matrix4.compose(translation, rotation, scale).is_identity():
            return self
        let result = GeometryData(geometry = self.geometry.transformed(translation, rotation, scale))
        if self.instance_count() > 0:
            let inner = GeometryData(geometry = result.geometry.instance(0))
            let kept: list[GeometryData] = []
            for index in 0..<self.instance_count():
                kept.append(self.instance(index))
            inner.children = kept
            result.children = [inner]
        if let cached = self.preview_cache:
            result.preview_cache = CadPreview([], cached, Matrix4.compose(translation, rotation, scale))
        return result

    pub func tessellated(self, divisions: int, edge_size: float = 0.0, progress: func(float) -> unit!? = none) -> GeometryData!:
        let result = GeometryData(geometry = CadGeometry.tessellated(self.geometry, divisions, edge_size, progress))
        if let mesh = result.mesh:
            result.warning = tessellation_warning(mesh)
        return result

    ## Elements whose object path matches `expression` kept, or removed.
    pub func blasted(self, expression: str, keep: bool) -> GeometryData!:
        return GeometryData(geometry = self.geometry.blasted(expression, keep))

    ## Resident bytes for the worker's result store: shared arrays count once
    ## within a result, and CAD previews on top.
    pub func footprint(self) -> int!:
        var total = 256 + self.geometry.footprint()
        if let preview = self.preview_cache:
            for mesh in preview.meshes:
                total += 256 + mesh.column_bytes()
            total += preview.point_count() * 24
        for child in self.children else []:
            if child.preview_cache != none: total += child.footprint()
        return total

    pub func description(self) -> str!:
        return self.geometry.description()

## Analytic CAD, as a File node imports it.
pub func cad_data(model: CadModel) -> GeometryData!:
    return GeometryData(geometry = CadGeometry.of_model(model))
