## Stretch (Alias's): a curve reshaped by handles anywhere along it, up to
## degree + 1, dragged in the viewport (stretch_handles.luc).
## An Edit CAD step on the curves picked at the Curves level
## (edit_cad_curves.luc).
from tool_record import Tool, ToolEntry, Pick
from parameter_rows import Parameter
from edit_types import curve_level
import pick_kinds
import edit_cad_curves
import cad_cook

pub func entry() -> ToolEntry:
    return ToolEntry(edit_cad_curves.stretch_verb, edit_cad_curves.stretch_verb, "scale-tool", "Curves", [], [cad_cook.edit_kind], made, verb = edit_cad_curves.stretch_verb)

func made() -> Tool:
    return entry().tool("Modify", "Curves", "Reshape a curve by dragging handles along it", [Pick("Curves", [curve_level], kind = pick_kinds.curves, slot = pick_kinds.nowhere)], rows(), edit_cad_curves.cook,
                        numbers = edit_cad_curves.stretch_numbers())

func rows() -> list[Parameter]:
    return edit_cad_curves.stretch_rows()
