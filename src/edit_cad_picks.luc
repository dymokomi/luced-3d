## Edit CAD steps waiting for a pick (edit_cad_commands.luc starts them):
## Replace Face's target face, Combine's tool bodies, Split Body's
## splitting face, Revolve's axis (an edge here; a sketch line through
## axis_pick.luc) and Extrude's To object face. The step is already the
## recipe's last, failing until it has what it needs, so the model as the
## steps before it left it shows to pick on; the pick goes into the step and
## the prompt with the step is one undo step (Esc takes both away).
from luce_geocore.geocore import Domain, Mesh, Selection
from workspace import Workspace
from node import Node
from tool_prompt import ToolPrompt
import edit_cad_faces
import cad_features
import cad_moves
import cad_names
from edit_types import edge_level

## The prompts Edit CAD's steps wait in.
pub let target_label = "Pick target faces"
pub let tools_label = "Pick tool bodies"
pub let splitting_label = "Pick splitting face"
pub let axis_label = "Pick revolve axis"
pub let object_label = "Pick extent face"
pub let plane_label = "Pick sketch plane"
## Move/Copy's picks: its points and the edge it turns about.
pub let from_label = "Pick from point"
pub let to_label = "Pick to point"
pub let pivot_label = "Pick pivot"
pub let rotate_label = "Pick rotate axis"

## The last step waits for prompt `label` at level `level`: the model as
## the steps before it left it shows, and what is picked goes into it.
pub func wait_for(w: Workspace, node: Node, label: str, level: int, hint: str) -> unit!:
    w.prompt = ToolPrompt(node.id, node.id, label, true)
    w.adopt_level(level)
    w.selection = none
    w.pending_changed = true
    say(w, hint)
    w.rebuild()

## Whether prompt `label` is one of Edit CAD's.
pub func waits(label: str) -> bool:
    return label in [target_label, tools_label, splitting_label, axis_label, object_label, plane_label, from_label, to_label, pivot_label, rotate_label]

## The selection changed while the last step waits: what was picked goes
## into it (a face's name, the tool bodies' group, an edge as the axis);
## a single pick finishes the prompt.
pub func follow_pick(w: Workspace, node: Node, mesh: Mesh, chosen: Selection) -> unit!:
    let prompt = w.prompt else return
    if node.edits.length == 0:
        return
    let step = node.edits[-1]
    let first = chosen.next(-1)
    if prompt.label == tools_label:
        if not w.on_domain(Domain.face):
            return
        node.edits[-1] = step.with_texts([chosen.expression(mesh) if chosen.count() > 0 else ""])
        w.network.invalidate(node.id)
        w.pending_changed = true
        w.rebuild()
        return
    if prompt.label == target_label:
        # Replace Face's targets: every face clicked (Shift adds); Enter
        # finishes, as Fusion's Target Faces field.
        if not w.on_domain(Domain.face):
            return
        let column = mesh.find_attribute("cad_face_name", 2)
        let names: list[str] = []
        var at = first
        while at >= 0 and column >= 0:
            let name = mesh.attribute_text(column, at)
            if name != "" and not (name in names):
                names.append(name)
            at = chosen.next(at)
        node.edits[-1] = step.with_texts([names.join(";")])
        w.network.invalidate(node.id)
        w.pending_changed = true
        w.rebuild()
        return
    if first < 0:
        return
    if prompt.label in [from_label, to_label, pivot_label, rotate_label]:
        moved_pick(w, node, prompt.label, mesh, first)
        return
    if prompt.label == axis_label:
        let references = mesh.find_attribute("cad_edge_reference", 4)
        if references < 0 or not w.on_domain(Domain.edge):
            return
        let reference = mesh.attribute_text(references, first)
        if reference == "":
            say(w, "This edge has no name to keep")
            return
        set_axis(w, node, cad_features.edge_axis(reference))
        return
    let names = mesh.find_attribute("cad_face_name", 2)
    if names < 0 or not w.on_domain(Domain.face):
        return
    let name = mesh.attribute_text(names, first)
    if name == "":
        say(w, "This face has no name to keep")
        return
    if prompt.label == object_label:
        let texts = [step.text(0), step.text(1), step.text(2), step.text(3)]
        texts[cad_features.face_text] = name
        node.edits[-1] = step.with_texts(texts)
    elif prompt.label == plane_label:
        # Redefine Sketch Plane: the face the sketch goes onto.
        node.edits[-1] = step.with_texts([step.text(0), name, step.text(2)])
    else:
        node.edits[-1] = step.with_texts([name])
        if step.verb == "Split Body":
            let numbers = step.numbers.copy()
            numbers[edit_cad_faces.split_tool_slot] = 0.0
            node.edits[-1] = node.edits[-1].with_numbers(numbers)
    finish_pick(w, node)

## Move/Copy's pick `label` took edge `edge` of the pick mesh: a point
## (the B-rep edge's nearer end, a round edge's middle) into the step's
## numbers, or the edge into its rotate axis; Point to point asks for its
## To point next.
func moved_pick(w: Workspace, node: Node, label: str, mesh: Mesh, edge: int) -> unit!:
    if not w.on_domain(Domain.edge):
        return
    let step = node.edits[-1]
    if label == rotate_label:
        let references = mesh.find_attribute("cad_edge_reference", 4)
        let reference = mesh.attribute_text(references, edge) if references >= 0 else ""
        if reference == "":
            say(w, "This edge has no name to keep")
            return
        node.edits[-1] = step.with_texts(["", reference])
        finish_pick(w, node)
        return
    let at = cad_names.edge_point(mesh, edge)
    let slot = cad_moves.from_slot if label == from_label else (cad_moves.to_slot if label == to_label else cad_moves.pivot_point_slot)
    let numbers = step.numbers.copy()
    while numbers.length < cad_moves.move_count:
        numbers.append(0.0)
    numbers[slot] = at.x
    numbers[slot + 1] = at.y
    numbers[slot + 2] = at.z
    node.edits[-1] = step.with_numbers(numbers)
    finish_pick(w, node)
    if label == from_label and int(numbers[cad_moves.type_slot]) == 3:
        pick_move(w, to_label)

## Move/Copy waits for pick `label` (its points, its pivot, its axis) on
## the edited model's edges.
pub func pick_move(w: Workspace, label: str) -> unit!:
    let node = w.selected() else return
    if w.in_transaction() or node.edits.length == 0 or node.edits[-1].verb != "Transform Components":
        return
    w.begin(label)
    # While a point is picked the move stands still (From and To alike), so
    # the model is picked on where it was.
    if label in [from_label, to_label]:
        let numbers = node.edits[-1].numbers.copy()
        while numbers.length < cad_moves.move_count:
            numbers.append(0.0)
        let (still, moving) = (cad_moves.to_slot, cad_moves.from_slot) if label == from_label else (cad_moves.from_slot, cad_moves.to_slot)
        for k in 0..<3:
            numbers[moving + k] = numbers[still + k]
        node.edits[-1] = node.edits[-1].with_numbers(numbers)
        w.network.invalidate(node.id)
    wait_for(w, node, label, edge_level, f"{label}: click near a corner or an edge's end (a round edge: its middle); Esc cancels")

## The waiting Revolve's axis: `axis` (a picked sketch line's or edge's).
pub func set_axis(w: Workspace, node: Node, axis: str) -> unit!:
    let step = node.edits[-1]
    let texts = [step.text(0), step.text(1), step.text(2), step.text(3)]
    texts[cad_features.axis_text] = axis
    let numbers = step.numbers.copy()
    numbers[cad_features.axis_slot] = 0.0
    node.edits[-1] = step.with_texts(texts).with_numbers(numbers)
    w.ask_value = false
    finish_pick(w, node)

## Enter while a step waits: kept as it stands (Combine's tools, Replace
## Face's targets, a Split by an origin plane chosen in the tool bar).
pub func accept_pick(w: Workspace, node: Node) -> unit!:
    finish_pick(w, node)

## The pick is made: one undo step with the step it completes.
func finish_pick(w: Workspace, node: Node) -> unit!:
    w.network.invalidate(node.id)
    w.prompt = none
    w.peeking = false
    w.selection = none
    w.notice = ""
    w.pending_changed = true
    w.commit()
    w.rebuild()

func say(w: Workspace, text: str):
    w.notice = text
    w.revision += 1
