## Surfacing's commands (the right-click menu, the S marking menu and
## Modify › Surfaces): Project, Intersect, Trim, Untrim, Trim Convert,
## Shrink, Stitch, Unstitch (Stage 3), Align and Symmetry Align (Stage 4,
## on a picked edge or curve end), and the surfaces from curves (Stage 5:
## Square, Skin, Rail, Profile, Set Planar, Sheet Extrude, Sheet Revolve on
## picked curves or edges, Extend on an edge or a curve's end). In a CAD network each makes its node
## (cad_surface_nodes.luc) after the displayed one, taking what is selected
## (faces by name, Project's curves, the bodies the faces are on), then
## waits for what it still needs (modify_picks.luc); a Trim then shows its
## region markers to click. In an edited Edit CAD model the same commands
## are its steps (edit_cad_surfaces.luc, edit_cad_commands.luc). Each is
## one undo step and says why when it does not apply.
from luce_ui.ui import Command
from interop import Connection
from luce_geocore.geocore import Domain
from workspace import Workspace
from tools import ToolRun
from edit_steps import insert_after_display
from edit_types import curve_level, edge_level
from tool_icons import asset_name
import cad_commands
import cad_names
import cad_surface_nodes
import edit_cad_commands
import edit_cad_surfaces
import modify_picks
import edit_cad_align
import edit_cad_build
import align_ops
import build_ops

## The commands, in Alias's Surface Edit order.
pub func command_names() -> list[str]:
    return cad_surface_nodes.kinds()

## The commands that act on picked faces (the right-click on faces).
pub func face_names() -> list[str]:
    return edit_cad_surfaces.face_verbs()

pub class SurfaceActions:
    let w: Workspace
    ## One command a node (names' order), and the submenu holding them.
    pub let commands: list[Command]
    pub let menu: Command
    let connections: list[Connection]

    pub func init(self, w: Workspace) -> unit!:
        self.w = w
        self.commands = []
        self.connections = []
        for name in command_names():
            let made = name
            let command = Command(name, id = command_id(name), icon = asset_name(name))
            self.commands.append(command)
            self.connections.append(command.on_trigger(func () -> unit!:
                w.last_cad_tool = command_id(made)
                w.last_cad_name = made
                if edit_cad_commands.active(w):
                    edit_cad_commands.tool(w, made)
                else:
                    surface(w, made)))
        self.menu = Command("Surfaces", id = "cad_surfaces", icon = asset_name("Surfaces"))
        self.menu.set_items(self.commands)

    ## Enabled in a CAD network (not while sketching); in Edit CAD where its
    ## step applies to the level, with something selected.
    pub func refresh(self) -> unit!:
        let w = self.w
        let cad = w.network.context() == "cad" and not w.sketching()
        let model = edit_cad_commands.active(w)
        var any = false
        for command in self.commands:
            var enabled = cad
            if cad and model:
                let available = w.tool_available(command.text()) catch failure:
                    recover false
                enabled = available and w.selected_count() > 0
            command.set_enabled(enabled)
            any = any or enabled
        self.menu.set_enabled(any)

    ## The commands acting on a picked edge or curve end (Align's input,
    ## Extend's) and on picked edges as curves (the builders).
    pub func on_edges(self) -> list[Command]:
        let result: list[Command] = []
        for command in self.commands:
            if command.text() in [cad_surface_nodes.align_kind, cad_surface_nodes.symmetry_kind, build_ops.extend_verb] or command.text() in build_ops.curve_verbs():
                result.append(command)
        return result

    ## The commands acting on picked faces.
    pub func on_faces(self) -> list[Command]:
        let result: list[Command] = []
        for command in self.commands:
            if command.text() in face_names():
                result.append(command)
        return result

    pub func close(self):
        for connection in self.connections:
            connection.disconnect()
        self.connections.clear()

## The id of node `kind`'s command (the marking menus' Repeat finds it).
pub func command_id(kind: str) -> str:
    return "cad_surface_" + kind.lower().replace(" ", "_")

## Node `kind` after the displayed node, taking the selection, then the
## first input it still waits for.
pub func surface(w: Workspace, kind: str) -> unit!:
    if w.network.context() != "cad" or w.sketching():
        w.notice = f"{kind}: enter a CAD node first"
        w.revision += 1
        return
    let faces = cad_commands.selected_faces(w)
    let curves = selected_curves(w)
    let bodies = selected_bodies(w)
    let align_input = selected_align_input(w)
    let curve_words = selected_curve_words(w)
    w.perform(kind, func () -> unit!:
        let node = insert_after_display(w, ToolRun(kind, cad_surface_nodes.starting(kind)))
        let first = cad_surface_nodes.first_text
        if kind == cad_surface_nodes.project_kind:
            node.texts[first] = curves.join(";")
        elif kind == cad_surface_nodes.stitch_kind:
            node.texts[first] = bodies.join(";")
        elif kind == cad_surface_nodes.unstitch_kind:
            node.texts[first] = bodies[0] if bodies.length > 0 else ""
        elif kind in [cad_surface_nodes.align_kind, cad_surface_nodes.symmetry_kind, build_ops.extend_verb]:
            node.texts[align_ops.input_text] = align_input
        elif kind in build_ops.curve_verbs():
            node.texts[build_ops.curves_text] = curve_words.join(";")
        elif faces.length > 0:
            node.texts[first] = faces[0]
            if kind == cad_surface_nodes.intersect_kind and faces.length > 1:
                node.texts[cad_surface_nodes.second_text] = faces[1]
        w.network.picked = [node.id]
        w.selection = none
        w.rebuild())
    let made = w.selected() else return
    if made.kind != kind:
        return
    if let input = modify_picks.next_input(made):
        modify_picks.start(w, made.id, input)

## Align's input as words: the edge selected (the Edges level) or the
## curve's end nearest its picked segment (the Curves level); "" none.
func selected_align_input(w: Workspace) -> str!:
    if w.sketching() or not w.selecting():
        return ""
    let mesh = w.geometry else return ""
    let chosen = w.current_selection() else return ""
    let words = edit_cad_align.pick_words(mesh, chosen.next(-1), w.level_index(), false) catch failure:
        recover ""
    return words

## The curves (the Curves level) or edges selected as a builder's words,
## in order.
func selected_curve_words(w: Workspace) -> list[str]!:
    if w.sketching() or not w.selecting():
        return []
    let mesh = w.geometry else return []
    let chosen = w.current_selection() else return []
    let level = w.level_index()
    if level != curve_level and level != edge_level:
        return []
    let words = edit_cad_build.picked_words(mesh, chosen, level, false) catch failure:
        recover []
    return words

## The names of the curves selected (the Curves level), each once.
func selected_curves(w: Workspace) -> list[str]!:
    if w.sketching() or not w.selecting() or w.level_index() != curve_level:
        return []
    let mesh = w.geometry else return []
    let chosen = w.current_selection() else return []
    let names = mesh.find_attribute("cad_curve_name", 4)
    let found: list[str] = []
    if names < 0:
        return found
    var at = chosen.next(-1)
    while at >= 0:
        let name = mesh.attribute_text(names, at)
        if name != "" and not (name in found):
            found.append(name)
        at = chosen.next(at)
    return found

## The bodies the selection is on, each by one of its faces' names.
func selected_bodies(w: Workspace) -> list[str]!:
    if w.sketching() or not w.selecting() or not w.on_domain(Domain.face):
        return []
    let mesh = w.geometry else return []
    let chosen = w.current_selection() else return []
    if chosen.count() == 0:
        return []
    let names = cad_names.model_names(mesh, chosen.expression(mesh))
    return names.split(";") if names != "" else []
