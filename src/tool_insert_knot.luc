## Insert Knot (Alias's): a knot added across U or V, as many times as asked
## up to the degree; the surface keeps its shape (luce-cad's CadNurbs).
## An Edit CAD step on the surface of the first CV or face picked
## (edit_cad_nets.luc).
from tool_record import Tool, ToolEntry, Pick
from edit_types import point_level, face_level, patch_level
import pick_kinds
import edit_cad_nets
import cad_cook

pub func entry() -> ToolEntry:
    return ToolEntry(edit_cad_nets.insert_verb, edit_cad_nets.insert_verb, "loop-cut", "Modify", [], [cad_cook.edit_kind], made)

func made() -> Tool:
    return entry().tool("Modify", "Surface Structure", "Add a knot to a surface where it is, the shape kept", [Pick("Surface", [point_level, face_level, patch_level], kind = pick_kinds.components, slot = pick_kinds.nowhere)],
                        edit_cad_nets.insert_rows(), edit_cad_nets.cook, numbers = [0.0, 0.5, 1.0])
