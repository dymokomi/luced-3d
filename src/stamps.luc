## Content stamps: a node's stamp names its cooked result. It covers what
## compute reads (kind, bypass, parameters, texts, Edit recipes, the file
## epoch, every input's stamp and the object paths it hides), never names,
## positions, display flags, selection or the Edit tool amount. Flags affect
## only what a level yields: a container's stamp lists the stamps of what it
## yields (Network.outputs), and a Render node's those of the root's objects.
## An Import node's lists its source's stamp and the steps that place it.
from network import Network
from node import Node
from cache_node import reads_file, cache_stamp, frozen_stamp
from edit_kinds import is_edit
import node_catalog
import script_cook

## Stamp every node. Computed on the UI thread before each request; cheap,
## since Edit recipes carry their own precomputed content keys.
pub func stamp_graph(graph: Network) -> unit!:
    let done: map[int, int] = {}
    for node in graph.nodes:
        node.stamp = stamp_of(graph, node, done, 0)

func stamp_of(graph: Network, node: Node, done: map[int, int], depth: int) -> int!:
    if let known = done[node.id]:
        return known
    if depth > 256:
        trap("node stamps exceed the graph depth budget")
    let inputs: list[int] = []
    for input in node.inputs:
        if let upstream = graph.find(input):
            inputs.append(stamp_of(graph, upstream, done, depth + 1))
        else:
            inputs.append(0)
    let children: list[int] = []
    if node.kind == "Input":
        let source = graph.find(graph.context_input(node))
        if let upstream = source:
            inputs.append(stamp_of(graph, upstream, done, depth + 1))
        else:
            inputs.append(0)
    if node_catalog.collects_children(node.kind):
        for child in graph.outputs(node.id):
            children.append(stamp_of(graph, child, done, depth + 1))
    # Render renders the root's flagged objects.
    if node.kind == "Render":
        for child in graph.outputs(-1):
            children.append(stamp_of(graph, child, done, depth + 1))
    # An Import reads its source, placed (a source that reads the Import
    # fails its cook; it is not followed, so stamping ends).
    if let source = graph.import_source(node):
        if not graph.depends_on(source.id, node.id):
            children.append(stamp_of(graph, source, done, depth + 1))
            children.append(nonzero(graph.import_steps(node, source).hash()))
    # A Material reads every node inside it.
    if node.kind == "Material":
        for child in graph.children(node.id):
            children.append(nonzero((stamp_of(graph, child, done, depth + 1), child.enabled).hash()))
    var stamp = 0
    if node.frozen != "":
        stamp = frozen_stamp(node.frozen)
    elif is_edit(node.kind) and node.enabled:
        stamp = prefix_stamp(node, inputs[0], node.edits.length)
    elif is_edit(node.kind):
        # A bypassed Edit passes its input through; its own values are UI state.
        stamp = nonzero((node.kind, false, inputs).hash())
    elif node.kind == "Cache":
        stamp = stamp_cache(node, inputs)
    else:
        # An Import's path is a name: what it reads is in `children`.
        let texts: list[str] = [] if node.kind == "Import" else node.texts
        stamp = nonzero((node.kind, node.enabled, node.values, texts, inputs, node.sources, children, node.source_revision, node.guard, graph.direct_children(node)).hash())
    # A Script node reads its file parameters' files: an edited file recooks it.
    if node.kind == script_cook.kind_name and node.frozen == "":
        stamp = nonzero((stamp, script_cook.file_stamps(node.texts, graph.folder)).hash())
    # A result that follows the timeline is a new result each frame.
    if node.time_dependent and node.frozen == "":
        stamp = nonzero((stamp, graph.frame, graph.fps).hash())
    # Hidden objects leave the result after the cook (an Edit node's recipe
    # prefixes keep the whole result).
    if node.hidden.length > 0:
        stamp = nonzero((stamp, node.hidden).hash())
    done[node.id] = stamp
    return stamp

## A Cache node's stamp: from its path and input while it writes (Load from
## disk off, or bypassed); from its file while it reads, so upstream edits
## stop there and downstream results survive the switch (cache_node.luc).
func stamp_cache(node: Node, inputs: list[int]) -> int!:
    let written = nonzero(("Cache", node.enabled, node.texts[0].trim(), inputs, node.source_revision).hash())
    return cache_stamp(reads_file(node.kind, node.enabled, node.values), node.texts[0], node.source_revision, written)

## An enabled Edit node's result after its first `count` recipes. The full
## count is the node's own stamp, so the state before a new recipe (or a
## gizmo drag's preview recipe) is already stored under count - 1.
pub func prefix_stamp(node: Node, input: int, count: int) -> int:
    let recipes: list[int] = []
    for at in 0..<count:
        recipes.append(node.edits[at].key)
    return nonzero((node.kind, input, recipes).hash())

## Zero means "never cooked" on both sides of the worker boundary.
func nonzero(value: int) -> int:
    return value if value != 0 else 1
