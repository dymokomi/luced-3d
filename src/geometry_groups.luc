## Named primitive groups, independent of node identity and viewport state.
## model = -1 identifies polygon faces; nonnegative IDs address analytic models.
pub class GeometryGroup:
    pub let path: str
    pub let model: int
    pub let faces: list[int]
    pub func init(self, path: str, faces: list[int], model: int = -1):
        self.path = path
        self.faces = faces.copy()
        self.model = model

## Glob matching is linear with backtracking only to the latest '*'.
pub func glob(pattern: str, value: str) -> bool:
    var p = 0
    var v = 0
    var star = -1
    var retry = 0
    while v < value.length:
        if p < pattern.length and (pattern[p..<p + 1] == "?" or pattern[p..<p + 1] == value[v..<v + 1]):
            p += 1
            v += 1
        elif p < pattern.length and pattern[p..<p + 1] == "*":
            star = p
            p += 1
            retry = v
        elif star >= 0:
            retry += 1
            v = retry
            p = star + 1
        else:
            return false
    while p < pattern.length and pattern[p..<p + 1] == "*":
        p += 1
    return p == pattern.length

pub func patterns(expression: str) -> list[str]:
    let result: list[str] = []
    var token = ""
    var quote = ""
    for at in 0..<expression.length:
        let ch = expression[at..<at + 1]
        if quote != "":
            if ch == quote:
                quote = ""
            else:
                token += ch
        elif ch in ["\"", "'"]:
            quote = ch
        elif ch in [" ", "\t", "\n", ","]:
            if token != "": result.append(token)
            token = ""
        else:
            token += ch
    if token != "": result.append(token)
    return result

## Exact parent paths include descendants; ^pattern subtracts matches.
pub func matches(path: str, selectors: list[str]) -> bool:
    if selectors.length == 0: return true
    var matched = false
    for selector in selectors:
        let exclude = selector.starts_with("^")
        let pattern = selector[1..<selector.length] if exclude else selector
        let hit = glob(pattern, path) or path.starts_with(pattern + "/")
        if hit: matched = not exclude
    return matched
