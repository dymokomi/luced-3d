## Small explicit group grammar: all (* / blank), IDs, inclusive ranges, @name.
## No expression interpreter or undocumented Houdini-compatible syntax.
from three import PolygonMesh
import ui

pub func group_indices(mesh: PolygonMesh, domain: int, expression: str) -> list[int]!:
    let count = mesh.domain_count(domain)
    let result: list[int] = []
    let text = expression.trim()
    if text == "" or text == "*":
        for id in 0..<count:
            result.append(id)
        return result
    if text.starts_with("@"):
        let attribute = mesh.find_attribute(text[1..<text.length], domain)
        if attribute < 0:
            error(ui.invalid, "Group attribute does not exist on this domain")
        for id in 0..<count:
            if mesh.attribute_value(attribute, id) != 0.0:
                result.append(id)
        return result
    for token in text.replace(",", " ").split(" "):
        if token == "":
            continue
        let pair = token.split("-")
        if pair.length > 2:
            error(ui.invalid, "Group expects IDs, inclusive ranges, or @attribute")
        let first = parse_id(pair[0])
        let last = parse_id(pair[1]) if pair.length == 2 else first
        if first < 0 or last < first or last >= count:
            error(ui.invalid, "Group component index is out of range")
        for id in first..<last + 1:
            if not (id in result):
                result.append(id)
    return result

func parse_id(text: str) -> int!:
    if text == "":
        error(ui.invalid, "Missing group index")
    var result = 0
    for char in text:
        let digit = "0123456789".index_of(char) else -1
        if digit < 0 or result > 65536:
            error(ui.invalid, "Invalid group index")
        result = result * 10 + digit
    return result
