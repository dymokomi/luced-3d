## A Sketch node's input body and frame for the editor on the UI thread
## (sketch_node.luc): an origin plane's frame at once; a Face plane's, and
## the body that projected curves follow, need its input, cooked here on a
## copy of the graph and kept until the input changes. And the view looking
## straight at a sketch.
from workspace import Workspace
from node import Node
from geometry_data import GeometryData
from sketch_node import SketchFrame, node_frame, face_frame, face_plane
from luce_cad.sketch import CadSketch
import sketch_kinds
from luce_std import math

pub class FrameCache:
    var key: str = ""
    var kept: SketchFrame? = none
    ## The input body as last cooked, and its node and stamp.
    var body_key: str = ""
    var body_data: GeometryData? = none

    ## Sketch node `node`'s input as cooked now (none without one), and a
    ## key that changes when it does.
    pub func body(self, w: Workspace, node: Node) -> GeometryData?!:
        let found = w.network.find(node.inputs[0])
        if found == none:
            self.body_key = ""
            self.body_data = none
            return none
        let input = found else return none
        # Stamps are current: every change rebuilds, which stamps the
        # graph, so this runs no graph walk per event.
        let key = f"{input.id}|{input.stamp}"
        if key != self.body_key:
            self.body_key = key
            self.body_data = w.network.copy().evaluate_data(input.id) catch failure:
                recover none
        return self.body_data

    pub func body_stamp(self) -> str:
        return self.body_key

    ## Sketch node `node`'s frame in `w` (an origin plane at once).
    pub func frame(self, w: Workspace, node: Node) -> SketchFrame!:
        if int(node.values[0]) != face_plane:
            return node_frame(node.values)
        let data = self.body(w, node) else return node_frame([1.0, node.values[1]])
        let key = f"{self.body_key}|{node.texts[1]}|{node.values[1]}"
        if key == self.key:
            if let f = self.kept:
                return f
        let f = face_frame(node.values, node.texts, data) catch failure:
            recover node_frame([1.0, node.values[1]])
        self.key = key
        self.kept = f
        return f

## Look straight at `sketch` on plane `f` (x right, y up, as the frame
## says), at the middle of what is drawn, as Fusion's Look At does.
pub func look_at(w: Workspace, sketch: CadSketch, f: SketchFrame) -> unit!:
    let n = f.normal()
    let view = w.view
    if math.abs(n.y) > 0.5:
        view.yaw = 0.0
        view.pitch = 1.5 if n.y > 0.0 else -1.5
    else:
        view.yaw = math.atan2(n.x, n.z)
        view.pitch = 0.0
    var low = [1.0e30, 1.0e30]
    var high = [-1.0e30, -1.0e30]
    for at in 0..<sketch.entity_count():
        if sketch.kind(at) == sketch_kinds.point_kind:
            low = [math.min(low[0], sketch.x(at)), math.min(low[1], sketch.y(at))]
            high = [math.max(high[0], sketch.x(at)), math.max(high[1], sketch.y(at))]
    if high[0] >= low[0]:
        view.target = f.at((low[0] + high[0]) * 0.5, (low[1] + high[1]) * 0.5)
        view.distance = math.max(20.0, 2.2 * math.max(high[0] - low[0], high[1] - low[1]))
    else:
        view.target = f.origin
    view.update_camera()
    w.revision += 1
