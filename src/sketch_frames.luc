## Sketch frames for the editor on the UI thread (sketch_node.luc): an
## origin plane's at once; a Face plane's needs its input body, cooked here
## on a copy of the graph and kept until the body, the face or the offset
## change.
from workspace import Workspace
from network import Node
from geometry_data import GeometryData
from stamps import stamp_graph
from sketch_node import SketchFrame, node_frame, face_frame, face_plane

## A Sketch node's frame, its Face plane's kept between calls.
pub class FrameCache:
    var key: str = ""
    var kept: SketchFrame? = none

    ## Sketch node `node`'s frame in `w` (an origin plane at once).
    pub func frame(self, w: Workspace, node: Node) -> SketchFrame!:
        if int(node.values[0]) != face_plane:
            return node_frame(node.values)
        let input = w.network.find(node.inputs[0]) else return node_frame([1.0, node.values[1]])
        stamp_graph(w.network)
        let key = f"{input.id}|{input.stamp}|{node.texts[1]}|{node.values[1]}"
        if key == self.key:
            if let f = self.kept:
                return f
        let data = w.network.copy().evaluate_data(input.id) catch failure:
            recover GeometryData()
        let f = face_frame(node.values, node.texts, data) catch failure:
            recover node_frame([1.0, node.values[1]])
        self.key = key
        self.kept = f
        return f
