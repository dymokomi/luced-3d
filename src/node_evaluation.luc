## Operator dispatch only. Mesh algorithms and attribute storage belong to three.
from three import PolygonMesh, MeshOps, MeshPrimitives, Vector3, TopologyTools
from component_groups import group_indices
import math
import ui
from obj import Obj
from step import Step
from fbx import Fbx
from geometry_data import GeometryData
from group_operations import imported_cad

pub func load_geometry(path: str) -> GeometryData!:
    if path == "":
        error(ui.invalid, "Choose an external geometry file")
    if path.lower().ends_with(".obj"):
        return GeometryData(Obj.load(path))
    if path.lower().ends_with(".fbx"):
        return GeometryData(Fbx.load(path))
    if path.lower().ends_with(".step") or path.lower().ends_with(".stp"):
        return imported_cad(Step.load_model(path))
    error(ui.invalid, "Unsupported geometry file extension")

pub func source_geometry(kind: str, v: list[float]) -> PolygonMesh!:
    if kind == "Cube":
        return PolygonMesh.cube(v[0]).transformed(Vector3(v[1], v[2], v[3]), Vector3(), Vector3(v[7], v[8], v[9]))
    if kind == "Grid":
        return MeshPrimitives.grid(v[0], int(v[1]))
    if kind == "Sphere":
        return MeshPrimitives.sphere(v[0], int(v[1]))
    if kind == "Cylinder" or kind == "Cone":
        return MeshPrimitives.cylinder(v[0], v[2], int(v[1]), kind == "Cone")
    return MeshPrimitives.torus(v[0], v[2], int(v[1]))

pub func evaluate_operator(kind: str, v: list[float], text: list[str], input: PolygonMesh, second: PolygonMesh?) -> PolygonMesh!:
    var mesh = input
    if kind in ["Reverse", "Triangulate", "Inset", "Duplicate", "Split", "Delete"]:
        let operation = ["Delete", "Reverse", "Triangulate", "Inset", "Duplicate", "Split"].index_of(kind) else 0
        return MeshOps.faces(mesh, group_indices(mesh, 2, text[0]), operation, v[0])
    if kind == "PolyExtrude":
        return mesh.extruded_faces(group_indices(mesh, 2, text[0]), v[0])
    if kind in ["Smooth", "Mountain", "Peak"]:
        let operation = ["Smooth", "Mountain", "Peak"].index_of(kind) else 0
        return MeshOps.points(mesh, group_indices(mesh, 0, text[0]), operation, v[0])
    if kind == "Fuse":
        return MeshOps.fuse(mesh, group_indices(mesh, 0, text[0]), v[0])
    if kind == "Clean":
        return MeshOps.compact(mesh)
    if kind == "Subdivide":
        for level in 0..<int(v[0]):
            mesh = MeshOps.subdivide(mesh, v[1] != 0.0)
        return mesh
    if kind == "Bevel":
        return TopologyTools.bevel(mesh, v[0])
    if kind == "Mirror":
        let axis = int(v[0])
        let mirrored = mesh.transformed(Vector3(), Vector3(), Vector3(-1.0 if axis == 0 else 1.0, -1.0 if axis == 1 else 1.0, -1.0 if axis == 2 else 1.0))
        return mesh.merged(mirrored) if v[1] != 0.0 else mirrored
    if kind == "CopyTransform" or kind == "CopyToPoints":
        let targets = second if kind == "CopyToPoints" else none
        let count = (targets else mesh).point_count() if kind == "CopyToPoints" else int(v[0])
        if count > 256 or mesh.point_count() * count > 16384 or mesh.vertex_count() * count > 65536:
            error(ui.invalid, "Copies exceed the modeling geometry budget")
        var result = PolygonMesh.empty()
        for copy in 0..<count:
            let offset = (targets else error(ui.invalid, "Connect target points")).point(copy) if kind == "CopyToPoints" else Vector3(v[1], v[2], v[3]).multiply_scalar(float(copy))
            let transformed = mesh.transformed(offset, Vector3(), Vector3(1.0, 1.0, 1.0))
            result = transformed if copy == 0 else result.merged(transformed)
        return result
    if kind == "MatchSize":
        let bounds = mesh.bounds()
        let size = bounds.maximum.subtract(bounds.minimum)
        let longest = math.max(size.x, math.max(size.y, size.z))
        if longest < 0.000001:
            return mesh
        let scale = v[0] / longest
        let center = bounds.minimum.add(bounds.maximum).multiply_scalar(0.5)
        return mesh.transformed(center.multiply_scalar(-scale), Vector3(), Vector3(scale, scale, scale))
    if kind == "AttributeDelete":
        return mesh.without_attribute(text[1], int(v[0]))
    if kind == "AttributeRename":
        return mesh.renamed_attribute(text[1], text[2], int(v[0]))
    if kind == "AttributePromote":
        return mesh.promoted_attribute(text[1], int(v[0]), int(v[1]))
    if kind in ["AttributeCreate", "AttributeRandomize", "Selection Group", "Color"]:
        let domain = 0 if kind == "Color" else int(v[0])
        let width = 3 if kind == "Color" else (1 if kind == "Selection Group" else int(v[1]))
        let integer = kind == "Selection Group" or (kind != "Color" and v[2] != 0.0)
        let selection = group_indices(mesh, domain, text[0]) if kind == "Selection Group" else []
        let values: list[float] = []
        for id in 0..<mesh.domain_count(domain):
            for component in 0..<width:
                var value = v[component] if kind == "Color" else (float(1 if id in selection else 0) if kind == "Selection Group" else v[3 + component])
                if kind == "AttributeRandomize":
                    let random = math.sin(float(id * 7 + component) * 12.9898 + v[7] * 78.233) * 43758.5453
                    value *= random - math.floor(random)
                values.append(math.floor(value) if integer else value)
        return mesh.with_attribute("Cd" if kind == "Color" else text[1], domain, width, values, integer)
    if kind == "UVProject":
        let values: list[float] = []
        for corner in 0..<mesh.vertex_count():
            let p = mesh.point(mesh.corner_point(corner))
            values.append(p.x * v[0])
            values.append(p.z * v[0])
        return mesh.with_attribute("uv", 1, 2, values)
    if kind == "Normal":
        let domain = 2 if int(v[0]) == 2 else 0
        let normals: list[Vector3] = []
        for id in 0..<mesh.domain_count(domain):
            normals.append(Vector3())
        for face in 0..<mesh.face_count():
            let normal = mesh.face_normal(face)
            if domain == 2:
                normals[face] = normal
            else:
                for at in 0..<mesh.face_size(face):
                    let id = mesh.face_point(face, at)
                    normals[id] = normals[id].add(normal)
        let values: list[float] = []
        for normal in normals:
            let n = normal.normalized() if normal.length() > 0.000001 else Vector3()
            values.append(n.x)
            values.append(n.y)
            values.append(n.z)
        return mesh.with_attribute("N", domain, 3, values)
    if kind == "Measure":
        let areas: list[float] = []
        for face in 0..<mesh.face_count():
            areas.append(0.0)
        for triangle in 0..<mesh.index_count() // 3:
            let a = mesh.vertex(mesh.index(triangle * 3)).position
            let b = mesh.vertex(mesh.index(triangle * 3 + 1)).position
            let c = mesh.vertex(mesh.index(triangle * 3 + 2)).position
            let face = mesh.triangle_face(triangle)
            areas[face] += b.subtract(a).cross(c.subtract(a)).length() * 0.5
        return mesh.with_attribute("area", 2, 1, areas)
    error(ui.invalid, "Operator has no evaluator")
