## Shared LuciaOS Rounded SVGs, rendered by luce-ui's cached luce-svg pipeline.
## Original assets and extensions: Dy Mokomi, CC BY 4.0.
from luce_ui.ui import Painter
from luce_gpu.gpu import Color, Rect
from luce_ui import ui

pub func asset_name(name: str) -> str:
    if name in ["Cube", "Sphere", "Cylinder", "Cone", "Torus"]: return name.lower()
    if name == "Grid": return "grid"
    if name == "Hulls": return "node-tool"
    if name == "File": return "import"
    if name == "Export": return "export"
    if name == "Group": return "group"
    if name == "CAD": return "package"
    if name == "Geo": return "mesh"
    if name == "SDF": return "sphere"
    if name == "Volumes": return "cube"
    if name == "GSplats": return "vertex-select"
    if name == "Materials": return "material"
    if name == "Input": return "import"
    if name == "Import": return "merge-layers"
    if name == "Extrude": return "extrude"
    if name == "Sketch": return "pen-tool"
    if name == "Revolve": return "rotate-tool"
    if name == "Offset Face": return "inset"
    if name == "Check": return "measure-tool"
    if name == "Insert Knot": return "loop-cut"
    if name == "Remove Knot": return "dissolve"
    if name == "Raise Degree": return "subdivide"
    if name == "Rebuild": return "reload"
    if name == "Convert to B-spline": return "shaded-wireframe"
    # Curves (Edit CAD's and the CAD nodes).
    if name in ["CV Curve", "Curve"]: return "pen-tool"
    if name == "EP Curve": return "path-tool"
    if name == "Curve on Surface": return "pencil-tool"
    if name == "Duplicate Curve": return "duplicate"
    if name == "Blend Curve": return "node-tool"
    if name == "Attach": return "merge-vertices"
    if name == "Detach": return "split-mesh"
    if name == "Close": return "loop-cut"
    if name == "Stretch": return "scale-tool"
    if name == "Reverse": return "flip-horizontal"
    # Surfacing Stage 3 (Edit CAD's steps and the CAD nodes).
    if name == "Project": return "arrow-down"
    if name == "Intersect": return "boolean-intersect"
    if name == "Trim": return "crop-tool"
    if name == "Untrim": return "restart"
    if name == "Trim Convert": return "corner-pin"
    if name == "Shrink": return "frame-selection"
    if name == "Stitch": return "attachment"
    if name == "Unstitch": return "split-window-horizontal"
    if name == "Align": return "snap"
    if name == "Symmetry Align": return "mirror-modifier"
    if name == "Surfaces": return "layer"
    # Surfacing Stage 5: surfaces from curves.
    if name == "Square": return "rectangle-tool"
    if name == "Skin": return "bring-forward"
    if name == "Rail": return "line-tool"
    if name == "Profile": return "ellipse-tool"
    if name == "Set Planar": return "plane"
    if name == "Sheet Extrude": return "extrude"
    if name == "Sheet Revolve": return "rotate-tool"
    if name == "Extend": return "arrow-right"
    # Surfacing Stage 6: blends between surfaces.
    if name == "Blend Surface": return "smooth-tool"
    if name == "Surface Fillet": return "bevel"
    if name == "Tube": return "cylinder"
    # Edit CAD's direct modeling tools.
    if name == "Move/Copy": return "move-tool"
    if name == "Remove Faces": return "subtract-from-selection"
    if name == "Replace Face": return "replace"
    if name == "Shell": return "solid-wireframe"
    if name == "Combine": return "boolean-union"
    if name == "Split Body": return "split-mesh"
    if name == "Split Face": return "loop-cut"
    if name == "Delete Face": return "fill-hole"
    if name == "Remove": return "trash"
    if name == "Press Pull": return "extrude"
    if name in ["Fillet", "Chamfer"]: return "bevel"
    if name == "Mirror Body": return "mirror-modifier"
    if name == "Pattern": return "array-modifier"
    if name.starts_with("Solid "): return name[6..<name.length].lower().replace("box", "cube")
    if name == "Camera": return "camera"
    if name == "Light": return "light-spot"
    if name == "Render": return "render"
    if name == "Material": return "material"
    if name == "Assign Material": return "fill-tool"
    if name in ["Transform", "Move", "Transform Components"]: return "move-tool"
    if name == "Tessellate": return "mesh"
    if name in ["Blast", "Delete"]: return "trash"
    if name.starts_with("Edit "): return "pencil-tool"
    if name in ["Box", "Object"]: return "cube"
    if name == "Plane": return "grid"
    if name == "Merge": return "git-merge"
    if name == "Null": return "node-tool"
    if name == "Output": return "arrow-right"
    if name == "Code": return "code"
    if name == "Switch": return "git-branch"
    if name == "Reverse": return "reverse-normals"
    if name in ["Triangulate", "Subdivide", "Inset", "Bevel", "Duplicate", "Dissolve", "Flatten"]: return name.lower()
    if name == "PolyBevel": return "bevel"
    if name == "Loop Cut": return "loop-cut"
    if name in ["Knife", "Clip"]: return "line-tool"
    if name == "Connect": return "path-tool"
    if name == "Edge Slide": return "distribute-horizontal"
    if name == "PolyMirror": return "mirror-modifier"
    if name == "Spin": return "orbit-tool"
    if name == "Crease": return "sharpen-tool"
    if name == "PolyDraw": return "polygon-select-tool"
    if name == "Bridge": return "fill-hole"
    if name == "Smooth": return "smooth-tool"
    if name in ["Fuse", "Merge Points"]: return "merge-vertices"
    if name in ["Extrude", "PolyExtrude"]: return "extrude"
    if name == "Split": return "split-mesh"
    if name == "Clean": return "healing-brush"
    if name == "Mirror": return "mirror-modifier"
    if name == "CopyTransform": return "array-modifier"
    if name == "CopyToPoints": return "vertex-select"
    if name in ["Noise", "Mountain"]: return "noise"
    if name in ["Peak", "Normal"]: return "surface-normal"
    if name == "MatchSize": return "corner-pin"
    if name == "AttributeCreate": return "plus"
    if name == "Name": return "text-tool"
    if name == "AttributeRandomize": return "noise"
    if name == "AttributeDelete": return "subtract-from-selection"
    if name == "AttributeRename": return "text-tool"
    if name == "AttributePromote": return "bring-forward"
    if name in ["Selection", "Select"]: return "selection-tool"
    if name == "Measure": return "measure-tool"
    if name == "UVProject": return "texture"
    if name == "Color": return "color-swatch"
    if name == "Rotate": return "rotate-tool"
    if name == "Scale": return "scale-tool"
    if name == "Pivot": return "pivot"
    if name == "Manipulator": return "transform-gizmo"
    if name == "Snap": return "snap-to-grid"
    if name == "Fill": return "fill-hole"
    if name == "Frame": return "frame-selection"
    # Edit SDF: booleans, blend, the capsule.
    if name == "Add": return "boolean-union"
    if name == "Subtract": return "boolean-subtract"
    if name == "Intersect": return "boolean-intersect"
    if name == "Blend": return "smooth-tool"
    if name == "Capsule": return "cylinder"
    return "mesh"

pub func draw_icon(p: Painter, name: str, x: float, y: float, size: float, ink: Color) -> unit!:
    ui.draw_icon(p.target(), asset_name(name), Rect(x, y, size, size), ink)
