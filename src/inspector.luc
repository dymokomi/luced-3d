## The Parameters pane: a compact node header (name, type and flags, what it
## does), then the node's parameters as one ParameterPanel built from the
## catalog, one line each after Houdini's parameter pane. The catalog's rows
## name the value or text slot each edits; an Edit node adds its component
## edit rows. A drag is live and one undo step on release.
from luce_ui.ui import VStack, HStack, Text, TextField, Font, Button, ParameterPanel, ParameterSpec, ParameterKind, Rect, Size, TextEditor
from code_editor import CodeEditor
from script_check import ScriptChecker
import code_node
import code_cook
import script_cook
import script_node
from interop import Connection
from workspace import Workspace
from actions import Actions
from parameter_rows import Parameter, ramp_numbers, padded
from shader_nodes import is_shader
from node import Node, waiting
from shader_nodes import inputs as shader_inputs
import node_catalog
from edit_kinds import is_edit
from edit_types import point_level
import edit_cad
from usd_nodes import Composition, compose_usd
import node_commands
import cad_nodes
import sketch_node
import sketch_commands
from sketch_commands import SketchDimension
import units
from angles import radians, degrees
import tool_prompts
import modify_picks
import cad_features
import cad_blends
import cad_check

pub class Inspector:
    ## A path row's Browse: pick a file for text slot `slot`.
    pub var on_browse: func(int) -> unit!? = none
    ## The Render node's Render button.
    pub var on_render: func() -> unit!? = none
    pub let body: VStack
    ## The selected node's parameters.
    pub let parameters: ParameterPanel
    let workspace: Workspace
    let actions: Actions
    let name: TextField
    let kind: Text
    let stats: Text
    let description: Text
    let state_rows: VStack
    let delete_button: Button
    let generic_rows: VStack
    ## In place of the rows while nothing is selected.
    pub let nothing: VStack
    let connections: list[Connection]
    ## The catalog rows the panel shows, and what each row is to the inspector:
    ## "value", "text", "info", "reload", "clear", "edits",
    ## "operation", or a blend's "edges", "pick_edges" and "all_edges".
    var rows: list[Parameter]
    var roles: list[str]
    ## What the panel was built for: node kind, file format and edit count.
    var built: str = ""
    ## A USD File node's composed stage, and the file, texts and revision
    ## it was composed for.
    var stage: Composition? = none
    var stage_key: str = ""
    var showing: int = -2
    ## A Sketch node's dimensions, read once per text it has.
    var dimensions_text: str = ""
    ## An Extrude's or Revolve's Operation items as last shown.
    var operation_items: str = ""
    var dimensions: list[SketchDimension]
    ## A Code node's body and header editors, shown for Code nodes; a Script
    ## node's code in the body editor, without a header.
    let code_box: VStack
    ## The Code or Script node's code (public for captures).
    pub let code_body: CodeEditor
    let code_header: CodeEditor
    let code_title: Text
    let header_title: Text
    ## What the code's k.printf calls said in the last cook (many lines).
    let console: TextEditor
    ## A Script node's check while typing, and the error of the text it held
    ## back ("" none), which the editor marks in place of the cook's.
    let checker: ScriptChecker
    var check_failure: str = ""

    pub func init(self, workspace: Workspace, actions: Actions, font: Font) -> unit!:
        self.dimensions = []
        self.workspace = workspace
        self.actions = actions
        self.connections = []
        self.rows = []
        self.roles = []
        self.name = TextField("", font = font, placeholder = "Node name", cells = 18.0)
        self.connections.append(self.name.on_commit(func (name: str) -> unit!: node_commands.rename(workspace, name)))
        self.kind = Text("", font = font, muted = true)
        self.stats = Text("", font = font, muted = true)
        self.description = Text("", font = font, muted = true)
        self.parameters = ParameterPanel([], font = font)
        self.connections.append(self.parameters.on_begin(func (index: int) -> unit!:
            if self.roles[index] in ["value", "dimension", "angle_dimension", "ramp"]:
                workspace.begin("Change " + self.rows[index].name)))
        self.connections.append(self.parameters.on_change(self.changed))
        self.connections.append(self.parameters.on_commit(func (index: int) -> unit!:
            workspace.commit()))
        self.connections.append(self.parameters.on_action(self.acted))
        self.state_rows = VStack([
            HStack([Button(action = actions.display, font = font), Button(action = actions.enabled, font = font)], spacing = 4.0)], spacing = 4.0)
        self.delete_button = Button(action = actions.delete, font = font)
        let header = VStack([self.name, self.kind, self.state_rows, self.description], spacing = 4.0, padding = 6.0)
        let footer = VStack([self.stats, self.delete_button], spacing = 4.0, padding = 6.0)
        self.code_body = CodeEditor(font)
        self.code_header = CodeEditor(font)
        self.code_body.editor.layout().set_limits(Size(240.0, 240.0), Size(16384.0, 420.0))
        self.code_header.editor.layout().set_limits(Size(240.0, 90.0), Size(16384.0, 300.0))
        self.code_body.on_commit = func (text: str) -> unit!: self.code_committed(code_cook.body_slot, text)
        self.checker = ScriptChecker()
        self.code_header.on_commit = func (text: str) -> unit!: self.code_committed(code_cook.header_slot, text)
        self.code_header.part = 1
        self.code_body.partner = self.code_header
        self.code_header.partner = self.code_body
        self.console = TextEditor("", read_only = true, line_numbers = false, font = font)
        self.console.layout().set_limits(Size(240.0, 40.0), Size(16384.0, 200.0))
        self.code_title = Text("Code (one element; it runs for all in parallel)", font = font, muted = true)
        self.header_title = Text("Header (helper functions)", font = font, muted = true)
        self.code_box = VStack([self.code_title, self.code_body.editor, self.console, self.header_title, self.code_header.editor], spacing = 4.0, padding = 6.0)
        self.generic_rows = VStack([header, self.parameters, self.code_box, footer], spacing = 0.0)
        self.nothing = VStack([Text("Nothing selected", font = font),
                               Text("Click a node or an object to edit it.", font = font, muted = true)], spacing = 4.0, padding = 6.0)
        self.body = VStack([self.nothing, self.generic_rows], spacing = 0.0)
        self.refresh()

    ## A parameter changed in the panel: its slots take the values (a vector
    ## its components), a text row its text.
    func changed(self, index: int) -> unit!:
        let role = self.roles[index]
        let row = self.rows[index]
        if role == "value":
            for component in 0..<row.components:
                node_commands.set_parameter(self.workspace, row.slot + component, self.parameters.component(index, component))
        elif role == "text":
            let node = self.workspace.selected() else return
            if node.kind == script_cook.kind_name and row.slot == script_cook.packages_slot:
                script_node.set_packages(self.workspace, node.id, self.parameters.text(index))
            else:
                node_commands.set_text(self.workspace, row.slot, self.parameters.text(index))
        elif role == "ramp":
            let node = self.workspace.selected() else return
            if row.value_ramp():
                node_commands.set_parameters(self.workspace, row.slot, padded(self.parameters.ramp(index), row.components))
            elif node.kind in [code_cook.kind_name, script_cook.kind_name]:
                code_node.set_ramp(self.workspace, node.id, row.slot, self.parameters.ramp(index))
            else:
                node_commands.set_ramp_text(self.workspace, node.id, row.slot, self.parameters.ramp(index))
        elif role == "dimension" or role == "angle_dimension":
            let node = self.workspace.selected() else return
            let value = self.parameters.value(index)
            sketch_commands.set_dimension(self.workspace, node.id, row.slot, radians(value) if role == "angle_dimension" else value)

    func acted(self, index: int) -> unit!:
        let role = self.roles[index]
        if role == "text":
            if let callback = self.on_browse:
                callback(self.rows[index].slot)
        elif role == "reload":
            node_commands.reload_file(self.workspace)
        elif role == "render":
            if let callback = self.on_render:
                callback()
        elif role == "clear":
            self.actions.clear_edits.trigger()
        elif role == "pick_edges":
            if let node = self.workspace.selected(): tool_prompts.pick_edges(self.workspace, node.id)
        elif role.starts_with("pick_set:"):
            if let node = self.workspace.selected(): tool_prompts.pick_edges(self.workspace, node.id, int(role[9..]))
        elif role == "all_edges" or role == "all_profiles":
            node_commands.set_text(self.workspace, 0, "")
        elif role == "pick_face":
            if let node = self.workspace.selected(): tool_prompts.pick_face(self.workspace, node.id)
        elif role == "pick_profiles":
            if let node = self.workspace.selected(): tool_prompts.pick_profiles(self.workspace, node.id)
        elif role == "pick_object" or role == "pick_object_two":
            if let node = self.workspace.selected(): tool_prompts.pick_object(self.workspace, node.id, role == "pick_object_two")
        elif role == "pick_axis":
            if let node = self.workspace.selected(): tool_prompts.pick_axis(self.workspace, node.id)
        elif role == "pick_center_face":
            if let node = self.workspace.selected(): tool_prompts.pick_center_face(self.workspace, node.id)
        elif role == "pick_start_object":
            if let node = self.workspace.selected(): tool_prompts.pick_start_object(self.workspace, node.id)
        elif role == "pick_bodies":
            if let node = self.workspace.selected(): tool_prompts.pick_bodies(self.workspace, node.id)
        elif role == "auto_bodies":
            node_commands.set_text(self.workspace, cad_features.bodies_text, "")
        elif role == "pick_faces" or role == "pick_other_faces" or role == "pick_offset_faces":
            if let node = self.workspace.selected(): tool_prompts.pick_faces(self.workspace, node.id, 2 if role == "pick_other_faces" else (0 if role == "pick_offset_faces" else 1))
        elif role.starts_with("modify_pick:"):
            if let node = self.workspace.selected():
                modify_picks.start(self.workspace, node.id, modify_picks.inputs(node.kind)[int(role[12..])])
        elif role == "reselect":
            if let node = self.workspace.selected(): tool_prompts.reselect(self.workspace, node.id)
        elif role == "keep_ids":
            if let node = self.workspace.selected(): node_commands.keep_ids(self.workspace, node.id)

    ## The field showing value slot `slot`, in window points; empty when none shows it.
    pub func field_bounds(self, slot: int) -> Rect!:
        let origin = self.parameters.layout().bounds()
        for index in 0..<self.rows.length:
            let row = self.rows[index]
            if self.roles[index] == "value" and slot >= row.slot and slot < row.slot + row.components:
                let field = self.parameters.field_bounds(index, slot - row.slot)
                return Rect(origin.x + field.x, origin.y + field.y, field.width, field.height)
        return Rect()

    ## The row showing text slot `slot`, in window points; empty when none shows it.
    pub func text_bounds(self, slot: int) -> Rect!:
        let origin = self.parameters.layout().bounds()
        for index in 0..<self.rows.length:
            if self.roles[index] == "text" and self.rows[index].slot == slot:
                let row = self.parameters.row_bounds(index)
                return Rect(origin.x + row.x, origin.y + row.y, row.width, row.height)
        return Rect()

    ## The text the panel shows on the row of role `role` (Face's "face",
    ## Profiles' "profiles"…), "" when none shows.
    pub func shown_text(self, role: str) -> str!:
        for index in 0..<self.rows.length:
            if self.roles[index] == role:
                return self.parameters.text(index)
        return ""

    ## The value the panel shows for slot `slot`.
    pub func shown_value(self, slot: int) -> float!:
        for index in 0..<self.rows.length:
            let row = self.rows[index]
            if self.roles[index] == "value" and slot >= row.slot and slot < row.slot + row.components:
                return self.parameters.component(index, slot - row.slot)
        return 0.0

    ## Rebuild the panel's rows for `node`: the catalog's, and an Edit node's edits.
    func build(self, kind: str, path: str) -> unit!:
        self.rows = []
        self.roles = []
        var specs: list[ParameterSpec] = []
        let shown = units.document_unit(self.workspace)
        var fields = node_catalog.fields(kind, path, self.stage)
        # A Code or Script node's spare parameters, from its code.
        if kind == code_cook.kind_name or kind == script_cook.kind_name:
            if let node = self.workspace.selected():
                fields = fields + code_node.spare_rows(node)
        for row in fields:
            if kind == edit_cad.kind_name and not self.cv_rows():
                # Fusion's direct edits have no soft selection, symmetry or
                # Keep selection: only Edit CAD's control vertices use them.
                continue
            specs.append(row.spec(shown))
            self.rows.append(row)
            self.roles.append("ramp" if row.kind in ["ramp", "color_ramp"] else "text" if row.kind in ["text", "path"] else (("render" if row.name == "Render" else "reload") if row.kind == "button" else ("info" if row.kind == "info" else "value")))
        if is_edit(kind):
            self.add(specs, "edits", ParameterSpec(name = "edits", label = "Edits", kind = ParameterKind.info))
            self.add(specs, "clear", ParameterSpec(name = "clear", label = "Clear edits", kind = ParameterKind.button,
                                                    doc = "Remove every component edit of this node."))
        # A verb node made from a selection: pick its components again, or keep
        # its numbers on a changed topology (Houdini's behaviour).
        # A blend's edges: references to them by their faces (luce-cad's
        # names), which survive changes upstream; shown as a count.
        if kind == sketch_node.kind_name:
            self.add(specs, "face", ParameterSpec(name = "face", label = "Face", kind = ParameterKind.info,
                                                  doc = "The input body's face the sketch is on (Plane: Face), kept by its name so it stays that face as the body changes."))
            self.add(specs, "pick_face", ParameterSpec(name = "pick_face", label = "Pick face", kind = ParameterKind.button,
                                                       doc = "Show the input body and click the flat face to sketch on."))
        if kind in ["Extrude", "Revolve"]:
            self.add(specs, "profiles", ParameterSpec(name = "profiles", label = "Profiles", kind = ParameterKind.info,
                                                      doc = "The sketch's regions to take, remembered by the curves round them so they hold as dimensions change. None picked: its closed shapes, holes left empty."))
            self.add(specs, "pick_profiles", ParameterSpec(name = "pick_profiles", label = "Pick profiles", kind = ParameterKind.button, join = true,
                                                           doc = "Click the sketch's regions to take (again to leave one out); Enter finishes."))
            self.add(specs, "all_profiles", ParameterSpec(name = "all_profiles", label = "Closed shapes", kind = ParameterKind.button,
                                                          doc = "Forget the picked profiles: take the sketch's closed shapes."))
        # Extrude's To object faces, Revolve's picked axis, Offset Face's
        # faces: kept by name, shown, picked in the viewport.
        if kind == "Extrude":
            self.add(specs, "object", ParameterSpec(name = "object", label = "Object", kind = ParameterKind.info, hide_when = "{ extent != 1 }",
                                                    doc = "The face the extrusion runs to (To object), kept by its name so it stays that face as the body changes."))
            self.add(specs, "pick_object", ParameterSpec(name = "pick_object", label = "Pick object", kind = ParameterKind.button, hide_when = "{ extent != 1 }",
                                                         doc = "Show the body and click the face to extrude to."))
            self.add(specs, "object_two", ParameterSpec(name = "object_two", label = "Side 2 object", kind = ParameterKind.info, hide_when = "{ direction != 1 } { side_2_extent != 1 }",
                                                        doc = "The face the second side runs to (To object)."))
            self.add(specs, "pick_object_two", ParameterSpec(name = "pick_object_two", label = "Pick side 2 object", kind = ParameterKind.button, hide_when = "{ direction != 1 } { side_2_extent != 1 }",
                                                             doc = "Show the body and click the face the second side extrudes to."))
            self.add(specs, "start_object", ParameterSpec(name = "start_object", label = "Start object", kind = ParameterKind.info, hide_when = "{ start != 2 }",
                                                          doc = "The face the extrusion starts from (Start: Object), kept by its name."))
            self.add(specs, "pick_start_object", ParameterSpec(name = "pick_start_object", label = "Pick start object", kind = ParameterKind.button, hide_when = "{ start != 2 }",
                                                               doc = "Show the body and click the face to start from."))
            self.add(specs, "bodies", ParameterSpec(name = "bodies", label = "Objects To Cut", kind = ParameterKind.info, hide_when = "{ operation == 1 }",
                                                    doc = "The bodies Join, Cut and Intersect act on, kept by their faces' names. Auto-select: every body, as it is when the node cooks."))
            self.add(specs, "pick_bodies", ParameterSpec(name = "pick_bodies", label = "Pick bodies", kind = ParameterKind.button, join = true, hide_when = "{ operation == 1 }",
                                                         doc = "Show the bodies and pick those to act on (Shift adds); Enter accepts."))
            self.add(specs, "auto_bodies", ParameterSpec(name = "auto_bodies", label = "Auto-select", kind = ParameterKind.button, hide_when = "{ operation == 1 }",
                                                         doc = "Forget the picked bodies: act on every body."))
        if kind == "Revolve":
            self.add(specs, "object", ParameterSpec(name = "object", label = "Object", kind = ParameterKind.info, hide_when = "{ type != 2 }",
                                                    doc = "The face the revolve turns to (Type: To), kept by its name."))
            self.add(specs, "pick_object", ParameterSpec(name = "pick_object", label = "Pick object", kind = ParameterKind.button, hide_when = "{ type != 2 }",
                                                         doc = "Show the body and click the face to turn to."))
            self.add(specs, "axis", ParameterSpec(name = "axis_picked", label = "Picked axis", kind = ParameterKind.info, hide_when = "{ axis != 0 }",
                                                  doc = "The sketch line or body edge the profiles turn about (projected onto the sketch's plane)."))
            self.add(specs, "pick_axis", ParameterSpec(name = "pick_axis", label = "Pick axis", kind = ParameterKind.button, hide_when = "{ axis != 0 }",
                                                       doc = "Click a line of the sketch, or a straight or round edge of the body."))
        if kind == "Offset Face":
            self.add(specs, "faces", ParameterSpec(name = "faces", label = "Faces", kind = ParameterKind.info,
                                                   doc = "The faces moved, kept by their names (Press Pull on faces of the body)."))
            self.add(specs, "pick_offset_faces", ParameterSpec(name = "pick_offset_faces", label = "Pick faces", kind = ParameterKind.button,
                                                               doc = "Show the body and pick the faces to move (Shift adds); Enter accepts."))
        # The Modify features' selection inputs (modify_picks.luc): what
        # each holds, and its pick button.
        let picks = modify_picks.inputs(kind)
        for index in 0..<picks.length:
            let input = picks[index]
            self.add(specs, f"modify:{index}", ParameterSpec(name = f"picked_{index}", label = input.label, kind = ParameterKind.info, hide_when = input.hide_when, doc = input.doc))
            self.add(specs, f"modify_pick:{index}", ParameterSpec(name = f"pick_{index}", label = "Set pivot" if input.label == "Pivot" else input.prompt(), kind = ParameterKind.button, hide_when = input.hide_when,
                                                                 doc = f"Show the input body and {"click the point" if input.takes == modify_picks.point else "pick it"} in the viewport."))
        if kind == "Fillet":
            let between = "{ type != 1 } { rule == 0 }"
            self.add(specs, "center_face", ParameterSpec(name = "center_face", label = "Center face", kind = ParameterKind.info, hide_when = "{ type != 2 }",
                                                         doc = "Full round: the face rounded away, kept by its name; the faces on each side are found across its longest parallel edges."))
            self.add(specs, "pick_center_face", ParameterSpec(name = "pick_center_face", label = "Pick center face", kind = ParameterKind.button, hide_when = "{ type != 2 }",
                                                              doc = "Show the body and click the face to round away whole."))
            self.add(specs, "rule_faces", ParameterSpec(name = "rule_faces", label = "Faces", kind = ParameterKind.info, hide_when = between,
                                                        doc = "Rule fillet, Between faces: the first set of faces, kept by their names."))
            self.add(specs, "pick_faces", ParameterSpec(name = "pick_faces", label = "Pick faces", kind = ParameterKind.button, hide_when = between,
                                                        doc = "Show the body and pick the first set of faces (Shift adds); Enter accepts."))
            self.add(specs, "rule_others", ParameterSpec(name = "rule_others", label = "Other faces", kind = ParameterKind.info, hide_when = between,
                                                         doc = "Rule fillet, Between faces: the second set (none: any face next to the first set)."))
            self.add(specs, "pick_other_faces", ParameterSpec(name = "pick_other_faces", label = "Pick other faces", kind = ParameterKind.button, hide_when = between,
                                                              doc = "Show the body and pick the second set of faces (Shift adds); Enter accepts."))
        if kind in ["Fillet", "Chamfer"]:
            # A Rule fillet's edges come from its rule.
            let ruled = "{ type != 0 }" if kind == "Fillet" else ""
            self.add(specs, "edges", ParameterSpec(name = "edges", label = "Edges", kind = ParameterKind.info, hide_when = ruled,
                                                   doc = "The edges to blend, remembered by the faces they lie between, so they stay the same edges when anything upstream changes. None picked: every straight convex edge between flat faces."))
            self.add(specs, "pick_edges", ParameterSpec(name = "pick_edges", label = "Pick edges", kind = ParameterKind.button, join = true, hide_when = ruled,
                                                        doc = "Show the input body and pick the edges to blend (Enter accepts). Hole rims can be picked too."))
            self.add(specs, "all_edges", ParameterSpec(name = "all_edges", label = "All edges", kind = ParameterKind.button, hide_when = ruled,
                                                       doc = "Forget the picked edges: blend every straight convex edge between flat faces."))
            # A Fillet's further selection sets: each its edges and pick.
            if kind == "Fillet":
                for k in 2..<cad_blends.most_sets + 1:
                    let hidden = "{ type != 0 } { radius_type == 1 } { selection_sets < " + f"{k}" + " }"
                    self.add(specs, f"set_edges:{k}", ParameterSpec(name = f"set_{k}_edges", label = f"Set {k} edges", kind = ParameterKind.info, hide_when = hidden,
                                                                     doc = f"Selection set {k}'s edges, filleted at Set {k} radius (with Variable radius, set 2: the constant edges the law runs into)."))
                    self.add(specs, f"pick_set:{k}", ParameterSpec(name = f"pick_set_{k}", label = f"Pick set {k} edges", kind = ParameterKind.button, hide_when = hidden,
                                                                    doc = f"Show the input body and pick set {k}'s edges (Enter accepts)."))
        if kind == cad_check.kind_name:
            self.add(specs, "edges", ParameterSpec(name = "edges", label = "Edges", kind = ParameterKind.info,
                                                   doc = "The edges checked, remembered by the faces they lie between. None picked: every edge between two faces."))
            self.add(specs, "pick_edges", ParameterSpec(name = "pick_edges", label = "Pick edges", kind = ParameterKind.button, join = true,
                                                        doc = "Show the input body and pick the edges to check (Enter accepts)."))
            self.add(specs, "all_edges", ParameterSpec(name = "all_edges", label = "All edges", kind = ParameterKind.button,
                                                       doc = "Forget the picked edges: check every edge between two faces."))
        # A sketch's dimensions, each a row in the document's unit (an
        # angle in degrees); its constraint is the row's slot.
        if kind == sketch_node.kind_name:
            for d in self.sketch_dimensions(path):
                let label = d.name + (" (driven)" if d.driven else "")
                if d.angle:
                    self.add(specs, "angle_dimension", ParameterSpec(name = d.name, label = label, value = degrees(d.value), minimum = -360.0, maximum = 360.0, step = 1.0, decimals = 2, suffix = "°",
                                                                    doc = "An angle the sketch holds; change it and the sketch follows."), d.constraint)
                else:
                    self.add(specs, "dimension", ParameterSpec(name = d.name, label = label, value = d.value, minimum = 0.0, maximum = 1000000.0, step = 1.0, decimals = 2, units = shown,
                                                              doc = "A length the sketch holds; change it and the sketch follows. Type any unit: 10 mm, 0.5 in."), d.constraint)
        if node_catalog.is_mesh_verb(kind):
            self.add(specs, "reselect", ParameterSpec(name = "reselect", label = "Reselect", kind = ParameterKind.button, join = true,
                                                      doc = "Show the input and pick the group's components again (Enter accepts)."))
            self.add(specs, "keep_ids", ParameterSpec(name = "keep_ids", label = "Keep IDs", kind = ParameterKind.button,
                                                      doc = "Use the group's numbers on the input's current topology."))
        self.parameters.set_specs(specs)
        self.operation_items = ""
        self.show_ramps()

    ## An inspector row of the Edit node; `slot` is an operation's index.
    func add(self, specs: list[ParameterSpec], role: str, spec: ParameterSpec, slot: int = -1):
        specs.append(spec)
        self.rows.append(Parameter(spec.label, slot, 0.0))
        self.roles.append(role)

    ## Whether Edit CAD shows the Edit framework's soft selection, symmetry
    ## and Keep rows: only at its CVs level, the one level they act on.
    func cv_rows(self) -> bool:
        return self.workspace.level_index() == point_level

    pub func refresh(self) -> unit!:
        self.generic_rows.layout().set_visible(self.workspace.selected() != none)
        self.nothing.layout().set_visible(self.workspace.selected() == none)
        let node = self.workspace.selected() else return
        let changed = node.id != self.showing
        let file = node.kind == "File"
        let format = node_catalog.file_format(node.texts[0]) if file else ""
        let key = f"{node.kind}|{format}|{self.compose(node.texts, node.source_revision) if format == "usd" else ""}|{self.sketch_key(node.kind, node.texts[0])}|{node.texts[code_cook.spares_slot] + code_node.ramp_key(node) if node.kind in [code_cook.kind_name, script_cook.kind_name] else ""}|{self.workspace.network.units}|{self.cv_rows() if node.kind == edit_cad.kind_name else false}"
        if key != self.built:
            self.build(node.kind, node.texts[0])
            self.built = key
        if changed:
            self.checker.stop()
            self.check_failure = ""
        self.showing = node.id
        self.state_rows.layout().set_visible(not file)
        let scripting = node.kind == script_cook.kind_name
        let coding = node.kind == code_cook.kind_name or scripting
        self.code_box.layout().set_visible(coding)
        # Ramp rows follow the node (an undo) unless one is being dragged.
        if coding and not self.workspace.in_transaction():
            self.show_ramps()
        if coding:
            if self.console.text() != node.console:
                self.console.set_text(node.console)
            self.console.layout().set_visible(node.console != "")
            self.header_title.layout().set_visible(not scripting)
            self.code_header.editor.layout().set_visible(not scripting)
            self.code_title.set_text("Script (runs once per cook, natively; imports any package)" if scripting else "Code (one element; it runs for all in parallel)")
            # Completion and hover read the Code node's API, or a script's
            # check package (its imports, checked in process; warmed off this
            # thread).
            self.code_body.script_file = self.checker.prepare(node.texts[script_cook.packages_slot], node.texts[script_cook.lock_slot], self.workspace.network.folder, node.texts[script_cook.code_slot]) if scripting else ""
            # A Script's text is checked at a pause before it goes to the node.
            self.code_body.on_pause = (func (text: str) -> unit!: self.check_script(text)) if scripting else none
            if scripting:
                self.code_body.show(node.texts[script_cook.code_slot])
            else:
                let run_over = int(node.values[code_cook.run_over_slot])
                self.code_body.run_over = run_over
                self.code_header.run_over = run_over
                self.code_body.show(node.texts[code_cook.body_slot])
                self.code_header.show(node.texts[code_cook.header_slot])
            let message = self.check_failure if scripting and self.check_failure != "" else node.failure
            let place = code_node.failure_place(message)
            self.code_body.show_error(place[1] if place.length == 3 and place[0] == 0 else 0, place[2] if place.length == 3 else 0, (place[2] if place.length == 3 else 0) + 1, message)
            self.code_header.show_error(place[1] if place.length == 3 and place[0] == 1 else 0, place[2] if place.length == 3 else 0, (place[2] if place.length == 3 else 0) + 1, message)
        self.delete_button.layout().set_visible(not file)
        if changed or not self.name.layout().is_focused():
            self.name.set_text(node.name)
        let network = self.workspace.network
        self.kind.set_text(node.kind + (" · output" if network.is_output(node.id) and not network.on_object_level(node.id) else "") + (" · displayed" if node.visible else "") + ("" if node.enabled else " · bypassed") + (" · frozen" if node.frozen != "" else ""))
        # One line: a message from code may hold line breaks or tabs.
        self.description.set_text(one_line(node.failure if node.failure != "" else ((node.warning if waiting(node.warning) else "Warning: " + node.warning) if node.warning != "" else node_catalog.description(node.kind))))
        self.description.layout().set_visible(not file or node.failure != "" or node.warning != "")
        self.parameters.layout().set_enabled(node.enabled or file)
        for index in 0..<self.rows.length:
            let role = self.roles[index]
            let row = self.rows[index]
            if role == "value":
                for component in 0..<row.components:
                    self.parameters.set_component(index, component, node.values[row.slot + component])
                # Auto says what it chose: "Auto (Cut)".
                if row.name == "Operation" and node.kind in ["Extrude", "Revolve"]:
                    let items = cad_nodes.operation_items(node.automatic)
                    if items != self.operation_items:
                        self.operation_items = items
                        self.parameters.set_items(index, items)
                # A shader node's linked input takes its link: its value waits.
                if is_shader(node.kind):
                    self.parameters.set_enabled(index, not linked_slot(node, row.slot))
            elif role == "text":
                # A selection too large to read as text shows as a summary
                # (the group itself stays exact); Reselect changes it.
                let text = node.texts[row.slot]
                let baked = row.name == "Group" and text.byte_count > 16384
                self.parameters.set_text(index, f"‹selection of {text.byte_count // 1024} KB›" if baked else text)
                self.parameters.set_enabled(index, not baked)
            elif role == "info":
                self.parameters.set_text(index, row.text)
            elif role == "edits":
                self.parameters.set_text(index, f"{node.edits.length} edits / {self.workspace.selected_entities()} selected")
            elif role == "edges":
                self.parameters.set_text(index, cad_check.edges_summary(node.texts[0]) if node.kind == cad_check.kind_name else cad_nodes.edges_summary(node.texts[0]))
            elif role.starts_with("set_edges:"):
                let picked = cad_blends.set_edges(node.texts, int(role[10..]))
                self.parameters.set_text(index, cad_nodes.edges_summary(picked) if picked != "" else "None picked")
            elif role == "all_edges" or role == "all_profiles":
                self.parameters.set_enabled(index, node.texts[0] != "")
            elif role == "face":
                self.parameters.set_text(index, node.texts[1] if node.texts[1] != "" else "None picked")
            elif role == "profiles":
                self.parameters.set_text(index, cad_nodes.profiles_summary(node.texts[0]))
            elif role == "object" or role == "object_two" or role == "start_object":
                var slot = cad_features.face_two_text if role == "object_two" else cad_features.face_text
                if role == "start_object":
                    slot = cad_features.start_face_text
                elif node.kind == "Revolve":
                    slot = cad_features.revolve_face_text
                let picked = node.texts[slot]
                self.parameters.set_text(index, picked if picked != "" else "None picked")
            elif role == "center_face":
                let center = node.texts[cad_blends.faces_text].split(";")[0].trim()
                self.parameters.set_text(index, center if center != "" else "None picked")
            elif role == "bodies":
                let text = node.texts[cad_features.bodies_text]
                let count = text.split(";").length
                self.parameters.set_text(index, "Auto-select (every body)" if text.trim() == "" else ("1 body" if count == 1 else f"{count} bodies"))
            elif role == "auto_bodies":
                self.parameters.set_enabled(index, node.texts[cad_features.bodies_text] != "")
            elif role == "axis":
                self.parameters.set_text(index, cad_features.axis_summary(node.texts[cad_features.axis_text]))
            elif role == "faces" or role == "rule_faces" or role == "rule_others":
                let text = node.texts[0 if role == "faces" else (1 if role == "rule_faces" else 2)]
                let count = text.split(";").length
                self.parameters.set_text(index, ("Any face" if role == "rule_others" else "None picked") if text.trim() == "" else ("1 face" if count == 1 else f"{count} faces"))
            elif role.starts_with("modify:"):
                self.parameters.set_text(index, modify_picks.summary(node, modify_picks.inputs(node.kind)[int(role[7..])]))
            elif role == "clear":
                self.parameters.set_enabled(index, node.edits.length > 0)
            elif role == "keep_ids":
                self.parameters.set_enabled(index, node.guard != 0)
            elif role == "dimension" or role == "angle_dimension":
                for d in self.sketch_dimensions(node.texts[0]):
                    if d.constraint == row.slot:
                        self.parameters.set_value(index, degrees(d.value) if d.angle else d.value)
                        self.parameters.set_enabled(index, not d.driven)
        if node_catalog.collects_children(node.kind):
            let yielded = network.outputs(node.id)
            let warning = network.output_warning(node.id)
            self.stats.set_text(warning if warning != "" else (f"Output: {yielded[0].name}" if yielded.length == 1 and network.level_of(node.id) == "data" else f"{yielded.length} objects"))
        elif self.workspace.compute != none:
            self.stats.set_text(node.phase if node.computing else node.summary)
        elif let data = node.cache:
            self.stats.set_text(data.description())
        else:
            self.stats.set_text("No evaluated geometry")

    ## Compose a USD File node's stage when its file, texts or revision
    ## changed (a failure shows as the node's cook error); the key composed.
    func compose(self, texts: list[str], revision: int) -> str:
        let key = f"{texts[0].trim()}|{texts[1]}|{texts[2]}|{revision}"
        if key != self.stage_key:
            self.stage_key = key
            self.stage = none
            let composed = compose_usd(texts[0].trim(), texts) catch failure:
                return key
            self.stage = composed
        return key

    ## Sketch text `text`'s dimensions (none when it does not read).
    func sketch_dimensions(self, text: str) -> list[SketchDimension]:
        if text != self.dimensions_text:
            self.dimensions_text = text
            self.dimensions = sketch_commands.dimensions(text) catch failure:
                recover []
        return self.dimensions

    ## What a Sketch node's dimension rows depend on: which constraints are
    ## dimensions (their values refresh in place).
    func sketch_key(self, kind: str, text: str) -> str:
        if kind != sketch_node.kind_name:
            return ""
        let parts: list[str] = []
        for d in self.sketch_dimensions(text):
            parts.append(f"{d.constraint}{"a" if d.angle else ""}{"d" if d.driven else ""}")
        return parts.join(",")

    ## The ramp rows show their data: a Code or Script node's ramps, a verb
    ## node's ramp texts (Volume Visualization's emission color ramp) or
    ## ramp values (Bevel's Custom profile).
    func show_ramps(self) -> unit!:
        let node = self.workspace.selected() else return
        let coded = node.kind in [code_cook.kind_name, script_cook.kind_name]
        let ramps = code_cook.ramps_of(node.texts[code_cook.ramps_slot]) if coded else []
        for index in 0..<self.rows.length:
            if self.roles[index] != "ramp":
                continue
            let slot = self.rows[index].slot
            if coded and slot >= ramps.length:
                continue
            var data: list[float] = []
            if coded:
                data = ramps[slot].data
            elif self.rows[index].value_ramp():
                data = ramp_numbers(node.values[slot..<slot + self.rows[index].components])
            elif not coded:
                data = node_catalog.verb_ramp(node.kind, slot, node.texts[slot])
            if data.length == 0:
                continue
            if self.parameters.ramp(index) != data:
                self.parameters.set_ramp(index, data)

    ## A Code editor's text, to the selected Code node.
    func code_committed(self, slot: int, text: str) -> unit!:
        let node = self.workspace.selected() else return
        self.check_failure = ""
        if node.kind == code_cook.kind_name:
            code_node.set_code(self.workspace, node.id, slot, text)
        elif node.kind == script_cook.kind_name and slot == code_cook.body_slot:
            script_node.set_code(self.workspace, node.id, text)

    ## Each frame: the code editors commit when typing pauses, and a Script's
    ## check reports.
    pub func poll(self) -> unit!:
        self.code_body.poll()
        self.code_header.poll()
        let reported = self.checker.poll()
        self.code_body.set_script_ready(self.checker.ready())
        if reported:
            # Only an error in the code holds the text back; anything else (a
            # package that cannot be found) is the build's to report.
            let place = code_node.failure_place(self.checker.failure)
            self.check_failure = self.checker.failure if place.length == 3 else ""
            if self.check_failure == "":
                self.code_body.checked(self.checker.text)
            else:
                self.code_body.show_error(place[1], place[2], place[2] + 1, self.check_failure)

    ## Whether the Script editor's package set is warm (captures wait for it).
    pub func script_ready(self) -> bool:
        return self.checker.ready()

    ## Check the selected Script node's `text` with its packages.
    func check_script(self, text: str) -> unit!:
        let node = self.workspace.selected() else return
        self.checker.start(text, node.texts[script_cook.packages_slot], node.texts[script_cook.lock_slot], self.workspace.network.folder)

    pub func close(self):
        self.checker.close()
        self.code_body.close()
        self.code_header.close()
        self.on_browse = none
        self.on_render = none
        for connection in self.connections:
            connection.disconnect()
        self.connections.clear()

## Whether the shader input kept in value slot `slot` is linked.
func linked_slot(node: Node, slot: int) -> bool:
    let sockets = shader_inputs(node.kind)
    for port in 0..<sockets.length:
        if sockets[port].slot == slot and port < node.inputs.length and node.inputs[port] >= 0:
            return true
    return false

## `text` on one line: line breaks and tabs as spaces (a Text holds one).
func one_line(text: str) -> str:
    return text.replace("\r", " ").replace("\n", " ").replace("\t", " ")
