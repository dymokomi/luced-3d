## The Parameters pane: a compact node header (name, type and flags, what it
## does), then the node's parameters as one ParameterPanel built from the
## catalog, one line each after Houdini's parameter pane. The catalog's rows
## name the value or text slot each edits; an Edit node adds its component
## edit rows. A drag is live and one undo step on release.
from luce_ui.ui import VStack, HStack, Text, TextField, Font, Button, ParameterPanel, ParameterSpec, ParameterKind, Rect
from interop import Connection
from workspace import Workspace
from actions import Actions
from parameter_rows import Parameter
from shader_nodes import is_shader
from network import Node
from shader_nodes import inputs as shader_inputs
import node_catalog
from edit_kinds import is_edit
from usd_nodes import Composition, compose_usd
import node_commands
import cad_nodes
import sketch_node
import sketch_commands
from sketch_commands import SketchDimension
import units
from angles import radians, degrees
import tool_prompts

pub class Inspector:
    pub var on_browse: func() -> unit!? = none
    ## The Render node's Render button.
    pub var on_render: func() -> unit!? = none
    pub let body: VStack
    ## The selected node's parameters.
    pub let parameters: ParameterPanel
    let workspace: Workspace
    let actions: Actions
    let name: TextField
    let kind: Text
    let stats: Text
    let description: Text
    let state_rows: VStack
    let delete_button: Button
    let generic_rows: VStack
    let connections: list[Connection]
    ## The catalog rows the panel shows, and what each row is to the inspector:
    ## "value", "text", "info", "reload", "clear", "edits",
    ## "operation", or a blend's "edges", "pick_edges" and "all_edges".
    var rows: list[Parameter]
    var roles: list[str]
    ## What the panel was built for: node kind, file format and edit count.
    var built: str = ""
    ## A USD File node's composed stage, and the file, texts and revision
    ## it was composed for.
    var stage: Composition? = none
    var stage_key: str = ""
    var showing: int = -2
    ## A Sketch node's dimensions, read once per text it has.
    var dimensions_text: str = ""
    var dimensions: list[SketchDimension]

    pub func init(self, workspace: Workspace, actions: Actions, font: Font) -> unit!:
        self.dimensions = []
        self.workspace = workspace
        self.actions = actions
        self.connections = []
        self.rows = []
        self.roles = []
        self.name = TextField("", font = font, placeholder = "Node name", cells = 18.0)
        self.connections.append(self.name.on_commit(func (name: str) -> unit!: node_commands.rename(workspace, name)))
        self.kind = Text("", font = font, muted = true)
        self.stats = Text("", font = font, muted = true)
        self.description = Text("", font = font, muted = true)
        self.parameters = ParameterPanel([], font = font)
        self.connections.append(self.parameters.on_begin(func (index: int) -> unit!:
            if self.roles[index] in ["value", "dimension", "angle_dimension"]:
                workspace.begin("Change " + self.rows[index].name)))
        self.connections.append(self.parameters.on_change(self.changed))
        self.connections.append(self.parameters.on_commit(func (index: int) -> unit!:
            workspace.commit()))
        self.connections.append(self.parameters.on_action(self.acted))
        self.state_rows = VStack([
            HStack([Button(action = actions.output, font = font), Button(action = actions.auto_output, font = font), Button(action = actions.visibility, font = font)], spacing = 4.0),
            HStack([Button(action = actions.display, font = font), Button(action = actions.enabled, font = font)], spacing = 4.0)], spacing = 4.0)
        self.delete_button = Button(action = actions.delete, font = font)
        let header = VStack([self.name, self.kind, self.state_rows, self.description], spacing = 4.0, padding = 6.0)
        let footer = VStack([self.stats, self.delete_button], spacing = 4.0, padding = 6.0)
        self.generic_rows = VStack([header, self.parameters, footer], spacing = 0.0)
        self.body = VStack([self.generic_rows], spacing = 0.0)
        self.refresh()

    ## A parameter changed in the panel: its slots take the values (a vector
    ## its components), a text row its text.
    func changed(self, index: int) -> unit!:
        let role = self.roles[index]
        let row = self.rows[index]
        if role == "value":
            for component in 0..<row.components:
                node_commands.set_parameter(self.workspace, row.slot + component, self.parameters.component(index, component))
        elif role == "text":
            node_commands.set_text(self.workspace, row.slot, self.parameters.text(index))
        elif role == "dimension" or role == "angle_dimension":
            let node = self.workspace.selected() else return
            let value = self.parameters.value(index)
            sketch_commands.set_dimension(self.workspace, node.id, row.slot, radians(value) if role == "angle_dimension" else value)

    func acted(self, index: int) -> unit!:
        let role = self.roles[index]
        if role == "text":
            if let callback = self.on_browse:
                callback()
        elif role == "reload":
            node_commands.reload_file(self.workspace)
        elif role == "render":
            if let callback = self.on_render:
                callback()
        elif role == "clear":
            self.actions.clear_edits.trigger()
        elif role == "pick_edges":
            if let node = self.workspace.selected(): tool_prompts.pick_edges(self.workspace, node.id)
        elif role == "all_edges" or role == "all_profiles":
            node_commands.set_text(self.workspace, 0, "")
        elif role == "pick_face":
            if let node = self.workspace.selected(): tool_prompts.pick_face(self.workspace, node.id)
        elif role == "pick_profiles":
            if let node = self.workspace.selected(): tool_prompts.pick_profiles(self.workspace, node.id)
        elif role == "reselect":
            if let node = self.workspace.selected(): tool_prompts.reselect(self.workspace, node.id)
        elif role == "keep_ids":
            if let node = self.workspace.selected(): node_commands.keep_ids(self.workspace, node.id)

    ## The field showing value slot `slot`, in window points; empty when none shows it.
    pub func field_bounds(self, slot: int) -> Rect!:
        let origin = self.parameters.layout().bounds()
        for index in 0..<self.rows.length:
            let row = self.rows[index]
            if self.roles[index] == "value" and slot >= row.slot and slot < row.slot + row.components:
                let field = self.parameters.field_bounds(index, slot - row.slot)
                return Rect(origin.x + field.x, origin.y + field.y, field.width, field.height)
        return Rect()

    ## The value the panel shows for slot `slot`.
    pub func shown_value(self, slot: int) -> float!:
        for index in 0..<self.rows.length:
            let row = self.rows[index]
            if self.roles[index] == "value" and slot >= row.slot and slot < row.slot + row.components:
                return self.parameters.component(index, slot - row.slot)
        return 0.0

    ## Rebuild the panel's rows for `node`: the catalog's, and an Edit node's edits.
    func build(self, kind: str, path: str) -> unit!:
        self.rows = []
        self.roles = []
        var specs: list[ParameterSpec] = []
        let shown = units.document_unit(self.workspace)
        for row in node_catalog.fields(kind, path, self.stage):
            specs.append(row.spec(shown))
            self.rows.append(row)
            self.roles.append("text" if row.kind in ["text", "path"] else (("render" if row.name == "Render" else "reload") if row.kind == "button" else ("info" if row.kind == "info" else "value")))
        if is_edit(kind):
            self.add(specs, "edits", ParameterSpec(name = "edits", label = "Edits", kind = ParameterKind.info))
            self.add(specs, "clear", ParameterSpec(name = "clear", label = "Clear edits", kind = ParameterKind.button,
                                                    doc = "Remove every component edit of this node."))
        # A verb node made from a selection: pick its components again, or keep
        # its numbers on a changed topology (Houdini's behaviour).
        # A blend's edges: references to them by their faces (luce-cad's
        # names), which survive changes upstream; shown as a count.
        if kind == sketch_node.kind_name:
            self.add(specs, "face", ParameterSpec(name = "face", label = "Face", kind = ParameterKind.info,
                                                  doc = "The input body's face the sketch is on (Plane: Face), kept by its name so it stays that face as the body changes."))
            self.add(specs, "pick_face", ParameterSpec(name = "pick_face", label = "Pick face", kind = ParameterKind.button,
                                                       doc = "Show the input body and click the flat face to sketch on."))
        if kind in ["Extrude", "Revolve"]:
            self.add(specs, "profiles", ParameterSpec(name = "profiles", label = "Profiles", kind = ParameterKind.info,
                                                      doc = "The sketch's regions to take, remembered by the curves round them so they hold as dimensions change. None picked: its closed shapes, holes left empty."))
            self.add(specs, "pick_profiles", ParameterSpec(name = "pick_profiles", label = "Pick profiles", kind = ParameterKind.button, join = true,
                                                           doc = "Click the sketch's regions to take (again to leave one out); Enter finishes."))
            self.add(specs, "all_profiles", ParameterSpec(name = "all_profiles", label = "Closed shapes", kind = ParameterKind.button,
                                                          doc = "Forget the picked profiles: take the sketch's closed shapes."))
        if kind in ["Fillet", "Chamfer"]:
            self.add(specs, "edges", ParameterSpec(name = "edges", label = "Edges", kind = ParameterKind.info,
                                                   doc = "The edges to blend, remembered by the faces they lie between, so they stay the same edges when anything upstream changes. None picked: every straight convex edge between flat faces."))
            self.add(specs, "pick_edges", ParameterSpec(name = "pick_edges", label = "Pick edges", kind = ParameterKind.button, join = true,
                                                        doc = "Show the input body and pick the edges to blend (Enter accepts). Hole rims can be picked too."))
            self.add(specs, "all_edges", ParameterSpec(name = "all_edges", label = "All edges", kind = ParameterKind.button,
                                                       doc = "Forget the picked edges: blend every straight convex edge between flat faces."))
        # A sketch's dimensions, each a row in the document's unit (an
        # angle in degrees); its constraint is the row's slot.
        if kind == sketch_node.kind_name:
            for d in self.sketch_dimensions(path):
                let label = d.name + (" (driven)" if d.driven else "")
                if d.angle:
                    self.add(specs, "angle_dimension", ParameterSpec(name = d.name, label = label, value = degrees(d.value), minimum = -360.0, maximum = 360.0, step = 1.0, decimals = 2, suffix = "°",
                                                                    doc = "An angle the sketch holds; change it and the sketch follows."), d.constraint)
                else:
                    self.add(specs, "dimension", ParameterSpec(name = d.name, label = label, value = d.value, minimum = 0.0, maximum = 1000000.0, step = 1.0, decimals = 2, units = shown,
                                                              doc = "A length the sketch holds; change it and the sketch follows. Type any unit: 10 mm, 0.5 in."), d.constraint)
        if node_catalog.is_mesh_verb(kind):
            self.add(specs, "reselect", ParameterSpec(name = "reselect", label = "Reselect", kind = ParameterKind.button, join = true,
                                                      doc = "Show the input and pick the group's components again (Enter accepts)."))
            self.add(specs, "keep_ids", ParameterSpec(name = "keep_ids", label = "Keep IDs", kind = ParameterKind.button,
                                                      doc = "Use the group's numbers on the input's current topology."))
        self.parameters.set_specs(specs)

    ## An inspector row of the Edit node; `slot` is an operation's index.
    func add(self, specs: list[ParameterSpec], role: str, spec: ParameterSpec, slot: int = -1):
        specs.append(spec)
        self.rows.append(Parameter(spec.label, slot, 0.0))
        self.roles.append(role)

    pub func refresh(self) -> unit!:
        self.generic_rows.layout().set_visible(self.workspace.selected() != none)
        let node = self.workspace.selected() else return
        let changed = node.id != self.showing
        let file = node.kind == "File"
        let format = node_catalog.file_format(node.texts[0]) if file else ""
        let key = f"{node.kind}|{format}|{self.compose(node.texts, node.source_revision) if format == "usd" else ""}|{self.sketch_key(node.kind, node.texts[0])}|{self.workspace.network.units}"
        if key != self.built:
            self.build(node.kind, node.texts[0])
            self.built = key
        self.showing = node.id
        self.state_rows.layout().set_visible(not file)
        self.delete_button.layout().set_visible(not file)
        if changed or not self.name.layout().is_focused():
            self.name.set_text(node.name)
        let network = self.workspace.network
        self.kind.set_text(node.kind + (" · Out" if network.is_output(node.id) else " · internal") + (" · Auto" if node.output == 0 else "") + (" · preview" if network.preview and node.id == network.display else "") + ("" if node.enabled else " · bypassed"))
        self.description.set_text(node.failure if node.failure != "" else ("Warning: " + node.warning if node.warning != "" else node_catalog.description(node.kind)))
        self.description.layout().set_visible(not file or node.failure != "" or node.warning != "")
        self.parameters.layout().set_enabled(node.enabled or file)
        for index in 0..<self.rows.length:
            let role = self.roles[index]
            let row = self.rows[index]
            if role == "value":
                for component in 0..<row.components:
                    self.parameters.set_component(index, component, node.values[row.slot + component])
                # A shader node's linked input takes its link: its value waits.
                if is_shader(node.kind):
                    self.parameters.set_enabled(index, not linked_slot(node, row.slot))
            elif role == "text":
                # A selection too large to read as text shows as a summary
                # (the group itself stays exact); Reselect changes it.
                let text = node.texts[row.slot]
                let baked = row.name == "Group" and text.byte_count > 16384
                self.parameters.set_text(index, f"‹selection of {text.byte_count // 1024} KB›" if baked else text)
                self.parameters.set_enabled(index, not baked)
            elif role == "info":
                self.parameters.set_text(index, row.text)
            elif role == "edits":
                self.parameters.set_text(index, f"{node.edits.length} edits / {self.workspace.selected_count()} selected")
            elif role == "edges":
                self.parameters.set_text(index, cad_nodes.edges_summary(node.texts[0]))
            elif role == "all_edges" or role == "all_profiles":
                self.parameters.set_enabled(index, node.texts[0] != "")
            elif role == "face":
                self.parameters.set_text(index, node.texts[1] if node.texts[1] != "" else "None picked")
            elif role == "profiles":
                self.parameters.set_text(index, cad_nodes.profiles_summary(node.texts[0]))
            elif role == "clear":
                self.parameters.set_enabled(index, node.edits.length > 0)
            elif role == "keep_ids":
                self.parameters.set_enabled(index, node.guard != 0)
            elif role == "dimension" or role == "angle_dimension":
                for d in self.sketch_dimensions(node.texts[0]):
                    if d.constraint == row.slot:
                        self.parameters.set_value(index, degrees(d.value) if d.angle else d.value)
                        self.parameters.set_enabled(index, not d.driven)
        if node_catalog.places_children(node.kind):
            self.stats.set_text(f"{network.outputs(node.id).length} exposed children")
        elif self.workspace.compute != none:
            self.stats.set_text(node.phase if node.computing else node.summary)
        elif let data = node.cache:
            self.stats.set_text(data.description())
        else:
            self.stats.set_text("No evaluated geometry")

    ## Compose a USD File node's stage when its file, texts or revision
    ## changed (a failure shows as the node's cook error); the key composed.
    func compose(self, texts: list[str], revision: int) -> str:
        let key = f"{texts[0].trim()}|{texts[1]}|{texts[2]}|{revision}"
        if key != self.stage_key:
            self.stage_key = key
            self.stage = none
            let composed = compose_usd(texts[0].trim(), texts) catch failure:
                return key
            self.stage = composed
        return key

    ## Sketch text `text`'s dimensions (none when it does not read).
    func sketch_dimensions(self, text: str) -> list[SketchDimension]:
        if text != self.dimensions_text:
            self.dimensions_text = text
            self.dimensions = sketch_commands.dimensions(text) catch failure:
                recover []
        return self.dimensions

    ## What a Sketch node's dimension rows depend on: which constraints are
    ## dimensions (their values refresh in place).
    func sketch_key(self, kind: str, text: str) -> str:
        if kind != sketch_node.kind_name:
            return ""
        let parts: list[str] = []
        for d in self.sketch_dimensions(text):
            parts.append(f"{d.constraint}{"a" if d.angle else ""}{"d" if d.driven else ""}")
        return parts.join(",")

    pub func close(self):
        self.on_browse = none
        self.on_render = none
        for connection in self.connections:
            connection.disconnect()
        self.connections.clear()

## Whether the shader input kept in value slot `slot` is linked.
func linked_slot(node: Node, slot: int) -> bool:
    let sockets = shader_inputs(node.kind)
    for port in 0..<sockets.length:
        if sockets[port].slot == slot and port < node.inputs.length and node.inputs[port] >= 0:
            return true
    return false
